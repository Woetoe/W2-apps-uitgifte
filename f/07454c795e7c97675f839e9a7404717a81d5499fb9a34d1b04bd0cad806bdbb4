function playerRow(pl, top) {
  const b = G.board, name = G.names[pl];
  const cubeHere = G.rules.cube && G.cube.owner === pl ? `<span class="cube">${G.cube.value}</span>` : '';
  const isTurn = G.turn === pl && G.phase !== 'gameover' && G.phase !== 'matchover';
  return `<div class="player ${isTurn ? 'turn' : ''}"><span class="chk ${pl === me() ? 'me' : 'op'}"></span>
    <span class="nm">${esc(name)}</span>${cubeHere}<span class="pip">${E.pips(b, pl)} pips</span><span class="sc" aria-label="Score">${G.score[pl]}</span></div>`;
}

function statusAndButtons() {
  const a = actor(), mineA = isMine(a) && !isCpu(a);
  const name = G.names[a];
  let status = '', btns = '', wait = false;
  if (G.phase === 'roll') {
    if (mineA) {
      status = G.mode === 'local' ? `${esc(name)} is aan zet` : 'Jij bent aan zet';
      btns = `<button class="btn" data-a="roll">Gooien</button>` + (canDouble(a) ? `<button class="btn ivory" data-a="double">Verdubbel naar ${G.cube.value * 2}</button>` : '');
    } else { status = `${esc(name)} gooit…`; wait = true; }
  } else if (G.phase === 'move') {
    const L = legal();
    if (mineA) {
      if (L.maxLen === 0) {
        status = 'Geen zet mogelijk met deze worp';
        btns = `<button class="btn" data-a="end">Beurt doorgeven</button>`;
      } else if (turnDone()) {
        status = 'Klaar? Bevestig je zet';
        btns = `<button class="btn quiet" data-a="undo">Terug</button><button class="btn" data-a="end">Klaar</button>`;
      } else {
        const left = L.maxLen - G.played.length;
        status = ui.sel === null ? (G.played.length ? `Nog ${left} ${left === 1 ? 'zet' : 'zetten'}` : 'Tik op een schijf om te zetten') : 'Tik waar de schijf heen moet';
        btns = G.played.length ? `<button class="btn quiet" data-a="undo">Terug</button>` : '';
      }
      if (G.mode === 'local') status = `${esc(G.names[G.turn])}: ${status.charAt(0).toLowerCase() + status.slice(1)}`;
    } else { status = `${esc(name)} zet…`; wait = true; }
  } else if (G.phase === 'double') {
    const doubler = G.names[G.turn];
    if (mineA) {
      status = `${esc(doubler)} verdubbelt naar ${G.cube.value * 2}. Neem je aan?`;
      btns = `<button class="btn quiet" data-a="drop">Opgeven (−${G.cube.value})</button><button class="btn" data-a="take">Aannemen</button>`;
    } else { status = `Wachten of ${esc(name)} de verdubbeling aanneemt…`; wait = true; }
  } else if (G.phase === 'gameover' || G.phase === 'matchover') {
    status = 'Spel afgelopen';
    btns = `<button class="btn" data-a="showresult">Uitslag bekijken</button>`;
  }
  if (!G.last && G.opening && G.phase === 'move' && !G.played.length) {
    status = `<div class="note">Openingsworp: ${esc(G.names[0])} ${G.opening[0]}, ${esc(G.names[1])} ${G.opening[1]}. ${esc(G.names[G.turn])} begint.</div>` + status;
  }
  if (G.crawford && (G.phase === 'roll' || G.phase === 'move')) status +=`<div class="note">Crawford-spel: verdubbelen kan nu niet</div>`;
  return `<div class="status ${wait ? 'wait' : ''}">${status}</div>${btns ? `<div class="btnrow">${btns}</div>` : ''}`;
}

function vGame() {
  const top = 1 - me(), bottom = me();
  const r = G.rules;
  const info = r.match ? `Tot ${r.match} punten` : `Spel ${G.gameNo}`;
  let netBar = '';
  if (G.mode === 'net' && net.status !== 'connected') {
    netBar = `<div class="netlost"><span>Verbinding met ${esc(G.names[1 - me()])} is weg. Je stand is bewaard.</span><button data-a="reconnect">Opnieuw verbinden</button></div>`;
  }
  return `<div class="wrap game">
    <div class="bar-top"><button class="iconbtn" data-a="home" aria-label="Terug">${IC.back}</button>
      <span class="info">${info}${r.cube && G.cube.owner === -1 && !G.crawford ? ` · kubus ${G.cube.value}` : ''}</span>
      <button class="iconbtn" data-a="menu" aria-label="Menu">${IC.menu}</button></div>
    ${netBar}
    ${playerRow(top, true)}
    <div class="case">${boardSVG()}</div>
    ${playerRow(bottom, false)}
    <div class="controls">${statusAndButtons()}</div>
  </div>`;
}

/* ================= vellen ================= */
function segBtns(key, opts) {
  return `<div class="seg">${opts.map(([v, l]) => `<button data-a="set" data-k="${key}" data-v="${v}" aria-pressed="${String(S[key]) === String(v)}">${l}</button>`).join('')}</div>`;
}
function tog(key, title, desc) {
  return `<div class="row"><div><b>${title}</b>${desc ? `<div class="d">${desc}</div>` : ''}</div><button class="toggle" data-a="tog" data-k="${key}" aria-pressed="${!!S[key]}" aria-label="${title}"></button></div>`;
}
function sheetSettings() {
  const running = G && view === 'game' && inProgress(G);
  return `<div class="sheet-head"><h2>Instellingen</h2><button class="btn quiet" style="min-height:40px;padding:8px 14px" data-a="close">Klaar</button></div>
    <div class="group"><span class="t">Spelvorm</span>${segBtns('variant', [['simple', 'Simpel'], ['cube', 'Met kubus'], ['match', 'Wedstrijd']])}
      <p class="note">${S.variant === 'simple' ? 'Gewone potjes zonder verdubbelkubus.' : S.variant === 'cube' ? 'Losse potjes. Voor je gooit mag je de inzet verdubbelen.' : 'Spelen tot een aantal punten, met verdubbelkubus.'}</p></div>
    ${S.variant === 'match' ? `<div class="group"><span class="t">Wedstrijd tot</span>${segBtns('matchLen', [[3, '3'], [5, '5'], [7, '7'], [9, '9']])}</div>` : ''}
    <div class="group">
      ${tog('gammons', 'Gammon en backgammon', 'Telt 2× of 3× als de verliezer nog niets eraf heeft')}
      ${S.variant === 'match' ? tog('crawford', 'Crawford-regel', 'Geen verdubbeling in het spel nadat iemand op 1 punt van winst staat') : ''}
    </div>
    ${running ? `<p class="note">Regels gelden vanaf een nieuw spel.</p>` : ''}
    <div class="group"><span class="t">Computer</span>${segBtns('level', [['easy', 'Makkelijk'], ['normal', 'Normaal']])}</div>
    <div class="group">
      ${tog('hints', 'Hulp bij zetten', 'Laat zien welke schijven kunnen bewegen')}
      ${tog('sound', 'Geluid')}
      ${tog('vibrate', 'Trillen')}
    </div>
    <details class="rules-help"><summary><b>Spelregels kort</b></summary><ul style="margin-top:8px">
      <li>Breng al je 15 schijven rond naar je thuisvak (rechtsonder) en speel ze eraf. Wie dat eerst doet, wint.</li>
      <li>Je mag niet landen op een punt met 2 of meer schijven van de ander. Land je op een losse schijf, dan sla je die naar de bar.</li>
      <li>Een geslagen schijf moet eerst terug het bord op, links onder, voor je iets anders mag zetten.</li>
      <li>Je moet altijd beide dobbelstenen gebruiken als dat kan. Dubbel gegooid? Dan zet je vier keer.</li>
      <li>Verdubbelen: vóór je gooit kun je de inzet verdubbelen. De ander neemt aan of geeft op.</li>
    </ul></details>`;
}
function sheetMenu() {
  return `<div class="sheet-head"><h2>Menu</h2><button class="btn quiet" style="min-height:40px;padding:8px 14px" data-a="close">Sluiten</button></div>
    <div class="menu-list">
      <button class="btn quiet" data-a="settings">Instellingen</button>
      ${G.mode !== 'net' || net.role === 'host' ? `<button class="btn quiet" data-a="restart">Opnieuw beginnen</button>` : ''}
      ${G.mode === 'net' ? `<button class="btn quiet" data-a="leave">Verbinding verbreken</button>` : ''}
    </div>
    <p class="note">${esc(rulesText(G.rules))}</p>`;
}
function sheetResult() {
  const R = G.result; if (!R) return '';
  const w = R.winner, iWon = G.mode === 'local' ? null : isMine(w);
  const kindTxt = R.dropped ? 'opgegeven' : ['', 'gewonnen', 'gammon', 'backgammon'][R.kind];
  const title = iWon === null ? `${esc(G.names[w])} wint` : iWon ? 'Je wint!' : `${esc(G.names[w])} wint`;
  const matchDone = G.phase === 'matchover';
  const canNext = G.mode !== 'net' || net.status === 'connected';
  return `<div class="result"><h2>${matchDone ? (iWon === false ? `${esc(G.names[w])} wint de wedstrijd` : iWon ? 'Wedstrijd gewonnen!' : `${esc(G.names[w])} wint de wedstrijd`) : title}</h2>
      <span class="pts">+${R.pts}</span>
      <p class="muted">${R.pts === 1 ? '1 punt' : R.pts + ' punten'} · ${kindTxt}${G.cube.value > 1 ? ` · kubus ${G.cube.value}` : ''}</p>
      <div class="scoreline">${esc(G.names[me()])} ${G.score[me()]} – ${G.score[1 - me()]} ${esc(G.names[1 - me()])}</div>
      ${G.rules.match ? `<p class="note">Wedstrijd tot ${G.rules.match}</p>` : ''}
    </div>
    <div class="menu-list">
      ${matchDone ? `<button class="btn" data-a="rematch" ${canNext ? '' : 'disabled'}>Nieuwe wedstrijd</button>` : `<button class="btn" data-a="next" ${canNext ? '' : 'disabled'}>Volgend spel</button>`}
      <button class="btn quiet" data-a="close">Bord bekijken</button>
    </div>`;
}

/* ================= render ================= */
function render() {
  let html = view === 'home' ? vHome() : view === 'lobby' ? vLobby() : (G ? vGame() : vHome());
  if (ui.sheet) {
    const inner = ui.sheet === 'settings' ? sheetSettings() : ui.sheet === 'menu' ? sheetMenu() : ui.sheet === 'result' && G ? sheetResult() : '';
    if (inner) html += `<div class="scrim" data-a="scrim"><div class="sheet" data-stop>${inner}</div></div>`;
  }
  // focus en waarde van het naamveld bewaren tijdens hertekenen
  const f = document.activeElement && document.activeElement.id === 'nm' ? document.activeElement.selectionStart : null;
  app.innerHTML = html;
  if (f !== null) { const el = document.getElementById('nm'); if (el) { el.focus(); try { el.setSelectionRange(f, f); } catch (e) {} } }
}

/* ================= invoer ================= */
function tapPoint(raw) {
  if (!G || G.phase !== 'move' || !isMine(G.turn) || isCpu(G.turn)) return;
  const r = rem();
  const srcs = E.sources(r, G.played.length);
  const pt = raw === 'bar' ? BAR : raw === 'off' ? OFF : +raw;
  if (ui.sel !== null) {
    const t = E.targetsFrom(r, G.played.length, ui.sel);
    if (t.has(pt)) { doPath(t.get(pt)); return; }
  }
  if (srcs.has(pt) && pt !== OFF) {
    ui.sel = ui.sel === pt && !srcs.has(BAR) ? null : pt;
    // maar één mogelijke bestemming? dan meteen zetten scheelt een tik — alleen als hulp aanstaat
    render(); return;
  }
  if (!srcs.has(BAR)) ui.sel = null;
  render();
}

function startMode(mode) {
  if (mode === 'cpu') newMatch('cpu', [S.name.trim() || 'Jij', 'Computer']);
  else if (mode === 'local') newMatch('local', ['Messing', 'Ivoor']);
  view = 'game'; ui.sheet = null;
  commit();
}

app.addEventListener('click', e => {
  const el = e.target.closest('[data-a],[data-pt],[data-act]');
  if (!el) return;
  if (el.dataset.pt !== undefined && !el.dataset.act) { tapPoint(el.dataset.pt); return; }
  const a = el.dataset.a || el.dataset.act;
  if (a === 'scrim') { if (e.target.closest('[data-stop]')) return; if (ui.sheet !== 'result') { ui.sheet = null; render(); } return; }
  switch (a) {
    case 'exit': location.href = '../index.html'; return;
    case 'home': view = 'home'; ui.sheet = null; ui.cpuToken++; if (net.status === 'hosting' || net.status === 'searching') { NET.stopSearching(); net.status = 'idle'; } break;
    case 'settings': ui.sheet = 'settings'; break;
    case 'menu': ui.sheet = 'menu'; break;
    case 'close': ui.sheet = null; break;
    case 'set': S[el.dataset.k] = isNaN(+el.dataset.v) ? el.dataset.v : +el.dataset.v; saveS(); break;
    case 'tog': S[el.dataset.k] = !S[el.dataset.k]; saveS(); if (el.dataset.k === 'sound' && S.sound) sClack(); if (el.dataset.k === 'vibrate') buzz(30); break;
    case 'new': startMode(el.dataset.m); return;
    case 'resume': G = loadGame(el.dataset.m); view = 'game'; ui.sel = null; if (G.phase === 'gameover' || G.phase === 'matchover') ui.sheet = 'result'; render(); schedule(); return;
    case 'lobby': netListen(); view = 'lobby'; net.error = ''; if (net.status === 'lost') net.status = 'idle'; break;
    case 'host': if (!(S.name || '').trim()) { net.error = 'Vul eerst je naam in, dan ziet de ander wie je bent.'; break; } startHost(); return;
    case 'join': if (!(S.name || '').trim()) { net.error = 'Vul eerst je naam in, dan ziet de ander wie je bent.'; break; } startJoin(); return;
    case 'connect': net.status = 'connecting'; net.peer = net.found.get(el.dataset.id) || ''; NET.connect(el.dataset.id); break;
    case 'cancel': NET.stop(); net.status = 'idle'; break;
    case 'reconnect': netListen(); NET.stop(); net.status = 'idle'; view = 'lobby'; setTimeout(() => (net.role === 'join' ? startJoin() : startHost()), 300); break;
    case 'leave': ui.sheet = null; NET.stop(); net.status = 'idle'; view = 'home'; break;
    case 'roll': if (G && G.phase === 'roll' && isMine(G.turn) && !isCpu(G.turn)) doRoll(); return;
    case 'double': offerDouble(); return;
    case 'take': take(); return;
    case 'drop': drop(); return;
    case 'undo': undo(); return;
    case 'end': endTurn(); return;
    case 'showresult': ui.sheet = 'result'; break;
    case 'next': nextGame(); return;
    case 'rematch': rematch(); return;
    case 'restart': ui.sheet = null; if (G.mode === 'net') { newMatch('net', G.names.slice()); } else { newMatch(G.mode, G.names.slice()); } commit(); return;
  }
  render();
});
app.addEventListener('input', e => {
  if (e.target.dataset.in === 'name') { S.name = e.target.value; saveS(); try { localStorage.setItem('w2-name', S.name); } catch (err) {} }
});

// Terugknop van Android: eerst vellen sluiten, dan naar het backgammon-startscherm
window.__w2back = function () {
  if (ui.sheet && ui.sheet !== 'result') { ui.sheet = null; render(); return true; }
  if (ui.sheet === 'result') { ui.sheet = null; render(); return true; }
  if (view !== 'home') { view = 'home'; ui.cpuToken++; if (net.status === 'hosting' || net.status === 'searching') { NET.stopSearching(); net.status = 'idle'; } render(); return true; }
  return false;
};

if (NET && NET.available()) { netListen(); if (NET.isConnected()) { net.status = 'connected'; setTimeout(() => NET.send({ t: 'here', game: 'backgammon', name: myName() }), 50); } }
render();
})();
</script>
</body>
</html>
