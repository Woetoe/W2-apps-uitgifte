  if (st === 'idle' || st === 'lost') {
    body = `<div class="field"><label for="nm">Jouw naam</label><input class="input" id="nm" data-in="name" value="${esc(S.name)}" maxlength="18" placeholder="bijv. Wouter" autocomplete="off"></div>
