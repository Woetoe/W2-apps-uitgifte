<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>Backgammon</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<style>
/* Reisbackgammon: een leren koffertje met groen vilt, bot- en bloedrode punten, messing en ivoor schijven. */
:root{
  --room:#1c1310; --room-2:#271a15; --leather:#3b2419; --leather-2:#4a2e20; --stitch:#c99a5b;
  --felt:#143d30; --felt-2:#1a4a3b; --bone:#e6d8b8; --blood:#8f2d2b;
  --brass:#e3b04b; --brass-deep:#a97a22; --ivory:#f4ecda; --ivory-deep:#b9ad93;
  --text:#f4ecda; --muted:#b9a68c; --line:#5b3d2c; --good:#7fd19b; --warn:#ff8a6b;
  --f-display:"Bricolage Grotesque",system-ui,sans-serif;
  --f-body:"Figtree",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--room);color:var(--text);font:16px/1.45 var(--f-body);-webkit-tap-highlight-color:transparent;
  -webkit-user-select:none;user-select:none;overscroll-behavior:none}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--brass);outline-offset:2px}
.wrap{max-width:520px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;
  padding:calc(env(safe-area-inset-top,0px) + 12px) max(14px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 14px) max(14px,env(safe-area-inset-left,0px))}
h1,h2{font-family:var(--f-display);font-weight:800;margin:0;letter-spacing:-.01em;text-wrap:balance}
p{margin:0}
.muted{color:var(--muted)}
.small{font-size:14px}

/* knoppen */
.btn{border:0;border-radius:14px;padding:15px 18px;font-weight:700;font-size:17px;background:var(--brass);color:#2a1a08;
  box-shadow:0 4px 0 var(--brass-deep);transition:transform .07s,box-shadow .07s;min-height:52px}
.btn:active{transform:translateY(2px);box-shadow:0 2px 0 var(--brass-deep)}
.btn:disabled{opacity:.4;box-shadow:none}
.btn.quiet{background:var(--leather-2);color:var(--text);box-shadow:0 4px 0 #2a1912}
.btn.quiet:active{box-shadow:0 2px 0 #2a1912}
.btn.ivory{background:var(--ivory);color:#2a1a08;box-shadow:0 4px 0 var(--ivory-deep)}
.iconbtn{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--room-2);display:grid;place-items:center;flex:none}
.iconbtn svg{width:22px;height:22px}

/* ---------- startscherm ---------- */
.home{gap:22px}
.home-top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.back{display:flex;align-items:center;gap:6px;background:none;border:0;color:var(--muted);font-weight:600;padding:10px 4px}
.hero{display:flex;flex-direction:column;gap:10px;padding-top:6px}
.hero h1{font-size:46px;line-height:.95}
.rules-line{color:var(--muted)}
.case-mini{height:110px;border-radius:16px;background:var(--leather);padding:9px;position:relative;
  box-shadow:inset 0 0 0 1px #00000040}
.case-mini::before{content:"";position:absolute;inset:4px;border-radius:12px;border:1.5px dashed var(--stitch);opacity:.55;pointer-events:none}
.case-mini svg{width:100%;height:100%;display:block;border-radius:8px}
.choices{display:flex;flex-direction:column;gap:10px}
.choice{display:flex;align-items:center;gap:14px;text-align:left;background:var(--room-2);border:1px solid var(--line);border-radius:16px;padding:14px 16px;min-height:76px}
.choice .ic{width:42px;height:42px;border-radius:50%;flex:none;display:grid;place-items:center;background:var(--leather-2)}
.choice .ic svg{width:24px;height:24px}
.choice b{display:block;font-size:17px}
.choice span{color:var(--muted);font-size:14px}
.choice:disabled{opacity:.5}
.resume{display:flex;gap:8px;margin-top:-2px}
.resume .btn{flex:1;padding:11px;min-height:44px;font-size:15px}

/* ---------- lobby ---------- */
.lobby{gap:18px}
.field{display:flex;flex-direction:column;gap:6px}
.field label{font-weight:700}
.input{background:var(--room-2);border:1px solid var(--line);border-radius:12px;padding:13px 14px;font-size:17px;-webkit-user-select:text;user-select:text}
.input:focus{outline:none;border-color:var(--brass)}
.tip{background:var(--room-2);border-left:3px solid var(--stitch);border-radius:6px 12px 12px 6px;padding:12px 14px;color:var(--muted);font-size:15px}
.tip b{color:var(--text)}
.found{display:flex;flex-direction:column;gap:8px}
.waiting{display:flex;align-items:center;gap:12px;padding:14px 0}
.pulse{width:14px;height:14px;border-radius:50%;background:var(--brass);animation:pulse 1.2s ease-in-out infinite;flex:none}
@keyframes pulse{0%,100%{transform:scale(.7);opacity:.5}50%{transform:scale(1.1);opacity:1}}
.err{color:var(--warn);font-weight:600}

/* ---------- spel ---------- */
.game{gap:8px}
.bar-top{display:flex;align-items:center;gap:8px}
.bar-top .info{flex:1;text-align:center;font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums}
.player{display:flex;align-items:center;gap:10px;padding:6px 4px;font-variant-numeric:tabular-nums}
.chk{width:22px;height:22px;border-radius:50%;flex:none;box-shadow:inset 0 0 0 3px #0000002a}
.chk.me{background:var(--brass)}
.chk.op{background:var(--ivory)}
.player .nm{font-weight:700;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.player .pip{color:var(--muted);font-size:14px}
.player .sc{font-family:var(--f-display);font-weight:800;font-size:22px;min-width:1.4ch;text-align:right}
.player.turn .nm::after{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--good);margin-left:8px;vertical-align:middle}
.cube{display:inline-grid;place-items:center;min-width:28px;height:28px;padding:0 5px;border-radius:7px;background:var(--ivory);color:#2a1a08;font-weight:800;font-size:14px;box-shadow:0 2px 0 var(--ivory-deep)}
.case{background:var(--leather);border-radius:18px;padding:8px;position:relative;box-shadow:0 10px 30px #00000066, inset 0 0 0 1px #00000040}
.case::before{content:"";position:absolute;inset:4px;border-radius:14px;border:1.5px dashed var(--stitch);opacity:.5;pointer-events:none}
#board{display:block;width:100%;height:auto;touch-action:manipulation}
.controls{display:flex;flex-direction:column;gap:10px;margin-top:4px}
.status{text-align:center;min-height:24px;font-weight:600}
.status.wait{color:var(--muted);font-weight:500}
.btnrow{display:flex;gap:10px}
.btnrow .btn{flex:1}
.netlost{background:#5a1f1a;border-radius:12px;padding:10px 12px;display:flex;align-items:center;gap:10px;font-size:15px}
.netlost span{flex:1}
.netlost button{border:0;background:var(--ivory);color:#2a1a08;border-radius:10px;padding:9px 12px;font-weight:700}

/* bord-svg */
.pt-hit{fill:transparent}
.target{fill:var(--brass);opacity:.38}
.target-dot{fill:var(--brass)}
.src-ring{fill:none;stroke:var(--good);stroke-width:2.5}
.sel-ring{fill:none;stroke:#fff;stroke-width:3}
.last-ring{fill:none;stroke:#ffffff;stroke-width:1.5;stroke-dasharray:3 3;opacity:.55}

/* ---------- vellen ---------- */
.scrim{position:fixed;inset:0;background:#0a0605b3;z-index:20;display:flex;align-items:flex-end;justify-content:center;
  padding:16px max(12px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 12px) max(12px,env(safe-area-inset-left,0px))}
.sheet{width:100%;max-width:520px;max-height:100%;overflow:auto;background:var(--room-2);border:1px solid var(--line);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:14px;
  -webkit-user-select:none;user-select:none}
.sheet h2{font-size:26px}
.sheet-head{display:flex;justify-content:space-between;align-items:center;gap:10px}
.group{display:flex;flex-direction:column;gap:8px}
.group > .t{font-weight:700}
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;background:var(--room);border:1px solid var(--line);border-radius:12px;padding:4px;gap:4px}
.seg button{border:0;background:none;border-radius:9px;padding:10px 4px;font-weight:600;color:var(--muted);font-size:15px}
.seg button[aria-pressed="true"]{background:var(--brass);color:#2a1a08}
.row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:4px 0}
.row .d{font-size:14px;color:var(--muted)}
.toggle{width:52px;height:30px;border-radius:15px;border:0;background:var(--line);position:relative;flex:none}
.toggle::after{content:"";position:absolute;top:4px;left:4px;width:22px;height:22px;border-radius:50%;background:var(--ivory);transition:transform .15s}
.toggle[aria-pressed="true"]{background:var(--good)}
.toggle[aria-pressed="true"]::after{transform:translateX(22px)}
.note{font-size:14px;color:var(--muted)}
.menu-list{display:flex;flex-direction:column;gap:8px}
.menu-list .btn{width:100%}
.result{text-align:center;display:flex;flex-direction:column;gap:8px;align-items:center;padding:6px 0}
.result h2{font-size:34px;line-height:1}
.result .pts{font-family:var(--f-display);font-weight:800;font-size:56px;color:var(--brass);line-height:1}
.scoreline{font-family:var(--f-display);font-weight:800;font-size:22px;font-variant-numeric:tabular-nums}
.rules-help ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:15px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="app"></div>
<script src="../w2.js"></script>
<script src="engine.js"></script>
<script>
(function () {
const E = window.BGE, BAR = E.BAR, OFF = E.OFF;
const app = document.getElementById('app');
const NET = window.W2 && W2.net;

/* ================= instellingen ================= */
const SKEY = 'bg-settings';
const defaults = { variant: 'cube', matchLen: 5, gammons: true, crawford: true, level: 'normal', sound: true, vibrate: true, hints: true, name: '' };
let S = Object.assign({}, defaults);
try { Object.assign(S, JSON.parse(localStorage.getItem(SKEY) || '{}')); } catch (e) {}
const saveS = () => { try { localStorage.setItem(SKEY, JSON.stringify(S)); } catch (e) {} };
function rulesNow() {
  return { cube: S.variant !== 'simple', gammons: !!S.gammons, match: S.variant === 'match' ? S.matchLen : 0, crawford: !!S.crawford };
}
function rulesText(r) {
  if (r.match) return `Wedstrijd tot ${r.match} punten${r.crawford ? ', Crawford-regel' : ''}`;
  if (r.cube) return `Losse spellen met verdubbelkubus${r.gammons ? '' : ', gammon telt niet'}`;
  return `Losse spellen zonder kubus${r.gammons ? ', gammon telt dubbel' : ''}`;
}

/* ================= opslag per spelvorm ================= */
const GKEY = m => 'bg-game-' + m;
function loadGame(mode) { try { const g = JSON.parse(localStorage.getItem(GKEY(mode)) || 'null'); return g && g.board ? g : null; } catch (e) { return null; } }
function saveGame(g) { try { localStorage.setItem(GKEY(g.mode), JSON.stringify(g)); } catch (e) {} }
function dropGame(mode) { try { localStorage.removeItem(GKEY(mode)); } catch (e) {} }
const inProgress = g => g && g.phase !== 'matchover';

/* ================= toestand ================= */
let G = null;               // huidig spel
let view = 'home';          // home | lobby | game
const ui = { sel: null, sheet: null, cpuToken: 0, err: '' };
const net = {
  role: localStorage.getItem('w2-net-role') || localStorage.getItem('bg-net-role') || null, // host | join
  status: 'idle',           // idle | hosting | searching | connecting | connected | lost
  found: new Map(), peer: '', error: ''
};
const me = () => (G && G.mode === 'net' ? (net.role === 'join' ? 1 : 0) : 0);

/* ================= geluid en trillen ================= */
let ac = null;
function tone(f, d, type, vol, delay) {
  if (!S.sound) return;
  try {
    ac = ac || new (window.AudioContext || window.webkitAudioContext)();
    if (ac.state === 'suspended') ac.resume();
    const t = ac.currentTime + (delay || 0), o = ac.createOscillator(), g = ac.createGain();
    o.type = type || 'sine'; o.frequency.value = f;
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol || 0.12, t + 0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, t + d);
    o.connect(g); g.connect(ac.destination); o.start(t); o.stop(t + d + 0.02);
  } catch (e) {}
}
const sClack = () => { tone(180, 0.06, 'triangle', 0.25); tone(90, 0.08, 'sine', 0.2, 0.01); };
const sDice = () => { for (let i = 0; i < 5; i++) tone(260 + Math.random() * 300, 0.04, 'square', 0.04, i * 0.05); };
const sHit = () => { tone(140, 0.15, 'sawtooth', 0.12); };
const sWin = () => { tone(523, 0.15, 'triangle', 0.12); tone(659, 0.15, 'triangle', 0.12, 0.13); tone(784, 0.35, 'triangle', 0.14, 0.26); };
const sTurn = () => tone(740, 0.12, 'sine', 0.08);
function buzz(p) { if (S.vibrate && navigator.vibrate) try { navigator.vibrate(p); } catch (e) {} }

/* ================= spelverloop ================= */
function uid() { return Date.now().toString(36) + E.rnd(1e6).toString(36); }

function newMatch(mode, names) {
  G = { v: 1, gid: uid(), mode, rules: rulesNow(), names, score: [0, 0], gameNo: 0, crawUsed: false, seq: 0 };
  newGame();
  return G;
}
function newGame() {
  const r = G.rules;
  G.board = E.newBoard();
  G.cube = { value: 1, owner: -1 };
  G.result = null; G.last = null; G.played = [];
  G.crawford = false;
  if (r.match && r.crawford && !G.crawUsed && (G.score[0] === r.match - 1 || G.score[1] === r.match - 1)) {
    G.crawford = true; G.crawUsed = true;
  }
  let a, b; do { a = E.rollDie(); b = E.rollDie(); } while (a === b);
  G.opening = [a, b];       // a = speler 0, b = speler 1
  G.turn = a > b ? 0 : 1;
  G.dice = [a, b];
  G.start = E.clone(G.board);
  G.phase = 'move';
  G.gameNo++;
  ui.sel = null;
}
function actor() { return G.phase === 'double' ? 1 - G.turn : G.turn; }
function isCpu(pl) { return G.mode === 'cpu' && pl === 1; }
function isMine(pl) {
  if (G.mode === 'local') return true;
  if (G.mode === 'cpu') return pl === 0;
  return pl === me() && net.status === 'connected';
}
function canDouble(pl) {
  const r = G.rules;
  if (!r.cube || G.crawford || G.phase !== 'roll' || G.turn !== pl) return false;
  if (G.cube.owner !== -1 && G.cube.owner !== pl) return false;
  if (G.cube.value >= 64) return false;
  if (r.match && G.score[pl] + G.cube.value >= r.match) return false; // heeft geen zin meer
  return true;
}

let legalCache = { key: '', val: null };
function legal() {
  if (!G || !G.dice || G.phase !== 'move') return { seqs: [], maxLen: 0 };
  const key = G.gid + '|' + G.start.p.join(',') + G.start.bar + G.start.off + '|' + G.turn + '|' + G.dice.join(',');
  if (legalCache.key !== key) legalCache = { key, val: E.legalSequences(G.start, G.turn, G.dice) };
  return legalCache.val;
}
function rem() { return E.remaining(legal().seqs, G.played); }
function turnDone() { return G.played.length >= legal().maxLen; }

function commit(opts) {
  G.seq++;
  saveGame(G);
  if (G.mode === 'net' && net.status === 'connected' && !(opts && opts.silent)) NET.send({ t: 'state', s: G });
  render();
  schedule();
}

function doRoll() {
  if (G.phase !== 'roll') return;
  G.dice = [E.rollDie(), E.rollDie()];
  G.start = E.clone(G.board); G.played = []; G.phase = 'move'; ui.sel = null;
  sDice(); buzz(20);
  commit();
}
function doPath(path) {
  const pl = G.turn;
  let hit = false;
  for (const m of path) { G.board = E.applyMove(G.board, pl, m); G.played.push(m); if (m.hit) hit = true; }
  ui.sel = null;
  if (hit) { sHit(); buzz([30, 30, 30]); } else { sClack(); buzz(12); }
  if (G.board.off[pl] === 15) return finish(pl, false);
  // nog een schijf op de bar? dan meteen die weer selecteren
  commit();
}
function undo() {
  if (!G.played.length) return;
  G.played.pop();
  let b = E.clone(G.start);
  for (const m of G.played) b = E.applyMove(b, G.turn, m);
  G.board = b; ui.sel = null; sClack();
  commit();
}
function endTurn() {
  G.last = { pl: G.turn, moves: G.played.slice(), dice: G.dice };
  G.turn = 1 - G.turn; G.dice = null; G.played = []; G.phase = 'roll'; ui.sel = null;
  commit();
  if (isMine(G.turn) && G.mode !== 'local') { sTurn(); buzz(25); }
}
function offerDouble() { if (!canDouble(G.turn)) return; G.phase = 'double'; tone(500, 0.2, 'triangle', 0.1); commit(); }
function take() { G.cube = { value: G.cube.value * 2, owner: 1 - G.turn }; G.phase = 'roll'; commit(); }
function drop() { finish(G.turn, true); }
function finish(winner, dropped) {
  const kind = dropped ? 1 : (G.rules.gammons ? E.winKind(G.board, winner) : 1);
  const pts = kind * G.cube.value;
  G.score[winner] += pts;
  G.result = { winner, kind, pts, dropped };
  G.phase = G.rules.match && G.score[winner] >= G.rules.match ? 'matchover' : 'gameover';
  G.last = { pl: G.turn, moves: G.played.slice(), dice: G.dice };
  if (isMine(winner) || G.mode === 'local') { sWin(); buzz([60, 40, 60, 40, 160]); } else { tone(200, 0.4, 'triangle', 0.1); }
  ui.sheet = 'result';
  commit();
}
function nextGame() { ui.sheet = null; newGame(); commit(); }
function rematch() {
  ui.sheet = null;
  const mode = G.mode, names = G.names.slice();
  newMatch(mode, names);
  commit();
}

/* ================= computer ================= */
function schedule() {
  if (!G || view !== 'game' || G.mode !== 'cpu') return;
  const a = actor();
  if (!isCpu(a) || G.phase === 'gameover' || G.phase === 'matchover') return;
  const token = ++ui.cpuToken, gid = G.gid;
  const still = () => token === ui.cpuToken && G && G.gid === gid && view === 'game';
  const lvl = S.level;
  if (G.phase === 'roll') {
    setTimeout(() => {
      if (!still()) return;
      if (canDouble(1) && E.aiShouldDouble(G.board, 1, lvl)) offerDouble(); else doRoll();
    }, 700);
  } else if (G.phase === 'double') {
    setTimeout(() => { if (still()) (E.aiShouldTake(G.board, 1, lvl) ? take() : drop()); }, 1100);
  } else if (G.phase === 'move') {
    // computer speelt zijn zetten één voor één, zodat je ze kunt volgen
    if (G.played.length) { G.played = []; G.board = E.clone(G.start); }
    const seq = E.chooseMove(G.start, 1, G.dice, lvl);
    let k = 0;
    const step = () => {
      if (!still()) return;
      if (k < seq.length) {
        const m = seq[k++];
        G.board = E.applyMove(G.board, 1, m); G.played.push(m);
        if (m.hit) { sHit(); buzz([30, 30, 30]); } else sClack();
        if (G.board.off[1] === 15) { finish(1, false); return; }
        G.seq++; saveGame(G); render();
        setTimeout(step, 520);
      } else {
        setTimeout(() => { if (still()) endTurn(); }, seq.length ? 450 : 1300);
      }
    };
    setTimeout(step, 650);
  }
}

/* ================= twee telefoons ================= */
let unlisten = null;
function netListen() {
  if (!NET || unlisten) return;
  unlisten = NET.on(ev => {
    switch (ev.type) {
      case 'hosting': net.status = 'hosting'; net.error = ''; break;
      case 'searching': net.status = 'searching'; net.error = ''; break;
      case 'found': net.found.set(ev.id, ev.name); break;
      case 'lost': net.found.delete(ev.id); break;
      case 'connecting': net.status = 'connecting'; net.peer = ev.name || net.peer; break;
      case 'connected':
        net.status = 'connected'; net.peer = ev.name || net.peer; net.error = ''; net.found.clear();
        onNetConnected(); return;
      case 'disconnected':
        net.status = 'lost'; buzz([80, 60, 80]); break;
      case 'stopped': net.status = 'idle'; break;
      case 'error':
        net.error = NET.explain(ev);
        if (net.status !== 'connected') net.status = 'idle';
        break;
      case 'message': {
        let msg; try { msg = JSON.parse(ev.data); } catch (e) { return; }
        onNetMessage(msg); return;
      }
    }
    render();
  });
}
function myName() { return (S.name || '').trim() || (localStorage.getItem('w2-name') || '').trim() || 'Speler'; }
function startHost() { net.role = 'host'; localStorage.setItem('bg-net-role', 'host'); localStorage.setItem('w2-net-role', 'host'); net.error = ''; net.status = 'hosting'; NET.host(myName()); render(); }
function startJoin() { net.role = 'join'; localStorage.setItem('bg-net-role', 'join'); localStorage.setItem('w2-net-role', 'join'); net.error = ''; net.found.clear(); net.status = 'searching'; NET.join(myName()); render(); }
function onNetConnected() {
  NET.send({ t: 'here', game: 'backgammon', name: myName() });
  if (net.role === 'host') {
    const saved = loadGame('net');
    if (inProgress(saved) && saved.names[1] === net.peer) G = saved;  // verder waar we waren
    else newMatch('net', [myName(), net.peer || 'Tegenstander']);
    view = 'game';
    G.seq++; saveGame(G);
    NET.send({ t: 'state', s: G });
  }
  // wie meedoet wacht op de stand van de host
  render();
}
function onNetMessage(msg) {
  if (msg.t === 'here') {
    if (msg.game === 'backgammon') {
      if (!msg.ack) NET.send({ t: 'here', game: 'backgammon', ack: true, name: myName() });
      if (net.role === 'host') {
        const saved = G && G.mode === 'net' ? G : loadGame('net');
        if (inProgress(saved)) { G = saved; view = 'game'; NET.send({ t: 'state', s: G }); }
        else { newMatch('net', [myName(), msg.name || net.peer || 'Tegenstander']); view = 'game'; G.seq++; saveGame(G); NET.send({ t: 'state', s: G }); }
        render();
      }
    }
    return;
  }
  if (msg.t === 'state' && msg.s) {
    const inc = msg.s;
    const local = G && G.mode === 'net' ? G : loadGame('net');
    if (local && local.gid === inc.gid && local.seq > inc.seq) {
      // wij zijn verder in hetzelfde spel (bv. na wegvallen verbinding): stuur onze stand terug
      G = local; view = 'game'; saveGame(G);
      NET.send({ t: 'state', s: G });
      render();
      return;
    }
    const prevTurn = G && G.mode === 'net' ? actor() : -1;
    G = inc; saveGame(G);
    if (view === 'lobby') view = 'game';
    if (G.phase === 'gameover' || G.phase === 'matchover') ui.sheet = 'result';
    else if (ui.sheet === 'result') ui.sheet = null;
    const a = actor();
    if (a === me() && prevTurn !== a && G.phase !== 'gameover' && G.phase !== 'matchover') { sTurn(); buzz(25); }
    else if (G.played.length) sClack();
    render();
  }
}

/* ================= tekenen: bord ================= */
const VW = 360, VH = 470, M = 8, RH = 30, BAND = 44, COLW = 164, TRI = 150;
const YB = M + 6 * RH;                // begin band
const YB2 = YB + BAND;                // begin onderste helft
const TRAY_Y = YB2 + 6 * RH + 8;
function nOf(i) { return me() === 0 ? i + 1 : 24 - i; }
function iOf(n) { return me() === 0 ? n - 1 : 24 - n; }
function geo(n) {
  const right = n <= 12;
  let r, top;
  if (n <= 6) { r = 6 - n; top = false; }
  else if (n <= 12) { r = 12 - n; top = true; }
  else if (n <= 18) { r = n - 13; top = true; }
  else { r = n - 19; top = false; }
  const y = top ? M + r * RH : YB2 + r * RH;
  return { right, y };
}
function checkerXY(n, k) {
  const g = geo(n);
  const cx = g.right ? VW - M - 15 - k * 29 : M + 15 + k * 29;
  return { cx, cy: g.y + 15 };
}
function chk(cx, cy, mine, label, extra) {
  const fill = mine ? 'var(--brass)' : 'var(--ivory)';
  const rim = mine ? 'var(--brass-deep)' : 'var(--ivory-deep)';
  return `<g ${extra || ''}><circle cx="${cx}" cy="${cy + 1.5}" r="13.5" fill="#00000055"/>
    <circle cx="${cx}" cy="${cy}" r="13.5" fill="${fill}" stroke="${rim}" stroke-width="1.5"/>
    <circle cx="${cx}" cy="${cy}" r="8.5" fill="none" stroke="${rim}" stroke-width="1" opacity=".7"/>
    ${label ? `<text x="${cx}" y="${cy + 5}" text-anchor="middle" font-family="Figtree" font-weight="800" font-size="14" fill="#2a1a08">${label}</text>` : ''}</g>`;
}
function dieSVG(x, y, s, v, mine, used) {
  const fill = mine ? 'var(--brass)' : 'var(--ivory)';
  const P = { 1: [[.5, .5]], 2: [[.27, .27], [.73, .73]], 3: [[.27, .27], [.5, .5], [.73, .73]], 4: [[.27, .27], [.73, .27], [.27, .73], [.73, .73]],
    5: [[.27, .27], [.73, .27], [.5, .5], [.27, .73], [.73, .73]], 6: [[.27, .25], [.73, .25], [.27, .5], [.73, .5], [.27, .75], [.73, .75]] }[v];
  return `<g opacity="${used ? 0.28 : 1}"><rect x="${x}" y="${y + 2}" width="${s}" height="${s}" rx="${s * .2}" fill="#00000055"/>
    <rect x="${x}" y="${y}" width="${s}" height="${s}" rx="${s * .2}" fill="${fill}"/>
    ${P.map(([a, b]) => `<circle cx="${x + a * s}" cy="${y + b * s}" r="${s * .095}" fill="#2a1a08"/>`).join('')}</g>`;
}

function boardSVG() {
  const b = G.board, mine = me(), opp = 1 - mine;
  const moving = G.phase === 'move' && isMine(G.turn);
  const r = moving ? rem() : [];
  const srcs = moving ? E.sources(r, G.played.length) : new Set();
  // staat er een eigen schijf op de bar, dan is die automatisch gekozen
  if (moving && srcs.has(BAR)) ui.sel = BAR;
  const targets = moving && ui.sel !== null ? E.targetsFrom(r, G.played.length, ui.sel) : new Map();

  let s = `<svg id="board" viewBox="0 0 ${VW} ${VH}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Backgammonbord">`;
  // vilt
  s += `<rect x="${M}" y="${M}" width="${COLW}" height="${6 * RH}" rx="6" fill="var(--felt)"/>
        <rect x="${VW - M - COLW}" y="${M}" width="${COLW}" height="${6 * RH}" rx="6" fill="var(--felt)"/>
        <rect x="${M}" y="${YB2}" width="${COLW}" height="${6 * RH}" rx="6" fill="var(--felt)"/>
        <rect x="${VW - M - COLW}" y="${YB2}" width="${COLW}" height="${6 * RH}" rx="6" fill="var(--felt)"/>
        <rect x="${M}" y="${YB + 4}" width="${VW - 2 * M}" height="${BAND - 8}" rx="8" fill="var(--leather-2)"/>`;
  // punten
  for (let n = 1; n <= 24; n++) {
    const g = geo(n), y = g.y;
    const col = n % 2 ? 'var(--blood)' : 'var(--bone)';
    const pts = g.right ? `${VW - M},${y + 1.5} ${VW - M},${y + RH - 1.5} ${VW - M - TRI},${y + RH / 2}`
                        : `${M},${y + 1.5} ${M},${y + RH - 1.5} ${M + TRI},${y + RH / 2}`;
    s += `<polygon points="${pts}" fill="${col}" opacity="${n % 2 ? .9 : .85}"/>`;
    const i = iOf(n);
    if (targets.has(i)) s += `<polygon points="${pts}" class="target" data-tgt="${i}"/>`;
  }
  // puntnummers voor de speler (klein, langs de rug)
  for (let n = 1; n <= 24; n++) {
    const g = geo(n);
    const x = g.right ? VW - M - COLW + 3 : M + COLW - 3;
    s += `<text x="${x}" y="${g.y + 19}" text-anchor="${g.right ? 'start' : 'end'}" font-family="Figtree" font-size="9" fill="#ffffff" opacity=".35">${n}</text>`;
  }
  // laatste zet van de tegenstander zichtbaar maken
  const lastTo = new Set();
  if (G.last && G.last.pl !== G.turn && (G.mode === 'local' || G.last.pl !== mine)) {
    for (const m of G.last.moves) if (m.to >= 0) lastTo.add(m.to);
  }
  // schijven
  for (let i = 0; i < 24; i++) {
    const v = b.p[i]; if (!v) continue;
    const owner = v > 0 ? 0 : 1, cnt = Math.abs(v), n = nOf(i);
    const shown = Math.min(cnt, 5);
    for (let k = 0; k < shown; k++) {
      const { cx, cy } = checkerXY(n, k);
      const lbl = k === 4 && cnt > 5 ? cnt : '';
      s += chk(cx, cy, owner === mine, lbl);
    }
    const top = checkerXY(n, shown - 1);
    if (srcs.has(i) && S.hints && ui.sel !== i) s += `<circle cx="${top.cx}" cy="${top.cy}" r="15.5" class="src-ring"/>`;
    if (ui.sel === i) s += `<circle cx="${top.cx}" cy="${top.cy}" r="16" class="sel-ring"/>`;
    if (lastTo.has(i)) s += `<circle cx="${top.cx}" cy="${top.cy}" r="16.5" class="last-ring"/>`;
  }
  // doel-stippen op lege punten
  for (const [t] of targets) {
    if (t < 0) continue;
    const n = nOf(t), ownCnt = E.own(b, G.turn, t);
    // op een losse schijf van de ander: stip op die schijf; anders op de eerstvolgende vrije plek
    const pos = checkerXY(n, ownCnt ? Math.min(ownCnt, 4) : 0);
    s += `<circle cx="${pos.cx}" cy="${pos.cy}" r="6" class="target-dot"/>`;
  }
  // bar: eigen schijven links (daar kom je binnen), tegenstander rechts
  const cy = YB + BAND / 2;
  for (let k = 0; k < Math.min(b.bar[mine], 3); k++) s += chk(M + 24 + k * 26, cy, true, k === 2 && b.bar[mine] > 3 ? b.bar[mine] : '');
  for (let k = 0; k < Math.min(b.bar[opp], 3); k++) s += chk(VW - M - 24 - k * 26, cy, false, k === 2 && b.bar[opp] > 3 ? b.bar[opp] : '');
  if (ui.sel === BAR && b.bar[G.turn]) {
    const x = G.turn === mine ? M + 24 + (Math.min(b.bar[mine], 3) - 1) * 26 : VW - M - 24 - (Math.min(b.bar[opp], 3) - 1) * 26;
    s += `<circle cx="${x}" cy="${cy}" r="16" class="sel-ring"/>`;
  }
  // dobbelstenen of kubus in het midden
  if (G.dice && (G.phase === 'move')) {
    const dm = G.turn === mine;
    const isD = G.dice[0] === G.dice[1];
    if (isD) {
      const usedN = G.played.length;
      for (let k = 0; k < 4; k++) s += dieSVG(VW / 2 - 58 + k * 30, YB + 10, 24, G.dice[0], dm, k < usedN);
    } else {
      const used = G.played.map(m => m.die);
      const u0 = used.includes(G.dice[0]), u1 = used.includes(G.dice[1]);
      s += dieSVG(VW / 2 - 40, YB + 6, 32, G.dice[0], dm, u0) + dieSVG(VW / 2 + 8, YB + 6, 32, G.dice[1], dm, u1);
    }
  } else if (G.phase === 'roll' && isMine(G.turn) && !isCpu(G.turn)) {
    s += `<g data-act="roll" style="cursor:pointer"><rect x="${VW / 2 - 52}" y="${YB + 7}" width="104" height="30" rx="15" fill="var(--brass)"/>
      <text x="${VW / 2}" y="${YB + 27}" text-anchor="middle" font-family="Figtree" font-weight="800" font-size="15" fill="#2a1a08">Gooien</text></g>`;
  }
  // eraf-bakjes
  const trayW = COLW;
  const tray = (x, cnt, isMineTray, highlight) => {
    let t = `<rect x="${x}" y="${TRAY_Y}" width="${trayW}" height="34" rx="8" fill="var(--leather-2)" ${highlight ? 'stroke="var(--brass)" stroke-width="3"' : ''}/>`;
    for (let k = 0; k < cnt; k++) t += `<rect x="${x + 6 + k * 10.1}" y="${TRAY_Y + 6}" width="8" height="22" rx="2" fill="${isMineTray ? 'var(--brass)' : 'var(--ivory)'}"/>`;
    if (!cnt) t += `<text x="${x + trayW / 2}" y="${TRAY_Y + 22}" text-anchor="middle" font-family="Figtree" font-size="12" fill="var(--muted)">eraf</text>`;
    return t;
  };
  s += tray(VW - M - trayW, b.off[mine], true, targets.has(OFF) && G.turn === mine);
  s += tray(M, b.off[opp], false, targets.has(OFF) && G.turn === opp);
  // tikvlakken
  for (let n = 1; n <= 24; n++) {
    const g = geo(n);
    s += `<rect class="pt-hit" data-pt="${iOf(n)}" x="${g.right ? VW - M - COLW : M}" y="${g.y}" width="${COLW}" height="${RH}"/>`;
  }
  s += `<rect class="pt-hit" data-pt="bar" x="${M}" y="${YB}" width="${VW / 2 - 60}" height="${BAND}"/>`;
  s += `<rect class="pt-hit" data-pt="bar" x="${VW / 2 + 60}" y="${YB}" width="${VW / 2 - 68}" height="${BAND}"/>`;
  s += `<rect class="pt-hit" data-pt="off" x="${M}" y="${TRAY_Y - 4}" width="${VW - 2 * M}" height="42"/>`;
  if (G.phase === 'roll' && isMine(G.turn) && !isCpu(G.turn)) s += `<rect class="pt-hit" data-act="roll" x="${VW / 2 - 60}" y="${YB}" width="120" height="${BAND}"/>`;
  s += `</svg>`;
  return s;
}

