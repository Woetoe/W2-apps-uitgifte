};
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

function miniBoard() {
  // decoratief bordje op het startscherm
  let s = '<svg viewBox="0 0 320 92" preserveAspectRatio="none"><rect width="320" height="92" fill="var(--felt)"/>';
  for (let k = 0; k < 12; k++) {
    const x = 6 + k * 25.6 + (k >= 6 ? 4 : 0);
    s += `<polygon points="${x},0 ${x + 22},0 ${x + 11},38" fill="${k % 2 ? 'var(--bone)' : 'var(--blood)'}" opacity=".9"/>`;
    s += `<polygon points="${x},92 ${x + 22},92 ${x + 11},54" fill="${k % 2 ? 'var(--blood)' : 'var(--bone)'}" opacity=".9"/>`;
  }
  const c = (x, y, m) => `<circle cx="${x}" cy="${y}" r="9.5" fill="${m ? 'var(--brass)' : 'var(--ivory)'}" stroke="${m ? 'var(--brass-deep)' : 'var(--ivory-deep)'}" stroke-width="1.2"/>`;
  s += c(17, 10, 1) + c(17, 29, 1) + c(119, 82, 0) + c(119, 63, 0) + c(170, 82, 1) + c(170, 63, 1) + c(170, 44, 1) + c(273, 10, 0) + c(273, 29, 0) + c(298, 82, 1);
  s += '</svg>';
  return s;
}

