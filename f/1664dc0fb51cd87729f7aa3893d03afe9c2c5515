        <rect x="4" y="66" width="14" height="14" rx="2"/><rect x="20" y="66" width="14" height="14" rx="2"/><rect x="36" y="66" width="14" height="14" rx="2"/><rect x="68" y="66" width="12" height="14" rx="2"/>
