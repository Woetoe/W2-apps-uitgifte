<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>W2 Apps</title>
<link rel="stylesheet" href="fonts/fonts.css">
<style>
/* Startscherm: elke tegel draagt de kleuren van zijn eigen spel, de rest blijft rustig. */
:root{--bg:#14161f;--panel:#1d202c;--line:#30344a;--text:#f2efe8;--muted:#a3a6b9;
  --f-display:"Bricolage Grotesque",system-ui,sans-serif;--f-body:"Figtree",system-ui,sans-serif;color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font:16px/1.45 var(--f-body);-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}
.wrap{max-width:520px;margin:0 auto;padding:calc(env(safe-area-inset-top,0px) + 28px) max(16px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 28px) max(16px,env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:26px}
header{display:flex;align-items:baseline;gap:12px}
.mark{font:800 52px/0.9 var(--f-display);letter-spacing:-.04em}
.mark sup{font-size:.45em;vertical-align:.95em;margin-left:2px;color:#ffc83d}
header p{margin:0;color:var(--muted)}
h2{font:800 20px/1.2 var(--f-display);margin:0 0 -12px}
.tiles{display:grid;gap:12px}
.tile{display:grid;grid-template-columns:84px 1fr;gap:16px;align-items:center;padding:12px 16px 12px 12px;border-radius:20px;text-decoration:none;color:inherit;min-height:108px;position:relative;overflow:hidden}
.tile:active{transform:scale(.985)}
.tile .art{width:84px;height:84px;border-radius:14px;display:block}
.tile b{display:block;font:800 23px/1.1 var(--f-display);margin-bottom:4px}
.tile span{font-size:15px;opacity:.85}
.bg{background:#3b2419;color:#f4ecda}
.lu{background:#17244f;color:#f3f5ff}
.sc{background:#18212d;color:#eef0f2}
.cd{background:#2a2236;color:#f3eef7}
.vs{background:#232534;color:#f4f2ec}
.wb{background:#16302a;color:#f3efe3}
.kk{background:#1a1a2a;color:#f4f1ea}
.soon{border:1.5px dashed var(--line);border-radius:20px;padding:18px;color:var(--muted);font-size:15px}
footer{color:var(--muted);font-size:13px;text-align:center}
.upd{display:flex;align-items:center;gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:12px 14px}
.upd.new{border-color:#ffc83d;background:#2a2610}
.upd .tx{flex:1;font-size:15px;line-height:1.3}
.upd .tx small{display:block;color:var(--muted);font-size:13px}
.upd button{border:0;border-radius:12px;padding:11px 14px;font:inherit;font-weight:700;background:#ffc83d;color:#211a02;min-height:44px;flex:none}
.upd button.q{background:var(--bg);color:var(--text);border:1px solid var(--line)}
.upd button:disabled{opacity:.5}
.bar{height:6px;border-radius:3px;background:var(--line);overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;background:#ffc83d;width:0}
@media (prefers-reduced-motion:reduce){.tile:active{transform:none}}
</style>
</head>
<body>
<div class="wrap">
