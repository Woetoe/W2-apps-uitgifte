<script src="w2.js"></script>
<script>
  // Lettertypes in de tegeltjes pas tekenen als ze geladen zijn
  if (document.fonts && document.fonts.load) document.fonts.load('13px "Dela Gothic One"');
  const U = window.W2 && W2.update;
  const verEl = document.getElementById('ver'), upd = document.getElementById('upd');
  const info = U && U.available() ? U.info() : {};
  verEl.textContent = window.W2 && W2.inApp ? 'W2 Apps ' + (info.build ? '1.0.' + info.build : '') : 'W2 Apps · browserversie (twee telefoons werkt alleen in de app)';

  /* Updates: knop om te zoeken, en stil zoeken bij openen (hooguit eens per uur) */
  const mb = b => (b / 1048576).toFixed(b > 1048576 ? 1 : 2).replace('.', ',') + ' MB';
  function show(html, cls) { upd.hidden = false; upd.className = 'upd ' + (cls || ''); upd.innerHTML = html; }
  function idle(msg) { show(`<div class="tx">${msg || 'Nieuwe spellen of verbeteringen?'}<small>Versie 1.0.${info.build || '?'}</small></div><button class="q" data-u="check">Updates zoeken</button>`); }
  let quiet = false;
  if (U && U.available()) {
    U.on(ev => {
      const s = ev.state;
      if (s === 'checking') { if (!quiet) show('<div class="tx">Zoeken naar updates…</div>'); }
      else if (s === 'none') { quiet ? idle() : idle('Je hebt de nieuwste versie.'); }
      else if (s === 'available') show(`<div class="tx"><b>Nieuwe versie ${ev.version}</b><small>${ev.files} bestand${ev.files === '1' ? '' : 'en'}, ${mb(+ev.bytes)} · je standen blijven bewaard</small></div><button data-u="apply">Bijwerken</button>`, 'new');
      else if (s === 'downloading') show(`<div class="tx">Bijwerken… ${ev.pct}%<div class="bar"><i style="width:${ev.pct}%"></i></div></div>`, 'new');
      else if (s === 'ready') { show(`<div class="tx"><b>Bijgewerkt naar ${ev.version}</b><small>De app start opnieuw…</small></div>`, 'new'); setTimeout(() => U.reload(), 900); }
      else if (s === 'apk') show(`<div class="tx"><b>Nieuwe app-versie ${ev.version}</b><small>Deze keer is een nieuwe installatie nodig. Je standen blijven bewaard.</small></div><button data-u="apk">Installeren</button>`, 'new');
      else if (s === 'apk-downloading') show(`<div class="tx">Downloaden… ${ev.pct}%<div class="bar"><i style="width:${ev.pct}%"></i></div></div>`, 'new');
      else if (s === 'apk-permission') show(`<div class="tx"><b>Eenmalig toestaan</b><small>Zet in het scherm dat opent "Toestaan van deze bron" aan, kom terug en tik nog eens op Installeren.</small></div><button data-u="apk">Installeren</button>`, 'new');
      else if (s === 'apk-ready') show('<div class="tx"><b>Tik op Installeren</b><small>Android vraagt nog één keer of je wilt bijwerken.</small></div>', 'new');
      else if (s === 'error') { quiet ? idle() : show(`<div class="tx"><b>Bijwerken lukte niet</b><small>${navigator.onLine === false ? 'Geen internet. Probeer het straks opnieuw.' : 'Check je internet en probeer opnieuw.'}</small></div><button class="q" data-u="check">Opnieuw</button>`); }
      if (s !== 'checking') quiet = false;
    });
    upd.addEventListener('click', e => {
      const b = e.target.closest('[data-u]'); if (!b) return;
      quiet = false;
      if (b.dataset.u === 'check') U.check();
      else if (b.dataset.u === 'apply') { b.disabled = true; U.apply(); }
      else if (b.dataset.u === 'apk') { b.disabled = true; U.installApk(); }
    });
    idle();
    let last = 0; try { last = +localStorage.getItem('w2-upd-last') || 0; } catch (e) {}
    if (navigator.onLine !== false && Date.now() - last > 3600e3) {
      try { localStorage.setItem('w2-upd-last', String(Date.now())); } catch (e) {}
      quiet = true; U.check();
    }
  }
</script>
</body>
