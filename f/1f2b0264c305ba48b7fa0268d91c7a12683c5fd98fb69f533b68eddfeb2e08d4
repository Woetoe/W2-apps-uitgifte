  return false;
};
window.addEventListener('pagehide', () => { if (role) leaveNet(); });
if (document.fonts && document.fonts.load) document.fonts.load('800 24px "Bricolage Grotesque"').then(() => { if (view === 'game') render(); });
render();
})();
</script>
