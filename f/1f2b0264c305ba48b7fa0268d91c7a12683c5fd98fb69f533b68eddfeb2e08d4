  const loc = loadGame('local');
  const why = !NET || !NET.available() ? 'Werkt alleen in de geïnstalleerde app' : !multiOK() ? 'Werk eerst de app bij (nieuwe installatie nodig)' : 'Ieder op een eigen telefoon, 2 tot 4 spelers';
  return `<div class="wrap">
    <div class="top"><button class="back" data-a="exit">${IC.back} Spellen</button><button class="iconbtn" data-a="settings" aria-label="Instellingen">${IC.gear}</button></div>
    <div class="hero"><div class="art" aria-hidden="true">${[T(1, 7), T(2, 7), T(3, 7)].map(t => tileHTML(t)).join('')}<span style="width:10px"></span>${tileHTML(104)}${tileHTML(T(0, 11))}</div>
      <h1>Tegelrummy</h1><p>Leg reeksen en groepen, bouw de tafel om, en wees als eerste door je stenen heen.</p></div>
    <div class="choices">
      ${inProgress(loc) ? `<div class="resume"><div><b>Lopend spel</b><p class="note">${loc.players.map(p => esc(p.name)).join(', ')} · ${loc.match.of > 1 ? `spel ${loc.match.game} van ${loc.match.of} · ` : ''}${loc.pool.length} in de pot</p></div>
        <div class="row2"><button class="btn" data-a="resume">Doorgaan</button><button class="btn quiet" data-a="abandon">Stoppen</button></div></div>` : ''}
      <button class="choice" data-a="setup" data-k="cpu"><span class="ic">${IC.cpu}</span><span><b>Tegen de computer</b><span>Makkelijk, normaal of sterk, met 1 tot 3 computers</span></span></button>
      <button class="choice" data-a="setup" data-k="local"><span class="ic">${IC.one}</span><span><b>Samen op één telefoon</b><span>2 tot 4 spelers, je stenen blijven geheim bij het doorgeven</span></span></button>
      <button class="choice" data-a="host" ${multiOK() ? '' : 'disabled'}><span class="ic">${IC.host}</span><span><b>Spel maken voor meer telefoons</b><span>${multiOK() ? 'Anderen doen mee op hun eigen telefoon, aangevuld met computers' : why}</span></span></button>
      <button class="choice" data-a="join" ${multiOK() ? '' : 'disabled'}><span class="ic">${IC.join}</span><span><b>Meedoen</b><span>${multiOK() ? 'Bij iemand die een spel heeft gemaakt' : why}</span></span></button>
      <button class="choice" data-a="rules"><span class="ic">${IC.book}</span><span><b>Spelregels</b><span>Kort uitgelegd, met voorbeelden</span></span></button>
    </div>
  </div>`;
}
function seg(act, cur, opts) { return `<div class="seg">${opts.map(([v, l]) => `<button data-a="${act}" data-v="${v}" aria-pressed="${String(cur) === String(v)}">${l}</button>`).join('')}</div>`; }
const TIMES = [[0, 'Geen'], [60, '1 min'], [120, '2 min'], [180, '3 min']];
function cfgHTML(time, games, nPlayers, prefix) {
  return `<div class="field"><div class="label">Tijd per beurt</div>${seg(prefix + 'time', time, TIMES)}
      <p class="note">${time ? 'Lukt het niet op tijd, dan gaat alles terug en pak je 3 strafstenen. Niks gedaan? Dan pak je er één.' : 'Iedereen neemt de tijd die nodig is. Officieel is het 1 minuut.'}</p></div>
    <div class="field"><div class="label">Aantal spellen</div>${seg(prefix + 'games', games, [['one', 'Eén spel'], ['round', `Een ronde (${Math.max(2, nPlayers)} spellen)`]])}
      <p class="note">${games === 'round' ? 'Wie de meeste spellen wint, wint de ronde. Gelijk? Dan telt de hoogste puntenstand.' : 'Na het spel zie je wie er wint en hoeveel punten iedereen kwijt is.'}</p></div>`;
}
function vSetup() {
  const seats = S.seats, n = seats.length, humans = seats.filter(s => s.type === 'human').length;
  return `<div class="wrap">
    <div class="top"><button class="back" data-a="home">${IC.back} Tegelrummy</button></div>
    <h1 style="font-size:34px">${ui.setupKind === 'cpu' ? 'Tegen de computer' : 'Samen op één telefoon'}</h1>
    <div class="field"><div class="label">Spelers <small>${n} van ${MAXP}</small></div>
      <div class="seats">${seats.map((s, i) => `<div class="seat">
        <span class="badge">${s.type === 'cpu' ? IC.cpu : i + 1}</span>
        ${s.type === 'human' ? `<input class="input" data-in="seat" data-i="${i}" value="${esc(s.name || (i === 0 ? myName() : ''))}" maxlength="16" placeholder="Speler ${i + 1}" autocomplete="off">`
          : `<span class="nm">Computer<small>Denkt zelf na</small></span><button class="pill" data-a="level" data-i="${i}">${LEVELS[s.level || 'normal']}</button>`}
