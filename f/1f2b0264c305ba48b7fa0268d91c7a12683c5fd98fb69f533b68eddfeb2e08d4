    case 'resume': G = loadGame('local'); if (!G) break; role = null; view = 'game'; resetTurnUi(); ui.seenStart = G.gid; ui.sheet = G.over ? 'result' : null; render(); schedule(); return;
    case 'abandon': store.del(GKEY('local')); if (view === 'game') { G = null; W = null; view = 'home'; } ui.sheet = null; break;
