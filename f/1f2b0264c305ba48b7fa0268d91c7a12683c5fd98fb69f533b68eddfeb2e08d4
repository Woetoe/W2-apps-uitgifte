}
function nameField() {
  return `<div class="field"><label class="label" for="nm">Jouw naam</label><input class="input" id="nm" data-in="name" value="${esc(myName())}" maxlength="16" placeholder="bijv. Wouter" autocomplete="off"></div>`;
}
function plRow(p, i, editable) {
  const tag = p.tok === TOK ? 'Jij' : p.type === 'cpu' ? 'Computer' : i === 0 ? 'Maakt het spel' : 'Telefoon';
  let acts = '';
  if (editable && p.type === 'cpu') acts = `<button class="pill" data-a="botlevel" data-i="${i}">${LEVELS[p.level]}</button><button class="xbtn" data-a="botdel" data-i="${i}" aria-label="Computer weghalen">${IC.x}</button>`;
  else if (p.type === 'cpu') acts = `<span class="note">${LEVELS[p.level]}</span>`;
  return `<div class="seat"><span class="badge">${p.type === 'cpu' ? IC.cpu : IC.person}</span><span class="nm">${esc(p.name)}<small>${tag}</small></span>${acts}</div>`;
}
function vHost() {
  const n = L.players.length, phones = L.players.filter(p => p.type === 'human' && p.tok !== TOK).length;
  const saved = loadGame('net');
  const resumable = inProgress(saved) && saved.players.some(p => p.tok === TOK);
  let status;
  if (!multiOK()) status = `<div class="status"><span class="pulse off"></span><div><b>Alleen tegen de computer</b><span class="note">${NET && NET.available() ? 'Voor meer telefoons is een nieuwe versie van de app nodig. Zoek naar updates via Instellingen (tandwiel op het startscherm).' : 'Andere telefoons kunnen meedoen in de geïnstalleerde app.'}</span></div></div>`;
  else if (net.status === 'hosting') status = `<div class="status"><span class="pulse"></span><div><b>Anderen kunnen nu meedoen</b><span class="note">Laat ze Tegelrummy openen en op Meedoen tikken.${phones ? ` ${phones} telefoon${phones > 1 ? 's' : ''} verbonden.` : ''}</span></div></div>`;
  else status = `<div class="status"><span class="pulse off"></span><div><b>Niet zichtbaar voor anderen</b><span class="note">Zet Bluetooth en wifi aan.</span></div><button class="btn quiet small" data-a="readvertise">Opnieuw</button></div>`;
  return `<div class="wrap">
    <div class="top"><button class="back" data-a="home">${IC.back} Tegelrummy</button></div>
    <h1 style="font-size:34px">Spel maken</h1>
    ${net.err ? `<p class="err">${esc(net.err)}</p>` : ''}
    ${status}
    ${resumable ? `<div class="resume"><div><b>Lopend spel</b><p class="note">${saved.players.map(p => esc(p.name)).join(', ')}. Wie nog niet terug is, speelt als computer tot die weer meedoet.</p></div><div class="row2"><button class="btn" data-a="netresume">Verder spelen</button><button class="btn quiet" data-a="netabandon">Weggooien</button></div></div>` : ''}
    ${nameField()}
    <div class="field"><div class="label">Spelers <small>${n} van ${MAXP}</small></div>
      <div class="seats">${L.players.map((p, i) => plRow(p, i, true)).join('')}</div>
      ${n < MAXP ? `<button class="btn quiet" data-a="botadd">+ Computer</button>` : ''}
    </div>
    ${cfgHTML(L.time, L.games, n, 'n')}
    <div class="sticky"><button class="btn" data-a="startnet" ${n < 2 ? 'disabled' : ''}>${n < 2 ? 'Voeg een computer toe of wacht op iemand' : `Start met ${n} spelers`}</button></div>
  </div>`;
}
function vJoin() {
  const st = net.status;
  let body = '';
  if (st === 'idle' || st === 'lost') {
    body = `${nameField()}
      ${st === 'lost' ? '<p class="err">De verbinding met de maker is weg.</p>' : ''}
      <button class="btn" data-a="search">Zoeken naar een spel</button>
      <p class="note">Iemand anders moet in Tegelrummy op Spel maken hebben getikt.</p>`;
  } else if (st === 'searching') {
    const list = [...net.found.entries()];
    body = `<div class="status"><span class="pulse"></span><div><b>Zoeken naar spellen in de buurt…</b><span class="note">Houd de telefoons bij elkaar.</span></div></div>
      <div class="list">${list.map(([id, nm]) => `<button class="btn" data-a="connect" data-id="${esc(id)}">Meedoen met ${esc(nm)}</button>`).join('')}</div>
      <button class="btn quiet" data-a="stopsearch">Stoppen</button>`;
  } else if (st === 'connecting') {
    body = `<div class="status"><span class="pulse"></span><b>Verbinden met ${esc(net.hostName || 'de maker')}…</b></div>`;
  } else if (st === 'connected') {
    const lb = net.lobby;
    body = `<div class="status"><span class="pulse"></span><div><b>${lb ? `Wachten tot ${esc(lb.host)} start…` : 'Verbonden'}</b><span class="note">${net.busy ? 'Er loopt nog een spel zonder jou. Je doet mee vanaf het volgende.' : 'Het spel begint vanzelf op jouw telefoon.'}</span></div></div>
      ${nameField()}
      ${lb ? `<div class="field"><div class="label">Spelers <small>${lb.players.length} van ${MAXP}</small></div><div class="seats">${lb.players.map((p, i) => plRow(p, i, false)).join('')}</div></div>
      <p class="note">Tijd per beurt: ${lb.time ? lb.time / 60 + ' min' : 'geen'} · ${lb.games === 'round' ? 'een ronde van ' + lb.players.length + ' spellen' : 'één spel'}</p>` : ''}
      <button class="btn quiet" data-a="leave">Weggaan</button>`;
  }
  return `<div class="wrap">
    <div class="top"><button class="back" data-a="home">${IC.back} Tegelrummy</button></div>
    <h1 style="font-size:34px">Meedoen</h1>
    ${net.err ? `<p class="err">${esc(net.err)}</p>` : ''}
    ${body}
    <div class="tip"><b>In het vliegtuig?</b> Zet vliegtuigmodus aan en daarna Bluetooth en wifi weer aan. Internet is niet nodig.</div>
  </div>`;
}

/* ---------------- spelscherm ---------------- */
function vGame() {
  const w = ensureW(), mine = !!w, owner = rackOwner();
  const live = !mine && ui.live && ui.live.k === turnKey() ? ui.live.table : null;
  const table = w ? w.table : live || G.table;
  const baseIds = new Set(G.table.flat());
  const sel = new Set(w ? w.sel : []), swaps = swapTargets();
  const lastSet = new Set(G.last || []);
  const cur = G.players[G.turn];
  const canPut = w && w.sel.length > 0;
  const sets = table.map((s, i) => {
    const a = TR.analyze(s), lock = w && lockedSet(s);
    const allSel = s.length && s.every(t => sel.has(t));
    const plus = canPut && !lock && !allSel ? `<button class="plus" data-a="put" data-i="${i}" aria-label="Hierbij leggen">+</button>` : '';
    const flip = w && !lock && TR.flipJoker(s) ? `<button class="flip" data-a="flip" data-i="${i}" aria-label="Joker naar de andere kant">${IC.flip}</button>` : '';
    const tiles = s.map(t => {
      let c = '';
      if (sel.has(t)) c = 'sel';
      else if (swaps.has(t)) c = 'swap';
      else if ((w || live) && !baseIds.has(t)) c = 'new';
      else if (!w && !live && lastSet.has(t)) c = 'last';
      return tileHTML(t, c);
    }).join('');
    return `<div class="set ${a.ok ? '' : 'bad'} ${lock ? 'lock' : ''}" data-set="${i}">${flip}${tiles}${plus}</div>`;
  }).join('');
  const newBtn = w ? `<button class="newset ${canPut ? 'on' : ''}" data-a="newset" data-drop="new" ${canPut ? '' : 'disabled'}>+ Nieuwe rij</button>` : '';

  // rek
  let rackHTML;
  if (owner >= 0) {
    const key = G.gid + ':' + owner, order = rackOrder(owner);
    const inRack = w ? order.filter(t => !onTableNow(t)) : order.filter(t => G.players[owner].rack.includes(t));
    const fresh = new Set(ui.fresh[key] || []);
    rackHTML = `<div class="rackhead"><span class="who">${G.mode === 'local' && humansHere() > 1 ? 'Stenen van ' + esc(G.players[owner].name) : 'Jouw stenen'} · ${inRack.length}</span>
        <div class="seg"><button data-a="sort" data-v="num" aria-pressed="${S.sort === 'num'}" aria-label="Sorteer op cijfer">7 7 7</button><button data-a="sort" data-v="col" aria-pressed="${S.sort === 'col'}" aria-label="Sorteer op kleur">5 6 7</button></div></div>
      <div class="rack" id="rack" data-drop="rack">${inRack.map(t => tileHTML(t, (sel.has(t) ? 'sel ' : '') + (fresh.has(t) && !sel.has(t) ? 'fresh' : ''))).join('') || '<span class="hidden-rack" style="width:100%">Leeg!</span>'}</div>`;
  } else {
    rackHTML = `<div class="rack"><div class="hidden-rack" style="width:100%">${cur.type === 'cpu' ? `${esc(cur.name)} denkt na…` : 'Stenen blijven verborgen tot de telefoon is doorgegeven.'}</div></div>`;
  }

  // bericht en knoppen
  let msg = '', msgCls = '';
  if (G.over) msg = 'Spel afgelopen';
  else if (ui.waiting) { msg = 'Zet versturen…'; msgCls = 'wait'; }
  else if (w) {
    if (ui.msg) { msg = ui.msg; msgCls = w.bad ? 'bad' : ''; }
    else if (!w.base.melded) { const ck = TR.checkTurn(w.base, { table: w.table }); msg = ck.meld ? `Eerste uitkomst: ${ck.meld} van de 30 punten` : 'Eerste uitkomst: leg samen minstens 30 punten, alleen uit je eigen rek.'; msgCls = ck.ok ? '' : 'wait'; }
    else msg = 'Jij bent aan de beurt';
  } else {
    msgCls = 'wait';
    msg = isCpuNow(G.turn) ? `${esc(cur.name)} is aan de beurt${G.players[G.turn].away ? ' (computer speelt even voor die)' : ''}` : `${esc(cur.name)} is aan de beurt`;
  }
  let acts = '';
  if (w) {
    const one = w.sel.length === 1 ? w.sel[0] : null;
    const canBack = w.sel.length && w.sel.every(ownNew);
    const splitOk = one !== null && onTableNow(one) && (() => { const s = w.table.find(x => x.includes(one)); return s.indexOf(one) > 0 && !lockedSet(s); })();
    acts = w.sel.length
      ? `<button class="btn quiet" data-a="newset">Nieuwe rij</button>${canBack ? '<button class="btn quiet" data-a="toback">Terug in rek</button>' : ''}${splitOk ? '<button class="btn quiet" data-a="split">Knip hiervoor</button>' : ''}<button class="btn dim" data-a="desel">Niks</button>`
      : '<span class="hint">Tik stenen aan, dan + bij een rij. Of sleep ze.</span>';
    if (swaps.size && !ui.msg) { msg = 'Tik de knipperende joker om hem te ruilen'; msgCls = ''; }
  }
  let main = '';
  if (w) {
    const changed = w.table.flat().length !== w.base.table.flat().length || w.dirty;
    const placed = w.table.flat().length - w.base.table.flat().length;
    main = changed
      ? `<button class="btn quiet" data-a="reset">Herstel</button><button class="btn" data-a="done">Klaar${placed > 0 ? ` (${placed})` : ''}</button>`
      : `<button class="btn quiet" data-a="sortcycle">Sorteer</button><button class="btn" data-a="draw">${G.pool.length ? 'Pak een steen' : 'Passen'}</button>`;
  } else if (G.over) main = `<button class="btn quiet" data-a="menu">Menu</button><button class="btn" data-a="showresult">Uitslag</button>`;

  const players = G.players.map((p, i) => {
    const total = G.match.of > 1 ? `<span title="Stand">${G.match.totals[i] > 0 ? '+' : ''}${G.match.totals[i]}</span>` : '';
    return `<div class="pl ${i === G.turn && !G.over ? 'turn' : ''}"><span class="nm">${esc(p.name)}${p.tok === TOK && G.mode === 'net' ? ' (jij)' : ''}</span>
      <span class="ct"><b>${p.rack.length}</b> stenen ${p.melded ? '<span class="ok" title="Al uitgekomen">✓</span>' : ''} ${p.away ? '<span class="away">weg</span>' : ''} ${total}</span></div>`;
  }).join('');

  const lost = ui.lostHost ? `<div class="netlost"><span>Verbinding met ${esc(net.hostName || 'de maker')} kwijt.</span><button data-a="rejoin">Opnieuw zoeken</button></div>` : '';
  const ms = timeLeft();
  return `<div class="game ${S.shapes ? 'shapes' : ''}" id="game">
    <div class="bar"><button class="iconbtn" data-a="menu" aria-label="Menu">${IC.menu}</button>
      <div class="info"><b>${G.pool.length}</b> in de pot${G.match.of > 1 ? ` · spel <b>${G.match.game}</b> van ${G.match.of}` : ''}</div>
      <span class="clock ${ms !== null && ms < 10000 ? 'low' : ''}" id="clock">${ms !== null && !isCpuNow(G.turn) && !G.over ? fmt(ms) : ''}</span></div>
    ${lost}
    <div class="players">${players}</div>
    <div class="felt" id="felt"><div class="sets">${sets}${newBtn}</div>${!table.length && !w ? '<div class="empty">Nog niks op tafel. De eerste uitkomst is minstens 30 punten.</div>' : ''}</div>
    <div class="msg ${msgCls}">${msg}</div>
    ${w ? `<div class="acts">${acts}</div>` : ''}
    ${rackHTML}
    ${main ? `<div class="main">${main}</div>` : ''}
  </div>`;
}
function vCover() {
  const p = G.turn, name = esc(G.players[p].name);
  const since = ui.lastSeen[p] === undefined ? 0 : ui.lastSeen[p];
  const lines = G.log.filter(e => e.m >= since && e.p !== p).slice(-4).map(logLine);
  return `<div class="cover"><p class="muted">Geef de telefoon aan</p><h2>${name}</h2>
    ${lines.length ? `<div class="lastmv">${lines.join('')}</div>` : ''}
    <button class="btn" data-a="uncover">Ik ben ${name}, laat zien</button>
    <button class="btn quiet" data-a="menu">Menu</button></div>`;
}
