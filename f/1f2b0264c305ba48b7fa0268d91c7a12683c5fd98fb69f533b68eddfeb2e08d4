<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>Tegelrummy</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<style>
/* Tegelrummy: een donker petrolgroen speelkleed met crèmekleurige stenen. Alles daaromheen blijft rustig. */
:root{
  --room:#0b1d24; --room2:#11272f; --panel:#173540; --line:#264a56; --text:#f3efe6; --muted:#9fb7bd;
  --felt:#0f3d49; --felt2:#13495a; --tile:#f7f1e3; --edge:#cdbd98; --sel:#ffc83d; --selInk:#2a1f00;
  --c0:#22242b; --c1:#d3352c; --c2:#1d63c9; --c3:#e08600;
  --accent:#ffc83d; --accentInk:#2a1f00; --good:#4fd18b; --warn:#ff8a6b;
  --f-display:"Bricolage Grotesque",system-ui,sans-serif; --f-body:"Figtree",system-ui,sans-serif;
  --tw:28px; --rw:42px; color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--room);color:var(--text);font:16px/1.45 var(--f-body);-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;overscroll-behavior:none}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
#app{height:100%}
.wrap{max-width:520px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;gap:16px;
  padding:calc(env(safe-area-inset-top,0px) + 12px) max(16px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 20px) max(16px,env(safe-area-inset-left,0px))}
h1,h2,h3{font-family:var(--f-display);font-weight:800;margin:0;letter-spacing:-.01em;text-wrap:balance}
p{margin:0}
.muted{color:var(--muted)}
.note{font-size:14px;color:var(--muted)}
.err{color:var(--warn);font-weight:600}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.back{display:flex;align-items:center;gap:6px;background:none;border:0;color:var(--muted);font-weight:600;padding:10px 4px}
.iconbtn{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--room2);display:grid;place-items:center;flex:none;color:var(--text)}
.iconbtn svg{width:22px;height:22px}
.btn{border:0;border-radius:14px;padding:13px 16px;min-height:50px;font-weight:700;font-size:16px;background:var(--accent);color:var(--accentInk)}
.btn:active{transform:translateY(1px)}
.btn:disabled{opacity:.4}
.btn.quiet{background:var(--panel);color:var(--text);border:1px solid var(--line)}
.btn.small{min-height:40px;padding:8px 14px;font-size:15px}
.btn.dim{background:var(--panel);color:var(--muted);border:1px solid var(--line)}

/* stenen */
.t{--w:var(--tw);width:var(--w);height:calc(var(--w)*1.36);border-radius:calc(var(--w)*.16);background:var(--tile);
  box-shadow:inset 0 calc(var(--w)*-.09) 0 var(--edge),0 2px 4px #0005;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;
  position:relative;flex:none;touch-action:none;font:800 calc(var(--w)*.62)/1 var(--f-display);font-variant-numeric:tabular-nums;letter-spacing:-.04em;transition:transform .1s}
.t.c0{color:var(--c0)} .t.c1{color:var(--c1)} .t.c2{color:var(--c2)} .t.c3{color:var(--c3)}
.t i{font-style:normal;font-size:calc(var(--w)*.26);line-height:1;margin-top:calc(var(--w)*.04);opacity:.85;display:none}
.shapes .t i{display:block}
.t .jk{width:72%;height:72%}
.t.sel{background:var(--sel);box-shadow:inset 0 calc(var(--w)*-.09) 0 #c79310,0 0 0 2px var(--sel),0 6px 12px #0007;transform:translateY(-3px)}
.t.new{box-shadow:inset 0 calc(var(--w)*-.09) 0 var(--edge),0 0 0 2px var(--good)}
.t.last{box-shadow:inset 0 calc(var(--w)*-.09) 0 var(--edge),0 0 0 2px #ffffffb0}
.t.fresh::after{content:"";position:absolute;top:3px;right:3px;width:7px;height:7px;border-radius:50%;background:var(--good)}
.t.swap{animation:sw 1s ease-in-out infinite}
@keyframes sw{50%{box-shadow:inset 0 calc(var(--w)*-.09) 0 var(--edge),0 0 0 3px var(--sel)}}
.t.drag{opacity:.25}
.felt .t{touch-action:manipulation}
.felt .t.sel{touch-action:none}
.t.back{background:linear-gradient(135deg,#d7c9a6,#b9a77f);color:transparent}

/* start */
.hero h1{font-size:50px;line-height:.92;letter-spacing:-.03em}
.hero p{margin-top:8px;color:var(--muted)}
.hero .art{display:flex;gap:6px;margin:6px 0 16px;--tw:44px;transform:rotate(-3deg);transform-origin:left}
.hero .art .t:nth-child(2n){transform:translateY(5px)}
.choices{display:flex;flex-direction:column;gap:10px}
.choice{display:flex;align-items:center;gap:14px;text-align:left;background:var(--room2);border:1px solid var(--line);border-radius:16px;padding:14px 16px;min-height:76px;color:var(--text);width:100%}
.choice .ic{width:44px;height:44px;border-radius:12px;flex:none;display:grid;place-items:center;background:var(--panel);color:var(--accent)}
.choice .ic svg{width:26px;height:26px}
.choice b{display:block;font-size:17px}
.choice span{color:var(--muted);font-size:14px}
.choice:disabled{opacity:.5}
.resume{display:flex;flex-direction:column;gap:10px;background:var(--panel);border:1px solid var(--accent);border-radius:16px;padding:14px 16px}
.resume .row2{display:flex;gap:8px}
.resume .btn{flex:1;min-height:44px}

/* instellen */
.field{display:flex;flex-direction:column;gap:8px}
.label{font-weight:700;display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.label small{font-weight:500;color:var(--muted);font-size:14px}
.input{background:var(--room2);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-size:17px;-webkit-user-select:text;user-select:text;width:100%;min-width:0}
.input:focus{outline:none;border-color:var(--accent)}
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;background:var(--room2);border:1px solid var(--line);border-radius:12px;padding:4px;gap:4px}
.seg button{border:0;background:none;border-radius:9px;padding:9px 4px;font-weight:600;color:var(--muted);font-size:15px;min-height:42px}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accentInk)}
.seats{display:flex;flex-direction:column;gap:8px}
.seat{display:flex;align-items:center;gap:10px;background:var(--room2);border:1px solid var(--line);border-radius:14px;padding:8px 8px 8px 12px;min-height:58px}
.seat .badge{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;flex:none;font:800 15px var(--f-display);background:var(--panel);color:var(--accent)}
.seat .badge svg{width:20px;height:20px}
.seat .nm{flex:1;min-width:0;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.seat .nm small{display:block;font-weight:500;color:var(--muted);font-size:13px}
.seat .input{padding:9px 12px;font-size:16px;flex:1}
.pill{border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:8px 12px;font-weight:600;font-size:14px;color:var(--text);min-height:40px}
.xbtn{width:40px;height:40px;border-radius:10px;border:0;background:none;color:var(--muted);display:grid;place-items:center;flex:none}
.xbtn svg{width:18px;height:18px}
.addrow{display:flex;gap:8px}
.addrow .btn{flex:1}
.row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:4px 0}
.row .d{font-size:14px;color:var(--muted)}
.toggle{width:52px;height:30px;border-radius:15px;border:0;background:var(--line);position:relative;flex:none}
.toggle::after{content:"";position:absolute;top:4px;left:4px;width:22px;height:22px;border-radius:50%;background:#fff;transition:transform .15s}
.toggle[aria-pressed="true"]{background:var(--good)}
.toggle[aria-pressed="true"]::after{transform:translateX(22px)}
.sticky{position:sticky;bottom:0;padding:10px 0 calc(env(safe-area-inset-bottom,0px) + 4px);background:linear-gradient(transparent,var(--room) 30%)}
.sticky .btn{width:100%}
.status{display:flex;align-items:center;gap:12px;background:var(--room2);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.status div{flex:1;display:flex;flex-direction:column}
.pulse{width:14px;height:14px;border-radius:50%;background:var(--accent);animation:pl 1.2s ease-in-out infinite;flex:none}
.pulse.off{background:var(--muted);animation:none}
@keyframes pl{0%,100%{transform:scale(.7);opacity:.5}50%{transform:scale(1.1);opacity:1}}
.tip{background:var(--room2);border-left:3px solid var(--accent);border-radius:6px 12px 12px 6px;padding:12px 14px;font-size:15px}
.list{display:flex;flex-direction:column;gap:8px}

/* spel */
.game{height:100%;max-width:620px;margin:0 auto;display:flex;flex-direction:column;gap:8px;
  padding:calc(env(safe-area-inset-top,0px) + 8px) max(10px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 10px) max(10px,env(safe-area-inset-left,0px))}
.bar{display:flex;align-items:center;gap:8px}
.bar .info{flex:1;text-align:center;font-size:14px;color:var(--muted);line-height:1.2}
.bar .info b{color:var(--text)}
.clock{font:800 18px var(--f-display);font-variant-numeric:tabular-nums;min-width:56px;text-align:right}
.clock.low{color:var(--warn)}
.players{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:6px}
.pl{display:flex;flex-direction:column;gap:1px;background:var(--room2);border:1.5px solid var(--line);border-radius:12px;padding:5px 8px;min-width:0;line-height:1.15}
.pl.turn{border-color:var(--accent);background:var(--panel)}
.pl .nm{font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pl .ct{font-size:12px;color:var(--muted);display:flex;gap:6px;align-items:center;white-space:nowrap}
.pl .ct b{font:800 16px var(--f-display);color:var(--text);font-variant-numeric:tabular-nums}
.pl .ok{color:var(--good);font-weight:800}
.pl .away{color:var(--warn)}
.felt{flex:1;min-height:120px;overflow:auto;background:radial-gradient(120% 90% at 50% 0%,var(--felt2),var(--felt));border-radius:16px;padding:10px 8px;box-shadow:inset 0 2px 14px #0007;-webkit-overflow-scrolling:touch}
.sets{display:flex;flex-wrap:wrap;gap:10px 12px;align-content:flex-start}
.set{display:flex;gap:2px;padding:3px;border-radius:9px;background:#00000024;border:1.5px solid transparent;align-items:center}
.set.bad{border-color:var(--warn);background:#ff8a6b22}
.set.lock{opacity:.78}
.set.hot{border-color:var(--accent);background:#ffc83d26}
.set .plus{width:calc(var(--tw)*.9);height:calc(var(--tw)*1.36);border-radius:7px;border:1.5px dashed var(--accent);background:#ffc83d1c;color:var(--accent);font:800 20px/1 var(--f-display);display:grid;place-items:center;padding:0}
.set .flip{width:22px;height:calc(var(--tw)*1.36);border:0;background:none;color:var(--muted);padding:0;display:grid;place-items:center}
.set .flip svg{width:16px;height:16px}
.newset{min-width:110px;height:calc(var(--tw)*1.36 + 6px);border-radius:9px;border:1.5px dashed #ffffff55;background:none;color:#ffffffa0;font-size:14px;font-weight:600;padding:0 12px}
.newset.on{border-color:var(--accent);color:var(--accent);background:#ffc83d1c}
.newset.hot{background:#ffc83d40}
.empty{color:#ffffff80;font-size:15px;text-align:center;padding:30px 10px}
.msg{text-align:center;font-size:15px;font-weight:600;min-height:22px}
.msg.bad{color:var(--warn)}
.msg.wait{color:var(--muted);font-weight:500}
.acts{display:flex;gap:6px;min-height:40px;align-items:center}
.acts .btn{flex:1;min-height:40px;padding:6px 6px;font-size:14px}
.acts .hint{flex:1;text-align:center;color:var(--muted);font-size:14px}
.rackhead{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)}
.rackhead .who{flex:1;font-weight:700;color:var(--text);font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rackhead .seg{padding:2px}
.rackhead .seg button{min-height:32px;padding:4px 10px;font-size:13px}
.rack{display:flex;flex-wrap:wrap;gap:6px 5px;padding:8px;background:linear-gradient(#3a2a1c,#2c1f14);border-radius:14px;box-shadow:inset 0 -4px 0 #1c130b,0 6px 16px #0006;max-height:calc(var(--rw)*1.36*3 + 40px);overflow:auto;min-height:calc(var(--rw)*1.36 + 16px);align-content:flex-start}
.rack .t{--w:var(--rw)}
.rack.hot{outline:2px solid var(--accent)}
.hidden-rack{display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:15px;text-align:center;padding:10px}
.main{display:grid;grid-template-columns:1fr 1.4fr;gap:8px}
.main .btn{min-height:50px}
.netlost{background:#4a1f1a;color:#fff;border-radius:12px;padding:8px 12px;display:flex;align-items:center;gap:10px;font-size:14px}
.netlost span{flex:1}
.netlost button{border:0;background:#fff;color:#2a1a10;border-radius:10px;padding:8px 12px;font-weight:700}
#ghost{position:fixed;left:0;top:0;pointer-events:none;z-index:60;display:flex;gap:2px}
#ghost .t{--w:40px;box-shadow:inset 0 -4px 0 var(--edge),0 12px 24px #0009}

/* doorgeven */
.cover{position:fixed;inset:0;z-index:15;background:var(--room);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;padding:24px}
.cover h2{font-size:34px}
.cover .lastmv{background:var(--room2);border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:15px;color:var(--muted);max-width:340px;display:flex;flex-direction:column;gap:4px}
.cover .btn{min-width:260px}

/* vellen */
.scrim{position:fixed;inset:0;background:#05080cb8;z-index:20;display:flex;align-items:flex-end;justify-content:center;padding:16px max(12px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 12px) max(12px,env(safe-area-inset-left,0px))}
.sheet{width:100%;max-width:520px;max-height:100%;overflow:auto;background:var(--room2);border:1px solid var(--line);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:14px;color:var(--text)}
.sheet h2{font-size:26px}
.sheet-head{display:flex;justify-content:space-between;align-items:center;gap:10px}
.rules{display:flex;flex-direction:column;gap:12px;font-size:15px}
.rules h3{font-size:17px;margin-bottom:-6px}
.rules ul{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px}
.ex{display:flex;gap:2px;--tw:24px;flex-wrap:wrap;align-items:center}
.ex .gap{width:10px}
.draws{display:flex;flex-direction:column;gap:8px}
.drow{display:flex;align-items:center;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:6px 10px;--tw:30px}
.drow b{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.drow.win{border-color:var(--accent)}
.rank{display:flex;flex-direction:column;gap:8px}
.rk{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:9px 12px}
.rk.win{border-color:var(--accent)}
.rk .n{font-weight:700;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rk .n small{display:block;font-weight:500;color:var(--muted);font-size:12px}
.rk .d{font:800 18px var(--f-display);font-variant-numeric:tabular-nums}
.rk .d.pos{color:var(--good)} .rk .d.neg{color:var(--warn)}
.rk .s{font:800 22px var(--f-display);font-variant-numeric:tabular-nums;min-width:44px;text-align:right}
.result{text-align:center;display:flex;flex-direction:column;gap:6px;align-items:center}
.result h2{font-size:32px;line-height:1.05}
.leftover{display:flex;flex-wrap:wrap;gap:2px;--tw:20px;margin-top:4px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="app"></div>
<div id="ghost" hidden></div>
<script src="../w2.js"></script>
<script src="engine.js"></script>
<script>
(function () {
const app = document.getElementById('app'), ghost = document.getElementById('ghost');
const NET = window.W2 && W2.net, GAME = 'tegelrummy', MAXP = 4;
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const uid = () => Date.now().toString(36) + TR.rnd(1e9).toString(36);
const clone = x => JSON.parse(JSON.stringify(x));
const store = {
  get(k, d) { try { const v = JSON.parse(localStorage.getItem(k) || 'null'); return v == null ? d : v; } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} },
  del(k) { try { localStorage.removeItem(k); } catch (e) {} }
};
const LEVELS = { easy: 'Makkelijk', normal: 'Normaal', strong: 'Sterk' };
const CNAME = ['zwart', 'rood', 'blauw', 'oranje'], SHAPE = ['●', '▲', '■', '◆'];
const myName = () => { try { return localStorage.getItem('w2-name') || ''; } catch (e) { return ''; } };
const setName = n => { try { localStorage.setItem('w2-name', n); } catch (e) {} };
const TOK = store.get('tr-tok', null) || (() => { const t = uid(); store.set('tr-tok', t); return t; })();

/* ---------------- instellingen ---------------- */
const S = Object.assign({ sound: true, vibrate: true, shapes: false, sort: 'col', time: 0, games: 'one',
  seats: [{ type: 'human', name: '' }, { type: 'cpu', level: 'normal' }], bots: [{ level: 'normal' }], netTime: 0, netGames: 'one' }, store.get('tr-settings', {}));
const saveS = () => store.set('tr-settings', S);

/* ---------------- toestand ---------------- */
let view = 'home';            // home | setup | host | join | game
let role = null;              // null (op één telefoon) | host | join
let G = null, W = null, L = null;
const ui = { sheet: null, cover: false, thinking: false, token: 0, ts: null, order: {}, fresh: {}, seenStart: '', msg: '', live: null, waiting: false, lostHost: false, setupKind: 'cpu', lastSeen: {} };
const net = { status: 'idle', found: new Map(), hostName: '', peers: new Map(), err: '', lobby: null, busy: false };
const multiOK = () => !!(NET && NET.multiAvailable && NET.multiAvailable());
const send = m => { if (NET && role) { m.game = GAME; NET.send(m); } };
const sendTo = (id, m) => { if (NET) { m.game = GAME; NET.sendTo(id, m); } };
const GKEY = m => 'tr-game-' + m;
const loadGame = m => { const g = store.get(GKEY(m), null); return g && g.gid ? g : null; };
const saveGame = g => { if (g.mode === 'local' || role === 'host') store.set(GKEY(g.mode), g); };
const inProgress = g => !!(g && !(g.over && g.match.done));

/* ---------------- geluid en trillen ---------------- */
let ac = null;
function tone(f, d, type, vol, delay) {
  if (!S.sound) return;
  try {
    ac = ac || new (window.AudioContext || window.webkitAudioContext)();
    if (ac.state === 'suspended') ac.resume();
    const t = ac.currentTime + (delay || 0), o = ac.createOscillator(), g = ac.createGain();
    o.type = type || 'sine'; o.frequency.value = f;
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol || 0.12, t + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + d);
    o.connect(g); g.connect(ac.destination); o.start(t); o.stop(t + d + 0.02);
  } catch (e) {}
}
const sClick = () => tone(1400, 0.03, 'triangle', 0.05);
const sPut = () => { tone(520, 0.05, 'triangle', 0.1); tone(780, 0.06, 'triangle', 0.08, 0.04); };
const sPlay = () => { tone(392, 0.1, 'triangle', 0.14); tone(587, 0.16, 'triangle', 0.14, 0.08); };
const sDraw = () => tone(300, 0.12, 'sine', 0.12);
const sErr = () => { tone(180, 0.14, 'square', 0.05); tone(140, 0.18, 'square', 0.05, 0.1); };
const sWin = () => [523, 659, 784, 1047].forEach((f, k) => tone(f, 0.18, 'triangle', 0.13, k * 0.09));
function buzz(p) { if (S.vibrate && navigator.vibrate) try { navigator.vibrate(p); } catch (e) {} }

/* ================================================================ spel maken */
function deal(g) {
  const pool = TR.newPool();
  g.players.forEach(p => { p.rack = pool.splice(0, TR.RACK); p.melded = false; });
  g.pool = pool; g.table = []; g.log = []; g.moves = 0; g.last = []; g.idle = 0; g.over = null;
  g.start = TR.drawForStart(g.players.length);
  g.turn = g.start.first; g.turnAt = Date.now();
}
function newGame(mode, players, cfg) {
  const g = { v: 1, gid: uid(), mode, seq: 0, cfg: { time: cfg.time, games: cfg.games },
    players: players.map(p => ({ name: p.name, type: p.type, level: p.level || null, tok: p.tok || null, ep: p.ep || null, away: false, rack: [], melded: false })) };
  const of = cfg.games === 'round' ? players.length : 1;
