      ${n < MAXP ? `<div class="addrow"><button class="btn quiet" data-a="seatadd" data-v="human">+ Speler</button><button class="btn quiet" data-a="seatadd" data-v="cpu">+ Computer</button></div>` : ''}
      ${humans > 1 ? '<p class="note">Na elke beurt verschijnt een scherm om de telefoon door te geven, zodat niemand andermans stenen ziet.</p>' : ''}
    </div>
    ${cfgHTML(S.time, S.games, n, 'l')}
    <div class="sticky"><button class="btn" data-a="startlocal">Start met ${n} spelers</button></div>
