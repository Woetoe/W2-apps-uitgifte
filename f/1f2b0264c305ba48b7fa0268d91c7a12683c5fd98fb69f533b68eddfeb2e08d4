const JOKER = '<svg class="jk" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 3c1.6 9 3.5 11.2 17 17-13.5 5.8-15.4 8-17 17-1.6-9-3.5-11.2-17-17C16.5 14.2 18.4 12 20 3z" fill="none"/>'
