function tileHTML(id, cls, extra) {
  if (TR.isJ(id)) return `<span class="t jkr ${cls || ''}" data-t="${id}" ${extra || ''} aria-label="joker">${JOKER}</span>`;
  const c = TR.col(id), n = TR.num(id);
  return `<span class="t c${c} ${cls || ''}" data-t="${id}" ${extra || ''} aria-label="${CNAME[c]} ${n}">${n}<i>${SHAPE[c]}</i></span>`;
}
const T = (c, n, k) => c * 26 + (k || 0) * 13 + n - 1;

