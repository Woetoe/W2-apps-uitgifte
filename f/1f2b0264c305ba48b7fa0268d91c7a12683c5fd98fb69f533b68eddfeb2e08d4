let drag = null;
app.addEventListener('pointerdown', e => {
  const el = e.target.closest('[data-t]');
  if (!el || !W || !canAct() || e.target.closest('.sheet')) return;
  const id = +el.dataset.t;
  if (!selectable(id)) return;
  if (el.closest('.felt') && !W.sel.includes(id)) return;   // op tafel eerst aantikken, dan slepen (zo blijft scrollen werken)
  drag = { id, x: e.clientX, y: e.clientY, on: false, el, pid: e.pointerId, over: null };
});
app.addEventListener('pointermove', e => {
  if (!drag || e.pointerId !== drag.pid) return;
  if (!drag.on) {
    if (Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 9) return;
    drag.on = true;
    drag.ids = W.sel.includes(drag.id) ? W.sel.slice() : [drag.id];
    ghost.innerHTML = drag.ids.slice(0, 6).map(t => tileHTML(t)).join('');
    ghost.hidden = false;
    drag.ids.forEach(t => { const x = app.querySelector(`[data-t="${t}"]`); if (x) x.classList.add('drag'); });
    try { drag.el.setPointerCapture(e.pointerId); } catch (err) {}
  }
  e.preventDefault();
  ghost.style.transform = `translate(${e.clientX - 20}px,${e.clientY - 60}px)`;
  const t = document.elementFromPoint(e.clientX, e.clientY);
  const over = t && (t.closest('[data-set]') || t.closest('[data-drop]'));
  if (over !== drag.over) {
    if (drag.over) drag.over.classList.remove('hot');
    drag.over = over; if (over) over.classList.add('hot');
  }
});
function endDrag(e, cancel) {
  if (!drag || (e && e.pointerId !== drag.pid)) return;
  const d = drag; drag = null;
  if (!d.on) return;
  dragged = true; setTimeout(() => { dragged = false; }, 50);
  ghost.hidden = true;
  if (d.over) d.over.classList.remove('hot');
  if (cancel || !d.over || !W) { render(); return; }
  const o = d.over;
  if (o.dataset.set !== undefined) {
    const s = W.table[+o.dataset.set];
    // één steen op een joker die hij kan vervangen: ruilen
    const tgt = e && document.elementFromPoint(e.clientX, e.clientY);
    const jt = tgt && tgt.closest('[data-t]');
    if (d.ids.length === 1 && jt && TR.isJ(+jt.dataset.t) && W.base.melded && swapJoker(d.ids[0], +jt.dataset.t)) { render(); return; }
    if (s && !lockedSet(s) && !d.ids.every(t => s.includes(t))) putInto(d.ids, s);
  } else if (o.dataset.drop === 'new') newSet(d.ids);
  else if (o.dataset.drop === 'rack') { if (d.ids.every(ownNew)) backToRack(d.ids); }
  render();
}
