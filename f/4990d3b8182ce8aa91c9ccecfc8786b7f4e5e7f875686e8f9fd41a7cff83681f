/** Foto maken of kiezen → {klein (om te bewaren), groot (om te lezen)}. */
function pickFoto(camera) {
  return new Promise(res => {
    const inp = $('#file');
    inp.value = '';
    if (camera) inp.setAttribute('capture', 'environment'); else inp.removeAttribute('capture');
    inp.onchange = async () => {
      const f = inp.files[0];
      if (!f) return res(null);
      try { res({ klein: await verklein(f, 1000, .8), groot: await verklein(f, 1800, .9) }); }
      catch (e) { toast('Deze foto kon niet gelezen worden.'); res(null); }
    };
    inp.click();
  });
}
async function verklein(blob, max, q) {
  const bmp = await createImageBitmap(blob, { imageOrientation: 'from-image' }).catch(() => createImageBitmap(blob));
  const sc = Math.min(1, max / Math.max(bmp.width, bmp.height));
  const c = document.createElement('canvas');
  c.width = Math.round(bmp.width * sc); c.height = Math.round(bmp.height * sc);
  const g = c.getContext('2d');
  g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height);
  g.drawImage(bmp, 0, 0, c.width, c.height);
  return c.toDataURL('image/jpeg', q);
}

// ---------------------------------------------------------------- alle waardes bijwerken (alleen als je erop tikt)
async function prijzen() {
  if (bezigMet) return;
  const c = col();
  const todo = items.filter(i => i.col === c.id && i.ref).sort((a, b) => (a.waardeDatum || '').localeCompare(b.waardeDatum || ''));
  if (!todo.length) return;
  bezigMet = true;
  const voor = items.filter(i => i.col === c.id && !i.wens).reduce((s, i) => s + (num(i.waarde) || 0) * (i.aantal || 1), 0);
  const traag = todo.filter(i => i.ref.bron === 'discogs').length;
  const s = sheet('Waardes bijwerken', `<div class="prog"><i id="pb"></i></div><p id="pt" style="margin:10px 0 0">0 van ${todo.length}</p>
    ${traag > 10 ? `<p class="hint">Discogs wil maar een paar vragen per minuut, dus dit duurt ongeveer ${Math.ceil(traag * 2.6 / 60)} minuten. Laat de app openstaan.</p>` : ''}`, [{ label: 'Stoppen', value: 'stop', kind: 'q' }]);
  let stop = false, ok = 0, geen = 0, fout = 0, laatsteFout = '';
  s.done.then(() => { stop = true; });
  for (const [n, i] of todo.entries()) {
    if (stop) break;
    try { (await haalWaarde(i, true)) ? ok++ : geen++; }
    catch (e) { fout++; laatsteFout = e.message; if (/internet|te veel/i.test(e.message)) break; }
    const pb = $('#pb', s.el), pt = $('#pt', s.el);
    if (pb) pb.style.width = Math.round((n + 1) / todo.length * 100) + '%';
    if (pt) pt.textContent = `${n + 1} van ${todo.length} · ${i.naam}`;
  }
  s.close('klaar');
  bezigMet = false;
  if (ok) { cfg.laatst[c.id] = today(); saveCfg(); }
  await load();
  const na = items.filter(i => i.col === c.id && !i.wens).reduce((s, i) => s + (num(i.waarde) || 0) * (i.aantal || 1), 0);
  const d = na - voor;
  toast([ok ? `${ok} bijgewerkt` : '', geen ? `${geen} zonder prijs` : '', fout ? `${fout} lukte niet${laatsteFout ? ' (' + laatsteFout + ')' : ''}` : '',
    ok && Math.abs(d) >= 0.01 ? `totaal ${d > 0 ? '+' : '−'}${eur(Math.abs(d))}` : ''].filter(Boolean).join(' · ') || 'Niets bijgewerkt', 5000);
}

// ---------------------------------------------------------------- verzamelingen
async function colForm(c) {
  const isNew = !c;
  c = c || { naam: '', soort: 'anders', taal: 'en' };
  const r = sheet(isNew ? 'Nieuwe verzameling' : c.naam, `<label class="f">Naam<input class="in" name="naam" value="${esc(c.naam)}" placeholder="Bv. Lego, munten, strips"></label>
    <label class="f">Soort<select class="in" name="soort">${Object.entries(SOORTEN).map(([k, s]) => `<option value="${k}" ${k === c.soort ? 'selected' : ''}>${s.emoji} ${s.naam}</option>`).join('')}</select></label>
    <label class="f" id="tl" ${c.soort === 'kaarten' ? '' : 'hidden'}>Taal van de kaarten (om op te zoeken)<select class="in" name="taal">${Object.entries(TALEN).map(([k, n]) => `<option value="${k}" ${k === (c.taal || 'en') ? 'selected' : ''}>${n}</option>`).join('')}</select></label>
    <p class="hint">Kaarten zoekt de app op bij TCGdex (prijzen van Cardmarket), platen bij MusicBrainz (prijzen van Discogs). Dat gebeurt alleen als je toevoegt of op Waardes bijwerken tikt.</p>`,
  (isNew || cfg.cols.length < 2 ? [{ label: 'Annuleren', value: null, kind: 'q' }] : [{ label: icon('trash'), value: 'del', kind: 'danger' }]).concat([{ label: 'Bewaren', value: 'ok', check: f => !f.naam.trim() ? 'Vul een naam in.' : '' }]), { focus: isNew });
  r.el.addEventListener('change', e => { if (e.target.name === 'soort') $('#tl', r.el).hidden = e.target.value !== 'kaarten'; });
  const res = await r.done;
  if (res.value === 'del') {
    const n = items.filter(i => i.col === c.id).length;
    if (!(await confirm(`<b>${esc(c.naam)}</b>${n ? ` en de ${n} dingen erin` : ''} verwijderen? Ook bij je partner.`, 'Verwijderen', true))) return;
    for (const i of items.filter(i => i.col === c.id)) await weg(i);
    cfg.cols = cfg.cols.filter(x => x !== c); cfg.col = cfg.cols[0].id; saveCfg(); deel && deel.push(); return load();
  }
  if (res.value !== 'ok') return;
  c.naam = res.form.naam.trim(); c.soort = res.form.soort; c.taal = c.soort === 'kaarten' ? res.form.taal : '';
  if (isNew) { c.id = D.uid(); cfg.cols.push(c); cfg.col = c.id; }
  saveCfg(); deel && deel.push(); render();
}

function setView(v) { view = v; $$('#seg button').forEach(b => b.classList.toggle('on', b.dataset.v === v)); render(); }
$('#seg').onclick = e => { const b = e.target.closest('[data-v]'); if (b) setView(b.dataset.v); };
$('#cols').onclick = e => { const b = e.target.closest('[data-c]'); if (!b) return; if (b.dataset.c === '+') return colForm(); cfg.col = b.dataset.c; zoek = ''; saveCfg(); render(); };
app.addEventListener('click', e => {
  const t = e.target.closest('[data-i],[data-act]'); if (!t) return;
  if (t.dataset.i) return show(items.find(i => i.id === t.dataset.i));
  if (t.dataset.act === 'new') return nieuw();
  if (t.dataset.act === 'prijzen') return prijzen();
});
app.addEventListener('input', e => { if (e.target.id === 'q') { zoek = e.target.value; clearTimeout(render.t); render.t = setTimeout(() => { render(); const q = $('#q'); if (q) { q.focus(); q.setSelectionRange(q.value.length, q.value.length); } }, 250); } });
app.addEventListener('change', e => { if (e.target.id === 'sort') { cfg.sort = e.target.value; saveCfg(); render(); } });
$('#fab').onclick = () => nieuw();
$('#menu').onclick = () => colForm(col());

// ---------------------------------------------------------------- delen met je partner (Samen)
function koppelDeel() {
  if (deel || !window.W2Deel) return;
  deel = W2Deel.koppel({
    kind: 'verzameling',
    // verzamelingen als "c:<id>", dingen als "i:<id>"
    lees: async () => {
      const m = {};
      cfg.cols.forEach((c, n) => { m['c:' + c.id] = { naam: c.naam, soort: c.soort, taal: c.taal || '', n }; });
      ((await db.all()) || []).forEach(i => { m['i:' + i.id] = i; });
      return m;
    },
    schrijf: async (map, changed) => {
      for (const k of changed) {
        if (!k.startsWith('i:')) continue;
        const id = k.slice(2), oud = items.find(x => x.id === id), nw = map[k];
        if (nw) await db.put(id, nw); else await db.del(id);
        if (oud && oud.foto && (!nw || fkey(nw) !== fkey(oud))) await fotos.del(fkey(oud));
      }
      if (changed.some(k => k.startsWith('c:'))) {
        const cols = Object.entries(map).filter(([k, v]) => k.startsWith('c:') && v).map(([k, v]) => ({ id: k.slice(2), naam: v.naam, soort: v.soort, taal: v.taal || '', n: v.n || 0 }))
          .sort((a, b) => a.n - b.n).map(({ n, ...c }) => c);
        cfg.cols = cols.length ? cols : START.map(c => ({ ...c }));
        if (!cfg.cols.some(c => c.id === cfg.col)) cfg.col = cfg.cols[0].id;
        saveCfg();
      }
      await load();
    },
    bestanden: i => i && i.id && i.foto ? [{ id: 'vz-' + fkey(i), naam: i.naam, mime: 'image/jpeg', get: async () => (await fotos.get(fkey(i))) || '', put: v => fotos.put(fkey(i), v) }] : [],
    bestandBinnen: () => hydrate()
  });
  W2Deel.badge();
}

saveCfg();
load().then(koppelDeel);
// Streepjescode-lezer alvast laten klaarzetten (Play-services haalt die de eerste keer op), hooguit eens per dag
if (W2.herken.available() && cfg.cols.some(c => c.soort === 'platen') && D.get('vz-code-klaar', '') !== today()) {
  const c = document.createElement('canvas'); c.width = c.height = 32;
  const g = c.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, 32, 32);
  W2.herken.foto(c.toDataURL('image/jpeg'), 'code').then(r => { if (r && !/download/i.test(r.codeFout || '')) D.set('vz-code-klaar', today()); });
}
