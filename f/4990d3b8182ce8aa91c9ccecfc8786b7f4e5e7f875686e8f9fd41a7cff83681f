async function maakPlaat(p, ctx) {
  const c = ctx.bestaand ? colOf(ctx.bestaand) : col();
  const w = bezig('Prijs zoeken op Discogs…');
  let dc = ctx.discogs || null, pr = null, foto = ctx.foto;
  try {
    if (!dc && p) dc = await Zoek.discogsBij(W2.get, p);
    if (w.stop) return;
    if (dc) pr = await Zoek.plaatPrijs(W2.get, dc).catch(() => null);
    if (w.stop) return;
    // voorkant van de hoes: mooier dan een foto van de streepjescode
    if (!ctx.bestaand && p && (ctx.via === 'code' || !foto)) { w.tekst('Hoes ophalen…'); foto = (await haalFoto('https://coverartarchive.org/release/' + p.mbid + '/front-500')) || foto; }
  } catch (e) { toast(e.message, 4000); }
  if (!w.stop) w.close(); else return;
  const ref = dc ? { bron: 'discogs', type: dc.type, id: dc.id } : null;
  if (ctx.bestaand) {
    const i = ctx.bestaand;
    if (!ref) { toast('Deze plaat staat (nog) niet aan Discogs gekoppeld in MusicBrainz. Plak de Discogs-link via Opzoeken.', 5000); return; }
    i.ref = ref; if (p) i.mb = p.mbid;
    if (pr) zetWaarde(i, pr);
    await bewaar(i); await load();
    toast(pr ? 'Gekoppeld. Waarde: ' + eur(pr.waarde) : 'Gekoppeld; er staat nu niets te koop, dus nog geen prijs.', 4000);
    return show(i);
  }
  if (!ref && p) toast('Geen Discogs-koppeling gevonden; de waarde kun je later koppelen of zelf invullen.', 4500);
  const item = p ? { naam: p.titel, col: c.id, v: { artiest: p.artiest, jaar: p.jaar, label: [p.label, p.catno, p.land].filter(Boolean).join(' · '), formaat: p.formaat }, ref, mb: p.mbid } : { naam: '', col: c.id, v: {}, ref };
  if (pr) zetWaarde(item, pr);
  return form(null, { item, foto });
}

async function haalFoto(url) {
  try {
    const r = await W2.get(url, true);
    if (!r || r.status !== 200 || !r.b64) return '';
    const bin = atob(r.b64), u8 = new Uint8Array(bin.length);
    for (let k = 0; k < bin.length; k++) u8[k] = bin.charCodeAt(k);
    return await verklein(new Blob([u8], { type: r.type || 'image/jpeg' }), 1000, .82);
  } catch (e) { return ''; }
}

