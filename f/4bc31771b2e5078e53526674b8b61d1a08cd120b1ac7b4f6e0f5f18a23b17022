  /** Volledig profiel van een bekend bier (stijl + afwijkingen). */
  const STIJL = Object.fromEntries(STIJLEN.map(s => [s.id, s]));
  function profielVan(b) {
    const st = STIJL[b.stijl];
    const p = JSON.parse(JSON.stringify(st ? st.p : prof([5, 3, 1, 0, 0, 0, 0, 2, 3])));
    Object.assign(p, b.p || {});
    if (b.a) p.aroma = Object.assign({}, p.aroma, b.a);
    return p;
  }

  const api = { STIJLEN, STIJL, BIEREN, GERECHTEN, profielVan, prof };
  if (typeof module === 'object' && module.exports) module.exports = api;
  else root.BierData = api;
