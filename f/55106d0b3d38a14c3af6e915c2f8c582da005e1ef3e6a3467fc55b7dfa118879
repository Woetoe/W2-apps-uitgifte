    return 'Claude gaf een fout' + (status ? ' (' + status + ')' : '') + (msg ? ': ' + msg : '') + '.';
  }

  const api = { PLEKKEN, PLEK, CATS, CAT_EMOJI, CAT_NAAM, MODELLEN, plekVoor, N, woorden, past, zoek, status, leesDatum, dagenTot, plusDagen, erbij, schoon, tel, afboekVoorstel, teAfboeken, bijnaOp, herinneringen, voorWeekmenu, TOOL, verzoek, antwoord, foutTekst, RESTJE };

  if (typeof module === 'object' && module.exports) { module.exports = api; return; }

  // ================================================================ in de app / browser
  const D = root.W2D;
  const KEY = 'voorraad', AI = 'voorraad-ai';
  const lees = () => Object.assign({ items: [], inst: {} }, D.get(KEY, null) || {});
  let data = lees(), deel = null;
  const luisteraars = new Set();
  const meldt = () => luisteraars.forEach(f => { try { f(data); } catch (e) { console.error(e); } });
  const vandaag = () => D.date.today();
  const door = () => (root.Samen && Samen.cfg && Samen.cfg.me ? Samen.cfg.me.id : '');

  function bewaar(items, inst) {
    if (items) data.items = items;
    if (inst) data.inst = inst;
    D.set(KEY, data);
    if (deel) deel.push();
    publiceer();
    meldt();
  }
  function publiceer() {
    if (!root.W2 || !W2.publish) return;
    const h = herinneringen(data.items, vandaag()), sig = JSON.stringify(h);
    if (sig !== publiceer.laatst) { publiceer.laatst = sig; W2.publish('herinneringen-voorraad', h); }
  }

  /** Delen via Samen aanzetten (één keer per pagina). onChange(data) bij elke verandering, ook van de ander. */
  function koppel(onChange) {
    if (onChange) luisteraars.add(onChange);
    if (deel || !root.W2Deel) return;
    deel = W2Deel.koppel({
      kind: 'voorraad',
      lees: async () => Object.fromEntries([...data.items.map(it => ['i:' + it.id, it]), ['inst', Object.assign({ id: 'inst' }, data.inst)]]),
      schrijf: async map => {
        const items = Object.entries(map).filter(([k]) => k.startsWith('i:')).map(([, v]) => kopie(v));
        const inst = map.inst ? kopie(map.inst) : {}; delete inst.id;
        data.items = items; data.inst = inst;
        D.set(KEY, data);
        publiceer();
        meldt();
      }
    });
  }

  /** Bieren uit de oude voorraad van Bierkeuze (van voor november 2026) erin zetten, met hetzelfde id:
      zo komt niets dubbel als beide telefoons dit doen. Geeft true als er oude voorraad was. */
  function verhuisBier(oud) {
    if (!oud || !oud.length) return false;
    const al = new Set(data.items.map(it => it.id));
    const nieuw = oud.filter(k => k && k.id && !al.has(k.id) && (k.aantal || 0) > 0).map(k => ({
      id: k.id, naam: k.naam, cat: 'bier', plek: 'kast', aantal: k.aantal,
      bier: Object.assign({ stijl: k.stijl || '', profiel: k.profiel || null }, k.bierId ? { bierId: k.bierId } : {}), t: Date.now()
    }));
    if (nieuw.length) bewaar(data.items.concat(nieuw));
    return true;
  }
  (function () {   // meteen bij het laden, op welke pagina ook
    const b = D.get('bier', null);
    if (b && b.kast && b.kast.length && verhuisBier(b.kast)) { b.kast = []; D.set('bier', b); }
  })();

  const ai = {
    get() { return Object.assign({ key: '', model: MODELLEN[0].id }, D.get(AI, null) || {}); },
    set(v) { D.set(AI, Object.assign(ai.get(), v)); },
    klaar: () => !!ai.get().key,
    /** Foto (data-URL, jpeg) laten lezen. Geeft {soort, winkel, producten, …}; gooit een Error met uitleg. */
    async herken(dataUrl, soort) {
      const cfg = ai.get();
      if (!cfg.key) throw new Error('Nog geen API-sleutel. Vul hem in bij het tandwiel.');
      const b64 = String(dataUrl).replace(/^data:[^,]*,/, '');
      const body = verzoek(b64, { soort, vandaag: vandaag(), model: cfg.model });
      const ctl = new AbortController(), timer = setTimeout(() => ctl.abort(), 120000);
      let r;
      try {
        r = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST', signal: ctl.signal,
          headers: { 'content-type': 'application/json', 'x-api-key': cfg.key, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-access': 'true' },
          body: JSON.stringify(body)
        });
      } catch (e) {
        clearTimeout(timer);
        throw new Error(e && e.name === 'AbortError' ? 'Claude deed er te lang over. Probeer het opnieuw.' : navigator.onLine === false ? 'Geen internet. Probeer het straks opnieuw.' : 'Kon Claude niet bereiken. Heb je internet?');
      }
      const txt = await r.text().catch(() => '');
      clearTimeout(timer);
      return antwoord(r.status, txt, vandaag());
    }
  };

  // Let op: getters met defineProperties, niet in Object.assign (dat zou ze één keer uitlezen en vastzetten).
  const VO = Object.defineProperties({}, {
    data: { get: () => data, enumerable: true },
    items: { get: () => data.items, enumerable: true },
    inst: { get: () => data.inst, enumerable: true }
  });
  root.Voorraad = Object.assign(VO, api, {
    vandaag, door, bewaar, koppel, publiceer, ai, verhuisBier,
    /** Nieuwe producten erbij en bewaren. */
    voegToe(nieuwe) { const r = erbij(data.items, nieuwe, { vandaag: vandaag(), uid: D.uid, door: door() }); bewaar(r.items); return r; },
    /** −1/+1 en bewaren. Geeft {item, op}. */
    tel(id, d) { const r = tel(data.items, id, d); if (r.item) bewaar(r.items); return r; },
    /** Eén item vervangen (bewerken) of weghalen (null). */
    zet(id, item) {
      const items = data.items.filter(x => x.id !== id);
      if (item) items.push(Object.assign(kopie(item), { id, t: Date.now(), door: door() }));
      bewaar(items);
    },
    zoek: (tekst, opts) => zoek(data.items, tekst, opts),
    /** Opnieuw van de opslag lezen (een andere pagina kan de kast veranderd hebben). */
    herlaad() { data = lees(); return data; }
  });
})(typeof window !== 'undefined' ? window : this);
