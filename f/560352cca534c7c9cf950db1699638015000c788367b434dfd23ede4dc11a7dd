/* W2 Apps — gedeelde opmaak voor de tools (Reizen, Kluis, Aftellen, Hardlopen, Recepten, Instellingen).
   Elke pagina zet zijn eigen accentkleur in --acc (en --acc-ink voor tekst op die kleur). */
:root{--bg:#14161f;--panel:#1d202c;--panel2:#252939;--line:#30344a;--text:#f2efe8;--muted:#a3a6b9;--danger:#ff6b5b;--ok:#5ee07a;
  --acc:#ffc83d;--acc-ink:#211a02;--f-display:"Bricolage Grotesque",system-ui,sans-serif;--f-body:"Figtree",system-ui,sans-serif;color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font:16px/1.45 var(--f-body);-webkit-tap-highlight-color:transparent}
body{padding-bottom:calc(env(safe-area-inset-bottom,0px) + 96px)}
button,input,select,textarea{font:inherit;color:inherit}
a{color:var(--acc)}
.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:8px;padding:calc(env(safe-area-inset-top,0px) + 10px) 12px 10px;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid transparent}
.top.scrolled{border-bottom-color:var(--line)}
.top h1{flex:1;margin:0;font:800 24px/1.1 var(--f-display);letter-spacing:-.01em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ib{width:44px;height:44px;border-radius:14px;border:0;background:transparent;display:grid;place-items:center;color:var(--text);flex:none;text-decoration:none;cursor:pointer}
.ib:active{background:var(--panel)}
.ib svg{width:24px;height:24px}
.page{max-width:560px;margin:0 auto;padding:6px 16px 0;display:flex;flex-direction:column;gap:14px}
h2{font:800 18px/1.2 var(--f-display);margin:12px 0 -4px;letter-spacing:-.005em}
h2 small{font:500 14px var(--f-body);color:var(--muted);margin-left:6px}
.muted{color:var(--muted)}
.small{font-size:14px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:14px 16px}
.card.acc{border-color:color-mix(in srgb,var(--acc) 55%,var(--line));background:color-mix(in srgb,var(--acc) 9%,var(--panel))}
.list{display:flex;flex-direction:column;gap:10px}
.row{display:flex;align-items:center;gap:12px;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:12px 14px;min-height:60px;text-decoration:none;color:inherit;cursor:pointer;width:100%;text-align:left}
.row:active{transform:scale(.99)}
.row .grow{flex:1;min-width:0}
.row b{display:block;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .sub{display:block;color:var(--muted);font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row .ico{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--panel2);flex:none;font-size:20px}
.row .ico svg{width:22px;height:22px}
.row .end{color:var(--muted);font-size:14px;text-align:right;flex:none}
.pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:3px 10px;font-size:13px;font-weight:700;background:var(--panel2);color:var(--muted)}
.pill.acc{background:color-mix(in srgb,var(--acc) 22%,transparent);color:var(--acc)}
.pill.warn{background:#3a2a10;color:#ffc83d}
.btn{border:0;border-radius:14px;min-height:48px;padding:10px 18px;font-weight:700;background:var(--acc);color:var(--acc-ink);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;text-decoration:none}
.btn.q{background:var(--panel2);color:var(--text);border:1px solid var(--line)}
.btn.danger{background:transparent;color:var(--danger);border:1px solid color-mix(in srgb,var(--danger) 45%,var(--line))}
.btn.wide{width:100%}
.btn:disabled{opacity:.45}
.btn svg{width:20px;height:20px}
.btns{display:flex;gap:10px;flex-wrap:wrap}
.btns .btn{flex:1}
.fab{position:fixed;right:max(18px,env(safe-area-inset-right,0px));bottom:calc(env(safe-area-inset-bottom,0px) + 20px);z-index:6;width:62px;height:62px;border-radius:20px;border:0;background:var(--acc);color:var(--acc-ink);display:grid;place-items:center;box-shadow:0 8px 24px rgba(0,0,0,.45);cursor:pointer}
.fab svg{width:28px;height:28px}
.empty{text-align:center;color:var(--muted);padding:34px 18px;border:1.5px dashed var(--line);border-radius:18px}
.empty b{display:block;color:var(--text);font:800 19px/1.2 var(--f-display);margin-bottom:6px}
.empty .btn{margin-top:14px}
label.f{display:flex;flex-direction:column;gap:6px;font-size:14px;color:var(--muted);font-weight:600}
.in{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px;min-height:48px;color:var(--text);font-size:16px}
.in:focus{outline:2px solid var(--acc);outline-offset:-1px;border-color:transparent}
textarea.in{min-height:96px;resize:vertical;line-height:1.4}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.seg{display:flex;background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:4px;gap:4px}
.seg button{flex:1;border:0;background:transparent;border-radius:10px;min-height:40px;font-weight:700;color:var(--muted);cursor:pointer}
.seg button.on{background:var(--panel2);color:var(--text)}
.check{display:flex;align-items:center;gap:12px;padding:10px 4px;border-bottom:1px solid var(--line);cursor:pointer}
.check:last-child{border-bottom:0}
.check .box{width:26px;height:26px;border-radius:8px;border:2px solid var(--line);display:grid;place-items:center;flex:none}
.check.on .box{background:var(--acc);border-color:var(--acc);color:var(--acc-ink)}
.check.on .t{color:var(--muted);text-decoration:line-through}
.check .t{flex:1}
.check.pick.on .t{color:var(--text);text-decoration:none}
.check.pick:not(.on) .t{color:var(--muted)}
.check .x{border:0;background:transparent;color:var(--muted);width:36px;height:36px;border-radius:10px;cursor:pointer}
.bar{height:8px;border-radius:4px;background:var(--line);overflow:hidden}
.bar i{display:block;height:100%;background:var(--acc);border-radius:4px}
.toggle{display:flex;align-items:center;gap:12px;padding:6px 0}
.toggle .grow{flex:1}
.sw{width:52px;height:32px;border-radius:16px;background:var(--line);position:relative;border:0;flex:none;cursor:pointer;transition:background .15s}
.sw::after{content:"";position:absolute;top:4px;left:4px;width:24px;height:24px;border-radius:12px;background:#fff;transition:transform .15s}
.sw.on{background:var(--acc)}
.sw.on::after{transform:translateX(20px)}
/* onderblad (dialoog) */
.scrim{position:fixed;inset:0;background:rgba(5,6,10,.6);z-index:20;opacity:0;transition:opacity .18s}
.scrim.show{opacity:1}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;max-height:92vh;overflow:auto;background:var(--panel);border-radius:22px 22px 0 0;border-top:1px solid var(--line);padding:10px 16px calc(env(safe-area-inset-bottom,0px) + 16px);transform:translateY(100%);transition:transform .2s ease-out;max-width:620px;margin:0 auto}
.sheet.show{transform:none}
.sheet .grab{width:44px;height:5px;border-radius:3px;background:var(--line);margin:0 auto 10px}
.sheet h3{margin:0 0 12px;font:800 21px/1.2 var(--f-display)}
.sheet .body{display:flex;flex-direction:column;gap:12px}
.sheet .btns{margin-top:16px}
.toast{position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 14px);transform:translateX(-50%) translateY(-20px);opacity:0;z-index:30;background:#f2efe8;color:#14161f;border-radius:14px;padding:12px 16px;font-weight:600;max-width:calc(100vw - 32px);transition:all .2s;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%)}
.toast{box-shadow:0 8px 24px rgba(0,0,0,.4)}
.gate{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;padding:56px 24px}
.gate svg{width:64px;height:64px;color:var(--acc)}
.gate b{font:800 22px/1.2 var(--f-display)}
.notice{background:#2a2610;border:1px solid #6b5a12;color:#f5e6a8;border-radius:14px;padding:12px 14px;font-size:14px}
@media (prefers-reduced-motion:reduce){.sheet,.scrim,.toast,.sw::after{transition:none}.row:active{transform:none}}
