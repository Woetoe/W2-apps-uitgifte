  });
}

// ---------------------------------------------------------------- bier bewerken (profiel)
/** Bier met profiel bewerken. Geeft {naam, stijl, bierId?, profiel, aantal?} of null. */
async function bewerkBier(b, metAantal, titel) {
  let p = b.profiel ? JSON.parse(JSON.stringify(b.profiel)) : (BD.STIJL[b.stijl] ? JSON.parse(JSON.stringify(BD.STIJL[b.stijl].p)) : null);
  const vanStijl = !p;
  if (!p) p = JSON.parse(JSON.stringify(BD.STIJL.blond.p));
  const ar = Object.assign({}, p.aroma || {});
  const dots = n => '●'.repeat(n) + '○'.repeat(3 - n);
  const arHtml = () => S.AROMAS.map(a => `<button type="button" class="chip${ar[a.id] ? ' on' : ''}" data-a="${a.id}" title="${esc(a.vb)}"><span class="ar">${esc(a.naam)}${ar[a.id] ? ` <span class="dots">${dots(ar[a.id])}</span>` : ''}</span></button>`).join('');
  const s = sheet(titel || b.naam || 'Bier', `
    <label class="f">Naam<input class="in" name="naam" value="${esc(b.naam || '')}"></label>
    <label class="f">Stijl<select class="in" name="stijl"><option value="">Kies een stijl…</option>${BD.STIJLEN.map(st => `<option value="${st.id}"${st.id === b.stijl ? ' selected' : ''}>${esc(st.naam)} (${esc(st.kort)})</option>`).join('')}</select></label>
    ${metAantal ? `<label class="f">Aantal in de kast<input class="in" name="aantal" type="number" min="0" max="99" value="${b.aantal != null ? b.aantal : 1}"></label>` : ''}
    <div id="velden">${velden(p)}</div>
    <div class="muted small">Aroma's (biersmaakwiel). Tik vaker voor sterker: ● licht, ●● duidelijk, ●●● sterk.</div>
    <div class="chips" id="aroma">${arHtml()}</div>
    <div class="muted small">${b.bierId || b.stijl ? 'Profiel is een schatting op basis van de stijl; pas aan naar wat je proeft.' : ''}</div>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Opslaan', value: 'ok', check: f => !f.naam.trim() ? 'Geef het bier een naam.' : !f.stijl ? 'Kies een stijl.' : '' }]);
  liveRng(s.el);
  $('select[name=stijl]', s.el).addEventListener('change', e => {
    const st = BD.STIJL[e.target.value]; if (!st) return;
    const np = JSON.parse(JSON.stringify(st.p));
    const abv = parseFloat(String($('input[name=abv]', s.el).value).replace(',', '.'));
    if (!vanStijl && abv) np.abv = abv;
    $('#velden', s.el).innerHTML = velden(np);
    Object.keys(ar).forEach(k => delete ar[k]); Object.assign(ar, np.aroma);
    $('#aroma', s.el).innerHTML = arHtml();
  });
  $('#aroma', s.el).addEventListener('click', e => {
    const c = e.target.closest('[data-a]'); if (!c) return;
    const k = c.dataset.a; ar[k] = ((ar[k] || 0) + 1) % 4; if (!ar[k]) delete ar[k];
    $('#aroma', s.el).innerHTML = arHtml();
  });
  const r = await s.done;
  if (r.value !== 'ok') return null;
  const f = r.form;
  const profiel = S.bierP({ abv: parseFloat(String(f.abv).replace(',', '.')), body: +f.body, koolzuur: +f.koolzuur, zoet: +f.zoet, zuur: +f.zuur, zout: +f.zout, pikant: +f.pikant, vet: +f.vet, bitter: +f.bitter, aroma: ar });
  const out = Object.assign({}, b, { naam: f.naam.trim(), stijl: f.stijl, profiel });
  if (metAantal) out.aantal = Math.max(0, Math.min(99, parseInt(f.aantal, 10) || 0));
  return out;
}
function velden(p) {
  return `<label class="f">Alcohol (%)<input class="in" name="abv" inputmode="decimal" value="${komma(p.abv)}"></label>
    ${rng('body', 'Body', p.body, 1, 5)}${rng('koolzuur', 'Koolzuur', p.koolzuur, 1, 5)}
    ${S.SMAKEN.map(x => rng(x, `<i style="display:inline-block;width:10px;height:10px;border-radius:5px;background:${S.SMAAK[x].kleur};margin-right:5px"></i>${S.SMAAK[x].naam}`, p[x], 0, 5)).join('')}`;
}

