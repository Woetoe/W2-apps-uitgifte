<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Bierkeuze</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<link rel="stylesheet" href="../w2ui.css">
<style>
:root{--acc:#f4b400;--acc-ink:#2b1d00}
.top .ib.r{margin-left:auto}
section{display:flex;flex-direction:column;gap:12px}
h2{font:800 18px var(--f-display);margin:6px 0 0}
.gq{display:flex;gap:8px}
.gq .in{flex:1}
.gq .btn{flex:none;padding:10px 14px}
.prof{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.sm{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:4px 9px;font-size:13px;font-weight:700;background:var(--panel2)}
.sm i{width:10px;height:10px;border-radius:5px;display:inline-block}
.sm.leeg{opacity:.4}
.kens{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.gtitel{display:flex;align-items:center;gap:8px}
.gtitel b{flex:1;font:800 17px var(--f-display)}
.lnk{border:0;background:none;color:var(--acc);font-weight:700;cursor:pointer;padding:6px 0}
.res{display:flex;flex-direction:column;gap:10px}
.bc{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:12px 14px}
.bc.best{border-color:var(--acc)}
.bc.nood{border-color:#6b5a12}
.bc .kop{display:flex;align-items:center;gap:12px}
.bc .kop .grow{flex:1;min-width:0}
.bc .kop b{display:block;font-weight:800;font-size:17px}
.bc .kop span{display:block;color:var(--muted);font-size:13px}
.sc{width:56px;height:56px;border-radius:16px;display:grid;place-items:center;flex:none;font:800 22px/1 var(--f-display);background:var(--panel2)}
.sc small{display:block;font:700 10px var(--f-body);opacity:.8;text-align:center}
.sc.l-top{background:var(--acc);color:var(--acc-ink)}
.sc.l-goed{background:#3d3410;color:#ffd75e}
.sc.l-matig,.sc.l-nee{background:var(--panel2);color:var(--muted)}
.sc.l-ko{background:#3a1616;color:#ff8a7a}
.delen{display:grid;grid-template-columns:78px 1fr 44px;gap:4px 8px;align-items:center;margin-top:10px;font-size:13px}
.delen .bar{height:7px}
.delen em{font-style:normal;color:var(--muted);text-align:right}
.why{margin-top:8px;font-size:14px}
.why h4{margin:10px 0 2px;font-size:14px}
.why ul{margin:0;padding-left:18px;color:var(--muted)}
.ko{color:#ff8a7a;font-size:14px;margin-top:6px}
.acts{display:flex;gap:8px;margin-top:10px}
.acts .btn{flex:1;min-height:42px}
.kast .row .n{display:flex;align-items:center;gap:6px;flex:none}
.kast .row .n button{width:34px;height:34px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text);font-size:18px;cursor:pointer}
.kast .row .n b{min-width:22px;text-align:center}
.kaartb{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.kaartb .chip{display:inline-flex;align-items:center;gap:6px}
.chip{border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:7px 11px;font-size:14px;cursor:pointer;color:inherit}
.chip.on{background:var(--acc);color:var(--acc-ink);border-color:var(--acc);font-weight:700}
.chip.rood{background:#3a1616;border-color:#7a2a2a;color:#ffb3a8}
.chip .x{opacity:.6;font-weight:800}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.rng{display:grid;grid-template-columns:96px 1fr 34px;align-items:center;gap:8px;font-size:14px}
.rng input{width:100%;accent-color:var(--acc)}
.rng output{text-align:right;font-weight:800}
.ar{display:inline-flex;align-items:center;gap:6px}
.ar .dots{letter-spacing:1px;font-size:10px}
.hex{width:100%;max-width:340px;display:block;margin:0 auto}
.paar{display:grid;grid-template-columns:1fr auto;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line)}
.paar:last-child{border-bottom:0}
.stp{display:flex;align-items:center;gap:6px}
.stp button{width:34px;height:34px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text);font-size:18px;cursor:pointer}
.stp b{min-width:38px;text-align:center}
.stp b.pos{color:#8bc34a}.stp b.neg{color:#ff7a66}
.gew{display:grid;grid-template-columns:1fr 84px;align-items:center;gap:8px;padding:4px 0}
.ar-row{padding:8px 0;border-bottom:1px solid var(--line);cursor:pointer}
.ar-row:last-child{border-bottom:0}
.ar-row b{display:block}
.ar-row span{display:block;font-size:13px;color:var(--muted)}
.hist{font-size:14px}
.hist div{padding:6px 0;border-bottom:1px solid var(--line);display:flex;gap:8px}
.hist div span{flex:1}
.hist div:last-child{border-bottom:0}
details summary{cursor:pointer;color:var(--muted);font-weight:700;padding:6px 0}
[hidden]{display:none!important}
.advies{display:flex;align-items:center;gap:10px;width:100%;margin-top:12px;padding:12px 14px;border-radius:14px;border:1px solid color-mix(in srgb,var(--acc) 55%,var(--line));background:color-mix(in srgb,var(--acc) 12%,var(--panel));color:var(--text);font:inherit;font-size:15px;text-align:left;cursor:pointer}
.advies span{flex:1;min-width:0}
.advies em{flex:none;font-style:normal;font-weight:700;color:var(--acc);font-size:14px}
.res{scroll-margin-top:76px}
</style>
</head>
<body>
<div class="top"><a class="ib" id="back" href="../index.html#samen" aria-label="Terug"></a><h1 id="titel">Bierkeuze</h1><button class="ib r" id="inst" type="button" aria-label="Scoring"></button></div>
<main class="page">
  <div class="seg" id="tabs"><button type="button" data-tab="thuis" class="on">🏠 Thuis</button><button type="button" data-tab="rest">🍽️ Restaurant</button><button type="button" data-tab="kast">🗄️ Voorraad</button></div>

  <section id="t-thuis">
    <div class="card" id="g-thuis"></div>
    <div class="res" id="r-thuis"></div>
  </section>

  <section id="t-rest" hidden>
    <div class="card" id="kaart"></div>
    <div class="card" id="g-rest"></div>
    <div class="res" id="r-rest"></div>
  </section>

  <section id="t-kast" class="kast" hidden>
    <div class="list" id="kastlijst"></div>
    <button class="btn wide" id="kast-plus" type="button"></button>
    <div id="hist"></div>
  </section>

  <section id="t-score" hidden></section>
</main>
<input type="file" id="file" accept="image/*" hidden>
<datalist id="gerechten"></datalist>
<script src="../w2.js"></script>
<script src="../w2data.js"></script>
<script src="../w2ui.js"></script>
<script src="../samen/sync.js"></script>
<script src="../samen/deel.js"></script>
<script src="../samen/boodschappen.js"></script>
<script src="score.js"></script>
<script src="data.js"></script>
<script>
const { esc, $, $$, icon, sheet, confirm, toast } = UI;
const D = W2D, S = BierScore, BD = BierData;
$('#back').innerHTML = icon('back');
$('#inst').innerHTML = icon('gear');
$('#kast-plus').innerHTML = icon('plus') + 'Bier toevoegen';
D.recent('bier');

// ---------------------------------------------------------------- opslag
// Gedeeld via Samen: voorraadkast (k:), bewaarde bierkaarten (c:), instellingen van de scoring (inst) en wat je dronk (l:).
// Alleen op dit apparaat: het gerecht en de bierkaart van nu.
let data = Object.assign({ kast: [], kaarten: [], inst: {}, log: [] }, D.get('bier', null) || {});
let nu = Object.assign({ tekst: '', p: null, naam: '', zeker: false, eigen: false, kaart: { naam: '', bieren: [], rest: [] } }, D.get('bier-nu', null) || {});
let tab = 'thuis', vorigeTab = 'thuis';
const cfg = () => S.config(data.inst);
const save = () => { data.log = data.log.slice(-60); D.set('bier', data); if (deel) deel.push(); };
const saveNu = () => D.set('bier-nu', nu);

let deel = null;
function koppelDeel() {
  if (deel || !window.W2Deel) return;
  deel = W2Deel.koppel({
    kind: 'bier',
    lees: async () => Object.fromEntries([
      ...data.kast.map(k => ['k:' + k.id, k]), ...data.kaarten.map(c => ['c:' + c.id, c]),
      ...data.log.map(l => ['l:' + l.id, l]), ['inst', Object.assign({ id: 'inst' }, data.inst)]
    ]),
    schrijf: async map => {
      const pick = pre => Object.entries(map).filter(([k]) => k.startsWith(pre)).map(([, v]) => JSON.parse(JSON.stringify(v)));
      data.kast = pick('k:'); data.kaarten = pick('c:');
      data.log = pick('l:').sort((a, b) => (a.t || 0) - (b.t || 0));
      const ins = map.inst ? JSON.parse(JSON.stringify(map.inst)) : {}; delete ins.id; data.inst = ins;
      D.set('bier', data);
      render();
    }
  });
  W2Deel.badge();
}

// ---------------------------------------------------------------- hulpjes
const komma = v => String(Math.round(v * 10) / 10).replace('.', ',');
const stijlNaam = id => (BD.STIJL[id] || {}).naam || 'Eigen bier';
const sub = b => [stijlNaam(b.stijl), b.profiel ? komma(b.profiel.abv) + '%' : ''].filter(Boolean).join(' · ');
const smaakChips = p => S.SMAKEN.map(s => `<span class="sm${p[s] ? '' : ' leeg'}"><i style="background:${S.SMAAK[s].kleur}"></i>${S.SMAAK[s].naam} ${p[s]}</span>`).join('');

function pickFoto(camera) {
  return new Promise(res => {
    const inp = $('#file');
    inp.value = '';
    if (camera) inp.setAttribute('capture', 'environment'); else inp.removeAttribute('capture');
    inp.onchange = async () => {
      const f = inp.files[0];
      if (!f) return res(null);
      try {
        const bmp = await createImageBitmap(f, { imageOrientation: 'from-image' }).catch(() => createImageBitmap(f));
        const sc = Math.min(1, 2000 / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas');
        c.width = Math.round(bmp.width * sc); c.height = Math.round(bmp.height * sc);
        const g = c.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, c.width, c.height); g.drawImage(bmp, 0, 0, c.width, c.height);
        res(c.toDataURL('image/jpeg', .9));
      } catch (e) { toast('Deze foto kon niet gelezen worden.'); res(null); }
    };
    inp.click();
  });
}

// ---------------------------------------------------------------- tabbladen
function toon(t) {
  if (t !== 'score') vorigeTab = t;
  tab = t;
  ['thuis', 'rest', 'kast', 'score'].forEach(x => { $('#t-' + x).hidden = x !== t; });
  $('#tabs').hidden = t === 'score';
  $$('#tabs [data-tab]').forEach(b => b.classList.toggle('on', b.dataset.tab === t));
  $('#titel').textContent = t === 'score' ? 'Scoring' : 'Bierkeuze';
  history.replaceState(null, '', '#' + t);
  render();
  window.scrollTo(0, 0);
}
$('#tabs').addEventListener('click', e => { const b = e.target.closest('[data-tab]'); if (b) toon(b.dataset.tab); });
$('#inst').onclick = () => toon(tab === 'score' ? vorigeTab : 'score');
window.UIback = () => { if (tab === 'score') { toon(vorigeTab); return true; } return false; };

function render() {
  if (tab === 'thuis') { renderGerecht($('#g-thuis')); renderUitslag('thuis'); }
  else if (tab === 'rest') { renderKaart(); renderGerecht($('#g-rest')); renderUitslag('rest'); }
  else if (tab === 'kast') renderKast();
  else renderScoring();
}

// ---------------------------------------------------------------- gerecht
$('#gerechten').innerHTML = BD.GERECHTEN.map(g => `<option value="${esc(g.naam)}">`).join('');

function zetGerecht(tekst) {
  tekst = String(tekst || '').trim();
  if (!tekst) return;
  const r = S.gerechtUitTekst(tekst, BD.GERECHTEN);
  Object.assign(nu, { tekst, p: r.p, naam: r.naam, zeker: r.zeker, gevonden: r.gevonden, eigen: false });
  saveNu();
  render();
  if (!r.zeker) aanpassenGerecht();
  else setTimeout(naarAdvies, 80);
}

function renderGerecht(host) {
  const p = nu.p;
  host.innerHTML = `
    <div class="gq"><input class="in" id="gq-${host.id}" list="gerechten" placeholder="Wat eet je? Bv. spareribs met BBQ-saus" value="${esc(nu.tekst)}" enterkeyhint="go" autocomplete="off"><button class="btn" type="button" data-act="zoek">${icon('search')}</button></div>
    ${p ? `<div style="margin-top:12px" class="gtitel"><b>${esc(nu.naam || 'Gerecht')}</b><button class="lnk" type="button" data-act="pas">Aanpassen</button></div>
      <div class="muted small">${nu.eigen ? 'Zelf ingesteld' : nu.zeker ? 'Herkend als ' + esc((nu.gevonden || []).slice(0, 2).join(' + ')) : 'Niet herkend: stel het smaakprofiel zelf in'} · intensiteit ${p.i} van 5</div>
      <div class="prof">${smaakChips(p)}</div>
      ${p.ken.length ? `<div class="kens">${p.ken.map(k => `<span class="pill">${esc(S.kenNaam(k))}</span>`).join('')}</div>` : ''}
      ${kortAdvies(host.id === 'g-thuis' ? 'thuis' : 'rest')}`
    : `<div class="muted small" style="margin-top:10px">Typ wat je eet (of gaat bestellen). De app zoekt het smaakprofiel erbij; dat kun je daarna aanpassen.</div>`}`;
  const inp = $('input', host);
  inp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); zetGerecht(inp.value); } });
  inp.addEventListener('change', () => { if (BD.GERECHTEN.some(g => g.naam === inp.value)) zetGerecht(inp.value); });
  host.onclick = e => {
    const a = e.target.closest('[data-act]'); if (!a) return;
    if (a.dataset.act === 'zoek') zetGerecht(inp.value);
    if (a.dataset.act === 'pas') aanpassenGerecht();
    if (a.dataset.act === 'naar') naarAdvies();
  };
}

/** Eén regel met het advies, meteen onder het gerecht (de kaarten met de scores staan verder naar beneden). */
function kortAdvies(modus) {
  if (!nu.p) return '';
  const kand = kandidaten(modus);
  let t;
  if (!kand.length) t = modus === 'thuis' ? 'Voorraad leeg: zie hieronder welk soort bier past' : 'Nog geen bierkaart: zie hieronder welk soort bier past';
  else {
    const r = S.kies(kand, nu.p, data.inst, modus === 'thuis' ? 'thuis' : 'restaurant', BD.STIJLEN);
    const a = r.aangeboden;
    if (a.length) t = `Beste keuze: <b>${esc(a[0].naam)}</b> (${a[0].s.totaal})${a.length > 1 ? ` · nog ${a.length - 1} andere` : ''}`;
    else if (r.noodoptie) t = `Niets past echt goed; het dichtst bij: <b>${esc(r.noodoptie.naam)}</b> (${r.noodoptie.s.totaal})`;
    else t = modus === 'thuis' ? 'Niets in je voorraad past goed: zie hieronder wat je kunt kopen' : 'Geen bier op de kaart past';
  }
  return `<button class="advies" type="button" data-act="naar">🍺 <span>${t}</span><em>Bekijk ↓</em></button>`;
}
function naarAdvies() {
  const el = $(tab === 'thuis' ? '#r-thuis' : '#r-rest');
  if (el && el.firstElementChild) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

const rng = (name, label, v, min, max, step) => `<label class="rng"><span>${label}</span><input type="range" name="${name}" min="${min}" max="${max}" step="${step || 1}" value="${v}"><output>${String(v).replace('.', ',')}</output></label>`;
function liveRng(el) { el.addEventListener('input', e => { if (e.target.type === 'range') e.target.nextElementSibling.textContent = String(e.target.value).replace('.', ','); }); }

async function aanpassenGerecht() {
  const p = nu.p || S.gerechtP({});
  const ken = new Set(p.ken);
  const s = sheet('Smaakprofiel van het gerecht', `
    <label class="f">Naam<input class="in" name="naam" value="${esc(nu.naam || nu.tekst)}"></label>
    ${rng('i', 'Intensiteit', p.i, 1, 5)}
    <div class="muted small">1 = salade of witte vis · 3 = kip, pasta · 5 = stoofvlees, wild, oude kaas</div>
    ${S.SMAKEN.map(x => rng(x, `<i style="display:inline-block;width:10px;height:10px;border-radius:5px;background:${S.SMAAK[x].kleur};margin-right:5px"></i>${S.SMAAK[x].naam}`, p[x], 0, 5)).join('')}
    <div class="muted small">Kenmerken (voor het aroma)</div>
    <div class="chips" id="kens">${S.KENMERKEN.map(([id, n]) => `<button type="button" class="chip${ken.has(id) ? ' on' : ''}" data-k="${id}">${esc(n)}</button>`).join('')}
      ${S.AROMAS.map(a => `<button type="button" class="chip${ken.has(a.id) ? ' on' : ''}" data-k="${a.id}">${esc(a.naam)}</button>`).join('')}</div>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Opslaan', value: 'ok' }]);
  liveRng(s.el);
  $('#kens', s.el).addEventListener('click', e => { const c = e.target.closest('[data-k]'); if (!c) return; const k = c.dataset.k; if (ken.has(k)) ken.delete(k); else ken.add(k); c.classList.toggle('on', ken.has(k)); });
  const r = await s.done;
  if (r.value !== 'ok') return;
  const f = r.form;
  nu.p = S.gerechtP({ i: +f.i, zoet: +f.zoet, zuur: +f.zuur, zout: +f.zout, pikant: +f.pikant, vet: +f.vet, bitter: +f.bitter, ken: [...ken] });
  nu.naam = f.naam.trim() || nu.naam; nu.eigen = true; nu.zeker = true;
  if (!nu.tekst) nu.tekst = nu.naam;
  saveNu(); render();
  setTimeout(naarAdvies, 80);
}

// ---------------------------------------------------------------- uitslag
function kandidaten(modus) {
  if (modus === 'thuis') return data.kast.filter(k => (k.aantal || 0) > 0).map(k => Object.assign({}, k));
  return (nu.kaart.bieren || []).map((b, i) => Object.assign({ id: 'm' + i }, b));
}

function scoreKaart(k, modus, extra) {
  const s = k.s, c = cfg();
  const cls = s.label.id;
  return `<div class="bc${cls === 'top' ? ' best' : ''}${extra === 'nood' ? ' nood' : ''}">
    <div class="kop"><div class="grow"><b>${esc(k.naam)}</b><span>${esc(!k.id && BD.STIJL[k.stijl] ? BD.STIJL[k.stijl].kort + ' · ± ' + komma(k.profiel.abv) + '%' : sub(k))}${modus === 'thuis' && k.aantal ? ' · nog ' + k.aantal : ''}</span>${!k.id && voorbeelden(k.stijl).length ? `<span>Bijvoorbeeld ${esc(voorbeelden(k.stijl).join(', '))}</span>` : ''}</div>
      <div class="sc l-${cls}">${s.totaal}<small>${esc(s.label.naam)}</small></div></div>
    <div class="delen">${s.delen.map(d => `<span>${esc(d.naam)}</span><div class="bar"><i style="width:${d.max ? Math.round(d.punten / d.max * 100) : 0}%"></i></div><em>${komma(d.punten)}/${d.max}</em>`).join('')}</div>
    ${s.ko.length ? `<div class="ko">✗ ${s.ko.map(esc).join(' · ')}</div>` : ''}
    <details class="why"><summary>Waarom?</summary>
      ${s.delen.map(d => `<h4>${esc(d.naam)} ${komma(d.punten)} van ${d.max}</h4><ul>${d.uitleg.map(u => `<li>${esc(u)}</li>`).join('')}</ul>`).join('')}
      <div class="muted small" style="margin-top:8px">Totaal = punten ÷ ${Object.values(c.max).reduce((a, b) => a + b, 0)} × 100. Aanbieden vanaf ${c.drempel.goed}, topmatch vanaf ${c.drempel.top}. Aanpassen via het tandwiel.</div>
    </details>
    ${extra === 'kopen' ? `<div class="acts"><button class="btn q" type="button" data-koop="${esc(k.naam)}">${icon('plus')}Op de boodschappenlijst</button></div>`
      : extra === 'geen' ? '' : `<div class="acts"><button class="btn${s.ok ? '' : ' q'}" type="button" data-drink="${esc(k.id)}">🍺 ${modus === 'thuis' ? 'Deze drink ik' : 'Deze neem ik'}</button></div>`}
  </div>`;
}

/** Beste bierstijlen bij het gerecht (om te kopen of op de kaart te zoeken); haalt niets de drempel, dan toch de beste 3. */
function koopAdvies() {
  const r = S.kies([], nu.p, data.inst, 'thuis', BD.STIJLEN);
  if (r.kopen.length) return r.kopen;
  return BD.STIJLEN.map(st => ({ naam: st.naam, stijl: st.id, profiel: st.p, s: S.score(st.p, nu.p, data.inst) }))
    .filter(k => !k.s.ko.length).sort((a, b) => b.s.totaal - a.s.totaal).slice(0, 3);
}
const voorbeelden = stijl => BD.BIEREN.filter(b => b.stijl === stijl).slice(0, 3).map(b => b.naam);

function renderUitslag(modus) {
  const host = $(modus === 'thuis' ? '#r-thuis' : '#r-rest');
  if (!nu.p) { host.innerHTML = ''; return; }
  const kand = kandidaten(modus);
  if (!kand.length) {
    // Niets in de voorraad / nog geen kaart: toch zeggen welk soort bier je zoekt
    const advies = koopAdvies();
    host.innerHTML = (modus === 'thuis'
      ? `<div class="notice"><b>Je voorraad is leeg.</b> Dit soort bier past bij ${esc(nu.naam || 'dit gerecht')}; koop er een of zet je bieren in de <button class="lnk" type="button" data-naar="kast">voorraad</button>.</div>`
      : `<div class="notice"><b>Nog geen bierkaart.</b> Zoek op de kaart naar dit soort bier, of maak hierboven een foto van de bierkaart.</div>`)
      + advies.map(k => scoreKaart(k, modus, modus === 'thuis' ? 'kopen' : 'geen')).join('');
    host.onclick = e => {
      const b = e.target.closest('[data-naar]'); if (b) return toon(b.dataset.naar);
      const kp = e.target.closest('[data-koop]'); if (kp) return opLijst(kp.dataset.koop);
    };
    return;
  }
  const r = S.kies(kand, nu.p, data.inst, modus === 'thuis' ? 'thuis' : 'restaurant', BD.STIJLEN);
  const rest = r.alle.filter(k => !k.s.ok && k !== r.noodoptie);
  let h = '';
  if (r.aangeboden.length) {
    h += `<h2>${modus === 'thuis' ? 'Uit je voorraad' : 'Van de kaart'}</h2>` + r.aangeboden.map(k => scoreKaart(k, modus)).join('');
  } else if (modus === 'thuis') {
    h += `<div class="notice"><b>Niets in je voorraad past goed bij ${esc(nu.naam || 'dit gerecht')}.</b> Geen enkel bier haalt ${cfg().drempel.goed} punten. Deze biertypes zouden wel passen:</div>`;
    h += koopAdvies().map(k => scoreKaart(k, modus, 'kopen')).join('');
  } else if (r.noodoptie) {
    h += `<div class="notice"><b>Geen bier op de kaart past echt goed.</b> Dit komt het dichtst bij, maar haalt de ${cfg().drempel.goed} punten niet.${r.kopen[0] ? ` Vraag eventueel of ze een <b>${esc(r.kopen[0].naam)}</b> hebben.` : ''}</div>`;
    h += scoreKaart(r.noodoptie, modus, 'nood');
  }
  if (rest.length) h += `<details><summary>Niet aangeboden (${rest.length})</summary><div class="res">${rest.map(k => scoreKaart(k, modus, 'geen')).join('')}</div></details>`;
  host.innerHTML = h;
  host.onclick = async e => {
    const d = e.target.closest('[data-drink]');
    if (d) return drink(modus, r.alle.find(k => k.id === d.dataset.drink));
    const kp = e.target.closest('[data-koop]');
    if (kp) return opLijst(kp.dataset.koop);
  };
}

async function drink(modus, k) {
  if (!k) return;
  const g = nu.naam || nu.tekst;
  if (modus === 'thuis') {
    const item = data.kast.find(x => x.id === k.id);
    if (!item) return;
    const ok = await confirm(`<b>${esc(item.naam)}</b> bij ${esc(g)}? Er gaat er één uit de voorraad${item.aantal > 1 ? ` (dan nog ${item.aantal - 1})` : ' (dan is hij op)'}.`, 'Proost 🍺');
    if (!ok) return;
    item.aantal = Math.max(0, (item.aantal || 1) - 1);
    if (!item.aantal) data.kast = data.kast.filter(x => x !== item);
    toast(item.aantal ? `Proost! Nog ${item.aantal} over.` : `Proost! ${item.naam} is nu op.`);
  } else toast('Proost! 🍺 Bewaard bij wat je dronk.');
  data.log.push({ id: D.uid(), t: Date.now(), bier: k.naam, stijl: k.stijl || '', gerecht: g, score: k.s.totaal, waar: modus === 'thuis' ? 'thuis' : (nu.kaart.naam || 'restaurant'), profiel: k.profiel });
  save(); render();
}

async function opLijst(naam) {
  const B = window.Boodschappen, lists = B ? B.lists() : [];
  if (!lists.length) return toast('Er is nog geen boodschappenlijst in Samen.');
  const out = B.addLines(lists[0].id, [naam], 'Bierkeuze');
  toast(out.added ? `${naam} staat op ${lists[0].naam}.` : 'Staat al op de lijst.');
}

// ---------------------------------------------------------------- restaurant: de bierkaart
function renderKaart() {
  const k = nu.kaart;
  $('#kaart').innerHTML = `
    <div class="gtitel"><b>🍺 Bierkaart${k.naam ? ' · ' + esc(k.naam) : ''}</b>${k.bieren.length ? `<button class="lnk" type="button" data-act="wis">Leeg</button>` : ''}</div>
    ${k.bieren.length ? `<div class="kaartb">${k.bieren.map((b, i) => `<span class="chip" data-i="${i}">${esc(b.naam)} <span class="muted">${esc(komma(b.profiel.abv))}%</span><span class="x" data-del="${i}">✕</span></span>`).join('')}</div>
      <div class="muted small" style="margin-top:6px">Tik op een bier om stijl of smaak aan te passen.</div>`
      : `<div class="muted small" style="margin-top:6px">Maak een foto van de bierkaart, of typ de bieren die ze hebben.</div>`}
    <div class="btns" style="margin-top:10px"><button class="btn q" type="button" data-act="foto">${icon('camera')}Foto</button><button class="btn q" type="button" data-act="typ">${icon('edit')}Typen</button>
      <button class="btn q" type="button" data-act="bewaard">${icon('folder')}Bewaard</button></div>
    ${k.bieren.length ? `<button class="lnk" type="button" data-act="bewaar">Kaart bewaren voor de volgende keer</button>` : ''}
    ${(k.rest || []).length ? `<details><summary>Ander tekst van de foto (gerecht kiezen)</summary><div class="chips">${k.rest.slice(0, 40).map((t, i) => `<button class="chip" type="button" data-rest="${i}">${esc(t)}</button>`).join('')}</div></details>` : ''}`;
  $('#kaart').onclick = async e => {
    const del = e.target.closest('[data-del]');
    if (del) { k.bieren.splice(+del.dataset.del, 1); saveNu(); return render(); }
    const ch = e.target.closest('[data-i]');
    if (ch) {
      const b = k.bieren[+ch.dataset.i];
      const nieuw = await bewerkBier(b, false);
      if (nieuw) { k.bieren[+ch.dataset.i] = nieuw; saveNu(); render(); }
      return;
    }
    const rs = e.target.closest('[data-rest]');
    if (rs) return zetGerecht(k.rest[+rs.dataset.rest]);
    const a = e.target.closest('[data-act]'); if (!a) return;
    if (a.dataset.act === 'foto') return kaartFoto();
    if (a.dataset.act === 'typ') return kaartTypen();
    if (a.dataset.act === 'bewaard') return kaartKiezen();
    if (a.dataset.act === 'bewaar') return kaartBewaren();
    if (a.dataset.act === 'wis' && await confirm('Bierkaart leegmaken?', 'Leegmaken')) { nu.kaart = { naam: '', bieren: [], rest: [] }; saveNu(); render(); }
  };
}

function voegToe(gelezen) {
  const k = nu.kaart, namen = new Set(k.bieren.map(b => S.norm(b.naam)));
  let n = 0;
  gelezen.bieren.forEach(b => { if (!namen.has(S.norm(b.naam))) { k.bieren.push(b); namen.add(S.norm(b.naam)); n++; } });
  k.rest = [...new Set([...(k.rest || []), ...(gelezen.rest || [])])].slice(0, 80);
  saveNu(); render();
  return n;
}

async function kaartFoto() {
  if (!W2.herken.available()) { toast('De kaart lezen van een foto kan alleen in de app. Typ de bieren.', 4000); return kaartTypen(); }
  const foto = await pickFoto(true);
  if (!foto) return;
  toast('Kaart lezen…', 20000);
  try {
    const scan = await W2.herken.foto(foto, 'tekst');
    toast('');
    if (!scan || !scan.ok) return toast('De foto kon niet gelezen worden. Probeer het met meer licht of van dichterbij.', 4000);
    const lines = (scan.lines || []).slice().sort((a, b) => (a.y - b.y) || (a.x - b.x));
    const g = S.leesKaart(lines.map(l => l.t), BD.BIEREN, BD.STIJLEN);
    const n = voegToe(g);
    if (!g.bieren.length) { toast('Geen bieren herkend op de foto. Typ ze, of maak een foto van dichterbij.', 4500); return kaartTypen(lines.map(l => l.t).join('\n')); }
    toast(`${n} bier${n === 1 ? '' : 'en'} van de kaart gehaald. Tik op een bier om het na te kijken.`, 3500);
  } catch (e) { toast(''); toast('Lezen lukte niet: ' + (e.message || e), 4000); }
}

async function kaartTypen(voor) {
  const s = sheet('Bieren op de kaart', `
    <label class="f">Restaurant (mag leeg)<input class="in" name="naam" value="${esc(nu.kaart.naam || '')}"></label>
    <label class="f">Eén bier per regel; alcohol erbij mag (bv. "Huis-IPA 6,5%")<textarea class="in" name="t" rows="8" placeholder="Duvel&#10;Westmalle Tripel&#10;Brouwerij X IPA 6,8%">${esc(voor || '')}</textarea></label>
    <div class="muted small">De app kent ± ${BD.BIEREN.length} bieren en ${BD.STIJLEN.length} stijlen. Een onbekend bier zonder stijl in de naam kies je daarna zelf.</div>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Toevoegen', value: 'ok' }], { focus: true });
  const r = await s.done;
  if (r.value !== 'ok') return;
  nu.kaart.naam = r.form.naam.trim();
  const regels = r.form.t.split(/\n+/).map(x => x.trim()).filter(Boolean);
  const g = S.leesKaart(regels, BD.BIEREN, BD.STIJLEN);
  // regels zonder herkend bier: toch als bier toevoegen, stijl zelf kiezen
  const onbekend = regels.filter(x => !S.bierUitRegel(x, BD.BIEREN, BD.STIJLEN));
  voegToe({ bieren: g.bieren, rest: [] });
  for (const naam of onbekend) {
    const b = await bewerkBier({ naam, stijl: '', profiel: null }, false, `Welke stijl is "${naam}"?`);
    if (b) { nu.kaart.bieren.push(b); saveNu(); }
  }
  render();
}

async function kaartBewaren() {
  const s = sheet('Kaart bewaren', `<label class="f">Naam van het restaurant<input class="in" name="naam" value="${esc(nu.kaart.naam || '')}"></label>`,
    [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Bewaren', value: 'ok', check: f => f.naam.trim() ? '' : 'Geef het restaurant een naam.' }], { focus: true });
  const r = await s.done;
  if (r.value !== 'ok') return;
  const naam = r.form.naam.trim();
  nu.kaart.naam = naam; saveNu();
  const bestaand = data.kaarten.find(c => c.naam.toLowerCase() === naam.toLowerCase());
  const kaart = { id: bestaand ? bestaand.id : D.uid(), naam, bieren: JSON.parse(JSON.stringify(nu.kaart.bieren)), datum: D.date.today() };
  data.kaarten = data.kaarten.filter(c => c.id !== kaart.id).concat(kaart);
  save(); render(); toast('Bewaard: ' + naam);
}

async function kaartKiezen() {
  if (!data.kaarten.length) return toast('Nog geen bewaarde kaarten. Bewaar er een nadat je hem hebt ingevuld.');
  const s = sheet('Bewaarde bierkaarten', `<div class="list">${data.kaarten.slice().sort((a, b) => a.naam.localeCompare(b.naam)).map(c => `<div class="row" data-c="${esc(c.id)}"><div class="grow"><b>${esc(c.naam)}</b><span class="sub">${c.bieren.length} bieren · ${esc(c.datum || '')}</span></div><button class="ib" type="button" data-weg="${esc(c.id)}" aria-label="Weggooien">${icon('trash')}</button></div>`).join('')}</div>`,
    [{ label: 'Sluiten', value: null, kind: 'q' }]);
  s.el.addEventListener('click', async e => {
    const w = e.target.closest('[data-weg]');
