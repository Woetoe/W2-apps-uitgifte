$('#kastlijst').addEventListener('click', async e => {
  const mi = e.target.closest('[data-min]'), pl = e.target.closest('[data-plus]');
  if (mi || pl) {
    const k = data.kast.find(x => x.id === (mi || pl).dataset[mi ? 'min' : 'plus']);
    k.aantal = Math.max(0, (k.aantal || 0) + (pl ? 1 : -1));
    if (!k.aantal && !(await confirm(`${esc(k.naam)} is op. Uit de voorraad halen?`, 'Weghalen'))) { k.aantal = 1; return renderKast(); }
    if (!k.aantal) data.kast = data.kast.filter(x => x !== k);
    save(); return renderKast();
  }
  const row = e.target.closest('[data-k]');
  if (!row) return;
  const k = data.kast.find(x => x.id === row.dataset.k);
  const nieuw = await bewerkBier(k, true);
  if (!nieuw) return;
  if (!nieuw.aantal) data.kast = data.kast.filter(x => x.id !== k.id);
  else Object.assign(k, nieuw);
  save(); renderKast();
});

$('#kast-plus').onclick = async () => {
  const s = sheet('Bier toevoegen', `
    <input class="in" id="zoekbier" placeholder="Zoek een bier of stijl, bv. Duvel of tripel" autocomplete="off">
    <div class="list" id="bierres" style="max-height:46vh;overflow:auto;gap:6px"></div>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }], { focus: true });
  const zoek = () => {
    const q = S.norm($('#zoekbier', s.el).value);
    const bieren = BD.BIEREN.filter(b => !q || S.norm(b.naam).includes(q) || (b.alias || []).some(a => S.norm(a).includes(q))).slice(0, 25);
    const stijlen = BD.STIJLEN.filter(st => !q || S.norm(st.naam).includes(q) || st.w.some(w => S.norm(w).includes(q))).slice(0, 10);
    $('#bierres', s.el).innerHTML = (q ? `<div class="row" data-eigen="1"><div class="ico">✏️</div><div class="grow"><b>"${esc($('#zoekbier', s.el).value.trim())}"</b><span class="sub">Eigen bier, stijl zelf kiezen</span></div></div>` : '') +
      bieren.map(b => `<div class="row" data-b="${b.id}"><div class="ico">🍺</div><div class="grow"><b>${esc(b.naam)}</b><span class="sub">${esc(stijlNaam(b.stijl))} · ${komma(BD.profielVan(b).abv)}%</span></div></div>`).join('') +
      stijlen.map(st => `<div class="row" data-st="${st.id}"><div class="ico">🏷️</div><div class="grow"><b>${esc(st.naam)}</b><span class="sub">${esc(st.kort)}</span></div></div>`).join('');
  };
  $('#zoekbier', s.el).addEventListener('input', zoek);
  zoek();
  let keuze = null;
  s.el.addEventListener('click', e => {
    const r = e.target.closest('[data-b],[data-st],[data-eigen]'); if (!r) return;
    const naam = $('#zoekbier', s.el).value.trim();
    if (r.dataset.b) { const b = BD.BIEREN.find(x => x.id === r.dataset.b); keuze = { naam: b.naam, stijl: b.stijl, bierId: b.id, profiel: S.bierP(BD.profielVan(b)) }; }
    else if (r.dataset.st) { const st = BD.STIJL[r.dataset.st]; keuze = { naam: naam && !st.w.some(w => S.norm(w) === S.norm(naam)) ? naam : st.naam, stijl: st.id, profiel: S.bierP(st.p) }; }
    else { const g = S.bierUitRegel(naam, BD.BIEREN, BD.STIJLEN); keuze = g ? Object.assign(g, { naam }) : { naam, stijl: '', profiel: null }; }
    s.close('ok');
  });
  await s.done;
  if (!keuze) return;
  const al = data.kast.find(k => S.norm(k.naam) === S.norm(keuze.naam));
  const nieuw = await bewerkBier(Object.assign({ aantal: al ? (al.aantal || 0) + 1 : 1 }, al || keuze), true);
  if (!nieuw || !nieuw.aantal) return;
  if (al) Object.assign(al, nieuw);
  else data.kast.push(Object.assign({ id: D.uid() }, nieuw));
  save(); renderKast(); toast(nieuw.naam + ' staat in de voorraad.');
};

// ---------------------------------------------------------------- scoring bekijken en aanpassen
const HEX = { zoet: -90, zuur: -30, zout: 30, pikant: 90, vet: 150, bitter: 210 };
function zeshoekSvg(c) {
  const R = 118, cx = 170, cy = 160, pos = s => [cx + R * Math.cos(HEX[s] * Math.PI / 180), cy + R * Math.sin(HEX[s] * Math.PI / 180)];
  let lines = '';
  S.SMAKEN.forEach((a, i) => S.SMAKEN.slice(i + 1).forEach(b => {
    const v = c.zeshoek[S.paar(a, b)] || 0, [x1, y1] = pos(a), [x2, y2] = pos(b);
    const kl = v > 0 ? '#8bc34a' : v < 0 ? '#e0533b' : '#666';
    lines += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${kl}" stroke-width="${1.5 + Math.abs(v) * 1.5}" ${v ? '' : 'stroke-dasharray="4 4"'} opacity=".9"/>`;
  }));
  const dots = S.SMAKEN.map(s => { const [x, y] = pos(s); const zelf = c.zeshoek[s + '|' + s]; return `<circle cx="${x}" cy="${y}" r="34" fill="${S.SMAAK[s].kleur}"/><text x="${x}" y="${y + 6}" text-anchor="middle" font-family="Bricolage Grotesque" font-weight="800" font-size="17" fill="#fff">${S.SMAAK[s].naam}</text><text x="${x}" y="${y + 22}" text-anchor="middle" font-size="11" font-weight="700" fill="#fff" opacity=".85">${zelf > 0 ? '+' : ''}${String(zelf).replace('.', ',')}</text>`; }).join('');
  return `<svg class="hex" viewBox="0 0 340 320" aria-label="Smaakzeshoek">${lines}${dots}</svg>`;
}

function renderScoring() {
  const c = cfg(), ins = data.inst;
  const tot = Object.values(c.max).reduce((a, b) => a + b, 0);
  const paren = [];
  S.SMAKEN.forEach((a, i) => S.SMAKEN.slice(i).forEach(b => paren.push(S.paar(a, b))));
  const pn = k => k.split('|').map(x => S.SMAAK[x].naam).join(' × ');
  const stp = (attr, v) => `<div class="stp"><button type="button" data-${attr}="-0.5">−</button><b class="${v > 0 ? 'pos' : v < 0 ? 'neg' : ''}">${v > 0 ? '+' : ''}${String(v).replace('.', ',')}</b><button type="button" data-${attr}="0.5">+</button></div>`;
  $('#t-score').innerHTML = `
    <div class="card"><b>Zo werkt de score</b><p class="muted small" style="margin:6px 0 0">Elk bier krijgt punten op vijf eigenschappen, samen 100. Een bier wordt alleen aangeboden vanaf ${c.drempel.goed} punten en zonder knock-out. Bij elk bier zie je onder <b>Waarom?</b> hoe de punten zijn opgebouwd. Alles hieronder kun je aanpassen; het geldt ook op de telefoon van je partner (via Samen).</p></div>

    <h2>Gewicht per eigenschap</h2>
    <div class="card">${S.DELEN.map(d => `<div class="gew"><div><b>${esc(d.naam)}</b><div class="muted small">${esc(d.uitleg)}</div></div><input class="in" type="number" min="0" max="100" data-max="${d.id}" value="${c.max[d.id]}"></div>`).join('')}
      <div class="muted small" style="margin-top:6px">Samen ${tot}${tot !== 100 ? ' (wordt omgerekend naar 100)' : ''}.</div></div>

    <h2>Smaakzeshoek</h2>
    <div class="card">${zeshoekSvg(c)}
      <p class="muted small">Groen = combinatie werkt (+), rood = botst (−). Waarde × smaak van het bier × smaak van het gerecht ÷ 5, opgeteld; 0 = neutraal (15 van de 30 punten). Het getal in een rondje geldt voor dezelfde smaak aan beide kanten (bij zoet: een dessert mag niet zoeter zijn dan het bier).</p>
      ${paren.map(k => `<div class="paar"><span>${esc(pn(k))}</span>${stp('z="' + k + '" data-d', c.zeshoek[k])}</div>`).join('')}</div>

    <h2>Drempels</h2>
    <div class="card">
      <div class="gew"><span>Topmatch vanaf</span><input class="in" type="number" min="0" max="100" data-dr="top" value="${c.drempel.top}"></div>
      <div class="gew"><span>Aanbieden vanaf</span><input class="in" type="number" min="0" max="100" data-dr="goed" value="${c.drempel.goed}"></div>
      <div class="gew"><span>Matig vanaf</span><input class="in" type="number" min="0" max="100" data-dr="matig" value="${c.drempel.matig}"></div></div>

    <h2>Knock-outs (nooit aanbieden)</h2>
    <div class="card">
      ${[['zwaar', 'Te zwaar', '9% of meer bij een licht gerecht (intensiteit 1–2), behalve een dessert'],
         ['botsing', 'Rode lijn', 'Een rode lijn uit de zeshoek waar bier en gerecht allebei sterk zijn (bv. bitter 4 bij pikant 3)'],
         ['dessert', 'Dessert te zoet', 'Het dessert is 2 of meer zoeter dan het bier']].map(([k, n, u]) =>
        `<div class="toggle"><div class="grow"><b>${n}</b><div class="muted small">${u}</div></div><button type="button" class="sw${c.ko[k] ? ' on' : ''}" data-ko="${k}" aria-label="${n}"></button></div>`).join('')}</div>

    <h2>Aroma's: past bij en botst met</h2>
    <div class="card">${S.AROMAS.map(a => `<div class="ar-row" data-ar="${a.id}"><b>${esc(a.naam)} <span class="muted small" style="display:inline">· ${esc(a.wiel)}</span></b>
      <span>✓ ${esc((c.bruggen[a.id] || []).map(S.kenNaam).join(', ') || '–')}</span>${(c.botsingen[a.id] || []).length ? `<span>✗ ${esc(c.botsingen[a.id].map(S.kenNaam).join(', '))}</span>` : ''}</div>`).join('')}
      <p class="muted small">Zelfde aroma in bier en gerecht: +3 per ●. Past bij: +3 (+1 bij ●●●). Botst met: −2 per ●. Basis 6, maximaal 25.</p></div>

    <h2>Overige regels</h2>
    <div class="card muted small">
      <p style="margin:0 0 6px"><b style="color:var(--text)">Alcohol</b>: onder 5% past bij alles; 5–6,5% vraagt intensiteit 2, 6,5–8% intensiteit 3, 8–10% intensiteit 4, vanaf 10% intensiteit 5 (dessert en oude kaas tellen 1 zwaarder). −6 per stap te licht; −5 bij 7% of meer met pikant 3+.</p>
      <p style="margin:0 0 6px"><b style="color:var(--text)">Body</b>: 15 als body gelijk is aan de intensiteit; −5 per stap te zwaar, −4 per stap te licht.</p>
      <p style="margin:0"><b style="color:var(--text)">Koolzuur</b>: basis 8; bij vet 3+ telt (koolzuur − 2) × 2; +2 bij gefrituurd met veel prik; −4 bij pikant 3+ met veel prik; +3 voor een zacht bier bij een romig dessert.</p></div>

    <button class="btn danger wide" type="button" id="reset">Alles terug naar standaard</button>`;
}
$('#t-score').addEventListener('click', async e => {
  const ins = data.inst;
  const z = e.target.closest('[data-z]');
  if (z) {
    const c = cfg(), k = z.dataset.z;
    ins.zeshoek = Object.assign({}, ins.zeshoek || {}, { [k]: Math.max(-3, Math.min(3, (c.zeshoek[k] || 0) + parseFloat(z.dataset.d))) });
    save(); return renderScoring();
  }
  const ko = e.target.closest('[data-ko]');
  if (ko) { const c = cfg(); ins.ko = Object.assign({}, ins.ko || {}, { [ko.dataset.ko]: !c.ko[ko.dataset.ko] }); save(); return renderScoring(); }
  const ar = e.target.closest('[data-ar]');
  if (ar) return aromaRegels(ar.dataset.ar);
  if (e.target.id === 'reset' && await confirm('Alle instellingen van de scoring terugzetten naar de standaard? Ook bij je partner.', 'Terugzetten', true)) { data.inst = {}; save(); renderScoring(); toast('Standaard staat er weer.'); }
});
$('#t-score').addEventListener('change', e => {
  const ins = data.inst, v = parseInt(e.target.value, 10);
  if (!Number.isFinite(v)) return;
  if (e.target.dataset.max) ins.max = Object.assign({}, cfg().max, ins.max || {}, { [e.target.dataset.max]: Math.max(0, Math.min(100, v)) });
  else if (e.target.dataset.dr) ins.drempel = Object.assign({}, cfg().drempel, ins.drempel || {}, { [e.target.dataset.dr]: Math.max(0, Math.min(100, v)) });
  else return;
  save(); renderScoring();
});

async function aromaRegels(id) {
  const c = cfg(), a = S.AROMA[id];
  const br = new Set(c.bruggen[id] || []), bo = new Set(c.botsingen[id] || []);
  const chips = () => S.KENMERKEN.map(([k, n]) => `<button type="button" class="chip${br.has(k) ? ' on' : bo.has(k) ? ' rood' : ''}" data-k="${k}">${br.has(k) ? '✓ ' : bo.has(k) ? '✗ ' : ''}${esc(n)}</button>`).join('');
  const s = sheet(a.naam, `<div class="muted small">${esc(a.vb)} · ${esc(a.wiel)} op het biersmaakwiel. Tik om te wisselen: ✓ past bij → ✗ botst met → niets.</div><div class="chips" id="ak">${chips()}</div>`,
    [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Opslaan', value: 'ok' }]);
  $('#ak', s.el).addEventListener('click', e => {
    const b = e.target.closest('[data-k]'); if (!b) return;
    const k = b.dataset.k;
    if (br.has(k)) { br.delete(k); bo.add(k); } else if (bo.has(k)) bo.delete(k); else br.add(k);
    $('#ak', s.el).innerHTML = chips();
  });
  if ((await s.done).value !== 'ok') return;
  data.inst.bruggen = Object.assign({}, data.inst.bruggen || {}, { [id]: [...br] });
  data.inst.botsingen = Object.assign({}, data.inst.botsingen || {}, { [id]: [...bo] });
  save(); renderScoring();
}

// ---------------------------------------------------------------- start
koppelDeel();
const start = (location.hash || '').slice(1);
toon(['thuis', 'rest', 'kast', 'score'].includes(start) ? start : (data.kast.length ? 'thuis' : 'kast'));
</script>
</body>
