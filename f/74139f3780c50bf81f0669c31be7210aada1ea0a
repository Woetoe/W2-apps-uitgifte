<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Aftellen</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<link rel="stylesheet" href="../w2ui.css">
<style>
:root{--acc:#ff6b6b;--acc-ink:#2a0b0b}
.ev{display:flex;flex-direction:column;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:14px;border-left:6px solid var(--c)}
.ev .hd{display:flex;gap:12px;align-items:center;cursor:pointer}
.ev .num{min-width:62px;text-align:center}
.ev .num b{display:block;font:800 30px/1 var(--f-display);color:var(--c)}
.ev .num span{font-size:12px;color:var(--muted);font-weight:700;text-transform:uppercase}
.ev .t{flex:1;min-width:0}
.ev .t b{display:block;font:800 18px/1.2 var(--f-display)}
.ev .t span{color:var(--muted);font-size:14px}
.ev .more{display:none;flex-direction:column;gap:8px}
.ev.open .more{display:flex}
.ev .note{white-space:pre-wrap;color:var(--muted);font-size:15px}
.jr .ico{background:#3d1f2a;font-size:20px}
.emojis,.colors{display:flex;gap:6px;flex-wrap:wrap}
.emojis button{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--bg);font-size:22px;cursor:pointer}
.emojis button.on,.colors button.on{outline:2px solid var(--text);outline-offset:2px}
.colors button{width:34px;height:34px;border-radius:17px;border:0;cursor:pointer}
.addline{display:flex;gap:8px}
.addline .in{min-height:44px}
.addline .btn{min-height:44px;padding:0 14px}
.grid3{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:8px}
</style>
</head>
<body>
<div class="top"><a class="ib" id="back" href="../index.html#tools" aria-label="Terug"></a><h1>Aftellen</h1></div>
<main class="page">
  <div class="seg" id="seg"><button type="button" data-v="events" class="on">Evenementen</button><button type="button" data-v="jarigen">Verjaardagen</button></div>
  <div id="app"></div>
</main>
<button class="fab" id="fab" type="button" aria-label="Toevoegen"></button>
<script src="../w2.js"></script>
<script src="../w2data.js"></script>
<script src="../w2ui.js"></script>
<script>
const { esc, $, $$, icon, sheet, confirm, toast } = UI;
const D = W2D, app = $('#app');
$('#back').innerHTML = icon('back');
$('#fab').innerHTML = icon('plus');
D.recent('aftellen');

const KLEUREN = ['#ff6b6b', '#ffc83d', '#2ec4b6', '#4d8dff', '#a76bdc', '#a7e35a', '#ff8a3d'];
const EMOJI = ['🥋', '🏆', '🎉', '🎂', '🎤', '⚽', '🏃', '🎬', '🍽️', '💍', '🎓', '📅'];
const SOORTEN = {
  judo: { naam: 'Judotoernooi', emoji: '🥋', kleur: '#4d8dff', lijst: ['Inschrijving geregeld', 'Judopak gewassen', 'Band', 'Judopas / licentie', 'Gewicht gecheckt', 'Slippers', 'Tape', 'Eten en drinken', 'Startgeld'] },
  feest: { naam: 'Feestje', emoji: '🎉', kleur: '#ffc83d', lijst: ['Cadeau gekocht', 'Kaartje', 'Vervoer geregeld'] },
  uitje: { naam: 'Uitje', emoji: '📅', kleur: '#2ec4b6', lijst: ['Kaartjes', 'Vervoer', 'Oppas / planten'] },
  leeg: { naam: 'Iets anders', emoji: '📅', kleur: '#ff6b6b', lijst: [] }
};
const MAANDEN = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];

let data = D.get('aftellen', null) || { events: [], jarigen: [] };
data.events = data.events || []; data.jarigen = data.jarigen || [];
let view = location.hash === '#jarigen' ? 'jarigen' : 'events';
let openId = /^#[a-z0-9]{6,}$/.test(location.hash) ? location.hash.slice(1) : null;
const save = () => D.set('aftellen', data);

function setView(v) { view = v; $$('#seg button').forEach(b => b.classList.toggle('on', b.dataset.v === v)); history.replaceState(null, '', v === 'jarigen' ? '#jarigen' : '#'); render(); }
$('#seg').onclick = e => { const b = e.target.closest('[data-v]'); if (b) setView(b.dataset.v); };

function render() { view === 'jarigen' ? renderJarigen() : renderEvents(); }

function renderEvents() {
  const today = D.date.today();
  const up = data.events.filter(e => e.datum >= today).sort((a, b) => a.datum < b.datum ? -1 : 1);
  const past = data.events.filter(e => e.datum < today).sort((a, b) => a.datum > b.datum ? -1 : 1);
  if (!data.events.length) {
    app.innerHTML = `<div class="empty"><b>Nog niets om af te tellen</b>Een judotoernooi, een feest, een concert. Met een lijstje van wat je nog moet regelen.<br><button class="btn" data-act="newev" type="button">${icon('plus')}Toevoegen</button></div>`;
    return;
  }
  const card = ev => {
    const d = D.date.days(ev.datum), done = ev.lijst.filter(x => x.ok).length;
    return `<div class="ev${ev.id === openId ? ' open' : ''}" style="--c:${ev.kleur}" data-ev="${ev.id}">
      <div class="hd" data-toggle="${ev.id}"><div class="num"><b>${d < 0 ? '✓' : d === 0 ? '!' : d}</b><span>${d < 0 ? 'geweest' : d === 0 ? 'vandaag' : d === 1 ? 'dag' : 'dagen'}</span></div>
        <div class="t"><b>${ev.emoji} ${esc(ev.naam)}</b><span>${esc(D.date.nice(ev.datum, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }))}${ev.tijd ? ' · ' + esc(ev.tijd) : ''}${ev.waar ? ' · ' + esc(ev.waar) : ''}</span>
        ${ev.lijst.length ? `<div class="bar" style="margin-top:8px"><i style="width:${Math.round(done / ev.lijst.length * 100)}%;background:${ev.kleur}"></i></div>` : ''}</div></div>
      <div class="more">
        ${ev.notitie ? `<div class="note">${esc(ev.notitie)}</div>` : ''}
        <div>${ev.lijst.map((x, i) => `<div class="check${x.ok ? ' on' : ''}" data-tick="${ev.id}:${i}"><span class="box">${x.ok ? icon('check', 'width="16" height="16" stroke-width="3"') : ''}</span><span class="t">${esc(x.t)}</span><button class="x" data-rm="${ev.id}:${i}" type="button" aria-label="Weghalen">${icon('x', 'width="16" height="16"')}</button></div>`).join('')}</div>
        <div class="addline"><input class="in" data-add="${ev.id}" placeholder="Iets toevoegen" enterkeyhint="done"><button class="btn q" data-addbtn="${ev.id}" type="button" aria-label="Toevoegen">${icon('plus')}</button></div>
        <div class="btns"><button class="btn q" data-edit="${ev.id}" type="button">${icon('edit')}Bewerken</button><button class="btn danger" data-del="${ev.id}" type="button">${icon('trash')}</button></div>
      </div></div>`;
  };
  app.innerHTML = `<div class="list">${up.map(card).join('') || '<p class="muted">Niets meer gepland.</p>'}</div>` +
    (past.length ? `<h2>Geweest</h2><div class="list" style="opacity:.7">${past.slice(0, 10).map(card).join('')}</div>` : '');
}

function renderJarigen() {
  if (!data.jarigen.length) {
    app.innerHTML = `<div class="empty"><b>Nog geen verjaardagen</b>Zet ze erin, dan zie je op het overzicht wie er binnenkort jarig is en hoe oud ze worden.<br><button class="btn" data-act="newjr" type="button">${icon('plus')}Verjaardag toevoegen</button></div>`;
    return;
  }
  const list = data.jarigen.map(j => ({ j, nb: D.date.nextBirthday(j.datum) })).filter(x => x.nb).sort((a, b) => a.nb.date < b.nb.date ? -1 : 1);
  app.innerHTML = `<div class="list">${list.map(({ j, nb }) => {
    const d = D.date.days(nb.date);
    return `<button class="row jr" data-jr="${j.id}" type="button"><span class="ico">${d === 0 ? '🎉' : '🎂'}</span><span class="grow"><b>${esc(j.naam)}</b><span class="sub">${esc(D.date.nice(nb.date, { weekday: 'short', day: 'numeric', month: 'long' }))}${nb.age ? ' · wordt ' + nb.age : ''}</span></span><span class="end">${d === 0 ? '<span class="pill acc">vandaag</span>' : D.date.rel(d)}</span></button>`;
  }).join('')}</div>`;
}

// ---------------------------------------------------------------- evenement
async function evForm(ev) {
  const isNew = !ev;
  let soort = 'judo';
  if (isNew) {
    const r = await sheet('Wat voor iets?', `<div class="list">${Object.entries(SOORTEN).map(([k, s]) => `<button class="row" data-s="${k}" type="button"><span class="ico">${s.emoji}</span><span class="grow"><b>${s.naam}</b><span class="sub">${s.lijst.length ? s.lijst.length + ' dingen om te regelen erbij' : 'Leeg beginnen'}</span></span></button>`).join('')}</div>`, []);
    r.el.addEventListener('click', e => { const b = e.target.closest('[data-s]'); if (b) { soort = b.dataset.s; r.close('ok'); } });
    if ((await r.done).value !== 'ok') return;
    const s = SOORTEN[soort];
    ev = { naam: soort === 'leeg' ? '' : s.naam, emoji: s.emoji, kleur: s.kleur, datum: '', tijd: '', waar: '', notitie: '', lijst: s.lijst.map(t => ({ t, ok: false })) };
  }
  const s = sheet(isNew ? 'Nieuw evenement' : 'Bewerken', `
    <label class="f">Naam<input class="in" name="naam" value="${esc(ev.naam)}" placeholder="Bijv. NK judo Masters"></label>
    <div class="grid2"><label class="f">Datum<input class="in" type="date" name="datum" value="${esc(ev.datum)}"></label><label class="f">Tijd (optioneel)<input class="in" type="time" name="tijd" value="${esc(ev.tijd || '')}"></label></div>
    <label class="f">Waar (optioneel)<input class="in" name="waar" value="${esc(ev.waar || '')}" placeholder="Bijv. Sporthal De Kreek"></label>
    <div class="emojis">${EMOJI.map(e => `<button type="button" data-em="${e}" class="${e === ev.emoji ? 'on' : ''}">${e}</button>`).join('')}</div>
    <div class="colors">${KLEUREN.map(c => `<button type="button" data-kl="${c}" style="background:${c}" class="${c === ev.kleur ? 'on' : ''}" aria-label="Kleur"></button>`).join('')}</div>
    <input type="hidden" name="emoji" value="${ev.emoji}"><input type="hidden" name="kleur" value="${ev.kleur}">
    <label class="f">Notitie (optioneel)<textarea class="in" name="notitie" placeholder="Weegtijden, poule, wie rijdt…">${esc(ev.notitie || '')}</textarea></label>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Bewaren', value: 'ok', check: f => !f.naam.trim() ? 'Geef het een naam.' : !f.datum ? 'Kies een datum.' : '' }], { focus: isNew && !ev.naam });
  s.el.addEventListener('click', e => {
    const em = e.target.closest('[data-em]'), kl = e.target.closest('[data-kl]');
    if (em) { $$('[data-em]', s.el).forEach(x => x.classList.toggle('on', x === em)); $('[name=emoji]', s.el).value = em.dataset.em; }
    if (kl) { $$('[data-kl]', s.el).forEach(x => x.classList.toggle('on', x === kl)); $('[name=kleur]', s.el).value = kl.dataset.kl; }
  });
  const r = await s.done;
  if (r.value !== 'ok') return;
  const f = r.form;
  Object.assign(ev, { naam: f.naam.trim(), datum: f.datum, tijd: f.tijd, waar: f.waar.trim(), emoji: f.emoji, kleur: f.kleur, notitie: f.notitie.trim() });
  if (isNew) { ev.id = D.uid(); data.events.push(ev); openId = ev.id; }
  save(); render();
}

// ---------------------------------------------------------------- verjaardag
async function jrForm(j) {
  const isNew = !j;
  j = j || { naam: '', datum: '' };
  const m = /(\d{4}|-)-(\d\d)-(\d\d)$/.exec(j.datum) || [];
  const r = await sheet(isNew ? 'Verjaardag toevoegen' : j.naam, `
    <label class="f">Naam<input class="in" name="naam" value="${esc(j.naam)}" placeholder="Bijv. Mama"></label>
    <div class="grid3">
      <label class="f">Dag<input class="in" name="dag" type="number" inputmode="numeric" min="1" max="31" value="${m[3] ? +m[3] : ''}"></label>
      <label class="f">Maand<select class="in" name="maand">${MAANDEN.map((n, i) => `<option value="${i + 1}" ${m[2] && +m[2] === i + 1 ? 'selected' : ''}>${n}</option>`).join('')}</select></label>
      <label class="f">Jaar (opt.)<input class="in" name="jaar" type="number" inputmode="numeric" min="1900" max="2100" value="${m[1] && m[1] !== '-' ? m[1] : ''}"></label>
    </div>`,
  (isNew ? [{ label: 'Annuleren', value: null, kind: 'q' }] : [{ label: icon('trash'), value: 'del', kind: 'danger' }]).concat([{ label: 'Bewaren', value: 'ok', check: f => !f.naam.trim() ? 'Vul een naam in.' : !(+f.dag >= 1 && +f.dag <= 31) ? 'Vul een geldige dag in.' : '' }]), { focus: isNew }).done;
  if (r.value === 'del') {
    if (!(await confirm(`Verjaardag van <b>${esc(j.naam)}</b> verwijderen?`, 'Verwijderen', true))) return;
    data.jarigen = data.jarigen.filter(x => x !== j); save(); return render();
  }
  if (r.value !== 'ok') return;
  const f = r.form, pad = n => String(n).padStart(2, '0');
  j.naam = f.naam.trim();
  j.datum = (f.jaar && +f.jaar > 1900 ? f.jaar : '-') + '-' + pad(+f.maand) + '-' + pad(+f.dag);
  if (isNew) { j.id = D.uid(); data.jarigen.push(j); }
  save(); render();
}

// ---------------------------------------------------------------- klikken
app.addEventListener('click', async e => {
  const t = e.target.closest('[data-act],[data-toggle],[data-tick],[data-rm],[data-addbtn],[data-edit],[data-del],[data-jr]');
  if (!t) return;
  const ds = t.dataset;
  const ev = id => data.events.find(x => x.id === id);
  if (ds.act === 'newev') return evForm();
  if (ds.act === 'newjr') return jrForm();
  if (ds.toggle) { openId = openId === ds.toggle ? null : ds.toggle; return render(); }
  if (ds.rm) { const [id, i] = ds.rm.split(':'); ev(id).lijst.splice(+i, 1); save(); return render(); }
  if (ds.tick) { const [id, i] = ds.tick.split(':'); const x = ev(id).lijst[+i]; x.ok = !x.ok; save(); return render(); }
  if (ds.addbtn) return addItem(ds.addbtn);
  if (ds.edit) return evForm(ev(ds.edit));
  if (ds.del) {
    const x = ev(ds.del);
    if (await confirm(`<b>${esc(x.naam)}</b> verwijderen?`, 'Verwijderen', true)) { data.events = data.events.filter(y => y !== x); save(); render(); }
    return;
  }
  if (ds.jr) return jrForm(data.jarigen.find(x => x.id === ds.jr));
});
app.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.dataset.add) addItem(e.target.dataset.add); });
function addItem(id) {
  const inp = $(`[data-add="${id}"]`), v = inp.value.trim();
  if (!v) return;
  data.events.find(x => x.id === id).lijst.push({ t: v, ok: false });
  save(); render();
  const n = $(`[data-add="${id}"]`); n && n.focus();
}
$('#fab').onclick = () => view === 'jarigen' ? jrForm() : evForm();

if (location.hash === '#nieuw') { history.replaceState(null, '', '#'); render(); evForm(); } else setView(view);
</script>
</body>
</html>
