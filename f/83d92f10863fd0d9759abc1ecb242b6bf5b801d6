<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>Woordbord</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<style>
/* Woordbord: alle kleuren komen uit het gekozen thema (themes.js zet de variabelen). */
:root{
  --room:#11241d; --room2:#18302a; --panel:#1f3a33; --line:#2f5047; --text:#f3efe3; --muted:#a9bdb5;
  --board:#0d3b2e; --cell:#e9e2cc; --cellLine:#0d3b2e; --tile:#f6e7c1; --tileInk:#2b1d0e; --tileEdge:#c9a96b;
  --dl:#9fd3e8; --tl:#3c8fc4; --dw:#f2b8b0; --tw:#d9473b; --prInk:#10261f; --accent:#f2b134; --accentInk:#2a1c02;
  --good:#5fd08a; --warn:#ff8a6b;
  --f-display:"Bricolage Grotesque",system-ui,sans-serif; --f-body:"Figtree",system-ui,sans-serif; --f-tile:var(--f-display);
  --cs:22px; color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--room);color:var(--text);font:16px/1.45 var(--f-body);-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;overscroll-behavior:none}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:520px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;gap:14px;
  padding:calc(env(safe-area-inset-top,0px) + 12px) max(14px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 16px) max(14px,env(safe-area-inset-left,0px))}
h1,h2{font-family:var(--f-display);font-weight:800;margin:0;letter-spacing:-.01em;text-wrap:balance}
p{margin:0}
.muted{color:var(--muted)}
.note{font-size:14px;color:var(--muted)}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.back{display:flex;align-items:center;gap:6px;background:none;border:0;color:var(--muted);font-weight:600;padding:10px 4px}
.iconbtn{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--room2);display:grid;place-items:center;flex:none;color:var(--text)}
.iconbtn svg{width:22px;height:22px}
.iconbtn[aria-pressed="true"]{background:var(--accent);color:var(--accentInk);border-color:var(--accent)}
.btn{border:0;border-radius:14px;padding:13px 16px;min-height:50px;font-weight:700;font-size:16px;background:var(--accent);color:var(--accentInk)}
.btn:active{transform:translateY(1px)}
.btn:disabled{opacity:.4}
.btn.quiet{background:var(--panel);color:var(--text);border:1px solid var(--line)}
.btnrow{display:flex;gap:8px}
.btnrow .btn{flex:1;padding:12px 8px}

/* start */
.hero{display:flex;flex-direction:column;gap:10px;padding-top:4px}
.hero h1{font-size:46px;line-height:.95}
.hero .art{display:flex;gap:5px;transform:rotate(-3deg);transform-origin:left center}
.hero .art span{width:34px;height:34px;border-radius:7px;background:var(--tile);color:var(--tileInk);box-shadow:inset 0 -3px 0 var(--tileEdge),0 4px 10px #0005;display:grid;place-items:center;font:800 19px var(--f-tile);position:relative}
.hero .art span i{position:absolute;right:3px;bottom:3px;font:700 9px/1 var(--f-body);font-style:normal;opacity:.8}
.hero .art span:nth-child(2n){transform:translateY(3px)}
.choices{display:flex;flex-direction:column;gap:10px}
.choice{display:flex;align-items:center;gap:14px;text-align:left;background:var(--room2);border:1px solid var(--line);border-radius:16px;padding:14px 16px;min-height:74px;color:var(--text)}
.choice .ic{width:42px;height:42px;border-radius:12px;flex:none;display:grid;place-items:center;background:var(--panel);color:var(--accent)}
.choice .ic svg{width:26px;height:26px}
.choice b{display:block;font-size:17px}
.choice span{color:var(--muted);font-size:14px}
.choice:disabled{opacity:.5}
.resume{display:flex;gap:8px}
.resume .btn{flex:1;min-height:44px;padding:10px;font-size:15px}

/* instellen */
.group{display:flex;flex-direction:column;gap:8px}
.group > .t{font-weight:700}
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;background:var(--room);border:1px solid var(--line);border-radius:12px;padding:4px;gap:4px}
.seg button{border:0;background:none;border-radius:9px;padding:10px 4px;font-weight:600;color:var(--muted);font-size:15px;min-height:42px}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accentInk)}
.seg.sm button{padding:7px 4px;font-size:14px;min-height:36px}
.seat{display:grid;grid-template-columns:52px 1fr;gap:12px;align-items:center;background:var(--room2);border:1px solid var(--line);border-radius:16px;padding:10px 12px}
.seat .avbtn{border:0;background:none;padding:0;width:52px;height:52px;border-radius:15px;position:relative}
.seat .avbtn svg{display:block}
.seat .avbtn .pen{position:absolute;right:-4px;bottom:-4px;width:20px;height:20px;border-radius:50%;background:var(--accent);color:var(--accentInk);display:grid;place-items:center;font-size:11px;font-weight:800}
.seat .who{display:flex;flex-direction:column;gap:6px;min-width:0}
.seat .nm{display:flex;justify-content:space-between;align-items:center;gap:8px}
.seat .nm b{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.themepick{display:flex;align-items:center;gap:12px;background:var(--room2);border:1px solid var(--line);border-radius:16px;padding:10px 12px;text-align:left;color:var(--text)}
.themepick b{display:block}
.themepick span.d{font-size:14px;color:var(--muted)}
.swatch{display:grid;grid-template-columns:repeat(5,1fr);gap:2px;padding:3px;border-radius:8px;width:66px;flex:none}
.swatch i{aspect-ratio:1;border-radius:2px;display:grid;place-items:center;font:800 9px/1 var(--f-body);font-style:normal}
.row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:4px 0}
.row .d{font-size:14px;color:var(--muted)}
.toggle{width:52px;height:30px;border-radius:15px;border:0;background:var(--line);position:relative;flex:none}
.toggle::after{content:"";position:absolute;top:4px;left:4px;width:22px;height:22px;border-radius:50%;background:#fff;transition:transform .15s}
.toggle[aria-pressed="true"]{background:var(--good)}
.toggle[aria-pressed="true"]::after{transform:translateX(22px)}

/* spel */
.bar{display:flex;align-items:center;gap:8px}
.bar .info{flex:1;text-align:center;font-size:14px;color:var(--muted);line-height:1.2}
.bar .info b{color:var(--text);font-variant-numeric:tabular-nums}
.players{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:6px}
.pl{display:flex;align-items:center;gap:7px;background:var(--room2);border:1.5px solid var(--line);border-radius:14px;padding:6px 8px;min-width:0}
.pl.turn{border-color:var(--accent);background:var(--panel)}
.pl svg{flex:none}
.pl .tx{min-width:0;display:flex;flex-direction:column;line-height:1.1}
.pl .nm{font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pl .sc{font:800 20px/1.05 var(--f-display);font-variant-numeric:tabular-nums}
.pl .ck{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.pl .ck.over{color:var(--warn);font-weight:700}
.pl.turn .ck{color:var(--text)}
.boardbox{position:relative;border-radius:10px;overflow:hidden;background:var(--board);padding:3px;box-shadow:0 10px 30px #0006}
.boardbox.zoom{overflow:auto;max-height:min(100vw,520px);-webkit-overflow-scrolling:touch}
#board{display:grid;grid-template-columns:repeat(15,1fr);gap:1.5px;width:100%;touch-action:manipulation}
.boardbox.zoom #board{width:170%}
.cell{aspect-ratio:1;background:var(--cell);border-radius:3px;display:grid;place-items:center;position:relative;overflow:visible}
.cell.dl{background:var(--dl)} .cell.tl{background:var(--tl)} .cell.dw,.cell.st{background:var(--dw)} .cell.tw{background:var(--tw)}
.cell .lb{font:800 calc(var(--cs)*.34)/1 var(--f-body);color:var(--prInk);opacity:.85;letter-spacing:-.02em}
.cell .em{font-size:calc(var(--cs)*.62);line-height:1}
.cell .deco{font-size:calc(var(--cs)*.5);line-height:1;opacity:.28;filter:saturate(.6)}
.cell.hover{outline:2px solid var(--accent);outline-offset:-1px;z-index:2}
.tile{position:absolute;inset:0;border-radius:3px;background:var(--tile);color:var(--tileInk);box-shadow:inset 0 calc(var(--cs)*-.08) 0 var(--tileEdge);
  display:grid;place-items:center;font:800 calc(var(--cs)*.6)/1 var(--f-tile);z-index:1}
.tile i{position:absolute;right:calc(var(--cs)*.06);bottom:calc(var(--cs)*.08);font:700 calc(var(--cs)*.26)/1 var(--f-body);font-style:normal;opacity:.8}
.tile.blank{color:var(--tileInk);opacity:.92;font-style:italic}
.tile.last{box-shadow:inset 0 calc(var(--cs)*-.08) 0 var(--tileEdge),0 0 0 2px var(--accent)}
.tile.new{background:var(--accent);color:var(--accentInk);box-shadow:inset 0 calc(var(--cs)*-.08) 0 #0004;touch-action:none;z-index:3}
.tile.new.bad{background:var(--warn);color:#2a0b02}
.status{text-align:center;font-weight:600;min-height:24px;font-size:15px}
.status.wait{color:var(--muted);font-weight:500}
.status.err{color:var(--warn)}
.status.ok b{font-family:var(--f-tile);letter-spacing:.03em}
.status .pts{display:inline-block;background:var(--good);color:#06240f;border-radius:8px;padding:1px 8px;margin-left:6px;font-weight:800}
.rack{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;padding:8px;background:var(--room2);border:1px solid var(--line);border-radius:16px;min-height:60px}
.rtile,.slot{aspect-ratio:1;border-radius:9px}
.slot{border:1.5px dashed var(--line)}
.rtile{background:var(--tile);color:var(--tileInk);box-shadow:inset 0 -4px 0 var(--tileEdge),0 3px 6px #0004;display:grid;place-items:center;font:800 26px/1 var(--f-tile);position:relative;touch-action:none;transition:transform .12s}
.rtile i{position:absolute;right:5px;bottom:5px;font:700 11px/1 var(--f-body);font-style:normal;opacity:.8}
.rtile.sel{transform:translateY(-7px);box-shadow:inset 0 -4px 0 var(--tileEdge),0 0 0 3px var(--accent),0 8px 14px #0006}
.rtile.drag{opacity:.25}
.rtile.q::before{content:"";width:40%;height:40%;border-radius:50%;border:2px dashed var(--tileEdge)}
.hidden-rack{display:flex;align-items:center;justify-content:center;gap:10px;color:var(--muted);font-size:15px;min-height:60px;background:var(--room2);border:1px solid var(--line);border-radius:16px}
.ctrls{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.ctrls .btn{min-height:46px;padding:8px 4px;font-size:15px}
.ctrls.two{grid-template-columns:1fr 2fr}
#ghost{position:fixed;left:0;top:0;width:56px;height:56px;border-radius:10px;background:var(--tile);color:var(--tileInk);box-shadow:inset 0 -4px 0 var(--tileEdge),0 12px 24px #0008;
  display:grid;place-items:center;font:800 30px/1 var(--f-tile);pointer-events:none;z-index:50}
.netlost{background:#4a1f1a;color:#fff;border-radius:12px;padding:10px 12px;display:flex;align-items:center;gap:10px;font-size:15px}
.netlost span{flex:1}
.netlost button{border:0;background:#fff;color:#2a1a10;border-radius:10px;padding:9px 12px;font-weight:700}

/* doorgeven */
.cover{position:fixed;inset:0;z-index:15;background:var(--room);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;padding:24px}
.cover h2{font-size:34px}
.cover .lastmv{background:var(--room2);border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:15px;color:var(--muted);max-width:340px}
.cover .btn{min-width:260px}

/* vellen */
.scrim{position:fixed;inset:0;background:#05080cb8;z-index:20;display:flex;align-items:flex-end;justify-content:center;padding:16px max(12px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 12px) max(12px,env(safe-area-inset-left,0px))}
.sheet{width:100%;max-width:520px;max-height:100%;overflow:auto;background:var(--room2);border:1px solid var(--line);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:14px;color:var(--text)}
.sheet h2{font-size:26px}
.sheet-head{display:flex;justify-content:space-between;align-items:center;gap:10px}
.sheet-head .btn{min-height:40px;padding:8px 14px}
.list{display:flex;flex-direction:column;gap:8px}
.list .btn{width:100%}
.letters{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.letters button{aspect-ratio:1;border:0;border-radius:9px;background:var(--tile);color:var(--tileInk);box-shadow:inset 0 -3px 0 var(--tileEdge);font:800 20px/1 var(--f-tile)}
.letters button[aria-pressed="true"]{background:var(--accent);color:var(--accentInk);box-shadow:inset 0 -3px 0 #0004}
.prow{display:flex;align-items:center;gap:12px;padding:8px 10px;background:var(--panel);border:1px solid var(--line);border-radius:14px;text-align:left;width:100%;color:var(--text)}
.prow b{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.prow:disabled{opacity:.45}
.prow .ed{border:1px solid var(--line);background:var(--room2);border-radius:10px;padding:6px 10px;font-size:14px;font-weight:600;color:var(--text)}
.editor{display:flex;flex-direction:column;gap:12px}
.editor .big{display:flex;align-items:center;gap:14px}
.ng-input,.inp{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-size:17px;color:var(--text);width:100%;-webkit-user-select:text;user-select:text}
.inp:focus{outline:none;border-color:var(--accent)}
.opts{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 6px;scrollbar-width:none}
.opts::-webkit-scrollbar{display:none}
.opts button{border:2px solid transparent;background:none;border-radius:13px;padding:1px;flex:none}
.opts button[aria-pressed="true"]{border-color:var(--accent)}
.opts button svg{display:block}
.thgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.thc{display:flex;flex-direction:column;gap:8px;align-items:stretch;border:2px solid var(--line);border-radius:16px;padding:8px;text-align:left}
.thc[aria-pressed="true"]{border-color:var(--accent)}
.thc .swatch{width:100%}
.thc .nm{font-weight:700;font-size:14px;display:flex;gap:6px;align-items:center}
.log{display:flex;flex-direction:column;gap:6px}
.lg{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;padding:7px 4px;border-bottom:1px solid var(--line)}
.lg .w{font-size:14px;line-height:1.35}
.lg .w b{font-family:var(--f-tile);letter-spacing:.02em}
.lg .w .who{color:var(--muted);font-size:12px;display:block}
.lg .p{font:800 18px var(--f-display);font-variant-numeric:tabular-nums}
.bingo{display:inline-block;background:var(--accent);color:var(--accentInk);border-radius:6px;padding:0 6px;font-size:12px;font-weight:800;margin-left:4px}
.result{text-align:center;display:flex;flex-direction:column;gap:6px;align-items:center;padding:4px 0}
.result h2{font-size:34px;line-height:1}
.rank{display:flex;flex-direction:column;gap:8px}
.rk{display:grid;grid-template-columns:24px 40px 1fr auto;gap:10px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:8px 12px}
.rk.win{border-color:var(--accent)}
.rk .n{font:800 18px var(--f-display);color:var(--muted)}
.rk .s{font:800 24px var(--f-display);font-variant-numeric:tabular-nums}
.rk .a{font-size:12px;color:var(--muted)}
.statcard{display:grid;grid-template-columns:48px 1fr;gap:12px;background:var(--room2);border:1px solid var(--line);border-radius:16px;padding:12px}
.statcard b{font-size:17px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px 10px;margin-top:6px}
.stats div{display:flex;flex-direction:column;font-size:12px;color:var(--muted)}
.stats div span{font:800 18px var(--f-display);color:var(--text);font-variant-numeric:tabular-nums}
.stats .wide{grid-column:1/-1}
.stats .wide span{font-size:15px;font-family:var(--f-body)}
.h2h{display:flex;align-items:center;gap:8px;background:var(--room2);border:1px solid var(--line);border-radius:14px;padding:8px 12px;font-size:15px}
.h2h .vs{flex:1;text-align:center;font:800 20px var(--f-display);font-variant-numeric:tabular-nums}
.h2h .side{display:flex;align-items:center;gap:6px;min-width:0;max-width:40%}
.h2h .side span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.loading{display:flex;align-items:center;justify-content:center;gap:10px;color:var(--muted);padding:30px 0}
.dot{width:12px;height:12px;border-radius:50%;background:var(--accent);animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{0%,100%{transform:scale(.7);opacity:.5}50%{transform:scale(1.1);opacity:1}}
.ng-field{display:none!important} /* naam komt hier uit je gekozen speler */
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="app"></div>
<div id="ghost" hidden></div>
<script src="../w2.js"></script>
<script src="../netgame.js"></script>
<script src="engine.js"></script>
<script src="themes.js"></script>
<script src="avatar.js"></script>
<script>
(function () {
const T = window.WB_THEMES, AV = window.WB_AVATAR;
const app = document.getElementById('app'), ghost = document.getElementById('ghost');
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const uid = () => Date.now().toString(36) + WB.rnd(1e9).toString(36);
const store = {
  get(k, d) { try { const v = JSON.parse(localStorage.getItem(k) || 'null'); return v == null ? d : v; } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
};
const LEVELS = { easy: 'Makkelijk', normal: 'Normaal', strong: 'Sterk' };
const DICT_LABEL = { nl: 'Nederlands', en: 'Engels', mix: 'NL + EN' };
const MOVE_TIMES = [[60, '1 min'], [120, '2 min'], [180, '3 min'], [300, '5 min']];
const TOTAL_TIMES = [[600, '10 min'], [900, '15 min'], [1500, '25 min'], [3000, '50 min']];

/* ---------------- instellingen en profielen ---------------- */
const baseCfg = () => ({ dict: 'nl', board: 'classic', time: { mode: 'none', move: 120, total: 1500 }, theme: 'klassiek' });
const S = Object.assign({ sound: true, vibrate: true, cfg: null, seatsCpu: null, seatsLocal: null, netCfg: null, netPid: null, theme: 'klassiek' }, store.get('wb-settings', {}));
if (!S.netCfg) S.netCfg = baseCfg();
const saveS = () => store.set('wb-settings', S);

let profiles = store.get('wb-profiles', []);
const saveProfiles = () => store.set('wb-profiles', profiles);
function sharedName() { try { return localStorage.getItem('w2-name') || ''; } catch (e) { return ''; } }
function setSharedName(n) { try { localStorage.setItem('w2-name', n); } catch (e) {} }
if (!profiles.length) { profiles.push({ id: uid(), name: sharedName() || 'Speler 1', av: AV.random() }); saveProfiles(); }
const prof = id => profiles.find(p => p.id === id);
const profByName = n => profiles.find(p => p.name.toLowerCase() === String(n || '').toLowerCase());
function freeProfile(used) {
  let p = profiles.find(x => !used.includes(x.id));
  if (!p) { p = { id: uid(), name: 'Speler ' + (profiles.length + 1), av: AV.random() }; profiles.push(p); saveProfiles(); }
  return p;
}
function netProfile() { let p = prof(S.netPid); if (!p) { p = profiles[0]; S.netPid = p.id; saveS(); } return p; }

/* ---------------- toestand ---------------- */
let G = null, view = 'home';
const ui = { sheet: null, place: [], sel: null, rv: [], rvKey: '', thinking: false, token: 0, cover: false, zoom: false, msg: '', msgBad: false,
  setup: null, kind: 'cpu', who: null, edit: null, themeFor: null, blank: null, swapSel: new Set(), confirm: null, ts: null, lastSeen: {} };
const GKEY = m => 'wb-game-' + m;
const loadGame = m => { const g = store.get(GKEY(m), null); return g && g.gid ? g : null; };
const saveGame = g => store.set(GKEY(g.mode), g);
const inProgress = g => !!(g && !g.over);

const net = window.W2NetGame('woordbord', {
  storageKey: GKEY('net'),
  inProgress,
  startHost(saved, peer) {
    if (inProgress(saved) && saved.players[1] && saved.players[1].name === peer) G = saved;
    else G = newNetGame(peer);
    G.seq++; view = 'game'; resetTurnUi(); render();
    return G;
  },
  onState(s) {
    const prevLen = G && G.gid === s.gid ? G.log.length : -1;
    const wasOver = G && G.gid === s.gid && G.over;
    G = s;
    if (view !== 'game') { view = 'game'; resetTurnUi(); }
    if (G.log.length > prevLen && prevLen >= 0) { ui.place = []; ui.sel = null; ui.msg = ''; const L = G.log[G.log.length - 1]; if (L && L.type === 'play') (L.bingo ? sBingo() : sPlay()); if (isMine(G.turn)) buzz(25); }
