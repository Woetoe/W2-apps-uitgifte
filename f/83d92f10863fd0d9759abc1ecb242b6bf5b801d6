  if (!needDict(G.dict)) return;
  ui.thinking = true; render();
  const gid = G.gid, n = G.log.length, t0 = Date.now();
  think({ dict: G.dict, prem: G.prem, board: G.board, rack: pl.rack, level: pl.level, bag: G.bag.length }, (id, mv) => {
    setTimeout(() => {
      if (!G || G.gid !== gid || G.log.length !== n || view !== 'game') { if (id === ui.token) ui.thinking = false; return; }
      ui.thinking = false;
