    const el = document.querySelector(`[data-clock="${p}"]`); if (!el) continue;
    const ms = clockLeft(p); el.textContent = fmtClock(ms); el.classList.toggle('over', ms < 0);
  }
  if (G.time.mode === 'move' && !ui.cover && isMine(G.turn) && G.players[G.turn].type === 'human' && clockLeft(G.turn) <= 0) {
