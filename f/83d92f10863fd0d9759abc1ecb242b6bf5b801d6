function statKey(pl) {
  if (pl.type === 'cpu') return 'cpu:' + pl.level;
  if (pl.pid && prof(pl.pid)) return pl.pid;
  const p = profByName(pl.name);
  return p ? p.id : 'n:' + String(pl.name).toLowerCase();
