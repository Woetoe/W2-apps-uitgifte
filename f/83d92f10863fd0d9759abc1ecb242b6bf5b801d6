  if (neg) s = Math.floor(Math.abs(ms) / 1000);
  return (neg ? '−' : '') + Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
}
function chargeClock(p) {
  if (G.time.mode === 'total' && isMine(p) && G.players[p].type === 'human') G.clock[p] -= elapsed();
}
setInterval(() => {
  if (!G || view !== 'game' || G.over || G.time.mode === 'none') return;
  touchTimer();
