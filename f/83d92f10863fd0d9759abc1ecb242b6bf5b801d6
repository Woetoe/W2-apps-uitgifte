function removeFromRack(rack, letters) {
  const r = rack.split('');
  for (const ch of letters) { const k = r.indexOf(ch); if (k >= 0) r.splice(k, 1); }
  return r.join('');
}
function applyPlay(p, tiles) {
  const ev = WB.evaluate(ctx(), G.board, tiles);
  if (!ev.ok) return ev;
  chargeClock(p);
  const B = G.board.split(''); tiles.forEach(([i, ch]) => { B[i] = ch; }); G.board = B.join('');
  let rack = removeFromRack(G.players[p].rack, tiles.map(([, ch]) => (ch >= 'A' && ch <= 'Z' ? '?' : ch)));
  const bag = G.bag.split(''); const n = Math.min(WB.RACK - rack.length, bag.length);
  rack += bag.splice(bag.length - n, n).join('');
  G.bag = bag.join(''); G.players[p].rack = rack;
  G.players[p].score += ev.score; G.scoreless = 0; G.last = tiles.map(t => t[0]);
  G.log.push({ p, type: 'play', words: ev.words.map(w => [w.w, w.score]), score: ev.score, bingo: ev.bingo, n: tiles.length });
  ev.bingo ? (sBingo(), buzz([40, 30, 40, 30, 120])) : (sPlay(), buzz(18));
  if (!rack.length && !G.bag.length) endGame('out', p); else nextTurn();
  commit();
