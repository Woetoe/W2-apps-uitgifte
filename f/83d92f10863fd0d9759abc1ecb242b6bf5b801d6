/* ---------------- computer ---------------- */
let worker = null, workerOk = true;
function think(msg, cb) {
  const id = ++ui.token;
  const fallback = () => setTimeout(() => {
    if (!dicts[msg.dict]) return;
    const set = WB.DICTS[msg.dict].set;
    cb(id, WB.choose({ dict: dicts[msg.dict], values: WB.SETS[set].values, prem: msg.prem }, msg.board, msg.rack, msg.level, msg.bag, set));
  }, 40);
  if (workerOk && window.Worker) {
    try {
      worker = worker || new Worker('ai-worker.js');
      worker.onmessage = e => { if (e.data.id !== id) return; if (e.data.error) { workerOk = false; fallback(); } else cb(id, e.data.mv); };
      worker.onerror = () => { workerOk = false; fallback(); };
      worker.postMessage(Object.assign({ id }, msg));
