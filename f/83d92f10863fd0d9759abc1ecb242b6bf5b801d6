function recordStats(g) {
  const st = store.get('wb-stats', { players: {}, h2h: {}, done: [] });
  if (st.done.includes(g.gid)) return;
  st.done.push(g.gid); if (st.done.length > 400) st.done = st.done.slice(-400);
  const keys = g.players.map(statKey);
  g.players.forEach((pl, q) => {
    const k = keys[q];
    const r = st.players[k] = Object.assign({ name: pl.name, av: pl.av, games: 0, wins: 0, draws: 0, total: 0, high: 0, best: null, bingos: 0, moves: 0 }, st.players[k] || {});
    r.name = pl.type === 'cpu' ? 'Computer ' + LEVELS[pl.level].toLowerCase() : pl.name; r.av = pl.av || r.av;
    r.games++;
    const win = g.over.winners.includes(q);
    if (win && g.over.winners.length > 1) r.draws++; else if (win) r.wins++;
    r.total += pl.score; r.high = Math.max(r.high, pl.score);
    for (const L of g.log) if (L.p === q && L.type === 'play') {
      r.moves++; if (L.bingo) r.bingos++;
      if (!r.best || L.score > r.best.s) r.best = { s: L.score, w: L.words.map(w => w[0]).join(', ') };
    }
  });
  for (let a = 0; a < g.players.length; a++) for (let b = a + 1; b < g.players.length; b++) {
    const ka = keys[a], kb = keys[b]; if (ka === kb) continue;
    const key = [ka, kb].sort().join('|');
    const h = st.h2h[key] = st.h2h[key] || { w: {}, d: 0, games: 0 };
    h.games++;
    let wa = g.players[a].score, wb = g.players[b].score;
    if (g.over.reason === 'resign') { wa = a === g.over.by ? -1 : 1; wb = b === g.over.by ? -1 : 1; }
    if (wa === wb) h.d++; else { const w = wa > wb ? ka : kb; h.w[w] = (h.w[w] || 0) + 1; }
  }
  store.set('wb-stats', st);
}

