  chargeClock(p);
  const bag = G.bag.split('');
  const drawn = bag.splice(bag.length - letters.length, letters.length);
  bag.push(...letters.split('')); WB.shuffle(bag);
  G.players[p].rack = removeFromRack(G.players[p].rack, letters.split('')) + drawn.join('');
  G.bag = bag.join(''); G.scoreless++; G.last = [];
