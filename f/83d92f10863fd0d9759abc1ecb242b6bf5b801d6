function boardHTML() {
  const th = T.byId[G.theme] || T.list[0];
  const placed = new Map(ui.place.map(x => [x.i, x]));
  const last = new Set(G.last || []);
  const v = vals();
  const bad = ui.preview && !ui.preview.ok;
  let h = '';
  for (let i = 0; i < WB.SIZE; i++) {
    const b = G.board[i], p = G.prem[i];
    const cls = p === 'd' ? 'dl' : p === 't' ? 'tl' : p === 'D' ? 'dw' : p === 'T' ? 'tw' : p === '*' ? 'st' : '';
    const tp = placed.get(i);
    let inner = '';
    if (b !== '.' || tp) {
      const ch = tp ? tp.ch : b, blank = ch >= 'A' && ch <= 'Z';
      inner = `<span class="tile${tp ? ' new' + (bad ? ' bad' : '') : ''}${!tp && last.has(i) ? ' last' : ''}${blank ? ' blank' : ''}" ${tp ? `data-pi="${i}"` : ''}>${ch.toUpperCase()}${blank ? '' : `<i>${v[ch.charCodeAt(0) - 97]}</i>`}</span>`;
    } else if (p === '*') inner = th.emo[0] ? `<span class="em">${th.emo[0]}</span>` : '<span class="lb">★</span>';
    else if (cls) inner = `<span class="lb">${{ dl: '2L', tl: '3L', dw: '2W', tw: '3W' }[cls]}</span>`;
    else if (th.emo.length && (i * 37 + 11) % 23 === 0) inner = `<span class="deco">${th.emo[(i >> 2) % th.emo.length]}</span>`;
    h += `<div class="cell ${cls}" data-i="${i}">${inner}</div>`;
  }
  return h;
}
