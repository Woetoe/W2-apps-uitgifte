/* ---------------- klok ---------------- */
const turnKey = () => G.gid + ':' + G.log.length;
function timerRunning() { return G && !G.over && !ui.cover && view === 'game'; }
function touchTimer() { if (timerRunning() && (!ui.ts || ui.ts.key !== turnKey())) ui.ts = { key: turnKey(), start: Date.now() }; }
function elapsed() { return ui.ts && G && ui.ts.key === turnKey() ? Date.now() - ui.ts.start : 0; }
function clockLeft(p) {
  if (!G || G.time.mode === 'none') return null;
  const run = p === G.turn && !G.over && G.players[p].type === 'human';
  if (G.time.mode === 'total') return G.clock[p] - (run ? elapsed() : 0);
  return run ? G.time.limit * 1000 - elapsed() : G.time.limit * 1000;
}
function fmtClock(ms) {
