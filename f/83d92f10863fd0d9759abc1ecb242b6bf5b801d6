}
function render() {
  T.apply(themeForView());
  let html = view === 'setup' && ui.setup ? vSetup() : view === 'net' ? vNet() : view === 'stats' ? vStats() : view === 'game' && G ? vGame() : vHome();
  if (view === 'game' && G && ui.cover && !ui.sheet) html += coverHTML();
  if (ui.sheet) {
    const inner = { settings: sheetSettings, menu: sheetMenu, log: sheetLog, blank: sheetBlank, swap: sheetSwap, confirm: sheetConfirm,
      themes: sheetThemes, who: sheetWho, avatar: sheetAvatar, result: sheetResult }[ui.sheet];
    const needsG = ['menu', 'log', 'blank', 'swap', 'result'].includes(ui.sheet);
    if (inner && (!needsG || G)) html += `<div class="scrim" data-a="scrim"><div class="sheet" data-stop>${inner()}</div></div>`;
  }
  // scrollstand bewaren (ingezoomd bord, lange lijsten)
  const bb = document.getElementById('boardbox'), sx = bb ? bb.scrollLeft : 0, sy = bb ? bb.scrollTop : 0;
  const sh = document.querySelector('.sheet'), shy = sh ? sh.scrollTop : 0, sheetWas = ui.lastSheet;
  const focusId = document.activeElement && document.activeElement.id, caret = focusId ? document.activeElement.selectionStart : null;
  app.innerHTML = html;
  const bb2 = document.getElementById('boardbox');
  if (bb2) { const w = bb2.clientWidth - 6; bb2.style.setProperty('--cs', ((ui.zoom ? w * 1.7 : w) / 15) + 'px'); bb2.scrollLeft = sx; bb2.scrollTop = sy; }
  const sh2 = document.querySelector('.sheet'); if (sh2 && sheetWas === ui.sheet) sh2.scrollTop = shy;
  ui.lastSheet = ui.sheet;
  if (focusId) { const el = document.getElementById(focusId); if (el && el.tagName === 'INPUT') { el.focus(); try { el.setSelectionRange(caret, caret); } catch (e) {} } }
}
window.addEventListener('resize', () => { const bb = document.getElementById('boardbox'); if (bb) { const w = bb.clientWidth - 6; bb.style.setProperty('--cs', ((ui.zoom ? w * 1.7 : w) / 15) + 'px'); } });

/* ---------------- leggen ---------------- */
function placeTile(r, i, ch) {
  if (!canAct() || G.board[i] !== '.' || ui.place.some(x => x.i === i)) return;
  if (r === null || r === undefined || r >= ui.rv.length || ui.place.some(x => x.r === r)) return;
  ch = ch || ui.rv[r];
  if (ch === '?') { ui.blank = { r, i }; ui.sheet = 'blank'; render(); return; }
  ui.place.push({ i, r, ch }); ui.sel = null; ui.msg = '';
  sTick(); buzz(8); render();
}
function moveTile(from, to) {
  const t = ui.place.find(x => x.i === from); if (!t) return;
  if (G.board[to] !== '.' || ui.place.some(x => x.i === to)) { render(); return; }
  t.i = to; sTick(); render();
}
function returnTile(i) { ui.place = ui.place.filter(x => x.i !== i); render(); }
function doPlay() {
  if (!canAct() || !ui.place.length) return;
  const tiles = ui.place.map(x => [x.i, x.ch]);
  const ev = WB.evaluate(ctx(), G.board, tiles);
  if (!ev.ok) { ui.msg = esc(ev.err); ui.msgBad = true; sErr(); buzz([30, 40, 30]); render(); return; }
  // de letters uit de rekweergave halen, zodat de volgorde van de rest blijft
  const usedR = new Set(ui.place.map(x => x.r));
  ui.rv = ui.rv.filter((_, r) => !usedR.has(r));
  ui.place = []; ui.sel = null; ui.msg = '';
  applyPlay(G.turn, tiles);
}

/* ---------------- slepen ---------------- */
let drag = null;
function dropTarget(x, y) { const el = document.elementFromPoint(x, y); return el ? (el.closest('.cell') || el.closest('.rack')) : null; }
function clearHover() { document.querySelectorAll('.cell.hover').forEach(c => c.classList.remove('hover')); }
app.addEventListener('pointerdown', e => {
  const rt = e.target.closest('.rtile'), pt = e.target.closest('.tile.new');
  if ((!rt && !pt) || !canAct()) return;
  const r = rt ? +rt.dataset.r : null, pi = pt ? +pt.dataset.pi : null;
  const ch = rt ? ui.rv[r] : ui.place.find(q => q.i === pi).ch;
  drag = { r, pi, ch, x: e.clientX, y: e.clientY, moved: false, id: e.pointerId, src: rt || pt };
});
window.addEventListener('pointermove', e => {
  if (!drag || e.pointerId !== drag.id) return;
  if (!drag.moved) {
    if (Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 8) return;
    drag.moved = true; ghost.hidden = false;
    ghost.textContent = drag.ch === '?' ? '' : drag.ch.toUpperCase();
    if (drag.src) drag.src.classList.add('drag');
  }
  ghost.style.transform = `translate(${e.clientX - 28}px,${e.clientY - 70}px)`;
  clearHover();
  const t = dropTarget(e.clientX, e.clientY - 42);
  if (t && t.classList.contains('cell')) t.classList.add('hover');
});
function endDrag(e, cancel) {
  if (!drag || e.pointerId !== drag.id) return;
  const d = drag; drag = null; ghost.hidden = true; clearHover();
  if (cancel) { render(); return; }
  if (!d.moved) {
    if (d.r !== null) { ui.sel = ui.sel === d.r ? null : d.r; render(); }
    else if (d.pi !== null) returnTile(d.pi);
    return;
  }
  const t = dropTarget(e.clientX, e.clientY - 42);
  if (t && t.dataset.i !== undefined) { const i = +t.dataset.i; if (d.r !== null) placeTile(d.r, i); else moveTile(d.pi, i); }
  else if (t && t.classList.contains('rack') && d.pi !== null) returnTile(d.pi);
  else render();
}
window.addEventListener('pointerup', e => endDrag(e, false));
window.addEventListener('pointercancel', e => endDrag(e, true));

/* ---------------- klikken ---------------- */
function startSetup(kind) {
  ui.kind = kind;
  const cfg = S.cfg ? JSON.parse(JSON.stringify(S.cfg)) : baseCfg();
  let seats = kind === 'cpu' ? S.seatsCpu : S.seatsLocal;
  if (!seats || !seats.length) {
    const a = profiles[0].id;
    seats = kind === 'cpu' ? [{ type: 'human', pid: a }, { type: 'cpu', level: 'normal' }] : [{ type: 'human', pid: a }, { type: 'human', pid: freeProfile([a]).id }];
  }
  seats = seats.map(s => (s.type === 'human' && !prof(s.pid) ? { type: 'human', pid: freeProfile(seats.map(x => x.pid)).id } : s));
  ui.setup = { cfg, seats: JSON.parse(JSON.stringify(seats)) };
  view = 'setup'; ui.sheet = null;
}
function setSeats(n) {
  const s = ui.setup.seats;
  while (s.length > n) s.pop();
  while (s.length < n) {
    if (ui.kind === 'cpu') s.push({ type: 'cpu', level: (s.find(x => x.type === 'cpu') || { level: 'normal' }).level });
    else s.push({ type: 'human', pid: freeProfile(s.filter(x => x.type === 'human').map(x => x.pid)).id });
  }
}
function startGame() {
  const s = ui.setup;
  if (!s.seats.some(x => x.type === 'human')) { s.seats[0] = { type: 'human', pid: profiles[0].id }; }
  S.cfg = JSON.parse(JSON.stringify(s.cfg)); S.theme = s.cfg.theme;
  if (ui.kind === 'cpu') S.seatsCpu = s.seats; else S.seatsLocal = s.seats;
  saveS();
  G = newGame('local', s.cfg, seatPlayers(s.seats));
  view = 'game'; resetTurnUi(); ui.sheet = null;
  needDict(G.dict);
  commit();
}
function rematch() {
  const cfg = gameCfg(G);
  const players = G.players.map(p => ({ type: p.type, level: p.level, name: p.name, av: p.av, pid: p.pid }));
  if (G.mode === 'net') { const keep = G.players; G = newGame('net', cfg, players); G.players.forEach((p, q) => { p.name = keep[q].name; p.av = keep[q].av; }); }
  else G = newGame('local', cfg, players);
  ui.sheet = null; resetTurnUi(); commit();
}
function cfgSet(c, k, v) {
  if (k === 'dict' || k === 'board') c[k] = v;
  else if (k === 'tmode') c.time.mode = v;
  else if (k === 'tmove') c.time.move = +v;
  else if (k === 'ttotal') c.time.total = +v;
  if (view === 'net') saveS();
}

app.addEventListener('click', e => {
  const el = e.target.closest('[data-a],[data-i]');
  if (!el) return;
  if (el.dataset.i !== undefined && !el.dataset.a) {
    if (e.target.closest('.tile.new')) return;
    if (ui.sel !== null && canAct()) placeTile(ui.sel, +el.dataset.i);
    return;
  }
  if (net.handleClick(el)) return;
  const a = el.dataset.a, v = el.dataset.v, k = el.dataset.k;
  if (a === 'scrim') {
    if (e.target.closest('[data-stop]')) return;
    if (ui.sheet === 'avatar' || ui.sheet === 'blank') return;
    ui.sheet = null; render(); return;
  }
  switch (a) {
    case 'exit': location.href = '../index.html'; return;
    case 'home': view = 'home'; ui.sheet = null; ui.token++; ui.thinking = false; ui.place = []; net.stopSearching(); break;
    case 'setup': startSetup(k); break;
    case 'netview': view = 'net'; net.error = ''; if (net.status === 'lost') net.status = 'idle'; setSharedName(netProfile().name);
      if (net.status === 'connected') { const s = loadGame('net'); if (inProgress(s)) { G = s; view = 'game'; resetTurnUi(); } } break;
    case 'stats': view = 'stats'; break;
    case 'resume': G = loadGame(el.dataset.m); if (!G) break; view = 'game'; resetTurnUi(); if (G.over) ui.sheet = 'result'; render(); schedule(); return;
    case 'abandon': ui.confirm = { title: 'Lopend spel stoppen?', text: 'Het spel telt dan niet mee in de statistieken.', yes: 'doabandon', ok: 'Stoppen' }; ui.sheet = 'confirm'; break;
    case 'doabandon': try { localStorage.removeItem(GKEY('local')); } catch (err) {} ui.sheet = null; break;
    case 'settings': ui.sheet = 'settings'; break;
    case 'menu': ui.sheet = 'menu'; break;
    case 'close': ui.sheet = null; ui.blank = null; ui.edit = null; break;
    case 'tog': S[k] = !S[k]; saveS(); if (k === 'sound' && S.sound) sPlay(); if (k === 'vibrate') buzz(30); break;
    case 'seats': setSeats(+v); break;
    case 'seattype': { const st = ui.setup.seats[+k]; if (v === st.type) break;
      if (v === 'cpu') ui.setup.seats[+k] = { type: 'cpu', level: 'normal' };
      else ui.setup.seats[+k] = { type: 'human', pid: freeProfile(ui.setup.seats.filter(x => x.type === 'human').map(x => x.pid)).id };
      break; }
    case 'seatlevel': ui.setup.seats[+k].level = v; break;
    case 'cfg': cfgSet(view === 'net' ? S.netCfg : ui.setup.cfg, k, v); break;
    case 'themes': ui.themeFor = el.dataset.for || (view === 'net' ? 'net' : view === 'game' ? 'game' : 'setup'); ui.sheet = 'themes'; break;
    case 'settheme':
      if (ui.themeFor === 'game') { G.theme = v; if (G.mode === 'net') commit(); else saveGame(G); }
      else if (ui.themeFor === 'net') { S.netCfg.theme = v; saveS(); }
      else if (ui.themeFor === 'home') { S.theme = v; saveS(); }
      else ui.setup.cfg.theme = v;
      break;
    case 'who': ui.who = { k: k === 'net' ? 'net' : +k }; ui.sheet = 'who'; break;
    case 'pickwho': {
      if (ui.who.k === 'net') { S.netPid = v; saveS(); setSharedName(prof(v).name); }
      else ui.setup.seats[ui.who.k].pid = v;
      ui.sheet = null; break; }
    case 'editwho': { const p = prof(v); ui.edit = { id: p.id, name: p.name, av: AV.fix(p.av), back: 'who' }; ui.sheet = 'avatar'; break; }
    case 'newwho': ui.edit = { id: null, name: '', av: AV.random(), back: 'who' }; ui.sheet = 'avatar'; break;
    case 'avopt': ui.edit.av[k] = v; if (k === 'eyes' && v === 'robot') ui.edit.av.skin = '#d6d6de'; break;
    case 'avrandom': ui.edit.av = AV.random(); break;
    case 'savewho': {
      const nm = (ui.edit.name || '').trim().slice(0, 18) || 'Speler ' + (profiles.length + 1);
      let p;
      if (ui.edit.id) { p = prof(ui.edit.id); p.name = nm; p.av = ui.edit.av; }
      else { p = { id: uid(), name: nm, av: ui.edit.av }; profiles.push(p); }
      saveProfiles();
      if (ui.who && ui.who.k === 'net') { if (!ui.edit.id) S.netPid = p.id; if (S.netPid === p.id) setSharedName(p.name); saveS(); }
      else if (ui.who && ui.setup && !ui.edit.id) ui.setup.seats[ui.who.k].pid = p.id;
      ui.edit = null; ui.sheet = 'who'; break; }
    case 'delwho': {
      const id = ui.edit.id; profiles = profiles.filter(p => p.id !== id); saveProfiles();
      if (ui.setup) ui.setup.seats.forEach(s => { if (s.type === 'human' && s.pid === id) s.pid = freeProfile(ui.setup.seats.filter(x => x.type === 'human').map(x => x.pid)).id; });
      if (S.netPid === id) { S.netPid = profiles[0].id; saveS(); }
      ui.edit = null; ui.sheet = 'who'; break; }
    case 'start': startGame(); return;
    case 'reveal': ui.cover = false; ui.ts = null; touchTimer(); buzz(15); break;
    case 'zoom': ui.zoom = !ui.zoom; break;
    case 'shuffle': ui.place = []; ui.sel = null; WB.shuffle(ui.rv); sTick(); break;
    case 'sort': ui.place = []; ui.sel = null; ui.rv.sort((x, y) => (x === '?') - (y === '?') || x.localeCompare(y)); sTick(); break;
    case 'recall': ui.place = []; ui.sel = null; break;
    case 'play': doPlay(); return;
    case 'blank': { const b = ui.blank; ui.sheet = null; ui.blank = null; if (b) { placeTile(b.r, b.i, v.toUpperCase()); return; } break; }
    case 'swap': if (!canAct()) break; ui.place = []; ui.swapSel = new Set(); ui.sheet = 'swap'; break;
    case 'swapsel': { const r = +v; ui.swapSel.has(r) ? ui.swapSel.delete(r) : ui.swapSel.add(r); break; }
    case 'swapall': ui.swapSel = new Set(ui.rv.map((_, r) => r)); break;
    case 'doswap': { const letters = [...ui.swapSel].map(r => ui.rv[r]).join(''); ui.sheet = null; ui.rv = ui.rv.filter((_, r) => !ui.swapSel.has(r)); if (isMine(G.turn)) applySwap(G.turn, letters); return; }
    case 'pass': ui.confirm = { title: 'Beurt overslaan?', text: 'Je legt niets en krijgt geen punten.', yes: 'dopass', ok: 'Passen' }; ui.sheet = 'confirm'; break;
    case 'dopass': ui.sheet = null; if (canAct() || isMine(G.turn)) { ui.place = []; applyPass(G.turn); } return;
    case 'log': ui.sheet = 'log'; break;
    case 'showresult': ui.sheet = 'result'; break;
    case 'again': rematch(); return;
    case 'askstop': ui.confirm = { title: 'Spel beëindigen?', text: 'Iedereen krijgt de waarde van de eigen letters in het rek van de score af. De uitslag telt mee.', yes: 'dostop', ok: 'Beëindigen' }; ui.sheet = 'confirm'; break;
    case 'dostop': ui.sheet = null; ui.token++; ui.thinking = false; endGame('stop', -1); commit(); return;
    case 'askresign': ui.confirm = { title: 'Opgeven?', text: 'De ander wint dit spel.', yes: 'doresign', ok: 'Opgeven' }; ui.sheet = 'confirm'; break;
    case 'doresign': ui.sheet = null; endGame('resign', me()); commit(); return;
    case 'askclear': ui.confirm = { title: 'Statistieken wissen?', text: 'Alle uitslagen en records op deze telefoon worden gewist. Spelers en avatars blijven.', yes: 'doclear', ok: 'Wissen' }; ui.sheet = 'confirm'; break;
    case 'doclear': try { localStorage.removeItem('wb-stats'); } catch (err) {} ui.sheet = null; break;
    case 'reconnect': view = 'net'; net.reconnect(); break;
    case 'leave': ui.sheet = null; net.stop(); view = 'home'; break;
  }
  render();
});
app.addEventListener('input', e => {
  if (net.handleInput(e)) return;
  if (e.target.dataset.in === 'name' && ui.edit) ui.edit.name = e.target.value;
});

window.__w2back = function () {
  if (ui.sheet) { ui.sheet = null; ui.blank = null; ui.edit = null; render(); return true; }
  if (view !== 'home') { view = 'home'; ui.token++; ui.thinking = false; ui.place = []; net.stopSearching(); render(); return true; }
  return false;
};

// al verbonden vanuit een ander spel en er loopt een spel? Dan meteen naar het bord
if (net.status === 'connected') { const s = loadGame('net'); if (inProgress(s)) { G = s; view = 'game'; resetTurnUi(); } }
render();
})();
</script>
