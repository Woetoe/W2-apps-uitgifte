  if (reason === 'out') {
    let sum = 0;
    for (let q = 0; q < n; q++) if (q !== by) { const v = rackValue(q); adj[q].rack -= v; sum += v; }
    adj[by].rack += sum;
  } else if (reason !== 'resign') for (let q = 0; q < n; q++) adj[q].rack -= rackValue(q);
