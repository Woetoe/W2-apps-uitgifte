  } else html = `Ronde ${G.round || 1}`;
  if (row.dataset.k !== html) { row.innerHTML = html; row.dataset.k = html; }
}

/* ---------- vellen ---------- */
function tog(key, title, desc) { return `<div class="row"><div><b>${title}</b>${desc ? `<div class="d">${desc}</div>` : ''}</div><button class="toggle" data-a="tog" data-k="${key}" aria-pressed="${!!S[key]}" aria-label="${title}"></button></div>`; }
function sheetSettings() {
  return `<div class="sheet-head"><h2>Instellingen</h2><button class="btn quiet small" data-a="close">Klaar</button></div>
    ${tog('sound', 'Geluid', 'Ja, met echte nep-scheten')}
    ${tog('vibrate', 'Trillen')}
    <p class="note">Op een laptop: pijltjes en spatie. Tweede speler: W A S D en E.</p>`;
}
function sheetPick() {
  const who = ui.pick;   // index in lobby, of 'me' bij meedoen
  let cur, taken = new Map();
  if (who === 'me') { cur = S.ch; if (net.lobby) net.lobby.players.forEach(p => { if (p.tok !== TOK) taken.set(p.ch, p.kind === 'cpu' ? 'computer' : p.name); }); }
  else { const p = L && L.players[who]; if (!p) return ''; cur = p.ch; L.players.forEach((q, j) => { if (j !== who) taken.set(q.ch, q.kind === 'cpu' ? 'computer' : q.name || 'Speler'); }); }
  return `<div class="sheet-head"><h2>Kies je figuurtje</h2><button class="btn quiet small" data-a="close">Klaar</button></div>
    <div class="chars">${CH.map((c, i) => `<button class="charbtn" data-a="char" data-v="${i}" aria-pressed="${i === cur}"><img src="${A.avatarURL(i)}" alt=""><b>${c.name}</b><small>${c.desc}</small>${taken.has(i) ? `<span class="who">nu: ${esc(taken.get(i))}</span>` : ''}</button>`).join('')}</div>
    <p class="note">Kies je een figuurtje dat al bezet is, dan ruil je.</p>`;
}
function sheetMenu() {
  const host = role === 'host';
  return `<div class="sheet-head"><h2>Menu</h2><button class="btn quiet small" data-a="close">Sluiten</button></div>
    <div class="list">
      ${host && G.phase !== 'over' ? `<button class="btn" data-a="pause">${G.paused ? 'Doorgaan' : 'Pauze'}</button>` : ''}
      <button class="btn quiet" data-a="settings">Instellingen</button>
      ${host ? `<button class="btn quiet" data-a="tolobby">Stoppen, terug naar spelers</button>` : `<button class="btn quiet" data-a="leave">Spel verlaten</button>`}
    </div>`;
}
function sheetResult() {
  if (!G || G.winner < 0) return '';
  const w = G.winner, host = role === 'host', wp = G.players[w];
  const order = G.players.map((p, i) => ({ p, i, s: G.scores[i] })).sort((a, b) => b.s - a.s);
  const nm = p => esc(p.kind === 'cpu' ? CH[p.ch].name : p.name);
  return `<div class="result"><img src="${A.avatarURL(wp.ch, true)}" alt=""><h2 style="color:${colOf(wp)}">${w === G.me ? 'Je wint!' : `${nm(wp)} wint!`}</h2>
    <div class="rank">${order.map((o, k) => `<div><b>${k + 1}</b><img src="${A.avatarURL(o.p.ch)}" alt=""><span>${nm(o.p)}${o.i === G.me && o.p.name !== 'Jij' ? ' (jij)' : ''}</span><b>${o.s}</b></div>`).join('')}</div></div>
    <div class="list">${host ? `<button class="btn" data-a="again">Nog een spel</button><button class="btn quiet" data-a="tolobby">Terug naar spelers</button>`
      : `<p class="note" style="text-align:center">Wachten tot ${esc(net.hostName || 'de host')} een nieuw spel start…</p><button class="btn quiet" data-a="leave">Spel verlaten</button>`}</div>`;
}
function sheetHTML() {
  if (!ui.sheet) return '';
  const fn = { settings: sheetSettings, menu: sheetMenu, result: sheetResult, pick: sheetPick }[ui.sheet];
  if (!fn || ((ui.sheet === 'menu' || ui.sheet === 'result') && !G)) return '';
  const inner = fn(); if (!inner) return '';
  return `<div class="scrim" data-a="scrim"><div class="sheet" data-stop>${inner}</div></div>`;
}
function renderSheet() {
  const host = document.getElementById('sheethost'); if (!host) return;
  const html = sheetHTML();
  if (host.dataset.k === html) return;
  const sc = host.querySelector('.sheet'), top = sc ? sc.scrollTop : 0;
  host.innerHTML = html; host.dataset.k = html;
  const ns = host.querySelector('.sheet'); if (ns) ns.scrollTop = top;
}
function render() {
  if (view === 'game' && G) { renderSheet(); return; }
  const html = (view === 'host' && L ? vHost() : view === 'join' ? vJoin() : vHome()) + '<div id="sheethost"></div>';
  const act = document.activeElement, focusName = act && act.id === 'nm', pos = focusName ? act.selectionStart : 0;
  const scroller = document.scrollingElement, sy = scroller ? scroller.scrollTop : 0;
  app.innerHTML = html;
  if (scroller) scroller.scrollTop = sy;
  if (focusName) { const el = document.getElementById('nm'); if (el) { el.focus(); try { el.setSelectionRange(pos, pos); } catch (e) {} } }
  if (view === 'home') drawHero();
  renderSheet();
}

/* ================================================================ kliks */
function closeSheet() { ui.sheet = (ui.sheet === 'settings' && G && G.phase === 'over') ? 'result' : null; ui.pick = null; }
app.addEventListener('click', e => {
  const el = e.target.closest('[data-a]');
  if (!el) return;
  const a = el.dataset.a;
  if (a === 'scrim') { if (e.target.closest('[data-stop]')) return; if (ui.sheet === 'result') return; closeSheet(); refresh(); return; }
  switch (a) {
    case 'exit': leaveNet(); location.href = '../index.html'; return;
    case 'home': leaveNet(); view = 'home'; ui.sheet = null; break;
    case 'host': openHost(); break;
    case 'join': openJoin(); break;
    case 'settings': ui.sheet = 'settings'; break;
    case 'menu': ui.sheet = 'menu'; break;
    case 'close': closeSheet(); break;
    case 'tog': S[el.dataset.k] = !S[el.dataset.k]; saveS(); if (el.dataset.k === 'vibrate') buzz(30); if (el.dataset.k === 'sound') sBoom(); break;
    case 'pick': ui.pick = +el.dataset.i; ui.sheet = 'pick'; break;
    case 'pickme': ui.pick = 'me'; ui.sheet = 'pick'; break;
    case 'char': {
      const v = +el.dataset.v;
      if (ui.pick === 'me') { S.ch = v; saveS(); if (role === 'join' && net.status === 'connected') send({ t: 'ch', ch: v }); }
      else if (L && L.players[ui.pick]) { pickChar(ui.pick, v); }
      closeSheet(); break;
    }
    case 'botadd': if (L.players.length < MAXP) { const used = new Set(L.players.map(p => p.ch)); let ch = 0; while (used.has(ch)) ch++; L.players.push({ name: '', kind: 'cpu', level: S.botLevel, ch }); renumberBots(); lobbyChanged(); } return;
    case 'add2': if (L.players.length < MAXP && !L.players.some(p => p.kind === 'local2')) { const used = new Set(L.players.map(p => p.ch)); let ch = used.has(S.ch2) ? 0 : S.ch2; while (used.has(ch)) ch++; const at = L.players.findIndex(p => p.kind === 'cpu'); L.players.splice(at < 0 ? L.players.length : at, 0, { name: S.name2 || 'Speler 2', kind: 'local2', ch }); lobbyChanged(); } return;
    case 'botdel': L.players.splice(+el.dataset.i, 1); renumberBots(); lobbyChanged(); return;
    case 'botlevel': { const p = L.players[+el.dataset.i]; const lv = ['easy', 'normal', 'strong']; p.level = lv[(lv.indexOf(p.level) + 1) % 3]; S.botLevel = p.level; lobbyChanged(); return; }
    case 'rounds': L.rounds = +el.dataset.v; lobbyChanged(); return;
    case 'shrink': L.shrink = +el.dataset.v; lobbyChanged(); return;
    case 'blocks': L.blocks = el.dataset.v; lobbyChanged(); return;
    case 'readvertise': net.err = ''; advertise(); break;
    case 'start': audio(); startGame(); return;
    case 'again': ui.sheet = null; startGame(); return;
    case 'tolobby': stopGameToLobby(); return;
    case 'pause': setPause(!G.paused); ui.sheet = null; break;
    case 'search': search(); break;
    case 'stopsearch': NET.stop(); net.status = 'idle'; break;
    case 'connect': net.status = 'connecting'; net.hostName = net.found.get(el.dataset.id) || ''; NET.connect(el.dataset.id); break;
    case 'leave': leaveNet(); openJoin(); ui.sheet = null; break;
  }
  refresh();
});
// computers heten zoals hun figuurtje
function renumberBots() { if (L) L.players.forEach(p => { if (p.kind === 'cpu') p.name = CH[p.ch] ? CH[p.ch].name : 'Computer'; }); }
app.addEventListener('input', e => {
  if (e.target.dataset.in !== 'name') return;
  const v = e.target.value; setName(v);
  if (role === 'host' && L) { const me = L.players.find(p => p.tok === TOK); if (me) me.name = v.trim() || 'Jij'; clearTimeout(nameT); nameT = setTimeout(() => { lobbyChanged(); }, 400); }
  if (role === 'join' && net.status === 'connected') { clearTimeout(nameT); nameT = setTimeout(() => send({ t: 'name', name: v.trim() || 'Speler' }), 500); }
});
let nameT = 0;
window.__w2back = function () {
  if (ui.sheet && ui.sheet !== 'result') { closeSheet(); refresh(); return true; }
  if (view === 'game') { ui.sheet = 'menu'; refresh(); return true; }
  if (view !== 'home') { leaveNet(); view = 'home'; ui.sheet = null; render(); return true; }
  return false;
};
window.addEventListener('pagehide', () => { if (role) leaveNet(); });
document.addEventListener('visibilitychange', () => { if (document.hidden && role === 'host' && G && G.phase !== 'over' && !G.paused) setPause(true); });
if (document.fonts && document.fonts.load) document.fonts.load('800 24px "Bricolage Grotesque"').then(() => { if (view === 'home') render(); }).catch(() => {});
render();
// voor de browsertest
window.__dampoe = { get G() { return G; }, get sim() { return sim; }, get L() { return L; }, get view() { return view; } };
})();
</script>
