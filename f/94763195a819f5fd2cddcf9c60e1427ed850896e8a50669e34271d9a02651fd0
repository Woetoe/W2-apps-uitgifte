    <p class="note">Jullie spelen samen in hetzelfde level en delen de levens. Valt de verbinding weg, dan speelt de computer even voor je maat.</p>
    <div class="sticky"><button class="btn" data-a="start" ${has2 ? '' : 'disabled'}>${has2 ? `Start level ${L.level}` : 'Wachten op je maat'}</button></div>
  </div>`;
}
function vJoin() {
  const st = net.status;
  let body = '';
  const myAv = charRow({ name: myName() || 'Jij', ch: S.ch }, 'me', true, 'jouw figuurtje · tik om te wisselen');
  if (st === 'idle' || st === 'lost') {
    body = `${nameField()}${myAv}
      ${st === 'lost' ? '<p class="err">De verbinding met je maat is weg.</p>' : ''}
      <button class="btn" data-a="search">Zoeken naar het spel</button>
      <p class="note">Je maat moet in High Pressure op Samen: spel maken hebben getikt.</p>`;
  } else if (st === 'searching') {
    const list = [...net.found.entries()];
    const inet = NET.via && NET.via() === 'inet';
    body = `<div class="status"><span class="pulse"></span><div><b>${inet ? 'Verbinden via internet…' : 'Zoeken in de buurt…'}</b><span class="note">${inet ? 'Vul de spelcode in van je maat.' : 'Houd de telefoons bij elkaar.'}</span></div></div>
      <div class="list">${list.map(([id, nm]) => `<button class="btn" data-a="connect" data-id="${esc(id)}">Meedoen met ${esc(nm)}</button>`).join('')}</div>
      <button class="btn quiet" data-a="stopsearch">Stoppen</button>`;
  } else if (st === 'connecting') {
    body = `<div class="status"><span class="pulse"></span><b>Verbinden met ${esc(net.hostName || 'je maat')}…</b></div>`;
  } else if (st === 'connected') {
    const lb = net.lobby;
    body = `<div class="status"><span class="pulse"></span><div><b>${lb ? `Wachten tot ${esc(lb.host)} start…` : 'Verbonden'}</b><span class="note">${net.busy ? 'Er loopt nog een spel. Je doet mee zodra het volgende begint.' : 'Het level begint vanzelf op jouw telefoon.'}</span></div></div>
      ${nameField()}
      ${lb ? `<div class="field"><div class="label">Spelers</div><div class="players">${lb.players.map(p => p.tok === TOK ? charRow(p, 'me', true, 'Jij · tik om te wisselen') : charRow(p, -1, false, 'Maakt het spel')).join('')}</div></div>
      <div class="field"><div class="label">Beginnen bij</div>${levelPicker(lb.level, false)}</div>` : ''}
      <button class="btn quiet" data-a="leave">Weggaan</button>`;
  }
  return `<div class="wrap">
    <div class="top"><button class="back" data-a="home">${IC.back} High Pressure</button><button class="iconbtn" data-a="settings" aria-label="Instellingen">${IC.gear}</button></div>
    <h1 style="font-size:36px">Meedoen</h1>
    ${net.err ? `<p class="err">${esc(net.err)}</p>` : ''}
    ${st === 'idle' || st === 'lost' || st === 'searching' ? netBadge() : ''}
    ${body}
    <div class="tip">${NET && NET.tip ? NET.tip() : ''}</div>
  </div>`;
}

/* ---------- spelscherm: één keer opbouwen, daarna alleen bijwerken ---------- */
function buildGame() {
  const me = G.me >= 0 ? G.players[G.me] : null;
  app.innerHTML = `<div class="game" style="--me:${colOf(me)}">
    <div class="hud"><button class="iconbtn" data-a="menu" aria-label="Menu">${IC.menu}</button><div class="lives" id="lives"></div><div class="mid" id="mid"></div><div class="score" id="score"></div><button class="iconbtn" data-a="mute" id="mute" aria-label="Muziek aan of uit"></button></div>
    <div class="tbar" id="tbar"><i></i></div>
    <div class="stage" id="stage"><div class="fieldbox" id="fieldbox"><canvas></canvas><div class="banner" id="banner"></div></div></div>
    <div class="stats" id="stats"></div>
    <div class="ctl ${S.swap ? 'swap' : ''}">
      <div class="mv"><button class="mvbtn" data-k="l" aria-label="Naar links">${IC.left}</button><button class="mvbtn" data-k="r" aria-label="Naar rechts">${IC.right}</button></div>
      <button class="shoot" aria-label="Schieten"><img src="${A.leafURL()}" alt=""><span>SCHIET</span></button>
    </div>
  </div><div id="sheethost"></div>`;
  R.attach(document.getElementById('fieldbox'));
  fitKey = ''; fitField(true);
  hold.l = hold.r = hold.kl = hold.kr = 0; ptr.clear(); sentD = 0;
  W2a(true);
  updateHud(); renderSheet();
}
let fitKey = '';
function fitField(force) {
  const st = document.getElementById('stage'); if (!st) return;
  const w = st.clientWidth, h = st.clientHeight, key = w + 'x' + h + ':' + (window.devicePixelRatio || 1);
  if (!force && key === fitKey) return;
  fitKey = key;
  const sc = Math.max(0.3, Math.min(w / W, h / (H + PAD)));
  const fb = document.getElementById('fieldbox'); fb.style.width = Math.floor(W * sc) + 'px'; fb.style.height = Math.floor((H + PAD) * sc) + 'px';
  R.fit(sc);
}
window.addEventListener('resize', () => { if (view === 'game') fitField(); });
function updateHud() {
  if (view !== 'game' || !G) return;
  const bn = document.getElementById('banner'); if (!bn) return;
  const b = G.paused ? { title: 'Pauze', sub: role === 'join' ? 'Je maat heeft het spel op pauze gezet' : 'Tik op ⋯ om door te gaan' } : G.banner;
  const want = b ? `<div style="${b.color ? `border-color:${b.color}` : ''}">${b.img ? `<img src="${b.img}" alt="">` : ''}<h2 style="${b.color ? `color:${b.color}` : ''}">${b.title}</h2>${b.sub ? `<p>${b.sub}</p>` : ''}</div>` : '';
  if (bn.dataset.k !== want) { bn.innerHTML = want; bn.dataset.k = want; }
  const mute = document.getElementById('mute');
  if (mute) { const h = S.music && S.sound ? IC.note : IC.noteoff; if (mute.dataset.k !== h) { mute.innerHTML = h; mute.dataset.k = h; } }
  updateStats();
}
function updateStats() {
  if (!G) return;
  const lives = document.getElementById('lives'), mid = document.getElementById('mid'), score = document.getElementById('score'), tbar = document.getElementById('tbar'), row = document.getElementById('stats');
  if (!lives) return;
  const lv = G.snap ? G.snap.lv : G.lives, leaf = A.leafURL();
  const lh = lv <= 5 ? Array.from({ length: lv }, () => `<img src="${leaf}" alt="">`).join('') || '<b>0</b>' : `<img src="${leaf}" alt=""><b>×${lv}</b>`;
  const lk = 'l' + lv; if (lives.dataset.k !== lk) { lives.innerHTML = lh; lives.dataset.k = lk; lives.setAttribute('aria-label', lv + ' levens'); }
  const L_ = K.levelDef(G.level || 1);
  const mh = `<b>Level ${G.level}</b><small>${K.WORLDS[L_.world].name}${L_.boss ? ' · eindbaas' : ''}</small>`;
  if (mid.dataset.k !== mh) { mid.innerHTML = mh; mid.dataset.k = mh; }
  const sc = G.snap ? G.snap.sc : G.score;
  const sh = `${sc.toLocaleString('nl-NL')}<small>punten</small>`;
  if (score.dataset.k !== sh) { score.innerHTML = sh; score.dataset.k = sh; }
  const tl = G.snap ? G.snap.tl : L_.time, pct = Math.max(0, Math.min(100, tl / L_.time * 100));
  const bar = tbar.firstChild; bar.style.width = pct + '%'; tbar.classList.toggle('hot', tl <= 10);
  let html = '';
  if (R.msg && R.msg.until > performance.now()) html = esc(R.msg.t);
  else if (G.snap && G.me >= 0 && G.snap.p[G.me]) {
    const f = G.snap.p[G.me][1];
    html = `<span class="st ${f & 16 ? '' : 'off'}"><img src="${A.itemURL('dubbel')}" alt="Dubbele plant"></span><span class="st ${f & 32 ? '' : 'off'}"><img src="${A.itemURL('plak')}" alt="Plakplant"></span><span class="st ${f & 4 ? '' : 'off'}"><img src="${A.itemURL('schild')}" alt="Schild"></span><span class="st ${G.snap.fz ? '' : 'off'}"><img src="${A.itemURL('chill')}" alt="Chill">${G.snap.fz ? G.snap.fz : ''}</span><span class="st">${Math.floor(tl / 60)}:${String(tl % 60).padStart(2, '0')}</span>`;
    const mate = G.players.findIndex((p, i) => i !== G.me);
    if (mate >= 0) { const mp = G.players[mate]; html += `<span class="st mate"><img class="av" src="${A.avatarURL(mp.ch)}" alt="">${esc(mp.name)}${mp.away ? ' (pc)' : ''}</span>`; }
  }
  if (row.dataset.k !== html) { row.innerHTML = html; row.dataset.k = html; }
}

/* ---------- vellen ---------- */
function tog(key, title, desc) { return `<div class="row"><div><b>${title}</b>${desc ? `<div class="d">${desc}</div>` : ''}</div><button class="toggle" data-a="tog" data-k="${key}" aria-pressed="${!!S[key]}" aria-label="${title}"></button></div>`; }
function sheetSettings() {
  return `<div class="sheet-head"><h2>Instellingen</h2><button class="btn quiet small" data-a="close">Klaar</button></div>
    ${tog('sound', 'Geluid')}
    ${tog('music', 'Reggae-muziek', 'Eigen deuntje tijdens het spelen')}
    ${tog('vibrate', 'Trillen')}
    ${tog('swap', 'Knoppen omdraaien', 'Schieten links, lopen rechts')}
    <p class="note">Op een laptop: ← → (of A D) om te lopen, spatie of ↑ om te schieten, P voor pauze.</p>`;
}
function sheetPick() {
  const who = ui.pick;
  let cur = S.ch; const taken = new Map();
  if (role === 'host' && L && typeof who === 'number') { cur = L.players[who].ch; L.players.forEach((q, j) => { if (j !== who) taken.set(q.ch, q.name || 'Speler'); }); }
  else if (role === 'join' && net.lobby) net.lobby.players.forEach(p => { if (p.tok !== TOK) taken.set(p.ch, p.name); });
  return `<div class="sheet-head"><h2>Kies je figuurtje</h2><button class="btn quiet small" data-a="close">Klaar</button></div>
    <div class="chars">${CH.map((c, i) => `<button class="charbtn" data-a="char" data-v="${i}" aria-pressed="${i === cur}"><img src="${A.avatarURL(i)}" alt=""><b>${c.name}</b><small>${c.desc}</small>${taken.has(i) ? `<span class="who">nu: ${esc(taken.get(i))}</span>` : ''}</button>`).join('')}</div>
    ${taken.size ? '<p class="note">Kies je het figuurtje van je maat, dan ruilen jullie.</p>' : ''}`;
}
function sheetLevels() {
  return `<div class="sheet-head"><h2>Level kiezen</h2><button class="btn quiet small" data-a="close">Klaar</button></div>${levelGrid(L ? L.level : S.level)}`;
}
function sheetMenu() {
  const lead = role !== 'join';
  return `<div class="sheet-head"><h2>Menu</h2><button class="btn quiet small" data-a="close">Sluiten</button></div>
    <div class="list">
      ${lead && (G.phase === 'play' || G.phase === 'count' || G.paused) ? `<button class="btn" data-a="pause">${G.paused ? 'Doorgaan' : 'Pauze'}</button>` : ''}
      <button class="btn quiet" data-a="settings">Instellingen</button>
      ${role === 'host' ? '<button class="btn quiet" data-a="tolobby">Stoppen, terug naar de lobby</button>' : role === 'solo' ? '<button class="btn quiet" data-a="tosolo">Stoppen, ander level kiezen</button>' : '<button class="btn quiet" data-a="leave">Spel verlaten</button>'}
    </div>`;
}
function sheetResult() {
  if (!G || !G.result) return '';
  const m = G.result, won = m.t === 'won', lead = role !== 'join';
  const me = G.me >= 0 ? G.players[G.me] : G.players[0];
  const lvl = m.level || K.LEVELS_N;
  return `<div class="result"><img src="${A.avatarURL(me.ch, true)}" alt=""><h2 style="color:${won ? 'var(--accent)' : 'var(--warn)'}">${won ? 'Alle 100 levels gehaald!' : 'Game over'}</h2>
    <p class="note">${won ? 'Rookvrij van strand tot ruimte. Respect.' : `Gestrand in level ${lvl}. Je kunt meteen weer verder vanaf dit level.`}</p>
    <div class="nums"><div>Score<b>${(m.score || 0).toLocaleString('nl-NL')}</b></div><div>Level<b>${lvl}</b></div><div>Hoogste ooit<b>${P.hi.toLocaleString('nl-NL')}</b></div></div></div>
    <div class="list">${lead ? `${won ? '' : `<button class="btn" data-a="again">Verder vanaf level ${lvl}</button>`}<button class="btn ${won ? '' : 'quiet'}" data-a="${role === 'host' ? 'tolobby' : 'tosolo'}">${role === 'host' ? 'Terug naar de lobby' : 'Ander level kiezen'}</button>`
      : `<p class="note" style="text-align:center">Wachten tot ${esc(net.hostName || 'je maat')} verder gaat…</p><button class="btn quiet" data-a="leave">Spel verlaten</button>`}</div>`;
}
function sheetHTML() {
  if (!ui.sheet) return '';
  const fn = { settings: sheetSettings, menu: sheetMenu, result: sheetResult, pick: sheetPick, levels: sheetLevels }[ui.sheet];
  if (!fn || ((ui.sheet === 'menu' || ui.sheet === 'result') && !G)) return '';
  const inner = fn(); if (!inner) return '';
  return `<div class="scrim" data-a="scrim"><div class="sheet" data-stop>${inner}</div></div>`;
}
function renderSheet() {
  const host = document.getElementById('sheethost'); if (!host) return;
  const html = sheetHTML();
  if (host.dataset.k === html) return;
  const sc = host.querySelector('.sheet'), top = sc ? sc.scrollTop : 0;
  host.innerHTML = html; host.dataset.k = html;
  const ns = host.querySelector('.sheet'); if (ns) ns.scrollTop = top;
}
function render() {
  if (view === 'game' && G) { renderSheet(); return; }
  const html = (view === 'host' && L ? vHost() : view === 'join' ? vJoin() : view === 'solo' ? vSolo() : vHome()) + '<div id="sheethost"></div>';
  const act = document.activeElement, focusName = act && act.id === 'nm', pos = focusName ? act.selectionStart : 0;
  const scroller = document.scrollingElement, sy = scroller ? scroller.scrollTop : 0;
  app.innerHTML = html;
  if (scroller) scroller.scrollTop = sy;
  if (focusName) { const el = document.getElementById('nm'); if (el) { el.focus(); try { el.setSelectionRange(pos, pos); } catch (e) {} } }
  if (view === 'home') drawHero();
  renderSheet();
}

/* ================================================================ kliks */
function closeSheet() { ui.sheet = (ui.sheet === 'settings' && G && G.result) ? 'result' : null; ui.pick = null; }
app.addEventListener('click', e => {
  const el = e.target.closest('[data-a]');
  if (!el) return;
  const a = el.dataset.a;
  if (a === 'scrim') { if (e.target.closest('[data-stop]')) return; if (ui.sheet === 'result') return; closeSheet(); refresh(); return; }
  switch (a) {
    case 'exit': leaveNet(); location.href = '../index.html'; return;
    case 'home': leaveNet(); view = 'home'; ui.sheet = null; break;
    case 'solo': role = 'solo'; view = 'solo'; ui.world = K.worldOf(S.level); break;
    case 'host': openHost(); break;
    case 'join': openJoin(); break;
    case 'settings': ui.sheet = 'settings'; break;
    case 'menu': ui.sheet = 'menu'; break;
    case 'close': closeSheet(); break;
    case 'tog': S[el.dataset.k] = !S[el.dataset.k]; saveS(); if (el.dataset.k === 'vibrate') buzz(30); if (el.dataset.k === 'sound') poof(3); if (el.dataset.k === 'swap' && view === 'game') { const ct = app.querySelector('.ctl'); if (ct) ct.classList.toggle('swap', S.swap); } musicFor(); break;
    case 'mute': S.music = !(S.music && S.sound); if (S.music) S.sound = true; saveS(); audio(); musicFor(); updateHud(); return;
    case 'pick': ui.pick = el.dataset.i === 'me' ? 'me' : +el.dataset.i; ui.sheet = 'pick'; break;
    case 'char': {
      const v = +el.dataset.v;
      if (role === 'host' && L && typeof ui.pick === 'number') pickChar(ui.pick, v);
      else { S.ch = v; saveS(); if (role === 'join' && net.status === 'connected') send({ t: 'ch', ch: v }); }
      closeSheet(); break;
    }
    case 'levels': ui.world = K.worldOf(L ? L.level : S.level); ui.sheet = 'levels'; break;
    case 'world': ui.world = +el.dataset.v; break;
    case 'lv': { const n = clampLv(+el.dataset.v); if (L && role === 'host') { L.level = n; lobbyChanged(); ui.sheet = null; } else { S.level = n; saveS(); } break; }
    case 'startsolo': audio(); startGame(S.level); return;
    case 'readvertise': net.err = ''; advertise(); break;
    case 'start': audio(); startGame(L.level); return;
    case 'again': { const lvl = G && G.result ? (G.result.level || 1) : 1; ui.sheet = null; startGame(lvl); return; }
    case 'tolobby': stopGame(true); return;
    case 'tosolo': stopGame(false); return;
    case 'pause': setPause(!G.paused); ui.sheet = null; break;
    case 'search': search(); break;
    case 'stopsearch': NET.stop(); net.status = 'idle'; break;
    case 'connect': net.status = 'connecting'; net.hostName = net.found.get(el.dataset.id) || ''; NET.connect(el.dataset.id); break;
    case 'leave': leaveNet(); openJoin(); ui.sheet = null; break;
  }
  refresh();
});
app.addEventListener('input', e => {
  if (e.target.dataset.in !== 'name') return;
  const v = e.target.value; setName(v);
  if (role === 'host' && L) { L.players[0].name = v.trim() || 'Jij'; clearTimeout(nameT); nameT = setTimeout(lobbyChanged, 400); }
  if (role === 'join' && net.status === 'connected') { clearTimeout(nameT); nameT = setTimeout(() => send({ t: 'name', name: v.trim() || 'Speler' }), 500); }
});
let nameT = 0;
window.__w2back = function () {
  if (ui.sheet && ui.sheet !== 'result') { closeSheet(); refresh(); return true; }
  if (view === 'game') { if (role !== 'join' && G && !G.paused && G.phase !== 'over' && G.phase !== 'won') setPause(true); ui.sheet = 'menu'; refresh(); return true; }
  if (view !== 'home') { leaveNet(); view = 'home'; ui.sheet = null; render(); return true; }
  return false;
};
window.addEventListener('pagehide', () => { MUS.stop(); if (role) leaveNet(); });
document.addEventListener('visibilitychange', () => {
  if (document.hidden && (role === 'host' || role === 'solo') && G && (G.phase === 'play' || G.phase === 'count') && !G.paused) setPause(true);
  musicFor();
});
if (document.fonts && document.fonts.load) document.fonts.load('800 24px "Bricolage Grotesque"').then(() => { if (view === 'home') render(); }).catch(() => {});
render();
// voor de browsertest
window.__pressure = { get G() { return G; }, get sim() { return sim; }, get L() { return L; }, get view() { return view; }, get music() { return MUS.on; } };
})();
</script>
</body>
</html>
