<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Weekmenu</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<link rel="stylesheet" href="../w2ui.css">
<style>
:root{--acc:#ffb347;--acc-ink:#2b1500}
.top .ib.r{margin-left:auto}
.wknav{display:flex;align-items:center;gap:8px}
.wknav b{flex:1;text-align:center;font:800 18px var(--f-display)}
.wknav b small{display:block;font:600 13px var(--f-body);color:var(--muted)}
.wat{display:flex;align-items:center;gap:12px;width:100%;border:0;border-radius:18px;padding:14px 16px;background:var(--acc);color:var(--acc-ink);cursor:pointer;text-align:left}
.wat .e{font-size:30px;line-height:1}
.wat b{display:block;font:800 18px var(--f-display)}
.wat span{display:block;font-size:14px;opacity:.85}
.day{display:flex;gap:10px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:10px 8px 10px 12px;min-height:68px;width:100%;color:inherit}
.day.today{border-color:var(--acc)}
.day .hit{display:flex;gap:10px;align-items:center;flex:1;min-width:0;border:0;background:none;color:inherit;text-align:left;cursor:pointer;padding:0}
.day .dt{width:42px;text-align:center;flex:none}
.day .dt b{display:block;font:800 20px/1 var(--f-display)}
.day .dt span{font-size:12px;color:var(--muted);font-weight:700;text-transform:uppercase}
.day.today .dt b{color:var(--acc)}
.day .ph{width:44px;height:44px;border-radius:12px;background:var(--panel2);flex:none;display:grid;place-items:center;font-size:22px;overflow:hidden}
.day .ph img{width:100%;height:100%;object-fit:cover}
.day .grow{flex:1;min-width:0}
.day .grow b{display:block;font-weight:800;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.day .grow span{display:block;color:var(--muted);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.day.empty0 .grow b{color:var(--muted);font-weight:600}
.day .swap{flex:none;width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--muted);display:grid;place-items:center;cursor:pointer}
.day .swap svg{width:18px;height:18px}
.tag{color:var(--acc);font-weight:700;font-style:normal}
.kok{width:10px;height:10px;border-radius:5px;display:inline-block;margin-right:5px;vertical-align:0}
.s5{display:flex;flex-wrap:wrap;gap:6px}
.s5 .pill{cursor:pointer}
.pill.ok{background:#173a2a;color:#7fe0a8}
.rlist{display:flex;flex-direction:column;gap:6px;max-height:40vh;overflow:auto}
.opt{display:flex;gap:10px;align-items:center;border:1px solid var(--line);background:var(--panel);border-radius:14px;padding:10px 12px;text-align:left;cursor:pointer;color:inherit;width:100%}
.rlist .opt{background:var(--bg)}
.opt .e{font-size:22px;flex:none;width:28px;text-align:center}
.opt .grow{flex:1;min-width:0}
.opt b{display:block;font-weight:700}
.opt span.sub{display:block;font-size:13px;color:var(--muted)}
.opt.on{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,var(--bg))}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips.scroll{flex-wrap:nowrap;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
.chip{border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:8px 12px;font-size:14px;cursor:pointer;white-space:nowrap;color:inherit}
.chip.on{background:var(--acc);color:var(--acc-ink);border-color:var(--acc);font-weight:700}
.zoekbalk{position:sticky;top:0;z-index:2;background:var(--bg);padding:4px 0 8px;display:flex;flex-direction:column;gap:8px}
.ing{max-height:46vh;overflow:auto}
.voorstel{display:flex;flex-direction:column;gap:8px}
.voorstel .opt{flex-wrap:wrap}
.why{display:flex;flex-wrap:wrap;gap:4px;width:100%;padding-left:38px}
.why .pill{font-size:12px;padding:2px 8px}
.aitem{display:flex;gap:10px;align-items:center;border-bottom:1px solid var(--line);padding:10px 2px;cursor:pointer}
.aitem .grow{flex:1;min-width:0}
.aitem .p{font-weight:800;color:var(--acc)}
.aitem.niet{opacity:.55}
.kook{display:flex;align-items:center;gap:10px}
.kook .grow{flex:1;min-width:0}
.kook b{display:block}
.inh{color:var(--muted);font-weight:700;font-style:normal;font-size:13px}
[hidden]{display:none!important}
</style>
</head>
<body>
<div class="top"><a class="ib" id="back" href="../index.html#samen" aria-label="Terug"></a><h1>Weekmenu</h1><button class="ib r" id="inst" type="button" aria-label="Instellingen"></button></div>
<main class="page">
  <div class="seg" id="tabs"><button type="button" data-tab="week" class="on">Week</button><button type="button" data-tab="ideeen">Ideeën</button><button type="button" data-tab="aanb">Aanbiedingen</button></div>

  <section id="t-week" class="list">
    <button class="wat" id="wat" type="button"><span class="e">🍽️</span><span><b>Wat eten we?</b><span id="wat-sub">Drie voorstellen voor vanavond</span></span></button>
    <div class="card kook" id="kook" hidden></div>
    <div class="wknav"><button class="ib" id="prev" type="button" aria-label="Vorige week"></button><b id="wk"></b><button class="ib" id="next" type="button" aria-label="Volgende week"></button></div>
    <div class="list" id="days"></div>
    <button class="btn wide q" id="maak" type="button"></button>
    <div class="card" id="s5"></div>
    <button class="btn wide" id="shop" type="button"></button>
    <p class="muted small" id="hint"></p>
  </section>

  <section id="t-ideeen" hidden>
    <div class="zoekbalk">
      <input class="in" id="q" type="search" placeholder="Zoek op gerecht of ingrediënt" autocomplete="off">
      <div class="chips scroll" id="filters"></div>
    </div>
    <div class="muted small" id="q-n"></div>
    <div class="list" id="opties" style="gap:6px"></div>
    <button class="btn wide q" id="meer" type="button" hidden>Meer laten zien</button>
  </section>

  <section id="t-aanb" class="list" hidden>
    <div class="card" id="a-kop"></div>
    <div class="btns" style="margin:0"><button class="btn q" id="a-ververs" type="button"></button><button class="btn q" id="a-zelf" type="button">Zelf invullen</button></div>
    <div id="a-lijst"></div>
    <p class="muted small">De aanbiedingen van de Vomar komen van PrijsProfeet (alle aanbiedingen van de week); lukt dat niet, dan uit de folder op folderz.nl. Prijzen zijn een indicatie: kijk in de winkel. Staat iets er niet bij? Met Zelf invullen zet je het erbij.</p>
  </section>
</main>
<script src="../w2.js"></script>
<script src="../w2data.js"></script>
<script src="../w2ui.js"></script>
<script src="../samen/sync.js"></script>
<script src="../samen/deel.js"></script>
<script src="../samen/boodschappen.js"></script>
<script src="../voorraad/kast.js"></script>
<script src="../recepten/web.js"></script>
<script src="catalogus.js"></script>
<script src="plan.js"></script>
<script>
const { esc, $, $$, icon, sheet, confirm, toast } = UI;
const D = W2D, B = Boodschappen, P = WMPlan;
const recepten = D.idb('w2-recepten'), fotos = D.idb('w2-recepten-foto');
$('#back').innerHTML = icon('back');
$('#prev').innerHTML = icon('back');
$('#inst').innerHTML = icon('gear');
const CHEV = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>';
$('#next').innerHTML = CHEV;
D.recent('weekmenu');

const DAG = ['ma', 'di', 'wo', 'do', 'vr', 'za', 'zo'];
const VRIJ = ['🍕 Pizza', '🍽️ Uit eten', '🥡 Afhalen', '♻️ Restjes', '🥪 Brood', '🍳 Iets snels', '🎉 Bij vrienden'];
const FOLDERZ = 'https://www.folderz.nl/winkels/vomar/folders-aanbiedingen';
let data = Object.assign({ dagen: {}, porties: 2, aanb: null, smaak: {}, inst: {} }, D.get('weekmenu', null) || {});
data.smaak = data.smaak || {}; data.inst = Object.assign({ snel: 45 }, data.inst || {});
let rec = [], offset = 0, pool = [], byId = {}, aanb = [], tab = 'week';
const save = () => { D.set('weekmenu', data); if (deel) deel.push(); publish(); };

const pad = n => String(n).padStart(2, '0');
const iso = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const today = () => D.date.today();
function weekDays(off) {
  const t = D.date.parse(today()), dow = (t.getDay() + 6) % 7;
  return [...Array(7)].map((_, i) => iso(new Date(t.getFullYear(), t.getMonth(), t.getDate() - dow + i + off * 7)));
}
function weekNr(s) {
  const d = D.date.parse(s), t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const day = t.getUTCDay() || 7; t.setUTCDate(t.getUTCDate() + 4 - day);
  const y = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  return Math.ceil(((t - y) / 864e5 + 1) / 7);
}
const leden = () => window.Samen && Samen.cfg ? Object.entries(Samen.data.leden || {}).map(([id, m]) => ({ id, ...m })) : [];
const recOf = id => rec.find(r => r.id === id);
const soortEmoji = o => o && o.soort ? (P.SOORT[o.soort[0]] || {}).emoji || '🍽️' : '🍽️';
const soortNaam = o => o && o.soort ? o.soort.map(s => (P.SOORT[s] || {}).naam).filter(Boolean).join(' + ') : '';

// ---------------------------------------------------------------- opties: receptenlijst + eigen recepten
function bouwPool() {
  const perBron = {};
  rec.forEach(r => { if (r.bron) perBron[r.bron.replace(/[?#].*$/, '').replace(/\/$/, '')] = r; });
  const cat = WMCatalogus.lijst.map(c => {
    const r = perBron[c.url.replace(/\/$/, '')];
    return P.optie(Object.assign({}, c, r ? { rid: r.id, fav: !!r.fav, heeftFoto: !!r.heeftFoto } : {}));
  });
  const gekoppeld = new Set(cat.filter(c => c.rid).map(c => c.rid));
  const eigen = rec.filter(r => !gekoppeld.has(r.id)).map(r => P.optie({
    id: 'r-' + r.id, rid: r.id, titel: r.titel, ingr: r.ingr || [], tijd: r.tijd || null, bron: 'eigen', bronNaam: r.boek || 'Eigen recepten',
    url: r.bron || '', eigen: true, fav: !!r.fav, heeftFoto: !!r.heeftFoto, sv5: false
  }));
  pool = eigen.concat(cat);
  byId = Object.fromEntries(pool.map(o => [o.id, o]));
  aanb = P.aanbiedingen(data.aanb && aanbGeldig() ? data.aanb.items : []);
}
function aanbGeldig() { const a = data.aanb; return !!(a && a.items && a.items.length && (!a.tot || D.date.days(a.tot) >= 0)); }

/** De optie bij een dag uit het menu (of een losse optie voor vrije tekst). */
function optVan(m) {
  if (!m) return null;
  if (m.opt && byId[m.opt]) return byId[m.opt];
  if (m.recept) { const o = pool.find(x => x.rid === m.recept); if (o) return o; }
  const t = String(m.tekst || m.titel || '');
  if (!t) return null;
  if (VRIJ.includes(t)) return { id: null, titel: t.replace(/^\S{1,2}\s/, ''), vrij: true, emoji: t.split(' ')[0] };
  const ts = P.termen(t);
  return { id: null, titel: t, vrij: true, termen: ts, soort: ts.length ? P.soortVan(ts) : null, basis: '' };
}
const weekOpts = days => days.map(d => { const o = optVan(data.dagen[d]); return o && o.soort ? o : null; });
const gebruikt = () => new Set(Object.entries(data.dagen).filter(([d]) => Math.abs(D.date.days(d)) <= 21).map(([, m]) => { const o = optVan(m); return o && o.id; }).filter(Boolean));

function zet(d, o, extra) {
  const oud = data.dagen[d];
  data.dagen[d] = Object.assign({ datum: d, opt: o.id, recept: o.rid || '', titel: o.titel, tekst: '', porties: (oud && oud.porties) || data.porties, kok: (oud && oud.kok) || '' }, extra || {});
}

// ---------------------------------------------------------------- delen via Samen
let deel = null;
function koppelDeel() {
  if (deel || !window.W2Deel) return;
  deel = W2Deel.koppel({
    kind: 'weekmenu',
    lees: async () => {
      const out = Object.fromEntries(Object.entries(data.dagen).filter(([d]) => D.date.days(d) >= -21));
      if (data.aanb) out.aanbiedingen = data.aanb;
      if (Object.keys(data.smaak).length) out.smaak = data.smaak;
      out.instellingen = data.inst;
      return out;
    },
    schrijf: async map => {
      const m = JSON.parse(JSON.stringify(map));
      data.aanb = m.aanbiedingen || data.aanb; delete m.aanbiedingen;
      data.smaak = m.smaak || {}; delete m.smaak;
      if (m.instellingen) data.inst = Object.assign({ snel: 45 }, m.instellingen); delete m.instellingen;
      data.dagen = m;
      D.set('weekmenu', data); bouwPool(); render();
    }
  });
  W2Deel.badge();
}

// ---------------------------------------------------------------- tekenen: week
function sub(m, o) {
  const ls = leden(), kok = m && m.kok ? ls.find(l => l.id === m.kok) : null;
  const hits = o && o.termen ? P.inAanbieding(o, aanb).hits : [];
  const delen = [o && o.soort && !o.vrij ? soortNaam(o) : '', o && o.tijd ? o.tijd + ' min' : '', o && o.bronNaam ? o.bronNaam : '', kok ? kok.naam + ' kookt' : '', m && m.porties && m.porties !== data.porties ? m.porties + ' pers.' : ''].filter(Boolean);
  return `${kok ? `<i class="kok" style="background:${esc(kok.kleur || 'var(--acc)')}"></i>` : ''}${hits.length ? '<em class="tag">🏷️ </em>' : ''}${esc(delen.join(' · '))}`;
}
async function render() {
  const days = weekDays(offset), t = today();
  $('#wk').innerHTML = `Week ${weekNr(days[0])}<small>${esc(D.date.nice(days[0], { day: 'numeric', month: 'short' }))} – ${esc(D.date.nice(days[6], { day: 'numeric', month: 'short' }))}${offset === 0 ? ' · deze week' : offset === 1 ? ' · volgende week' : ''}</small>`;
  $('#days').innerHTML = days.map((d, i) => {
    const m = data.dagen[d], o = optVan(m);
    const foto = o && o.rid && o.heeftFoto;
    return `<div class="day${d === t ? ' today' : ''}${m ? '' : ' empty0'}"><button class="hit" data-d="${d}" type="button"><div class="dt"><span>${DAG[i]}</span><b>${D.date.parse(d).getDate()}</b></div>
      <div class="ph">${foto ? `<img data-foto="${esc(o.rid)}" alt="">` : m ? esc(o && o.vrij && o.emoji ? o.emoji : soortEmoji(o)) : '+'}</div>
      <div class="grow"><b>${m && o ? esc(o.titel) : 'Nog niets gepland'}</b>${m ? `<span>${sub(m, o)}</span>` : ''}</div></button>
      ${D.date.days(d) >= 0 ? `<button class="swap" data-swap="${d}" type="button" aria-label="Ander voorstel">${icon('refresh')}</button>` : ''}</div>`;
  }).join('');
  const leeg = days.filter(d => !data.dagen[d] && D.date.days(d) >= 0).length;
  const bijnaOm = days.filter(d => D.date.days(d) >= 0).length <= 2;   // za/zo: dan de volgende week plannen
  $('#maak').innerHTML = `✨ ${bijnaOm ? 'Weekplan voor volgende week maken' : leeg ? `Weekplan maken (${leeg} ${leeg === 1 ? 'dag' : 'dagen'} leeg)` : 'Weekplan opnieuw maken'}`;
  $('#maak').dataset.volgende = bijnaOm ? '1' : '';
  $('#maak').hidden = days.every(d => D.date.days(d) < 0);
  // Schijf van Vijf
  const b = P.balans(weekOpts(days));
  $('#s5').innerHTML = `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><b>Schijf van Vijf · week ${weekNr(days[0])}</b><span class="muted small">${b.aantal} van 7 gepland</span></div>
    <div class="s5">${b.regels.map(r => `<span class="pill ${r.ok ? 'ok' : 'warn'}" data-regel="${r.k}">${r.emoji} ${esc(r.tekst)} ${r.ok ? '✓' : '!'}</span>`).join('')}</div>
    ${b.aantal ? `<div class="muted small" style="margin-top:8px">${b.sv5} van ${b.aantal} recepten passen volgens de bron in de Schijf van Vijf. Tik op een vakje voor uitleg.</div>` : ''}`;
  const n = days.filter(d => { const o = optVan(data.dagen[d]); return o && (o.rid || o.url); }).length;
  $('#shop').innerHTML = `${icon('plus')}Boodschappen voor ${n ? n + ' recept' + (n === 1 ? '' : 'en') : 'deze week'}`;
  $('#shop').disabled = !n;
  $('#hint').textContent = !(window.Samen && Samen.cfg) ? 'Koppel Samen om het weekmenu met je partner te delen en de boodschappen op jullie gedeelde lijst te zetten.' : '';
  renderKook();
  const vm = optVan(data.dagen[t]);
  $('#wat-sub').textContent = vm ? 'Vanavond: ' + vm.titel : 'Drie voorstellen voor vanavond';
  for (const img of $$('img[data-foto]')) { const v = await fotos.get(img.dataset.foto); if (v) img.src = v; }
}

// ---------------------------------------------------------------- context voor voorstellen
/** De voorraadkast voor de voorstellen: wat in huis is (en wat bijna over de datum gaat) telt mee. */
const kastCtx = () => window.Voorraad ? Voorraad.voorWeekmenu(Voorraad.items, today(), P.termen) : [];
function ctxVoor(d) {
  const days = weekDays(Math.floor(Math.round((D.date.parse(d) - D.date.parse(weekDays(0)[0])) / 864e5) / 7));
  const i = days.indexOf(d);
  const week = weekOpts(days); week[i] = null;
  return { week, i, gebruikt: gebruikt(), aanb, kast: kastCtx(), smaak: data.smaak, doordeweeks: i < 5, snel: data.inst.snel || 0, rng: null };
}
const kiesbaar = () => pool.filter(o => data.smaak[o.id] !== -1);

// ---------------------------------------------------------------- Wat eten we?
async function watEtenWe(d) {
  d = d || today();
  const m = data.dagen[d], huidig = optVan(m);
  let n = 0;
  const lijst = () => P.voorstellen(kiesbaar().filter(o => !huidig || o.id !== huidig.id), Object.assign(ctxVoor(d), { rng: P.rngVan(Date.now() + n * 7919) }), 3);
  let vs = lijst();
  const kaart = x => `<button class="opt" type="button" data-kies="${esc(x.o.id)}"><span class="e">${soortEmoji(x.o)}</span><span class="grow"><b>${esc(x.o.titel)}</b><span class="sub">${esc([soortNaam(x.o), x.o.tijd ? x.o.tijd + ' min' : '', x.o.bronNaam].filter(Boolean).join(' · '))}</span></span>
      <span class="why">${x.waarom.slice(0, 3).map(w => `<span class="pill acc">${esc(w)}</span>`).join('')}</span></button>`;
  const titel = d === today() ? 'Wat eten we vanavond?' : 'Wat eten we op ' + D.date.nice(d, { weekday: 'long' }) + '?';
  const s = sheet(titel, `
    ${huidig ? `<div class="card acc"><div class="muted small">Op het menu</div><b style="font-size:17px">${esc(huidig.titel)}</b>
      <div class="btns" style="margin-top:8px">${huidig.id ? `<button class="btn q" type="button" data-x="recept">${icon('open')}Recept</button>` : ''}</div></div>
      <div class="muted small">Of liever iets anders:</div>` : '<div class="muted small">Gekozen op afwisseling, de Schijf van Vijf en wat er in de aanbieding is:</div>'}
    <div class="voorstel" id="vs">${vs.map(kaart).join('')}</div>
    <button class="btn wide q" type="button" data-x="ander">${icon('refresh')}Andere voorstellen</button>
    <button class="btn wide q" type="button" data-x="zoek">${icon('search')}Zelf zoeken in alle recepten</button>`,
  [{ label: 'Sluiten', value: null, kind: 'q' }]);
  s.el.addEventListener('click', e => {
    const k = e.target.closest('[data-kies]'), x = e.target.closest('[data-x]');
    if (k) s.close('kies:' + k.dataset.kies);
    if (x && x.dataset.x === 'ander') { n++; vs = lijst(); $('#vs', s.el).innerHTML = vs.map(kaart).join(''); }
    if (x && x.dataset.x === 'zoek') s.close('zoek');
    if (x && x.dataset.x === 'recept') s.close('recept');
  });
  const r = await s.done;
  if (!r.value) return;
  if (r.value === 'zoek') { naarTab('ideeen'); $('#q').focus(); return; }
  if (r.value === 'recept') return openRecept(huidig);
  const o = byId[r.value.slice(5)];
  if (!o) return;
  zet(d, o); save(); render();
  toast(`${o.titel} staat op ${d === today() ? 'vanavond' : D.date.nice(d, { weekday: 'long' })}`, 3000);
}

// ---------------------------------------------------------------- ander voorstel (🔄)
const wissels = {};
function wissel(d) {
  const m = data.dagen[d], huidig = optVan(m);
  const ctx = Object.assign(ctxVoor(d), { rng: P.rngVan(1 + (wissels[d] || 0)) });
  const vs = P.voorstellen(kiesbaar().filter(o => !huidig || o.id !== huidig.id), ctx, 6);
  if (!vs.length) return toast('Geen ander voorstel gevonden');
  const x = vs[(wissels[d] = (wissels[d] || 0) + 1) % vs.length];
  zet(d, x.o, { auto: true }); save(); render();
  toast(`${DAG[(D.date.parse(d).getDay() + 6) % 7]}: ${x.o.titel}`, 2500);
}

// ---------------------------------------------------------------- weekplan maken
async function weekplan() {
  const days = weekDays(offset);
  const open = days.map((d, i) => ({ d, i })).filter(x => D.date.days(x.d) >= 0);
  const autoN = open.filter(x => data.dagen[x.d] && data.dagen[x.d].auto).length;
  const aan = new Set(open.filter(x => !data.dagen[x.d]).map(x => x.i));
  const s = sheet('Weekplan maken', `
