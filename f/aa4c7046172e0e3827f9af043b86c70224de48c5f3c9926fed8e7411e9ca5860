async function openRecept(o) {
  if (!o) return;
  if (o.rid && recOf(o.rid)) { location.href = '../recepten/index.html#' + o.rid; return; }
  if (!o.url) return toast('Bij dit gerecht hoort geen recept');
  const kan = W2.page.available();
  const r = await sheet(o.titel, `<div class="muted">Recept van ${esc(o.bronNaam || WebRecept.host(o.url))}.${kan ? ' Ophalen zet het in Recepten (ook offline te lezen, met kookmodus), en dan kunnen de ingrediënten met hoeveelheden op de boodschappenlijst.' : ''}</div>`,
    [{ label: 'Website', value: 'web', kind: 'q' }].concat(kan ? [{ label: 'Ophalen', value: 'get' }] : [])).done;
  if (r.value === 'web') { if (!W2.openLink(o.url)) toast('Openen lukte niet'); return; }
  if (r.value !== 'get') return;
  toast('Recept ophalen…', 45000);
  const rid = await ophalen(o);
  toast('');
  if (rid) location.href = '../recepten/index.html#' + rid;
}

/** Recept van de website halen en bewaren in Recepten. Geeft het id, of null (met melding als stil uit staat). */
async function ophalen(o, stil) {
  if (!W2.page.available()) { if (!stil) toast(W2.inApp ? 'Hiervoor is de nieuwe app-versie nodig: Instellingen › Updates.' : 'Recepten ophalen kan alleen in de app op je telefoon.', 5000); return null; }
  const res = await W2.page.get(o.url);
  if (!res.status || res.status >= 400 || res.body == null) { if (!stil) toast('Ophalen lukte niet: ' + (res.fout || 'fout ' + res.status), 4000); return null; }
  let r;
  try { r = WebRecept.parse(res.body, res.url || o.url); } catch (e) { if (!stil) toast(e.message, 5000); return null; }
  delete r.fotoUrl;
  const id = D.uid();
  const out = Object.assign({}, r, { id, titel: r.titel && r.titel !== 'Recept' ? r.titel : o.titel, boek: o.bronNaam || 'Van internet', bron: o.url, fav: data.smaak[o.id] === 1, added: Date.now(), heeftFoto: false });
  if (!out.personen && o.bron === 'vc') out.personen = 2;
  await recepten.put(id, out);
  rec = (await recepten.all()) || [];
  Object.values(data.dagen).forEach(m => { if (m.opt === o.id) m.recept = id; });
  bouwPool();
  D.set('weekmenu', data); if (deel) deel.push();
  return id;
}

