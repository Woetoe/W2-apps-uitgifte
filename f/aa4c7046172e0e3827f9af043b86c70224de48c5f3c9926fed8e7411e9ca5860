let haalBezig = false;
const PP = 'https://www.prijsprofeet.nl/api/v1/products/promotional/all?retailer=vomar&page_size=100&page=';

/** Bron 1: PrijsProfeet (alle Vomar-aanbiedingen van de week, ± 180, met actie en van-prijs). */
async function viaPrijsProfeet() {
  const paginas = [];
  for (let pg = 1; pg <= 4; pg++) {
    const r = await W2.page.get(PP + pg);
    if (!r.status || r.status >= 400) throw new Error('PrijsProfeet: ' + P.watKwamTerug(r));
    let j;
    try { j = JSON.parse(r.body); } catch (e) { throw new Error('PrijsProfeet: geen gegevens (' + P.watKwamTerug(r) + ')'); }
    paginas.push(j);
    if (!j.products || !j.products.length || pg * 100 >= (+j.total || 0)) break;
  }
  const u = P.prijsProfeet(paginas, today());
  if (!u.items.length) throw new Error('PrijsProfeet: geen Vomar-aanbiedingen voor vandaag');
  return { bron: 'prijsprofeet', week: u.tot ? weekNr(u.tot) : u.van ? weekNr(u.van) : null, van: u.van, tot: u.tot, items: u.items };
}

/** Bron 2: de folder op folderz.nl (alleen de grote producten per pagina). */
async function viaFolderz() {
  const lijst = await W2.page.get(FOLDERZ);
  if (!lijst.status || lijst.status >= 400) throw new Error('folderz.nl: ' + P.watKwamTerug(lijst));
  const links = P.folderLinks(lijst.body).slice(0, 3);
  const folders = [];
  // Soms staan de producten al op de winkelpagina zelf.
  const eigen = P.folder(lijst.body, new Date().getFullYear());
  if (eigen.items.length) folders.push(eigen);
  for (const u of links) {
    const p = await W2.page.get(u);
    if (!p.status || p.status >= 400) continue;
    const f = P.folder(p.body, new Date().getFullYear());
    if (f.tot && D.date.days(f.tot) < 0) continue;      // verlopen folder
    if (f.items.length) folders.push(f);
  }
  if (!folders.length) throw new Error('folderz.nl: geen folder gevonden (' + P.watKwamTerug(lijst) + (links.length ? ', ' + links.length + ' links' : '') + ')');
  // Wat nu geldt eerst; de folder van volgende week alleen als er niets anders is.
  const nu = folders.filter(f => !f.van || D.date.days(f.van) <= 0);
  const gebruik = nu.length ? nu : folders;
  const kop = gebruik.find(f => f.week) || gebruik[0];
  const alle = [], seen = new Set();
  gebruik.forEach(f => f.items.forEach(it => { const k = P.N(it.n); if (!seen.has(k)) { seen.add(k); alle.push(it); } }));
  return { bron: 'folderz', week: kop.week, van: kop.van, tot: kop.tot, items: alle };
}

async function haalAanb(stil) {
  if (haalBezig) return;
  if (!W2.page.available()) { if (!stil) W2.openLink('https://www.vomar.nl/aanbiedingen'); return; }
  haalBezig = true;
  const fouten = [];
  try {
    if (!stil) toast('Vomar-aanbiedingen ophalen…', 60000);
    let a = null;
    for (const bron of [viaPrijsProfeet, viaFolderz]) {
      try { a = await bron(); break; } catch (e) { fouten.push(e.message || String(e)); }
    }
    if (!a) throw new Error('geen bron');
    data.aanb = Object.assign(a, { at: Date.now() });
    D.set('weekmenu-aanb-fout', '');
    save(); bouwPool(); render(); drawAanb(); drawIdeeen();
    if (!stil) toast(`${aanb.filter(x => x.eten).length} aanbiedingen om mee te koken ✓`, 3000);
  } catch (e) {
    D.set('weekmenu-aanb-fout', fouten.join(' · '));
    if (!stil) {
      toast('');
      const r = await sheet('Ophalen lukte niet', `<div class="muted">De aanbiedingen van de Vomar konden niet worden opgehaald. Je kunt de folder openen en ze zelf invullen.</div>
        <div class="card"><div class="muted small">Wat er terugkwam (stuur dit gerust door):</div><div class="small" style="word-break:break-word">${fouten.map(esc).join('<br>')}</div></div>`,
        [{ label: 'Kopiëren', value: 'kopie', kind: 'q' }, { label: 'Folder openen', value: 'web', kind: 'q' }, { label: 'Zelf invullen', value: 'zelf' }]).done;
      if (r.value === 'kopie') { try { await navigator.clipboard.writeText('Weekmenu aanbiedingen: ' + fouten.join(' | ')); toast('Gekopieerd'); } catch (x) { toast('Kopiëren lukte niet'); } }
      if (r.value === 'web') W2.openLink('https://www.vomar.nl/aanbiedingen');
      if (r.value === 'zelf') zelfAanb();
    }
  } finally { haalBezig = false; D.set('weekmenu-aanb-poging', Date.now()); }
}

async function zelfAanb() {
  const huidig = data.aanb && data.aanb.items ? data.aanb.items.map(i => i.n + (i.p ? ' ' + i.p.toFixed(2).replace('.', ',') : '')).join('\n') : '';
  const r = await sheet('Aanbiedingen invullen', `
    <div class="muted small">Eén product per regel, prijs mag erachter. Bv. "Rundergehakt 7,99" of "Spruitjes". Plakken uit de Vomar-app kan ook.</div>
    <textarea class="in" name="t" rows="9" placeholder="Rundergehakt 7,99&#10;Hollandse spruiten 0,99&#10;Zalmfilet">${esc(huidig)}</textarea>
    <label class="f">Geldig t/m<input class="in" type="date" name="tot" value="${esc((data.aanb && data.aanb.tot) || weekDays(0)[5])}"></label>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Bewaren', value: 'ok' }]).done;
  if (r.value !== 'ok') return;
  const items = P.eigenLijst(r.form.t);
  data.aanb = items.length ? { bron: 'zelf', week: null, van: today(), tot: r.form.tot || '', items, at: Date.now() } : null;
  save(); bouwPool(); render(); drawAanb(); drawIdeeen();
}

// ---------------------------------------------------------------- boodschappen voor de week
async function boodschappen() {
  const days = weekDays(offset).filter(d => D.date.days(d) >= 0 || offset > 0);
  let opts = days.map(d => ({ d, m: data.dagen[d], o: optVan(data.dagen[d]) })).filter(x => x.o && (x.o.rid || x.o.url));
  if (!opts.length) return toast('Er staan deze week (vanaf vandaag) geen recepten op het menu.');
  const S = window.Samen;
  if (!S || !S.cfg) {
    const r = await sheet('Boodschappenlijst', `<div class="muted">De boodschappenlijst staat in <b style="color:var(--text)">Samen</b>. Zet Samen eerst aan (ook als je hem alleen voor jezelf gebruikt).</div>`, [{ label: 'Sluiten', value: null, kind: 'q' }, { label: 'Naar Samen', value: 'go' }]).done;
    if (r.value === 'go') location.href = '../samen/index.html';
    return;
  }
  const lists = B.lists();
  if (!lists.length) return toast('Er is nog geen boodschappenlijst in Samen. Maak er daar een.');
  // Recepten die nog niet in Recepten staan eerst ophalen (dan komen de hoeveelheden mee).
  const nodig = opts.filter(x => !(x.o.rid && recOf(x.o.rid)));
  const mislukt = [];
  if (nodig.length && W2.page.available()) {
    for (let i = 0; i < nodig.length; i++) {
      toast(`Recept ${i + 1} van ${nodig.length} ophalen: ${nodig[i].o.titel}`, 45000);
      const rid = await ophalen(nodig[i].o, true);
      if (!rid) mislukt.push(nodig[i].o);
    }
    toast('');
    opts = days.map(d => ({ d, m: data.dagen[d], o: optVan(data.dagen[d]) })).filter(x => x.o && (x.o.rid || x.o.url));
  } else nodig.forEach(x => mislukt.push(x.o));
  const ruw = [];
  opts.forEach(({ m, o }) => {
    const r = o.rid && recOf(o.rid);
    if (r) { const f = r.personen && m.porties ? m.porties / r.personen : 1; (r.ingr || []).forEach(x => { const t = B.fromRecipe(B.scaleText(x, f)); if (t) ruw.push(t); }); }
    else (o.ingr || []).forEach(x => ruw.push(x));   // alleen de hoofdingrediënten (zonder hoeveelheid)
  });
  const lines = B.combine(ruw).map((t, i) => ({ i, t, a: aanb.length ? P.inAanbieding({ termen: P.termen(t) }, aanb).hits[0] : null, h: window.Voorraad ? Voorraad.zoek(B.parseQty(t).tekst, { zonderBier: true }) : null }));
  // Wat al in de voorraadkast staat, staat uit (aanzetten kan altijd).
  const pick = new Set(lines.filter(x => !B.isStaple(x.t) && !x.h).map(x => x.i));
  const nHuis = lines.filter(x => x.h).length;
  const sh = sheet('Boodschappen voor het weekmenu', `
    <div class="muted small">${opts.map(x => esc(x.o.titel)).join(' · ')}</div>
    ${mislukt.length ? `<div class="notice">Van ${mislukt.map(o => esc(o.titel)).join(', ')} staan alleen de hoofdingrediënten erbij, zonder hoeveelheden${W2.page.available() ? ' (het recept ophalen lukte niet)' : ' (recepten ophalen kan in de app)'}.</div>` : ''}
    ${lists.length > 1 ? `<label class="f">Lijst<select class="in" name="lijst">${lists.map(l => `<option value="${esc(l.id)}">${esc((l.emoji || '') + ' ' + l.naam)}</option>`).join('')}</select></label>` : ''}
    <div class="card ing">${lines.map(x => `<div class="check pick${pick.has(x.i) ? ' on' : ''}" data-pi="${x.i}"><span class="box">${pick.has(x.i) ? icon('check', 'width="16" height="16" stroke-width="3"') : ''}</span><span class="t">${esc(x.t)}${x.a ? ` <span class="tag">🏷️${x.a.p ? ' €' + x.a.p.toFixed(2).replace('.', ',') : ''}</span>` : ''}${x.h ? ` <em class="inh">🏠 ${esc(x.h.naam)}${x.h.aantal > 1 ? ' ×' + x.h.aantal : ''}</em>` : ''}</span></div>`).join('')}</div>
    <div class="muted small">Zelfde ingrediënten uit verschillende recepten zijn opgeteld. Zout, peper en olie staan uit. 🏷️ = in de aanbieding bij de Vomar.${nHuis ? ' 🏠 = staat al in de voorraadkast, dus uit.' : ''}</div>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Erop zetten', value: 'ok' }]);
  sh.el.addEventListener('click', e => {
    const c = e.target.closest('[data-pi]'); if (!c) return;
    const i = +c.dataset.pi, on = !pick.has(i);
    on ? pick.add(i) : pick.delete(i);
    c.classList.toggle('on', on);
    c.querySelector('.box').innerHTML = on ? icon('check', 'width="16" height="16" stroke-width="3"') : '';
  });
  const res = await sh.done;
  if (res.value !== 'ok') return;
  const L = lists.find(l => l.id === res.form.lijst) || lists[0];
  try { await S.start(); } catch (e) {}
  const out = B.addLines(L.id, lines.filter(x => pick.has(x.i)).map(x => x.t), 'Weekmenu');
  toast(out.added ? `${out.added} dingen op ${(L.emoji || '') + ' ' + L.naam}${out.dup ? ` (${out.dup} stond${out.dup === 1 ? '' : 'en'} er al op)` : ''}` : 'Alles stond er al op.', 3500);
}

// ---------------------------------------------------------------- voorraadkast: afboeken wat je kookte
/** Ingrediënten van het gerecht van dag d (met hoeveelheden als het recept in Recepten staat). */
function ingrVan(d) {
  const m = data.dagen[d], o = optVan(m);
  if (!o) return [];
  const r = o.rid && recOf(o.rid);
  if (r) return (r.ingr || []).map(x => B.parseQty(B.fromRecipe(x)).tekst).filter(Boolean);
  return (o.ingr || []).slice();
}
function renderKook() {
  const el = $('#kook'), V = window.Voorraad;
  const t = V && V.items.length ? V.teAfboeken(data.dagen, today(), new Date().getHours()) : [];
  el.hidden = !t.length || offset !== 0;
  if (el.hidden) return;
  const d = t[t.length - 1], o = optVan(data.dagen[d]), n = D.date.days(d);
  el.innerHTML = `<span style="font-size:26px">🍳</span><div class="grow"><b>${n === 0 ? 'Vanavond' : n === -1 ? 'Gisteren' : esc(D.date.nice(d, { weekday: 'long' }))}: ${esc(o ? o.titel : 'gekookt')}</b><span class="muted small">Gekookt? Haal uit de voorraadkast wat je gebruikte.</span></div>
    <button class="btn q" type="button" data-afb="${d}" style="flex:none">Afboeken</button>`;
}
$('#kook').addEventListener('click', e => { const b = e.target.closest('[data-afb]'); if (b) afboeken(b.dataset.afb); });

async function afboeken(d) {
  const V = window.Voorraad, m = data.dagen[d], o = optVan(m);
  if (!V || !m || !o) return;
  V.herlaad();
  const voorstel = V.afboekVoorstel(V.items, ingrVan(d).concat([o.titel]));
  const klaar = waarde => { m.afgeboekt = waarde; save(); render(); };
  const titel = `🍳 ${o.titel}`;
  if (!voorstel.length) {
    const r = await sheet(titel, `<div>Er staat niets uit dit recept in de voorraadkast${o.rid && recOf(o.rid) ? '' : ' (van dit recept kent de app alleen de hoofdingrediënten)'}.</div>`,
      [{ label: 'Later', value: null, kind: 'q' }, { label: 'OK, klaar', value: 'ok' }]).done;
    if (r.value === 'ok') klaar(true);
    return;
  }
  const aan = new Set(voorstel.filter(x => x.aan).map(x => x.item.id));
  const tel = Object.fromEntries(voorstel.map(x => [x.item.id, 1]));
  const rij = x => `<div class="check pick${aan.has(x.item.id) ? ' on' : ''}" data-v="${esc(x.item.id)}"><span class="box">${aan.has(x.item.id) ? icon('check', 'width="16" height="16" stroke-width="3"') : ''}</span>
    <span class="t">${esc(x.item.naam)} <span class="muted small">(${x.item.aantal} in huis${x.item.aantal - tel[x.item.id] <= 0 && aan.has(x.item.id) ? ', dan op' : ''})</span></span>
    <span class="n" style="display:flex;align-items:center;gap:6px"><button class="btn q" style="min-height:34px;padding:0 10px" type="button" data-dt="-1">−</button><b>${tel[x.item.id]}</b><button class="btn q" style="min-height:34px;padding:0 10px" type="button" data-dt="1">+</button></span></div>`;
  const s = sheet(titel, `<div class="muted small">Wat ${D.date.days(d) === 0 ? 'vanavond' : D.date.nice(d, { weekday: 'long' })} uit de voorraadkast ging. Aangevinkt gaat eraf (− en + voor hoeveel). Olie, kruiden en sauzen staan uit: die zijn meestal niet in één keer op.</div>
    <div class="card ing" id="afb">${voorstel.map(rij).join('')}</div>`,
  [{ label: 'Niet gekookt', value: 'nee', kind: 'q' }, { label: 'Afboeken', value: 'ok' }]);
  s.el.addEventListener('click', e => {
    const row = e.target.closest('[data-v]'); if (!row) return;
    const id = row.dataset.v, x = voorstel.find(v => v.item.id === id), dt = e.target.closest('[data-dt]');
    if (dt) { tel[id] = Math.max(1, Math.min(x.item.aantal, tel[id] + +dt.dataset.dt)); aan.add(id); }
    else aan.has(id) ? aan.delete(id) : aan.add(id);
    row.outerHTML = rij(x);
  });
  const r = await s.done;
  if (r.value === 'nee') return klaar('nee');
  if (r.value !== 'ok') return;
  const op = [];
  voorstel.filter(x => aan.has(x.item.id)).forEach(x => { const u = V.tel(x.item.id, -tel[x.item.id]); if (u.op) op.push(u.item); });
  klaar(true);
  toast(`${aan.size} ${aan.size === 1 ? 'ding' : 'dingen'} uit de voorraadkast.${op.length ? ' Op: ' + op.map(i => i.naam).join(', ') + '.' : ''}`, 3500);
  if (op.length) opDeLijst(op);
}
/** Wat op is: op de boodschappenlijst (vast in huis en "altijd" meteen, anders vragen; "nooit" niet). */
async function opDeLijst(op) {
  const V = window.Voorraad, stand = V.inst.opLijst || 'vragen', vast = new Set(V.inst.vast || []);
  const lists = B.lists();
  if (!lists.length) return;
  let zet = op.filter(i => i.vast || vast.has(V.N(i.naam)) || stand === 'altijd');
  const vraag = stand === 'vragen' ? op.filter(i => !zet.includes(i)) : [];
  if (vraag.length) {
    const ok = await confirm(`<b>${vraag.map(i => esc(i.naam)).join(', ')}</b> ${vraag.length === 1 ? 'is' : 'zijn'} op. Op de boodschappenlijst zetten?`, 'Op de lijst');
    if (ok) zet = zet.concat(vraag);
  }
  if (!zet.length) return;
  try { await Samen.start(); } catch (e) {}
  const out = B.addLines(lists[0].id, zet.map(i => i.naam), 'Voorraadkast');
  if (out.added) toast(`${zet.map(i => i.naam).join(', ')} op ${lists[0].naam}.`, 3000);
}

// ---------------------------------------------------------------- instellingen
async function instellingen() {
  const r = await sheet('Weekmenu', `
    <label class="f">Standaard aantal personen<input class="in" name="porties" type="number" inputmode="numeric" min="1" value="${data.porties}"></label>
    <label class="f">Doordeweeks hooguit<select class="in" name="snel">${[[0, 'geen grens'], [30, '30 minuten'], [45, '45 minuten'], [60, '1 uur']].map(([v, l]) => `<option value="${v}" ${+data.inst.snel === v ? 'selected' : ''}>${l}</option>`).join('')}</select></label>
    <div class="muted small">${Object.values(data.smaak).filter(v => v === -1).length} recepten op "liever niet" en ${Object.values(data.smaak).filter(v => v === 1).length} op "lekker". Die gelden voor jullie allebei.</div>`,
  [{ label: 'Annuleren', value: null, kind: 'q' }, { label: 'Bewaren', value: 'ok' }]).done;
  if (r.value !== 'ok') return;
  data.porties = Math.max(1, +r.form.porties || 2);
  data.inst.snel = +r.form.snel || 0;
  save(); render();
}

// ---------------------------------------------------------------- doorgeven aan de widget en het overzicht
function publish() {
  W2.publish('weekmenu', weekDays(0).map(d => { const o = optVan(data.dagen[d]); return o ? { datum: d, titel: o.titel } : null; }).filter(Boolean));
  try {
    const rijen = [], t = today();
    rijen.push({ k: 'kop', t: 'Komende dagen' });
    weekDays(0).concat(weekDays(1)).filter(d => D.date.days(d) >= 0).slice(0, 7).forEach(d => {
      const o = optVan(data.dagen[d]), i = (D.date.parse(d).getDay() + 6) % 7;
      rijen.push({ k: 'dag', t: o ? o.titel : 'Nog niets gepland', s: (d === t ? 'Vanavond' : DAG[i] + ' ' + D.date.parse(d).getDate()) + (o && o.soort && !o.vrij ? ' · ' + soortEmoji(o) + ' ' + soortNaam(o) : ''), o: 'dag=' + d, nu: d === t });
    });
    const ctx = Object.assign(ctxVoor(t), { rng: P.rngVan(+t.replace(/-/g, '')) });
    const vs = P.voorstellen(kiesbaar(), ctx, 40);
    const metAanb = vs.filter(x => x.aanb && x.aanb.length).slice(0, 12);
    if (metAanb.length) {
      rijen.push({ k: 'kop', t: '🏷️ Met aanbiedingen' });
      metAanb.forEach(x => rijen.push({ k: 'optie', t: x.o.titel, s: soortEmoji(x.o) + ' ' + x.aanb.slice(0, 2).map(h => h.n).join(', '), o: 'optie=' + x.o.id }));
    }
    rijen.push({ k: 'kop', t: '💡 Ideeën voor vanavond' });
    vs.filter(x => !metAanb.includes(x)).slice(0, 30).forEach(x => rijen.push({ k: 'optie', t: x.o.titel, s: [soortEmoji(x.o) + ' ' + soortNaam(x.o), x.o.tijd ? x.o.tijd + ' min' : '', x.o.bronNaam].filter(Boolean).join(' · '), o: 'optie=' + x.o.id }));
    const vm = optVan(data.dagen[t]);
    W2.publish('weekmenu-opties', { datum: t, vanavond: vm ? vm.titel : '', rijen });
  } catch (e) { console.error('widget', e); }
}

// ---------------------------------------------------------------- tabs en knoppen
function naarTab(k) {
  tab = k;
  $$('#tabs button').forEach(b => b.classList.toggle('on', b.dataset.tab === k));
  $('#t-week').hidden = k !== 'week'; $('#t-ideeen').hidden = k !== 'ideeen'; $('#t-aanb').hidden = k !== 'aanb';
  if (k === 'week') render();
  if (k === 'ideeen') { toon = 60; drawFilters(); drawIdeeen(); }
  if (k === 'aanb') drawAanb();
  window.scrollTo(0, 0);
}
$('#tabs').addEventListener('click', e => { const b = e.target.closest('[data-tab]'); if (b) naarTab(b.dataset.tab); });
$('#days').addEventListener('click', e => {
  const sw = e.target.closest('[data-swap]'); if (sw) return wissel(sw.dataset.swap);
  const b = e.target.closest('[data-d]'); if (b) dagSheet(b.dataset.d);
});
$('#s5').addEventListener('click', e => {
  const p = e.target.closest('[data-regel]'); if (!p) return;
  const r = P.balans(weekOpts(weekDays(offset))).regels.find(x => x.k === p.dataset.regel);
  sheet(r.emoji + ' ' + r.tekst, `<div>${esc(r.uitleg)}</div><div class="muted small">Bron: Schijf van Vijf van het Voedingscentrum (2026), aanbevolen hoeveelheden per week voor volwassenen.</div>`, [{ label: 'OK', value: null }]);
});
$('#prev').onclick = () => { offset--; render(); };
$('#next').onclick = () => { offset++; render(); };
$('#shop').onclick = boodschappen;
$('#maak').onclick = () => { if ($('#maak').dataset.volgende) { offset++; render(); } weekplan(); };
$('#wat').onclick = () => watEtenWe();
$('#inst').onclick = instellingen;
$('#q').addEventListener('input', () => { toon = 60; drawIdeeen(); });
$('#filters').addEventListener('click', e => {
  if (e.target.closest('[data-prod]')) { product = null; drawFilters(); return drawIdeeen(); }
  const c = e.target.closest('[data-f]'); if (!c) return;
  filt.has(c.dataset.f) ? filt.delete(c.dataset.f) : filt.add(c.dataset.f);
  toon = 60; drawFilters(); drawIdeeen();
});
$('#opties').addEventListener('click', e => { const b = e.target.closest('[data-o]'); if (b) optieSheet(b.dataset.o); });
$('#meer').onclick = () => { toon += 60; drawIdeeen(); };
$('#a-ververs').onclick = () => haalAanb(false);
$('#a-zelf').onclick = zelfAanb;
window.UIback = () => { if (tab !== 'week') { naarTab('week'); return true; } return false; };

function route() {
  const h = decodeURIComponent(location.hash.slice(1));
  if (!h) return;
  history.replaceState(null, '', location.pathname);
  if (h === 'volgende') { offset = 1; render(); }
  else if (h === 'wat') watEtenWe();
  else if (h === 'afboeken') { const t = window.Voorraad ? Voorraad.teAfboeken(data.dagen, today(), new Date().getHours()) : []; if (t.length) afboeken(t[t.length - 1]); else toast('Er is niets meer af te boeken.'); }
  else if (h === 'zoek') { naarTab('ideeen'); setTimeout(() => $('#q').focus(), 50); }
  else if (h === 'ideeen' || h === 'aanb') naarTab(h);
  else if (h.startsWith('optie=')) optieSheet(h.slice(6));
  else if (h.startsWith('dag=')) { const d = h.slice(4); if (data.dagen[d]) dagSheet(d); else watEtenWe(d); }
}
window.addEventListener('hashchange', route);

(async () => {
  try { rec = (await recepten.all()) || []; } catch (e) { rec = []; }
  // Oude menu's (alleen recept-id) krijgen een optie-id.
  Object.values(data.dagen).forEach(m => { if (m && m.recept && !m.opt) m.opt = ''; });
  bouwPool();
  koppelDeel();
  if (window.Voorraad) Voorraad.koppel(() => { if (tab === 'week') renderKook(); });
  publish();
  render();
  route();
  const poging = D.get('weekmenu-aanb-poging', 0) || 0;
  if (W2.page.available() && !aanbGeldig() && Date.now() - poging > 6 * 3600e3) haalAanb(true);
})();
</script>
