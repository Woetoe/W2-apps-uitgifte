const KEY = 'legtuit-v1';
const app = document.getElementById('app');

function rand(n){const a=new Uint32Array(1);crypto.getRandomValues(a);return a[0]%n;}
function shuffle(arr){const a=arr.slice();for(let i=a.length-1;i>0;i--){const j=rand(i+1);[a[i],a[j]]=[a[j],a[i]];}return a;}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function tc(c){return 'var('+TEAMS[c][1]+')';}

function defaults(){return {screen:'setup',settings:{teams:[{name:'Team Rood',c:0},{name:'Team Blauw',c:1}],time:30,length:30,sound:true,dice:true,genres:['mensen','plekken','film','sport','alles']},custom:'',used:{},game:null};}
function load(){try{const r=localStorage.getItem(KEY);if(r){const d=JSON.parse(r);const s=Object.assign(defaults(),d);s.settings=Object.assign(defaults().settings,d.settings||{});return s;}}catch(e){}return null;}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}

let S = load() || defaults();
const ui = {board:false, stop:false, rolling:false, face:1, anim:null};

/* ---------- Woorden ---------- */
function customWords(){return [...new Set(S.custom.split('\n').map(w=>w.trim()).filter(Boolean))];}
function wordsOf(id){return id==='eigen'?customWords():WORDS[id].split('|');}
function nextWord(id){
  const list=wordsOf(id);
  let used=(S.used[id]||[]).filter(w=>list.includes(w));
  let avail=list.filter(w=>!used.includes(w));
  if(!avail.length){used=[];avail=list.slice();}
  const w=avail[rand(avail.length)];
  used.push(w); S.used[id]=used; return w;
}
const BASE=['mensen','plekken','film','sport','dieren','feest','alles'];
function genres(){const g=(S.settings.genres||[]).filter(id=>WORDS[id]);return g.length?g:BASE.slice(0,1);}
function pool(){const p=BASE.filter(id=>genres().includes(id));if(customWords().length>=5)p.push('eigen');return p;}
function drawCard(){
  const p=pool(); let cats;
  if(p.length>=5){const pick=shuffle(p).slice(0,5);cats=p.filter(id=>pick.includes(id));}
  else{cats=p.slice();while(cats.length<5)cats.push(p[rand(p.length)]);cats.sort((a,b)=>p.indexOf(a)-p.indexOf(b));}
  const seen=new Set(), out=[];
  for(const id of cats){let w,n=0;do{w=nextWord(id);n++;}while(seen.has(w)&&n<20);seen.add(w);out.push({cat:id,word:w});}
  return out;
}

/* ---------- Geluid, trillen, scherm aan ---------- */
let ac=null;
function audio(){if(!S.settings.sound)return null;try{ac=ac||new (window.AudioContext||window.webkitAudioContext)();if(ac.state==='suspended')ac.resume();return ac;}catch(e){return null;}}
function beep(f,d,type,vol){const a=audio();if(!a)return;try{const o=a.createOscillator(),g=a.createGain();o.type=type||'sine';o.frequency.value=f;g.gain.setValueAtTime(vol||0.18,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+d);o.connect(g);g.connect(a.destination);o.start();o.stop(a.currentTime+d);}catch(e){}}
function buzz(ms){if(!S.settings.sound)return;try{navigator.vibrate&&navigator.vibrate(ms);}catch(e){}}
let wake=null;
async function requestWake(){try{if('wakeLock' in navigator&&!wake){wake=await navigator.wakeLock.request('screen');wake.addEventListener('release',()=>{wake=null;});}}catch(e){}}
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&S.game)requestWake();});

/* ---------- Spelverloop ---------- */
function startGame(){
  const st=S.settings;
  S.game={teams:st.teams.map(t=>({name:(t.name||'').trim()||('Team '+TEAMS[t.c][0]),c:t.c,pos:0,
    players:(t.players||'').split(',').map(p=>p.trim()).filter(Boolean),next:0})),turn:0,round:1,dice:null,card:null,checked:[],endsAt:0,last:null,winner:null,length:st.length};
  if(!st.dice) S.game.dice=0;
  S.screen='pass'; save(); requestWake(); audio(); render();
}
function roll(){
  if(ui.rolling)return; audio(); ui.rolling=true; let n=0; render();
  const iv=setInterval(()=>{
    ui.face=FACES[rand(6)]; paintDie(true); beep(300+rand(200),0.03,'square',0.05);
    if(++n>=10){clearInterval(iv);ui.rolling=false;S.game.dice=FACES[rand(6)];beep(660,0.15);save();render();}
  },75);
}
function startTurn(){
  const g=S.game; audio(); requestWake();
  g.card=drawCard(); g.checked=[false,false,false,false,false];
  g.endsAt=Date.now()+S.settings.time*1000;
  S.screen='play'; save(); render(); runTick();
}
let tick=null, lastSec=null;
function runTick(){
  clearInterval(tick); lastSec=null;
  tick=setInterval(()=>{
    const g=S.game; if(!g||S.screen!=='play'){clearInterval(tick);return;}
    const left=Math.max(0,(g.endsAt-Date.now())/1000);
    paintTimer(left);
    const s=Math.ceil(left);
    if(s!==lastSec){lastSec=s; if(s<=5&&s>0){beep(880,0.09,'sine',0.2);buzz(40);}}
    if(left<=0){clearInterval(tick);timeUp(false);}
  },100);
}
function timeUp(all){
  if(all){beep(660,0.12);setTimeout(()=>beep(990,0.25),120);buzz([60,40,60]);}
  else{beep(170,0.7,'sawtooth',0.22);buzz([300,100,300]);}
  S.screen='check'; save(); render();
}
function explainer(t){const p=t.players||[];return p.length?p[(t.next||0)%p.length]:null;}
function correct(){return S.game.checked.filter(Boolean).length;}
function confirmTurn(){
  const g=S.game, t=g.teams[g.turn];
  const steps=Math.max(0,correct()-(g.dice||0));
  const from=t.pos, to=Math.min(g.length,from+steps);
  g.last={team:g.turn,from,to,steps,who:explainer(t)}; t.pos=to;
  if((t.players||[]).length) t.next=((t.next||0)+1)%t.players.length;
  if(to>=g.length) g.winner=g.turn;
  S.screen='move'; save();
  ui.anim={team:g.turn,pos:from}; render();
  if(steps===0){ui.anim=null;render();return;}
  const iv=setInterval(()=>{
    ui.anim.pos++; beep(440+ui.anim.pos*12,0.06,'triangle',0.15); paintBoard(ui.anim.pos);
    if(ui.anim.pos>=to){clearInterval(iv);ui.anim=null;if(g.winner!=null){beep(660,0.15);setTimeout(()=>beep(880,0.15),150);setTimeout(()=>beep(1320,0.35),300);buzz([80,50,80,50,200]);}render();}
  },300);
}
function nextTurn(){
  const g=S.game;
  if(g.winner!=null){S.screen='win';save();render();return;}
  g.turn=(g.turn+1)%g.teams.length; if(g.turn===0)g.round++;
  g.dice=S.settings.dice?null:0; g.card=null; g.checked=[]; g.last=null;
  S.screen='pass'; save(); render();
}

/* ---------- Schermen ---------- */
function topBar(){
  return `<div class="top"><span class="round">Ronde ${S.game.round}</span>
    <button class="pill" data-a="board">Bord</button><button class="pill" data-a="stop">Stoppen</button></div>`;
}
function standings(){
  return `<div class="stand">${S.game.teams.map(t=>`<span><i class="dot" style="background:${tc(t.c)}"></i>${esc(t.name)} · ${t.pos}/${S.game.length}</span>`).join('')}</div>`;
}
function dieHTML(face,rolling){
  const pos={1:['2/2'],2:['1/1','3/3']}[face]||[];
  return `<div id="die" class="die ${face===0?'blank':''} ${rolling?'rolling':''}" aria-label="Dobbelsteen: ${face}">${pos.map(p=>`<i style="grid-area:${p.split('/')[0]}/${p.split('/')[1]}"></i>`).join('')}</div>`;
}
function boardHTML(animPos){
  const g=S.game, N=g.length, cols=6, catCols=genres().map(c=>'--c-'+c);
  let out='';
  for(let i=0;i<=N;i++){
    const row=Math.floor(i/cols), k=i%cols, col=row%2===0?k+1:cols-k;
    const pawns=g.teams.map((t,ti)=>({t,p:(ui.anim&&ui.anim.team===ti)?(animPos??ui.anim.pos):t.pos})).filter(o=>o.p===i)
      .map(o=>`<span class="pawn" style="background:${tc(o.t.c)}" title="${esc(o.t.name)}"></span>`).join('');
    const cls=i===0?'start':i===N?'finish':'';
    const lab=i===0?'Start':i===N?'Finish':i;
    const hit=ui.anim&&(animPos??ui.anim.pos)===i&&i>0?' hit':'';
    out+=`<div class="cell ${cls}${hit}" style="grid-row:${row+1};grid-column:${col};border-bottom-color:var(${catCols[i%catCols.length]})"><span class="n">${lab}</span><span class="pawns">${pawns}</span></div>`;
  }
  return `<div class="board" id="board">${out}</div>`;
}
function wordsHTML(compact){
  const g=S.game;
  return `<div class="card${compact?' compact':''}">${g.card.map((w,i)=>`<button class="word ${g.checked[i]?'on':''}" data-a="tick" data-i="${i}" aria-pressed="${g.checked[i]}">
    <span class="stripe" style="background:var(--c-${w.cat})"></span>
    <span class="txt"><span class="cat">${esc(CAT[w.cat].name)}</span><span class="w">${esc(w.word)}</span></span>
    <span class="tick">✓</span></button>`).join('')}</div>`;
}

