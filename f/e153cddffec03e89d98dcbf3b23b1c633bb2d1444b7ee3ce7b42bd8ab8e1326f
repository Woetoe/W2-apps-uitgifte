<title>Leg 't Uit</title>
<style>
/* Speltafel: één kolom, telefoon-eerst. Papieren kaartjes op een donkerblauw speelbord, één felgele accentkleur voor tijd en knoppen. */
:root{
  --table:#17244f; --table-2:#203165; --line:#34478a; --chalk:#f3f5ff; --muted:#a9b4da;
  --paper:#fbf7ee; --ink:#1a1d2b; --ink-soft:#5b6077;
  --accent:#ffc83d; --accent-deep:#c9961c; --good:#2fbf71; --good-soft:#d6f4e3; --bad:#ff5a4f;
  --c-mensen:#ff6b5b; --c-plekken:#22b5a4; --c-film:#a76bdc; --c-sport:#3f8cff; --c-alles:#ff9d2e; --c-eigen:#ee5fa7; --c-dieren:#5cb85c; --c-feest:#e8c22c;
  --t1:#ff5a4f; --t2:#3f8cff; --t3:#ffc83d; --t4:#36c47a; --t5:#b27ae6; --t6:#ff8a2a;
  --f-display:"Dela Gothic One","Arial Black",Impact,sans-serif;
  --f-body:"Figtree",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  color-scheme:dark;
}
html,body{height:100%}
body{
  background:var(--table);
  background-image:radial-gradient(var(--table-2) 1.2px,transparent 1.6px);
  background-size:22px 22px;
  color:var(--chalk); font-family:var(--f-body); font-size:16px; line-height:1.45;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:0;
  -webkit-tap-highlight-color:transparent;
}
*{box-sizing:border-box}
button,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:520px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;gap:20px;padding-block:20px 28px}
h1,h2,.display{font-family:var(--f-display);font-weight:400;letter-spacing:.01em;text-wrap:balance;margin:0}
.label{font-size:12px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:800}

.homelink{align-self:flex-start;display:flex;align-items:center;gap:6px;color:var(--muted);text-decoration:none;font-weight:600;padding:10px 4px;margin:-4px 0 -4px -4px}
/* Logo */
.logo{display:flex;flex-direction:column;gap:6px;padding-top:8px}
.logo h1{font-size:46px;line-height:.95;color:var(--chalk)}
.logo h1 span{color:var(--accent)}
.logo p{margin:0;color:var(--muted);font-size:15px}
.genres{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:6px}
.genres button{display:flex;align-items:center;gap:7px;border:1px solid var(--line);background:var(--table-2);color:var(--muted);border-radius:999px;padding:8px 12px;font-weight:600;opacity:.55}
.genres button i{width:12px;height:12px;border-radius:50%;display:block}
.genres button[aria-pressed="true"]{background:var(--chalk);color:var(--ink);opacity:1}
.chips{display:flex;gap:6px;margin-top:6px}
.chips i{width:28px;height:8px;border-radius:4px;display:block}

/* Panels */
.panel{display:flex;flex-direction:column;gap:12px}
.teams{display:flex;flex-direction:column;gap:8px}
.team-row{display:grid;grid-template-columns:18px 1fr 40px;gap:10px;align-items:center;background:var(--table-2);border:1px solid var(--line);border-radius:12px;padding:6px 6px 6px 12px}
.dot{width:18px;height:18px;border-radius:50%;border:2px solid var(--paper)}
.team-row input{background:transparent;border:0;padding:8px 0;font-weight:600;min-width:0;width:100%}
.team-row input:focus{outline:none}
.team-row:focus-within{border-color:var(--accent)}
.team-row input.players{grid-column:2/4;font-weight:400;font-size:15px;border-top:1px solid var(--line);padding:9px 0 5px}
.team-row input::placeholder{color:var(--muted);opacity:.8}
.teamtag{font-weight:800;font-size:15px}
.icon-btn{width:40px;height:40px;border-radius:10px;border:0;background:transparent;color:var(--muted);font-size:20px}
.icon-btn:disabled{opacity:.25}
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;background:var(--table-2);border:1px solid var(--line);border-radius:12px;padding:4px;gap:4px}
.seg button{border:0;background:transparent;border-radius:9px;padding:10px 4px;font-weight:600;color:var(--muted);font-variant-numeric:tabular-nums}
.seg button[aria-pressed="true"]{background:var(--chalk);color:var(--ink)}
.row{display:flex;justify-content:space-between;align-items:center;gap:12px}
.toggle{width:54px;height:32px;border-radius:16px;border:0;background:var(--line);position:relative;flex:none}
.toggle::after{content:"";position:absolute;top:4px;left:4px;width:24px;height:24px;border-radius:50%;background:var(--chalk);transition:transform .15s}
.toggle[aria-pressed="true"]{background:var(--good)}
.toggle[aria-pressed="true"]::after{transform:translateX(22px)}
details{background:var(--table-2);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
summary{font-weight:800;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:8px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--accent);font-family:var(--f-display)}
details[open] summary::after{content:"–"}
details .inner{display:flex;flex-direction:column;gap:10px;margin-top:10px;color:var(--muted);font-size:15px}
details ol{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px}
textarea{width:100%;min-height:130px;background:var(--table);border:1px solid var(--line);border-radius:10px;padding:10px;color:var(--chalk);resize:vertical}
.small{font-size:13px;color:var(--muted)}

/* Buttons */
.btn{font-family:var(--f-display);font-size:19px;background:var(--accent);color:var(--ink);border:0;border-radius:14px;padding:16px 18px;box-shadow:0 5px 0 var(--accent-deep);transition:transform .08s,box-shadow .08s;width:100%}
.btn:active{transform:translateY(3px);box-shadow:0 2px 0 var(--accent-deep)}
.btn:disabled{opacity:.4;box-shadow:none}
.btn.ghost{background:transparent;color:var(--chalk);border:2px solid var(--line);box-shadow:none;font-family:var(--f-body);font-weight:800;font-size:16px}
.btn.add{padding:12px;font-size:15px}
.spacer{flex:1}
.dock{position:sticky;bottom:0;z-index:5;display:flex;flex-direction:column;gap:10px;margin-top:auto;
  padding-top:14px;padding-bottom:calc(10px + env(safe-area-inset-bottom,0px));
  background:linear-gradient(to bottom,transparent,var(--table) 14px)}
.wrap.docked{padding-bottom:0}
.card.compact .word{min-height:54px}
.card.compact .word .w{font-size:19px}
.card.compact .word .txt{padding:7px 12px}

/* Top bar */
.top{display:flex;align-items:center;gap:8px}
.top .round{font-family:var(--f-display);font-size:15px;color:var(--muted);flex:1}
.pill{border:1px solid var(--line);background:var(--table-2);border-radius:999px;padding:8px 14px;font-weight:800;font-size:14px;color:var(--chalk)}

/* Standings */
.stand{display:flex;flex-wrap:wrap;gap:6px}
.stand span{display:flex;align-items:center;gap:6px;background:var(--table-2);border-radius:999px;padding:5px 10px 5px 6px;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}
.stand .dot{width:14px;height:14px}

/* Pass screen */
.hand{display:flex;flex-direction:column;gap:8px;text-align:center;align-items:center;padding-top:10px}
.hand .team{font-size:40px;line-height:1}
.diebox{display:flex;flex-direction:column;align-items:center;gap:12px;padding:8px 0}
.die{width:104px;height:104px;border-radius:22px;background:var(--paper);box-shadow:0 6px 0 #cfc7b0, 0 14px 30px rgba(0,0,0,.35);display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);padding:18px;border:0}
.die i{width:18px;height:18px;border-radius:50%;background:var(--ink);place-self:center;display:block}
.die.blank{place-items:center}
.die.rolling{animation:shake .14s linear infinite}
@keyframes shake{0%{transform:rotate(-8deg)}50%{transform:rotate(8deg)}100%{transform:rotate(-8deg)}}
.die-note{color:var(--muted);text-align:center;max-width:30ch}
.die-note b{color:var(--chalk)}

/* Play screen */
.timer{display:flex;align-items:flex-end;justify-content:space-between;gap:12px}
.secs{font-family:var(--f-display);font-size:84px;line-height:.9;color:var(--accent);font-variant-numeric:tabular-nums}
.secs.low{color:var(--bad)}
.bar{height:10px;background:var(--table-2);border-radius:5px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--accent);border-radius:5px;transform-origin:left}
.bar.low i{background:var(--bad)}
.got{font-family:var(--f-display);font-size:22px;text-align:right;line-height:1.1}
.got small{display:block;font-family:var(--f-body);font-size:13px;color:var(--muted);font-weight:600}
.card{display:flex;flex-direction:column;gap:8px}
.word{display:grid;grid-template-columns:10px 1fr 44px;align-items:center;background:var(--paper);color:var(--ink);border:0;border-radius:12px;overflow:hidden;min-height:70px;text-align:left;padding:0;box-shadow:0 3px 0 #cfc7b0;transition:background .12s}
.word .stripe{align-self:stretch}
.word .txt{padding:10px 12px;display:flex;flex-direction:column;gap:2px;min-width:0}
.word .cat{font-size:11px;text-transform:uppercase;letter-spacing:.09em;font-weight:800;color:var(--ink-soft)}
.word .w{font-size:22px;font-weight:800;line-height:1.15;overflow-wrap:anywhere}
.word .tick{width:30px;height:30px;border-radius:50%;border:2px solid #d8d1bd;display:grid;place-items:center;font-weight:800;color:transparent}
.word.on{background:var(--good-soft)}
.word.on .tick{background:var(--good);border-color:var(--good);color:#fff}
.hint{text-align:center;color:var(--muted);font-size:14px}

/* Check screen */
.sum{background:var(--table-2);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;font-variant-numeric:tabular-nums}
.sum .eq{color:var(--muted);font-size:15px}
.sum .res{font-family:var(--f-display);font-size:30px;color:var(--accent);white-space:nowrap}

/* Board */
.board{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}
.cell{aspect-ratio:1;border-radius:9px;background:var(--table-2);border:1px solid var(--line);border-bottom-width:4px;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:3px 4px;min-width:0}
.cell .n{font-size:11px;color:var(--muted);font-weight:800;font-variant-numeric:tabular-nums}
.cell.start,.cell.finish{background:var(--accent);border-color:var(--accent-deep)}
.cell.start .n,.cell.finish .n{color:var(--ink);font-size:9px;text-transform:uppercase;letter-spacing:.04em}
.pawns{display:flex;flex-wrap:wrap;gap:2px;justify-content:center}
.pawn{width:13px;height:13px;border-radius:50%;border:2px solid var(--paper);box-shadow:0 1px 2px rgba(0,0,0,.5);display:block}
.cell.hit{animation:pop .28s ease-out}
@keyframes pop{0%{transform:scale(1)}50%{transform:scale(1.12)}100%{transform:scale(1)}}
.move-msg{text-align:center;display:flex;flex-direction:column;gap:4px}
.move-msg .big{font-size:28px}
.move-msg p{margin:0;color:var(--muted)}

/* Overlay */
.overlay{position:fixed;inset:0;background:rgba(10,16,40,.82);display:flex;align-items:flex-end;justify-content:center;z-index:20;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-bottom:calc(16px + env(safe-area-inset-bottom,0px));padding-top:calc(16px + env(safe-area-inset-top,0px))}
.sheet{background:var(--table);border:1px solid var(--line);border-radius:18px;padding:18px;width:100%;max-width:520px;display:flex;flex-direction:column;gap:14px;max-height:100%;overflow:auto}
.sheet .btns{display:grid;grid-template-columns:1fr 1fr;gap:10px}

/* Win */
.win{text-align:center;display:flex;flex-direction:column;gap:10px;align-items:center;padding-top:20px}
.trophy{font-family:var(--f-display);font-size:16px;color:var(--ink);background:var(--accent);padding:6px 14px;border-radius:999px}
.win .team{font-size:44px;line-height:1}
.rank{display:flex;flex-direction:column;gap:6px;width:100%}
.rank div{display:grid;grid-template-columns:28px 18px 1fr auto;gap:10px;align-items:center;background:var(--table-2);border-radius:10px;padding:10px 12px;text-align:left;font-variant-numeric:tabular-nums}
.rank b{font-family:var(--f-display);font-weight:400;color:var(--muted)}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

</head>
