  const st=S.settings, cw=customWords().length;
  const total=genres().reduce((n,id)=>n+WORDS[id].split('|').length,0)+cw;
  return `<div class="wrap">
  <a class="homelink" href="../index.html"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>Spellen</a>
  <div class="logo"><h1>Leg ’t <span>Uit</span></h1><p>Vijf woorden. ${st.time} seconden. Jij legt uit, je team raadt.</p>
    <div class="chips">${genres().map(c=>`<i style="background:var(--c-${c})"></i>`).join('')}</div></div>

  <section class="panel"><span class="label">Teams</span>
    <div class="teams">${st.teams.map((t,i)=>`<div class="team-row"><span class="dot" style="background:${tc(t.c)}"></span>
      <input id="team-${t.c}" data-in="team" data-i="${i}" value="${esc(t.name)}" maxlength="22" aria-label="Naam team ${i+1}">
      <button class="icon-btn" data-a="rmTeam" data-i="${i}" ${st.teams.length<=2?'disabled':''} aria-label="Team verwijderen">×</button>
      <input class="players" id="players-${t.c}" data-in="players" data-i="${i}" value="${esc(t.players||'')}" placeholder="Spelers, bv. Wouter, Sanne, Tom" aria-label="Spelers team ${i+1}"></div>`).join('')}</div>
    <span class="small">Zet komma's tussen de namen. De app wisselt per beurt wie er uitlegt.</span>
    ${st.teams.length<6?`<button class="btn ghost add" data-a="addTeam">+ Team toevoegen</button>`:''}
  </section>

  <section class="panel"><span class="label">Genres</span>
    <div class="genres">${BASE.map(id=>`<button data-a="genre" data-v="${id}" aria-pressed="${genres().includes(id)}"><i style="background:var(--c-${id})"></i>${esc(CAT[id].name)}</button>`).join('')}</div>
    <span class="small">Kies welke soorten woorden op de kaartjes komen. Minstens één.</span>
  </section>

  <section class="panel"><span class="label">Tijd per beurt</span>
    <div class="seg">${[20,30,45,60].map(v=>`<button data-a="time" data-v="${v}" aria-pressed="${st.time===v}">${v} sec</button>`).join('')}</div>
  </section>
  <section class="panel"><span class="label">Spelbord</span>
    <div class="seg">${[[20,'Kort'],[30,'Normaal'],[40,'Lang']].map(([v,l])=>`<button data-a="len" data-v="${v}" aria-pressed="${st.length===v}">${l} · ${v}</button>`).join('')}</div>
  </section>
  <section class="panel">
    <div class="row"><div><b>Dobbelsteen</b><div class="small">0, 1 of 2 woorden gaan van je score af</div></div><button class="toggle" data-a="dice" aria-pressed="${st.dice}" aria-label="Dobbelsteen"></button></div>
    <div class="row"><div><b>Geluid en trillen</b><div class="small">Tikken in de laatste 5 seconden</div></div><button class="toggle" data-a="sound" aria-pressed="${st.sound}" aria-label="Geluid"></button></div>
  </section>

  <details><summary>Eigen woorden <span class="small" id="cw">${cw?cw+' woorden':''}</span></summary>
    <div class="inner"><span>Eén woord per regel. Vanaf 5 woorden komt er een roze categorie bij op de kaartjes. Blijft bewaard op deze telefoon.</span>
    <textarea id="custom" data-in="custom" placeholder="Opa Henk&#10;Camping in Frankrijk&#10;De gele Fiat">${esc(S.custom)}</textarea></div></details>

  <details><summary>Spelregels</summary><div class="inner"><ol>
    <li>Teams spelen om de beurt. Eén speler legt uit, de rest van het team raadt.</li>
    <li>Gooi eerst de dobbelsteen. Druk dan op start: je ziet vijf woorden.</li>
    <li>Omschrijf ze zonder het woord of een deel ervan te zeggen. Niet aanwijzen, niet vertalen, geen ‘rijmt op’.</li>
    <li>Tik een woord aan zodra het geraden is.</li>
    <li>Geraden min dobbelsteen is het aantal stappen. Wie als eerste de finish haalt, wint.</li></ol>
    <span>${total} woorden in het spel. Woorden komen pas terug als een categorie op is.</span></div></details>

  <button class="btn" data-a="start">Start het spel</button>
  </div>`;
}
function vPass(){
  const g=S.game, t=g.teams[g.turn], rolled=g.dice!=null, who=explainer(t);
  let die='';
  if(S.settings.dice){
    die=`<div class="diebox">${ui.rolling?dieHTML(ui.face,true):rolled?dieHTML(g.dice,false):`<button class="die blank" data-a="roll" aria-label="Gooi de dobbelsteen" style="font-family:var(--f-display);color:var(--ink);font-size:15px;place-items:center;display:grid">GOOI</button>`}
      <div class="die-note">${rolled?(g.dice===0?'<b>Geluk!</b> Er gaat niets af.':`Er ${g.dice===1?'gaat':'gaan'} straks <b>${g.dice} ${g.dice===1?'woord':'woorden'}</b> van je score af.`):'Tik op de dobbelsteen om te gooien.'}</div></div>`;
  }
  return `<div class="wrap">${topBar()}${standings()}
    <div class="hand"><span class="label">Geef de telefoon aan</span>
      ${who?`<h2 class="team" style="color:${tc(t.c)}">${esc(who)}</h2>
      <span class="teamtag" style="color:${tc(t.c)}">${esc(t.name)}</span>
      <span style="color:var(--muted)">Jij legt uit, de rest van je team raadt.</span>
      ${t.players.length>1?`<button class="pill" data-a="skipPlayer">Iemand anders legt uit</button>`:''}`
      :`<h2 class="team" style="color:${tc(t.c)}">${esc(t.name)}</h2>
      <span style="color:var(--muted)">Wie legt er deze beurt uit? De rest kijkt niet mee.</span>`}</div>
    ${die}
    <div class="dock"><button class="btn" data-a="go" ${rolled&&!ui.rolling?'':'disabled'}>Start ${S.settings.time} seconden</button></div></div>`;
}
function vPlay(){
  const g=S.game, n=correct();
  return `<div class="wrap">
    <div class="timer"><span class="secs" id="secs">${S.settings.time}</span>
      <span class="got">${n} van 5<small>${g.dice?'−'+g.dice+' dobbelsteen':'geen aftrek'}</small></span></div>
    <div class="bar" id="bar"><i id="barfill"></i></div>
    ${wordsHTML()}
    <p class="hint">Tik op een woord als het geraden is.</p></div>`;
}
function vCheck(){
  const g=S.game, n=correct(), steps=Math.max(0,n-(g.dice||0)), t=g.teams[g.turn];
  return `<div class="wrap">
    <div><span class="label" style="color:${tc(t.c)}">${esc(t.name)}${explainer(t)?' · '+esc(explainer(t)):''}</span><h2 style="font-size:34px">Tijd is om</h2>
      <p style="margin:4px 0 0;color:var(--muted)">Klopt het? Tik een woord aan of uit om het te verbeteren.</p></div>
    ${wordsHTML(true)}
    <div class="sum"><span class="eq">${n} geraden${S.settings.dice?' − '+g.dice+' dobbelsteen':''}</span><span class="res">${steps} ${steps===1?'stap':'stappen'}</span></div>
    <div class="dock"><button class="btn" data-a="confirm">${steps?'Zet pion '+steps+' vooruit':'Verder zonder stappen'}</button></div></div>`;
}
function vMove(){
  const g=S.game, L=g.last, t=g.teams[L.team], done=!ui.anim, nextT=g.teams[(g.turn+1)%g.teams.length];
  let msg;
  if(g.winner!=null&&done) msg=`<span class="display big" style="color:${tc(t.c)}">${esc(t.name)} haalt de finish!</span>`;
  else msg=`<span class="display big" style="color:${tc(t.c)}">${L.steps?'+'+L.steps:'Helaas'}</span><p>${L.who?esc(L.who)+' legde uit. ':''}${esc(t.name)} staat ${L.to===0?'nog op start':'op vakje '+L.to}.</p>`;
  return `<div class="wrap">${topBar()}${boardHTML()}<div class="move-msg">${msg}</div>
    <div class="dock"><button class="btn" data-a="next" ${done?'':'disabled'}>${g.winner!=null?'Bekijk de uitslag':'Volgende: '+esc(nextT.name)}</button></div></div>`;
}
function vWin(){
  const g=S.game, w=g.teams[g.winner];
  const order=g.teams.map((t,i)=>({t,i})).sort((a,b)=>b.t.pos-a.t.pos);
  return `<div class="wrap"><div class="win"><span class="trophy">Winnaar</span>
    <h2 class="team" style="color:${tc(w.c)}">${esc(w.name)}</h2><span style="color:var(--muted)">in ${g.round} ${g.round===1?'ronde':'rondes'}</span></div>
    <div class="rank">${order.map((o,r)=>`<div><b>${r+1}</b><span class="dot" style="background:${tc(o.t.c)}"></span><span>${esc(o.t.name)}</span><span>${o.t.pos}/${g.length}</span></div>`).join('')}</div>
    <div class="dock"><button class="btn" data-a="again">Nog een potje</button>
    <button class="btn ghost" data-a="home">Teams en instellingen</button></div></div>`;
}
function overlays(){
  let o='';
  if(ui.board&&S.game) o+=`<div class="overlay" data-a="closeBoard"><div class="sheet" data-stop>
    <div class="row"><h2 style="font-size:22px">Spelbord</h2><button class="pill" data-a="closeBoard">Sluiten</button></div>${boardHTML()}${standings()}</div></div>`;
  if(ui.stop) o+=`<div class="overlay"><div class="sheet"><h2 style="font-size:22px">Spel stoppen?</h2>
    <p style="margin:0;color:var(--muted)">De stand gaat verloren. Teams en instellingen blijven bewaard.</p>
    <div class="btns"><button class="btn ghost" data-a="stopNo">Doorspelen</button><button class="btn" data-a="stopYes">Stoppen</button></div></div></div>`;
  return o;
}
let lastScreen=null;
function render(){
  if(S.screen!==lastScreen){lastScreen=S.screen;try{window.scrollTo(0,0);}catch(e){}}
  const v={setup:vSetup,pass:vPass,play:vPlay,check:vCheck,move:vMove,win:vWin}[S.screen]||vSetup;
  app.innerHTML=v()+overlays();
  if(S.screen==='play'&&S.game) paintTimer(Math.max(0,(S.game.endsAt-Date.now())/1000));
}
function paintTimer(left){
  const s=document.getElementById('secs'), f=document.getElementById('barfill'), b=document.getElementById('bar');
  if(!s)return; const low=left<=5;
  s.textContent=Math.ceil(left); s.classList.toggle('low',low); b.classList.toggle('low',low);
  f.style.transform='scaleX('+(left/S.settings.time)+')';
}
function paintDie(rolling){const d=document.getElementById('die');if(d)d.outerHTML=dieHTML(ui.face,rolling);}
function paintBoard(p){const b=document.getElementById('board');if(b)b.outerHTML=boardHTML(p);}

/* ---------- Invoer ---------- */
app.addEventListener('click',e=>{
  const el=e.target.closest('[data-a]'); if(!el)return;
  if(el.dataset.a==='closeBoard'&&e.target.closest('[data-stop]')&&!e.target.closest('.pill'))return;
  const a=el.dataset.a, st=S.settings, g=S.game;
  switch(a){
    case 'addTeam':{const used=st.teams.map(t=>t.c);const c=[0,1,2,3,4,5].find(x=>!used.includes(x));st.teams.push({name:'Team '+TEAMS[c][0],c});break;}
    case 'rmTeam': if(st.teams.length>2)st.teams.splice(+el.dataset.i,1); break;
    case 'time': st.time=+el.dataset.v; break;
    case 'len': st.length=+el.dataset.v; break;
    case 'genre':{const v=el.dataset.v;let g=genres().slice();if(g.includes(v)){if(g.length>1)g=g.filter(x=>x!==v);}else g.push(v);st.genres=g;break;}
    case 'dice': st.dice=!st.dice; break;
    case 'sound': st.sound=!st.sound; if(st.sound)beep(660,0.1); break;
    case 'start': startGame(); return;
    case 'roll': roll(); return;
    case 'go': startTurn(); return;
    case 'skipPlayer':{const t=g.teams[g.turn];t.next=((t.next||0)+1)%t.players.length;break;}
    case 'tick':{const i=+el.dataset.i; g.checked[i]=!g.checked[i];
      if(g.checked[i]){beep(760,0.07,'triangle',0.2);buzz(25);}
      save(); render();
      if(S.screen==='play'&&correct()===5){clearInterval(tick);timeUp(true);}
      return;}
    case 'confirm': confirmTurn(); return;
    case 'next': nextTurn(); return;
    case 'board': ui.board=true; break;
    case 'closeBoard': ui.board=false; break;
    case 'stop': ui.stop=true; break;
    case 'stopNo': ui.stop=false; break;
    case 'stopYes': ui.stop=false; clearInterval(tick); S.game=null; S.screen='setup'; break;
    case 'again': startGame(); return;
    case 'home': S.game=null; S.screen='setup'; break;
  }
  save(); render();
});
app.addEventListener('input',e=>{
  const el=e.target;
  if(el.dataset.in==='team'){S.settings.teams[+el.dataset.i].name=el.value;save();}
  if(el.dataset.in==='players'){S.settings.teams[+el.dataset.i].players=el.value;save();}
  if(el.dataset.in==='custom'){S.custom=el.value;save();const n=customWords().length;const c=document.getElementById('cw');if(c)c.textContent=n?n+' woorden':'';}
});

/* ---------- Start ---------- */
function boot(data){
  if(data&&data.S) S=data.S;
  if(S.screen==='play'&&S.game){ if(Date.now()>=S.game.endsAt) S.screen='check'; }
  if(S.screen==='move'&&S.game&&S.game.winner!=null) S.screen='win';
  render();
  if(S.screen==='play') runTick();
  if(S.game) requestWake();
}
window.claude?.hot?.snapshot?.(()=>({S}));
window.claude?.hot?.ready ? window.claude.hot.ready(boot) : boot(window.claude?.hot?.data ?? {});
})();
</script>

