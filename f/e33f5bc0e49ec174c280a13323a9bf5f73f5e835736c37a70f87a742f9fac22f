  if (r.phase === 'quiz') {
    const q = curQ();
    if (!q) { r.phase = 'end'; return finish(); }
    const pick = r.picks[r.qi];
    const answered = pick != null && r.kind !== 'mock';
    const head = r.kind === 'boss' ? bossHead() : `<div class="prog"><span class="pill acc">${r.qi + 1}/${r.qids.length}</span><div class="bar xpbar"><i style="width:${r.qi / r.qids.length * 100}%"></i></div>${r.kind === 'mock' ? `<span class="clock" id="clock"></span>` : `<span class="pill">+${r.xp} XP</span>`}</div>`;
    const u = unitOf(q.lo);
    app.innerHTML = `${head}<div class="kicker">${esc(u.mod)} · ${esc(idx.lo[q.lo].t)}</div><div class="qtext">${esc(q.q)}</div>
      ${q.a.map((a, i) => `<button class="opt${answered ? (i === q.c ? ' right' : i === pick ? ' wrong' : '') : pick === i ? ' sel' : ''}" data-pick="${i}" type="button" ${answered ? 'disabled' : ''}><span class="k">${'ABCD'[i]}</span>${esc(a)}</button>`).join('')}
      ${answered ? `<div class="fb ${pick === q.c ? 'ok' : 'no'}"><b>${pick === q.c ? pickPraise() : pick === -1 ? '⏰ Time\'s up.' : 'Not quite — the answer is ' + 'ABCD'[q.c] + '.'}</b>${esc(q.x)}</div><div class="btns"><button class="btn wide" data-run="nextq" type="button">${r.kind === 'boss' && (r.hp <= 0 || r.hearts <= 0) ? 'See the result' : r.qi + 1 < r.qids.length ? 'Next question' : 'Finish'}</button></div>` : ''}
      ${r.kind === 'mock' ? `<div class="btns"><button class="btn wide" data-run="mocknext" type="button" ${pick == null ? 'disabled' : ''}>${r.qi + 1 < r.qids.length ? 'Next' : 'Hand in'}</button></div><div class="btns"><button class="btn q" data-run="pause" type="button">${icon('pause')}Pause</button><button class="btn danger" data-run="handin" type="button">Hand in now</button></div>` : ''}`;
    tick(true);
    return;
  }
  if (r.phase === 'end') finish();
}
const PRAISE = ['Correct! 🎯', 'Spot on.', 'Nailed it! 💪', 'Exactly right.', 'Yes! The supervisor would be impressed.', 'Correct — well reasoned.'];
const pickPraise = () => PRAISE[(run.qi + run.seed) % PRAISE.length];
function bossHead() {
  const B = bossOf(run.boss);
  return `<div class="arena"><div class="em" id="bem">${B.emoji}</div><div class="hp"><i style="width:${Math.max(0, run.hp)}%"></i></div>
    <div style="display:flex;justify-content:space-between;align-items:center"><span class="hearts">${'❤️'.repeat(run.hearts)}${'🖤'.repeat(3 - run.hearts)}</span><span class="clock" id="clock"></span><span class="pill">${run.qi + 1}/${run.qids.length}</span></div></div>`;
}

function choose(i) {
  const r = run, q = curQ();
  if (r.kind === 'mock') { r.picks[r.qi] = i; save(); renderRun(); return; }
  if (r.picks[r.qi] != null) return;
  r.picks[r.qi] = i;
  const ok = i === q.c;
  if (ok) r.ok++;
  const gained = E.answer(st, q.id, ok, T());
  r.xp += gained; popXp(ok ? gained : 0);
  if (r.kind === 'boss') {
    if (ok) { r.hp -= 12; const em = $('#bem'); if (em) em.classList.add('hit'); } else r.hearts--;
    r.qsec = 0;
  }
  try { navigator.vibrate && navigator.vibrate(ok ? 20 : [40, 40, 40]); } catch (e) {}
  save(); renderRun();
}
function nextQ() {
  const r = run;
  if (r.kind === 'boss' && (r.hp <= 0 || r.hearts <= 0)) { r.phase = 'end'; return finish(); }
  r.qi++;
  if (r.qi >= r.qids.length) { r.phase = 'end'; return finish(); }
  save(); renderRun();
}

function finish() {
  const r = run, d = T();
  if (r.kind === 'mock') {
    let ok = 0; const byMod = {};
    r.qids.forEach((id, i) => {
      const q = E.present(idx.q[id], E.rng(r.seed + i * 7919)), m = idx.mod(q.lo), good = r.picks[i] === q.c;
      byMod[m] = byMod[m] || [0, 0]; byMod[m][1]++; if (good) { ok++; byMod[m][0]++; }
      if (st.lo[q.lo]) E.answer(st, id, good, d, { noXp: true });
    });
    r.ok = ok;
    r.xp += E.gainXp(st, d, Math.round(E.XP.mockPerVraag * r.qids.length) + E.XP.perGoedMock * ok);
    st.mocks.push({ d, n: r.qids.length, ok, sec: r.el, byMod });
    r.byMod = byMod;
  }
  let won = null;
  if (r.kind === 'boss') {
    won = r.hp <= 0;
    const b = st.boss[r.boss] || (st.boss[r.boss] = { tries: 0, best: 0 });
    b.tries++; b.best = Math.max(b.best, r.ok);
    if (won) { r.xp += E.gainXp(st, d, b.won ? E.XP.bossOpnieuw : E.XP.boss); if (!b.won) b.won = d; }
  }
  const L = E.logDay(st, d);
  const daily = r.kind === 'daily' || r.daily;
  let streakBonus = 0;
  if (daily && !L.done) {
    L.done = true;
    const sk = E.streak(st, d);
    streakBonus = 5 * Math.min(sk.n, 10);
    r.xp += E.gainXp(st, d, E.XP.dag + streakBonus);
  }
  const lv0 = E.level(r.xp0), lv1 = E.level(st.xp);
  const nb = E.badges(st, idx, d).filter(b => b.got && !r.badges0.includes(b.id));
  const total = r.kind === 'boss' ? r.qi + 1 : r.qids.length;
  const wrong = r.kind === 'mock' ? [] : r.qids.map((id, i) => [id, i]).filter(([id, i]) => r.picks[i] != null && r.picks[i] !== E.present(idx.q[id], E.rng(r.seed + i * 7919)).c);
  let head;
  if (r.kind === 'boss') { const B = bossOf(r.boss); head = `<div class="arena"><div class="em">${won ? '👑' : B.emoji}</div></div><h3 style="font:800 22px var(--f-display);margin:0 0 6px">${won ? 'Victory!' : 'The boss escaped…'}</h3><p>${esc(won ? B.win : B.lose)}</p>`; }
  else if (r.kind === 'mock') head = `<div class="big">${pct(r.ok / r.qids.length)}</div><p>${r.ok}/${r.qids.length} correct in ${Math.round(r.el / 60)} min. ${r.ok / r.qids.length >= 0.7 ? 'That is at or above the 70% study target. 💪' : 'Below the 70% study target — check the weak modules below.'}</p>
    <div class="card" style="text-align:left">${Object.keys(E.MODS).filter(m => r.byMod[m]).map(m => `<div class="hbar"><span>${esc(m)} ${esc(E.MODS[m].kort)}</span><div class="tr"><i style="width:${r.byMod[m][0] / r.byMod[m][1] * 100}%"></i></div><span class="v">${r.byMod[m][0]}/${r.byMod[m][1]}</span></div>`).join('')}</div>`;
  else head = `<div class="big">${r.ok}/${total}</div><p>${r.ok === total && total ? 'Perfect round! 💯' : r.ok / Math.max(1, total) >= 0.7 ? 'Well done.' : 'Tough one — these questions will come back in your reviews.'}</p>`;
  r.done = true; r.live = false;
  const result = r;
  run = null; save();
  replan();
  $('#seg').style.display = 'none';
  $('#ttl').textContent = result.title;
  app.innerHTML = `<div class="card res">${head}
      <div class="stats"><div class="stat"><b>+${result.xp}</b><span>XP</span></div><div class="stat"><b>${E.streak(st, d).n}${daily ? '🔥' : ''}</b><span>streak${streakBonus ? ' (+' + streakBonus + ')' : ''}</span></div><div class="stat"><b>${lv1.lvl}</b><span>level</span></div></div>
      ${lv1.lvl > lv0.lvl ? `<p style="font:800 18px var(--f-display);color:var(--acc);margin:14px 0 0">⬆️ Level up! You are now level ${lv1.lvl}: ${esc(lv1.titel)}</p>` : ''}
      ${nb.length ? `<div style="margin-top:12px">${nb.map(b => `<div class="pill acc" style="margin:3px">${b.emoji} New badge: ${esc(b.t)}</div>`).join('')}</div>` : ''}</div>
    ${wrong.length ? `<h2>Review your mistakes</h2>${wrong.map(([id]) => { const q = idx.q[id]; return `<div class="card"><b>${esc(q.q)}</b><div class="fb ok" style="margin-top:8px"><b>${esc(q.a[q.c])}</b>${esc(q.x)}</div></div>`; }).join('')}` : ''}
    <div class="btns"><button class="btn wide" data-act="home" type="button">Back to today</button></div>`;
  scrollTo(0, 0);
}

// Klok: telt studietijd, bewaakt boss- en mocktijd
let lastSave = 0;
function tick(only) {
  if (!run || !run.live) return;
  const c = $('#clock');
  if (run.kind === 'boss' && run.phase === 'quiz' && run.picks[run.qi] == null) {
    const left = 180 - run.qsec;
    if (c) { c.textContent = `⏱ ${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}`; c.classList.toggle('low', left <= 30); }
    if (!only && left <= 0) { run.picks[run.qi] = -1; run.hearts--; E.answer(st, idx.q[run.qids[run.qi]].id, false, T()); save(); renderRun(); }
  }
  if (run.kind === 'mock' && run.phase === 'quiz') {
    const left = Math.max(0, run.limit - run.el);
    if (c) { c.textContent = `⏱ ${Math.floor(left / 3600)}:${String(Math.floor(left % 3600 / 60)).padStart(2, '0')}:${String(left % 60).padStart(2, '0')}`; c.classList.toggle('low', left < 600); }
    if (!only && left <= 0) { toast('Time is up — your answers have been handed in.'); run.phase = 'end'; finish(); }
  }
}
setInterval(() => {
  if (!run || !run.live || document.visibilityState !== 'visible') return;
  E.logDay(st, T()).sec++; run.el++;
  if (run.kind === 'boss' && run.phase === 'quiz' && run.picks[run.qi] == null) run.qsec++;
  tick(false);
  if (Date.now() - lastSave > 15000) { lastSave = Date.now(); save(); }
}, 1000);

// ---------------------------------------------------------------- klikken
app.addEventListener('click', e => {
  const t = e.target.closest('[data-act],[data-run],[data-pick],[data-lo],[data-unit],[data-boss],[data-mile],[data-mock]');
  if (!t) return;
  const ds = t.dataset;
  if (ds.pick != null) return choose(+ds.pick);
  if (ds.run) {
    const r = run;
    if (ds.run === 'next') { r.phase = r.phase === 'story' ? (r.los.length ? 'lessons' : r.kind === 'boss' || r.kind === 'mock' ? 'intro' : 'quiz') : 'quiz'; if (r.phase === 'intro' && !(r.kind === 'boss' || r.kind === 'mock')) r.phase = 'quiz'; save(); return render(); }
    if (ds.run === 'learned') { r.xp += E.studyLo(st, r.los[r.li], T()); popXp(E.XP.les); r.li++; if (r.li >= r.los.length) r.phase = 'quiz'; replan(); save(); scrollTo(0, 0); return renderRun(); }
    if (ds.run === 'nextq') { scrollTo(0, 0); return nextQ(); }
    if (ds.run === 'mocknext') { if (r.picks[r.qi] == null) return; scrollTo(0, 0); return nextQ(); }
    if (ds.run === 'pause') { r.live = false; save(); toast('Paused — resume from Today.'); return render(); }
    if (ds.run === 'handin') return confirm(`Hand in now? Unanswered questions count as wrong.`, 'Hand in').then(ok => { if (ok) { r.phase = 'end'; finish(); } });
    return;
  }
  if (ds.lo) return loSheet(ds.lo);
  if (ds.unit) { openUnits[ds.unit] = !t.closest('.unit').classList.contains('open'); t.closest('.unit').classList.toggle('open'); return; }
  if (ds.boss) { const miss = E.bossReady(st, idx, ST, ds.boss).length; if (miss) { toast(`Locked: study ${miss} more lesson${miss === 1 ? '' : 's'} first.`); return; } return startBoss(ds.boss, false); }
  if (ds.mile) { st.mijl[ds.mile] = st.mijl[ds.mile] ? null : T(); if (!st.mijl[ds.mile]) delete st.mijl[ds.mile]; else toast('Milestone done! 🎉'); save(); return render(); }
  if (ds.mock) return startMock(+ds.mock, false);
  e.preventDefault();
  const act = ds.act;
  if (act === 'start') return startDaily();
  if (act === 'resume') { run.live = true; save(); return render(); }
  if (act === 'drop') return confirm('Stop this session? Answers you already gave are kept.', 'Stop', true).then(ok => { if (ok) { run = null; save(); render(); } });
  if (act === 'catch') { const b = E.backlog(st, plan, idx, T()).slice(0, 2); return startRun({ kind: 'catch', title: 'Catch up', los: b, qids: b.flatMap(id => idx.byLo[id]) }); }
  if (act === 'ahead') { const b = E.nextLos(st, idx, 1); return startRun({ kind: 'ahead', title: 'Study ahead', los: b, qids: b.flatMap(id => idx.byLo[id]) }); }
  if (act === 'due') return startRun({ kind: 'practice', title: 'Reviews', qids: E.dueQs(st, idx, T()).slice(0, 15) });
  if (act === 'drill') return startRun({ kind: 'drill', title: 'Weak-spot drill', qids: E.weakest(st, idx, E.studied(st, idx), 10, E.rng(Date.now())) });
  if (act === 'topic') return topicSheet();
  if (act === 'logtime') return logTime();
  if (act === 'home') { setView('today'); return; }
});

function logTime() {
  sheet('Log study time', `<p class="muted small" style="margin-top:0">Time outside the app — reading the GARP curriculum, videos, end-of-chapter questions.</p>
    <div class="grid2"><label class="f">Minutes<input class="in" type="number" inputmode="numeric" name="min" value="30"></label><label class="f">Date<input class="in" type="date" name="d" value="${T()}"></label></div>`,
    [{ label: 'Cancel', value: null, kind: 'q' }, { label: 'Add', value: 'ok', check: f => (+f.min > 0 && +f.min <= 720 ? '' : 'Enter 1 to 720 minutes') }]).done.then(r => {
    if (r.value !== 'ok') return;
    const d = r.form.d || T();
    st.extra[d] = (+st.extra[d] || 0) + Math.round(+r.form.min);
    save(); render(); toast('Logged ' + Math.round(+r.form.min) + ' min');
  });
}

// ---------------------------------------------------------------- instellingen
const WD = [[1, 'Mon'], [2, 'Tue'], [3, 'Wed'], [4, 'Thu'], [5, 'Fri'], [6, 'Sat'], [0, 'Sun']];
$('#menu').onclick = () => {
  if (run && run.live) { run.live = false; save(); render(); }
  const s = sheet('Settings', `
    <label class="f">Exam date<input class="in" type="date" name="exam" value="${esc(set.exam)}"></label>
    <label class="f" style="margin-top:10px">Path start date<input class="in" type="date" name="start" value="${esc(set.start)}"></label>
    <div class="f" style="margin-top:10px"><span class="muted" style="font-weight:600;font-size:14px">New lessons on</span><div class="chips" id="wd" style="margin-top:6px">${WD.map(([n, t]) => `<button class="chip${set.learnDays.includes(n) ? ' on' : ''}" data-wd="${n}" type="button">${t}</button>`).join('')}</div><span class="muted small">Other days: case-file reviews and boss battles.</span></div>
    <div class="grid2" style="margin-top:10px"><label class="f">Review weeks before exam<input class="in" type="number" inputmode="numeric" name="rw" value="${set.reviewWeeks}"></label><label class="f">Target study hours<input class="in" type="number" inputmode="numeric" name="th" value="${set.targetHours}"></label></div>
    <label class="f" style="margin-top:10px">Readiness target (%)<input class="in" type="number" inputmode="numeric" name="tg" value="${Math.round(set.target * 100)}"></label>
    <div class="btns" style="margin-top:12px"><button class="btn q" data-x="replan" type="button">${icon('refresh')}Re-plan from today</button></div>
    <p class="muted small">Re-plan keeps everything you studied and spreads the remaining lessons over the days left. Use it after a holiday or illness.</p>
    <p class="muted small">Content: own summaries and questions per learning objective of the GARP RAI Study Guide 2026 (5 modules, 80 questions, 4 hours; exam weights M1 5–15%, M2 25–35%, M3–M5 15–25%). GARP estimates 100–130 study hours. Exam window April 2027: 3–11 April. Regulation notes updated to November 2026 (EU AI Act Digital Omnibus, US SR 26-2).</p>
    <div class="btns"><button class="btn danger" data-x="reset" type="button">${icon('trash')}Reset all progress</button></div>`,
    [{ label: 'Cancel', value: null, kind: 'q' }, { label: 'Save', value: 'ok', check: f => (f.exam > f.start ? '' : 'The exam must be after the start date') }]);
  let days = set.learnDays.slice();
  s.el.addEventListener('click', e => {
    const w = e.target.closest('[data-wd]');
    if (w) { const n = +w.dataset.wd; days = days.includes(n) ? days.filter(x => x !== n) : days.concat(n); w.classList.toggle('on'); return; }
    const x = e.target.closest('[data-x]'); if (!x) return;
    if (x.dataset.x === 'replan') { s.close(null); set.start = T(); D.set('rai-set', set); replan(); save(); render(); toast('Plan updated from today'); }
    if (x.dataset.x === 'reset') { s.close(null); confirm('Delete all RAI progress, XP and badges? This cannot be undone.', 'Delete', true).then(ok => { if (ok) { st = E.newState(); st.hist = {}; run = null; replan(); save(); render(); } }); }
  });
  s.done.then(r => {
    if (r.value !== 'ok') return;
    set.exam = r.form.exam || set.exam; set.start = r.form.start || set.start;
    set.learnDays = days.length ? days : [1, 2, 3, 4, 5];
    set.reviewWeeks = Math.max(1, Math.min(10, +r.form.rw || 5));
    set.targetHours = Math.max(10, Math.min(400, +r.form.th || 115));
    set.target = Math.max(0.5, Math.min(0.95, (+r.form.tg || 75) / 100));
    D.set('rai-set', set); replan(); save(); render();
  });
};
window.UIback = () => { if (run && run.live) { run.live = false; save(); render(); return true; } return false; };

// Samenvatting voor het overzicht (en de widget)
function dash() {
  const d = T(), s = E.status(st, plan, idx, set, d);
  D.set('dash-rai', { examen: set.exam, ready: s.ready, label: s.label, tone: s.tone, done: s.done, total: s.total, streak: E.streak(st, d).n, vandaag: !!(st.log[d] && st.log[d].done) });
}
save();
setView(view);
</script>
</body>
</html>
