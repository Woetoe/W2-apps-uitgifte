<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>RAI Quest</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<link rel="stylesheet" href="../w2ui.css">
<style>
:root{--acc:#9d8cff;--acc-ink:#120b33;--c-act:#3987e5;--c-plan:#d95926;--good:#5ee07a;--warn:#ffc83d;--bad:#ff6b5b}
.hero{display:flex;gap:14px;align-items:center}
.lvl{width:64px;height:64px;border-radius:20px;background:var(--acc);color:var(--acc-ink);display:grid;place-items:center;flex:none;text-align:center;line-height:1}
.lvl b{font:800 26px/1 var(--f-display);display:block}.lvl small{font-size:11px;font-weight:800;text-transform:uppercase}
.hero .t{flex:1;min-width:0}.hero .t b{display:block;font:800 18px/1.2 var(--f-display)}
.xpbar{height:8px;border-radius:4px;background:var(--line);overflow:hidden;margin-top:8px}.xpbar i{display:block;height:100%;background:var(--acc);border-radius:4px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.stat{background:var(--panel2);border-radius:14px;padding:8px 10px;text-align:center}
.stat b{display:block;font:800 20px/1.1 var(--f-display)}.stat span{font-size:12px;color:var(--muted);font-weight:700}
.tone{display:flex;align-items:center;gap:10px}
.tone .dot{width:34px;height:34px;border-radius:12px;display:grid;place-items:center;font-size:18px;flex:none}
.tone.ok .dot,.tone.ahead .dot{background:color-mix(in srgb,var(--good) 22%,transparent)}
.tone.warn .dot{background:color-mix(in srgb,var(--warn) 22%,transparent)}
.tone.bad .dot{background:color-mix(in srgb,var(--bad) 22%,transparent)}
.tone b{font:800 17px/1.2 var(--f-display)}
.meter{position:relative;height:12px;border-radius:6px;background:var(--line);margin:10px 0 4px}
.meter i{position:absolute;left:0;top:0;bottom:0;border-radius:6px;background:var(--c-act)}
.meter u{position:absolute;top:-4px;bottom:-4px;width:3px;border-radius:2px;background:var(--c-plan)}
.meter s{position:absolute;top:-4px;bottom:-4px;width:2px;background:var(--text);opacity:.55}
.leg{display:flex;flex-wrap:wrap;gap:12px;font-size:13px;color:var(--muted)}
.leg span::before{content:"";display:inline-block;width:14px;height:3px;border-radius:2px;background:var(--c);margin-right:6px;vertical-align:3px}
.leg span.d::before{background:repeating-linear-gradient(90deg,var(--c) 0 5px,transparent 5px 8px)}
.chal{position:relative;overflow:hidden}
.chal .big{font-size:40px;line-height:1;float:right;margin-left:10px}
.chal h3{margin:2px 0 4px;font:800 20px/1.2 var(--f-display)}
.story{font-size:15px;color:var(--text);opacity:.9;margin:8px 0 12px;border-left:3px solid var(--acc);padding-left:10px}
.kicker{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--acc)}
.unit{background:var(--panel);border:1px solid var(--line);border-radius:18px;overflow:hidden}
.unit>.hd{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer}
.unit>.hd .grow{flex:1;min-width:0}.unit>.hd b{display:block;font:800 16px/1.25 var(--f-display)}
.unit>.hd span{color:var(--muted);font-size:13px}
.unit .body{display:none;padding:0 12px 10px}.unit.open .body{display:block}
.mini{height:6px;border-radius:3px;background:var(--line);overflow:hidden;margin-top:6px}.mini i{display:block;height:100%;background:var(--c-act)}
.lo{display:flex;gap:10px;align-items:center;padding:10px 4px;border-top:1px solid var(--line);cursor:pointer}
.lo .ic{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:var(--panel2);flex:none;font-size:15px}
.lo .grow{flex:1;min-width:0}.lo .grow b{display:block;font-weight:700;font-size:15px}.lo .grow span{display:block;color:var(--muted);font-size:12px}
.boss-row{display:flex;gap:12px;align-items:center;padding:12px 14px;border-radius:16px;border:1.5px dashed var(--line);cursor:pointer}
.boss-row .em{font-size:30px}.boss-row.won{border-style:solid;border-color:color-mix(in srgb,var(--good) 50%,var(--line))}
.boss-row.ready{border-style:solid;border-color:var(--acc)}
.lesson{font-size:16px;line-height:1.55}.lesson p{margin:0 0 12px}.lesson ul{margin:0 0 12px;padding-left:20px}.lesson li{margin:3px 0}
.keys{background:var(--panel2);border-radius:14px;padding:10px 14px;margin-top:6px}
.keys h4{margin:0 0 6px;font-size:13px;text-transform:uppercase;color:var(--acc);letter-spacing:.04em}
.keys ul{margin:0;padding-left:18px}.keys li{margin:2px 0;font-size:15px}
.prog{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.prog .bar{flex:1}
.qtext{font:700 18px/1.4 var(--f-body);margin:4px 0 14px}
.opt{display:block;width:100%;text-align:left;border:1.5px solid var(--line);background:var(--panel);color:var(--text);border-radius:14px;padding:13px 14px;margin:0 0 10px;font-size:16px;cursor:pointer;line-height:1.35}
.opt:active{background:var(--panel2)}
.opt.sel{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,var(--panel))}
.opt.right{border-color:var(--good);background:color-mix(in srgb,var(--good) 14%,var(--panel))}
.opt.wrong{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 14%,var(--panel))}
.opt .k{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:8px;background:var(--panel2);font-weight:800;font-size:13px;margin-right:10px}
.fb{border-radius:14px;padding:12px 14px;margin:4px 0 12px;font-size:15px}
.fb.ok{background:color-mix(in srgb,var(--good) 14%,var(--panel))}.fb.no{background:color-mix(in srgb,var(--bad) 13%,var(--panel))}
.fb b{display:block;margin-bottom:4px}
.pop{position:fixed;left:50%;top:38%;transform:translate(-50%,0);font:800 30px var(--f-display);color:var(--acc);pointer-events:none;animation:pop 1s ease-out forwards;z-index:20}
@keyframes pop{0%{opacity:0;transform:translate(-50%,10px) scale(.8)}20%{opacity:1;transform:translate(-50%,0) scale(1.1)}100%{opacity:0;transform:translate(-50%,-50px) scale(1)}}
.arena{text-align:center;padding:6px 0 10px}
.arena .em{font-size:64px;line-height:1;display:inline-block}
.arena .em.hit{animation:hit .45s}
@keyframes hit{0%,100%{transform:none}25%{transform:translateX(-8px) rotate(-6deg)}50%{transform:translateX(8px) rotate(6deg)}75%{transform:translateX(-4px)}}
.hp{height:12px;border-radius:6px;background:var(--line);overflow:hidden;margin:8px 0}.hp i{display:block;height:100%;background:var(--bad);transition:width .4s}
.hearts{font-size:22px;letter-spacing:4px}
.clock{font:800 15px var(--f-display);color:var(--muted)}.clock.low{color:var(--bad)}
.res{text-align:center}.res .big{font:800 54px/1 var(--f-display);color:var(--acc)}
.badges{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:8px}
.badge{background:var(--panel2);border-radius:14px;padding:10px 6px;text-align:center;font-size:12px;color:var(--muted)}
.badge b{display:block;font-size:13px;color:var(--text);margin-top:4px}.badge .e{font-size:28px;line-height:1}
.badge.no{opacity:.38;filter:grayscale(1)}
.chart{position:relative;touch-action:pan-y}
.chart svg{display:block;width:100%;height:auto;overflow:visible}
.tip{position:absolute;top:0;pointer-events:none;background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:6px 9px;font-size:12px;white-space:nowrap;display:none;z-index:2}
.tip strong{font-size:14px}.tip .k{display:inline-block;width:12px;height:3px;border-radius:2px;margin-right:6px;vertical-align:3px}
.hbar{display:grid;grid-template-columns:96px 1fr 44px;gap:8px;align-items:center;font-size:14px;margin:8px 0}
.hbar .tr{height:12px;border-radius:6px;background:var(--line);overflow:hidden}.hbar .tr i{display:block;height:100%;background:var(--c-act);border-radius:0 4px 4px 0}
.hbar .v{text-align:right;font-weight:800}
.hbar span small{display:block;color:var(--muted);font-size:11px}
.heat{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;grid-template-rows:repeat(7,1fr);gap:3px}
.heat i{width:100%;aspect-ratio:1;border-radius:3px;background:var(--panel2);display:block}
.mile{display:flex;gap:12px;align-items:flex-start;padding:10px 0;border-top:1px solid var(--line)}
.mile:first-child{border-top:0}
.mile .box{width:26px;height:26px;border-radius:8px;border:2px solid var(--line);flex:none;display:grid;place-items:center;cursor:pointer;background:transparent;color:var(--acc-ink)}
.mile.on .box{background:var(--acc);border-color:var(--acc)}
.mile .grow b{display:block}.mile .grow span{display:block;color:var(--muted);font-size:13px}
.mile.on .grow b{text-decoration:line-through;opacity:.6}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:7px 12px;font-size:14px;cursor:pointer;color:var(--text)}
.chip.on{background:var(--acc);color:var(--acc-ink);border-color:var(--acc);font-weight:700}
table.tv{width:100%;border-collapse:collapse;font-size:13px;margin-top:8px}table.tv td,table.tv th{padding:5px 4px;border-top:1px solid var(--line);text-align:right}table.tv th:first-child,table.tv td:first-child{text-align:left}
details summary{cursor:pointer;color:var(--muted);font-size:13px;margin-top:8px}
.session .seghide{display:none}
</style>
</head>
<body>
<div class="top"><a class="ib" id="back" href="../index.html#persoonlijk" aria-label="Back"></a><h1 id="ttl">RAI Quest</h1><button class="ib" id="menu" type="button" aria-label="Settings"></button></div>
<main class="page">
  <div class="seg" id="seg"><button type="button" data-v="today">Today</button><button type="button" data-v="path">Path</button><button type="button" data-v="progress">Progress</button><button type="button" data-v="practice">Practice</button></div>
  <div id="app"></div>
</main>
<script src="../w2.js"></script>
<script src="../w2data.js"></script>
<script src="../w2ui.js"></script>
<script src="stof1.js"></script>
<script src="stof2.js"></script>
<script src="stof3.js"></script>
<script src="stof4.js"></script>
<script src="story.js"></script>
<script src="engine.js"></script>
<script>
const { esc, $, $$, icon, sheet, confirm, toast } = UI;
const D = W2D, E = RaiEngine, ST = RaiStory, app = $('#app');
const idx = E.index(RaiStof);
$('#back').innerHTML = icon('back');
$('#menu').innerHTML = icon('gear');
D.recent('rai');

const T = () => E.today();
let set = D.get('rai-set', null);
if (!set) { set = E.defaults(); D.set('rai-set', set); }
set = Object.assign(E.defaults(), set);
let st = Object.assign(E.newState(), D.get('rai', null) || {});
st.hist = st.hist || {};
let plan = E.makePlan(idx, ST, set, st);
let run = st.run || null;           // lopende sessie (blijft bewaard als je de app sluit)
if (run) run.live = false;          // na opnieuw openen: eerst de kaart "Resume" op Today
let view = !run && ['#path', '#progress', '#practice'].includes(location.hash) ? location.hash.slice(1) : 'today';
const openUnits = {};

const pct = x => Math.round((x || 0) * 100) + '%';
const nice = (d, o) => { const x = E.parse(d); return x ? x.toLocaleDateString('en-GB', o || { weekday: 'short', day: 'numeric', month: 'short' }) : ''; };
const rel = n => n == null ? '' : n === 0 ? 'today' : n === 1 ? 'tomorrow' : n === -1 ? 'yesterday' : n > 1 ? (n < 60 ? `in ${n} days` : `in ${Math.round(n / 7)} weeks`) : `${-n} days ago`;
function save() {
  st.run = run;
  st.hist[T()] = Math.round(E.readiness(st, idx) * 1000) / 1000;
  D.set('rai', st);
  dash();
}
function replan() { plan = E.makePlan(idx, ST, set, st); }

// ---------------------------------------------------------------- tekst
function md(s) {
  const fmt = t => esc(t).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
  return s.split(/\n\s*\n/).map(block => {
    const lines = block.split('\n');
    if (lines.every(l => l.startsWith('• '))) return '<ul>' + lines.map(l => `<li>${fmt(l.slice(2))}</li>`).join('') + '</ul>';
    const head = [], items = [];
    lines.forEach(l => (l.startsWith('• ') ? items : (items.length ? items : head)).push(l));
    return (head.length ? `<p>${head.map(fmt).join('<br>')}</p>` : '') + (items.length ? '<ul>' + items.map(l => `<li>${fmt(l.replace(/^• /, ''))}</li>`).join('') + '</ul>' : '');
  }).join('');
}
const unitOf = id => E.UNIT[idx.lo[id].unit];
const bossOf = id => ST.bosses[id];
const TYPES = {
  learn: { em: '📘', t: 'Lesson day' }, review: { em: '🗂️', t: 'Case file review' }, boss: { em: '⚔️', t: 'Boss battle' },
  mock: { em: '📝', t: 'Mock exam' }, drill: { em: '🎯', t: 'Weak-spot drill' }, light: { em: '🧘', t: 'Light review' },
  exam: { em: '🎓', t: 'Exam day' }, done: { em: '🏁', t: 'After the exam' }
};

// ---------------------------------------------------------------- weergave
function setView(v) {
  view = v;
  $$('#seg button').forEach(b => b.classList.toggle('on', b.dataset.v === v));
  history.replaceState(null, '', '#' + v);
  render();
}
$('#seg').onclick = e => { const b = e.target.closest('[data-v]'); if (b) { if (run && run.live) return; setView(b.dataset.v); } };
function render() {
  document.body.classList.toggle('session', !!(run && run.live));
  $('#seg').style.display = run && run.live ? 'none' : '';
  $('#ttl').textContent = run && run.live ? run.title : 'RAI Quest';
  if (run && run.live) return renderRun();
  ({ today: renderToday, path: renderPath, progress: renderProgress, practice: renderPractice })[view]();
  scrollTo(0, 0);
}

function statusCard(s) {
  const ic = { ahead: '🚀', ok: '✅', warn: '⚠️', bad: '⏰' }[s.tone];
  const lead = s.delta === 0 ? 'Exactly on plan' : s.delta > 0 ? `${s.delta} lesson${s.delta === 1 ? '' : 's'} ahead` : `${-s.delta} lesson${s.delta === -1 ? '' : 's'} behind (≈ ${Math.max(1, -s.daysDelta)} study day${s.daysDelta === -1 ? '' : 's'})`;
  return `<div class="card"><div class="tone ${s.tone}"><span class="dot">${ic}</span><div class="grow"><b>${esc(s.label)}</b><div class="muted small">${lead} · ${s.done}/${s.total} objectives studied, ${s.planned} planned so far</div></div></div>
    <div class="meter" aria-label="Readiness ${pct(s.ready)}, expected ${pct(s.exp)}, target ${pct(set.target)}"><i style="width:${Math.min(100, s.ready * 100)}%"></i><u style="left:calc(${Math.min(100, s.exp * 100)}% - 1px)"></u><s style="left:${set.target * 100}%"></s></div>
    <div class="leg"><span style="--c:var(--c-act)">Readiness <b style="color:var(--text)">${pct(s.ready)}</b></span><span style="--c:var(--c-plan)">Expected today ${pct(s.exp)}</span><span style="--c:var(--text)">Target ${pct(set.target)}</span></div></div>`;
}

// ---------------------------------------------------------------- TODAY
function renderToday() {
  const d = T(), s = E.status(st, plan, idx, set, d), lv = E.level(st.xp), sk = E.streak(st, d);
  const ses = E.session(st, plan, idx, ST, set, d, seedOf(d));
  const L = st.log[d] || {};
  const info = TYPES[ses.type] || TYPES.review;
  const back = E.backlog(st, plan, idx, d);
  let body = '';
  if (d < set.start) body = `<p class="muted">Your path starts on ${esc(nice(set.start, { weekday: 'long', day: 'numeric', month: 'long' }))}. You can already study ahead below.</p>`;
  else if (ses.type === 'exam') body = `<p>Today is the day. Sleep well, eat breakfast, bring your ID, trust your preparation. Readiness: <b>${pct(s.ready)}</b>. Good luck, ${esc(ST.hero.split(',')[0])}! 🍀</p>`;
  else if (ses.type === 'done') body = `<p>The exam date has passed. Change it in settings (⚙️) if you are taking the next sitting (October 2027).</p>`;
  else {
    let sub = '';
    if (ses.type === 'learn') sub = ses.los.map(id => `<div class="small">• ${esc(idx.lo[id].t)}</div>`).join('') + `<div class="small muted" style="margin-top:6px">${ses.qids.length} questions · ≈ ${Math.max(10, ses.los.length * 8 + ses.qids.length * 1.5 | 0)} min</div>`;
    else if (ses.type === 'boss') { const b = bossOf(ses.boss); sub = `<div style="font-size:15px"><b>${b.emoji} ${esc(b.naam)}</b> — “${esc(b.taunt)}”</div><div class="small muted" style="margin-top:6px">12 questions · 3 hearts · 3 min per question (exam pace)</div>`; }
    else if (ses.type === 'mock') sub = `<div class="small">80 questions weighted like the real exam · 4 hours · you can pause and continue later.</div>`;
    else sub = (ses.blocked ? `<div class="small" style="margin-bottom:6px">⚔️ Today's boss unlocks after ${ses.blocked} more lesson${ses.blocked === 1 ? '' : 's'} — review instead.</div>` : '') + `<div class="small muted">${ses.qids.length} questions from what you've studied, weakest and due first.</div>`;
    const ep = ses.type === 'learn' ? episodeFor(ses.los) : null;
    const story = ep ? ST.episodes[ep] : ses.case;
    body = `${story ? `<div class="kicker">${esc(story.t)}</div><div class="story">${esc(story.s)}</div>` : ''}${sub}
      <div class="btns" style="margin-top:12px">${L.done ? `<button class="btn q wide" data-act="start" type="button">${icon('refresh')}Do it again (no streak XP)</button>` : `<button class="btn wide" data-act="start" type="button" ${ses.qids.length || ses.los.length ? '' : 'disabled'}>${icon('play')}Start today's challenge</button>`}</div>`;
  }
  app.innerHTML = `
    ${run ? `<div class="card acc"><b>Session in progress</b><div class="muted small">${esc(run.title)} · ${Math.min(run.qi, run.qids.length)}/${run.qids.length} answered</div><div class="btns" style="margin-top:10px"><button class="btn" data-act="resume" type="button">${icon('play')}Resume</button><button class="btn q" data-act="drop" type="button">Stop</button></div></div>` : ''}
    <div class="card"><div class="hero"><div class="lvl"><div><small>Lvl</small><b>${lv.lvl}</b></div></div><div class="t"><b>${esc(lv.titel)}</b><span class="muted small">${st.xp} XP · ${lv.to - st.xp} to level ${lv.lvl + 1}${lv.next ? ` · next title at ${lv.next.lvl}: ${esc(lv.next.titel)}` : ''}</span><div class="xpbar"><i style="width:${lv.pct * 100}%"></i></div></div></div>
      <div class="stats"><div class="stat"><b>${sk.n}${sk.today ? '🔥' : ''}</b><span>day streak${sk.shields ? ' · ' + '🛡️'.repeat(sk.shields) : ''}</span></div><div class="stat"><b>${Math.max(0, s.daysLeft)}</b><span>days to exam</span></div><div class="stat"><b>${s.due}</b><span>reviews due</span></div></div></div>
    ${statusCard(s)}
    <div class="card chal${L.done ? '' : ' acc'}"><span class="big">${L.done ? '✅' : info.em}</span><div class="kicker">${esc(nice(d, { weekday: 'long', day: 'numeric', month: 'long' }))}${L.done ? ' · completed' : ''}</div><h3>${esc(info.t)}</h3>${body}</div>
    ${back.length ? `<div class="card"><b>Catch up</b><div class="muted small">${back.length} planned lesson${back.length === 1 ? '' : 's'} not studied yet, oldest: ${esc(idx.lo[back[0]].t)}.</div><div class="btns" style="margin-top:10px"><button class="btn" data-act="catch" type="button">${icon('play')}Catch up 2 lessons</button></div></div>` : ''}
    ${!back.length && (L.done || !(ses.qids.length || ses.los.length)) && E.nextLos(st, idx, 1).length ? `<div class="card"><b>Feeling strong?</b><div class="muted small">Study ahead: ${esc(idx.lo[E.nextLos(st, idx, 1)[0]].t)}</div><div class="btns" style="margin-top:10px"><button class="btn q" data-act="ahead" type="button">${icon('plus')}Next lesson</button></div></div>` : ''}
    ${mileCard(d)}
    ${!Object.keys(st.lo).length ? `<div class="card"><div class="kicker">Your story</div><div class="story">${esc(ST.intro)}</div></div>` : ''}`;
}
const seedOf = d => +d.replace(/-/g, '') + Object.keys(st.lo).length;
function episodeFor(los) {
  const u = idx.lo[los[0]].unit;
  return idx.unitLos[u][0] === los[0] || !Object.keys(st.lo).some(id => idx.lo[id].unit === u) ? u : null;
}
function mileCard(d) {
  const open = E.MIJLPALEN.filter(m => !st.mijl[m.id] && D.date.days(m.d) <= 45);
  if (!open.length) return '';
  return `<div class="card"><b>Milestones</b>${open.map(m => mileRow(m)).join('')}</div>`;
}
const mileRow = m => `<div class="mile${st.mijl[m.id] ? ' on' : ''}"><button class="box" data-mile="${m.id}" type="button" aria-label="Done">${st.mijl[m.id] ? icon('check') : ''}</button><div class="grow"><b>${esc(m.t)}</b><span>${esc(m.sub)}</span><span>${st.mijl[m.id] ? 'Done ' + esc(nice(st.mijl[m.id])) : 'Before ' + esc(nice(m.d, { day: 'numeric', month: 'long', year: 'numeric' })) + ' · ' + esc(rel(D.date.days(m.d)))}</span></div></div>`;

// ---------------------------------------------------------------- PATH
function renderPath() {
  const d = T(), um = E.unitMastery(st, idx);
  const bossAfter = {}; E.BOSSES.forEach(b => { const us = bossOf(b).units; bossAfter[us[us.length - 1]] = b; });
  let cur = E.nextLos(st, idx, 1)[0];
  const curUnit = cur ? idx.lo[cur].unit : null;
  if (curUnit && openUnits[curUnit] == null) openUnits[curUnit] = true;
  app.innerHTML = `
