/** Lijngrafiek met haarlijn en tooltip. series: [{name, color, dash, vals:[number|null]}], xs: datums. */
function lineChart(host, xs, series, o) {
  const W = 340, H = 180, P = { l: 30, r: 10, t: 10, b: 22 };
  const n = xs.length, ymax = o.ymax;
  const X = i => P.l + (W - P.l - P.r) * (n <= 1 ? 0 : i / (n - 1)), Y = v => H - P.b - (H - P.t - P.b) * (v / ymax);
  const ticks = o.ticks;
  const ti = xs.indexOf(T());
  const months = []; xs.forEach((d, i) => { if (d.endsWith('-01') || i === 0) months.push(i); });
  const path = s => { let p = '', pen = false; s.vals.forEach((v, i) => { if (v == null) { pen = false; return; } p += (pen ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1); pen = true; }); return p; };
  host.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(o.label)}">
    ${ticks.map(t => `<line x1="${P.l}" x2="${W - P.r}" y1="${Y(t)}" y2="${Y(t)}" stroke="var(--line)" stroke-width="1"/><text x="${P.l - 5}" y="${Y(t) + 4}" text-anchor="end" font-size="10" fill="var(--muted)">${esc(o.fmt(t))}</text>`).join('')}
    ${months.map(i => `<text x="${X(i)}" y="${H - 6}" font-size="10" fill="var(--muted)" text-anchor="${i === 0 ? 'start' : 'middle'}">${esc(nice(xs[i], { month: 'short' }))}</text>`).join('')}
    ${o.refs ? o.refs.map(r => `<line x1="${P.l}" x2="${W - P.r}" y1="${Y(r.v)}" y2="${Y(r.v)}" stroke="var(--muted)" stroke-width="1" stroke-dasharray="2 3"/><text x="${W - P.r}" y="${Y(r.v) - 4}" text-anchor="end" font-size="10" fill="var(--muted)">${esc(r.t)}</text>`).join('') : ''}
    ${ti >= 0 ? `<line x1="${X(ti)}" x2="${X(ti)}" y1="${P.t}" y2="${H - P.b}" stroke="var(--text)" stroke-opacity=".35" stroke-width="1"/><text x="${X(ti)}" y="${P.t + 8}" font-size="10" fill="var(--muted)" text-anchor="${ti > n * 0.8 ? 'end' : 'start'}" dx="${ti > n * 0.8 ? -4 : 4}">today</text>` : ''}
    ${series.map(s => `<path d="${path(s)}" fill="none" stroke="${s.color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" ${s.dash ? 'stroke-dasharray="5 4"' : ''}/>`).join('')}
    <line class="xh" y1="${P.t}" y2="${H - P.b}" stroke="var(--text)" stroke-width="1" style="display:none"/>
    ${series.map((s, k) => `<circle class="pt${k}" r="4" fill="${s.color}" stroke="var(--panel)" stroke-width="2" style="display:none"/>`).join('')}
  </svg><div class="tip"></div>`;
  const svg = $('svg', host), tip = $('.tip', host), xh = $('.xh', svg);
  const move = e => {
    const r = svg.getBoundingClientRect(), x = (e.clientX - r.left) / r.width * W;
    const i = Math.max(0, Math.min(n - 1, Math.round((x - P.l) / (W - P.l - P.r) * (n - 1))));
    xh.setAttribute('x1', X(i)); xh.setAttribute('x2', X(i)); xh.style.display = '';
    series.forEach((s, k) => { const c = $('.pt' + k, svg), v = s.vals[i]; if (v == null) { c.style.display = 'none'; return; } c.setAttribute('cx', X(i)); c.setAttribute('cy', Y(v)); c.style.display = ''; });
    tip.innerHTML = '';
    const hd = document.createElement('div'); hd.textContent = nice(xs[i], { weekday: 'short', day: 'numeric', month: 'short' }); hd.className = 'muted'; tip.appendChild(hd);
    series.forEach(s => { const v = s.vals[i]; if (v == null) return; const row = document.createElement('div'); const k = document.createElement('span'); k.className = 'k'; k.style.background = s.color; const b = document.createElement('strong'); b.textContent = o.fmt(v); row.append(k, b, document.createTextNode(' ' + s.name)); tip.appendChild(row); });
    tip.style.display = 'block';
    const px = X(i) / W * r.width;
    tip.style.left = Math.max(0, Math.min(r.width - tip.offsetWidth, px - tip.offsetWidth / 2)) + 'px';
  };
  svg.addEventListener('pointermove', move);
  svg.addEventListener('pointerdown', move);
  svg.addEventListener('pointerleave', () => { tip.style.display = 'none'; xh.style.display = 'none'; series.forEach((s, k) => { $('.pt' + k, svg).style.display = 'none'; }); });
}
function dates() { const xs = []; for (let x = set.start; x <= set.exam; x = E.add(x, 1)) xs.push(x); return xs; }
function chartLessons(host, tbl) {
  const xs = dates(), d = T();
  const pc = {}, ac = {};
  Object.values(plan.loDate).forEach(x => { pc[x] = (pc[x] || 0) + 1; });
  Object.values(st.lo).forEach(x => { const k = x.d < set.start ? set.start : x.d; ac[k] = (ac[k] || 0) + 1; });
  let p = 0, a = 0;
  const pv = xs.map(x => (p += pc[x] || 0)), av = xs.map(x => { a += ac[x] || 0; return x <= d ? a : null; });
  const tot = idx.los.length;
  lineChart(host, xs, [{ name: 'planned', color: 'var(--c-plan)', dash: true, vals: pv }, { name: 'studied', color: 'var(--c-act)', vals: av }],
    { ymax: tot, ticks: [0, 25, 50, 75, 100].filter(t => t <= tot), fmt: v => String(Math.round(v)), label: 'Learning objectives studied versus planned over time' });
  const rows = [];
  for (let i = 0; i < xs.length; i += 7) rows.push(`<tr><td>${esc(nice(xs[i], { day: 'numeric', month: 'short' }))}</td><td>${pv[i]}</td><td>${av[i] == null ? '–' : av[i]}</td></tr>`);
  tbl.innerHTML = `<table class="tv"><tr><th>Week of</th><th>Planned</th><th>Studied</th></tr>${rows.join('')}</table>`;
}
function chartReady(host) {
  const xs = dates(), d = T();
  const ev = xs.map(x => E.expected(plan, idx, set, x));
  let last = null;
  const rv = xs.map(x => { if (x > d) return null; if (st.hist[x] != null) last = st.hist[x]; return last == null ? 0 : last; });
  lineChart(host, xs, [{ name: 'expected', color: 'var(--c-plan)', dash: true, vals: ev }, { name: 'readiness', color: 'var(--c-act)', vals: rv }],
    { ymax: 1, ticks: [0, 0.25, 0.5, 0.75, 1], fmt: v => pct(v), refs: [], label: 'Readiness versus expected readiness over time' });
}
function heat(host) {
  const d = T(); let start = E.add(d, -83); while (E.dow(start) !== 1) start = E.add(start, -1);
  const cells = [];
  for (let x = start; x <= d; x = E.add(x, 1)) {
    const l = st.log[x], xp = l ? l.xp : 0;
    const a = xp <= 0 ? 0 : xp < 60 ? 0.35 : xp < 150 ? 0.6 : xp < 250 ? 0.8 : 1;
    cells.push(`<i title="${esc(nice(x))}: ${xp} XP${l && l.done ? ' · challenge done' : ''}" style="${a ? `background:color-mix(in srgb,var(--c-act) ${a * 100}%,var(--panel2))` : ''}"></i>`);
  }
  host.innerHTML = cells.join('');
}

