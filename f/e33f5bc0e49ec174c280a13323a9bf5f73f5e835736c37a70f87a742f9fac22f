/* run = { live, kind: daily|catch|ahead|practice|drill|boss|mock, title, d, los, li (lesindex), qids, qi, picks:{}, ok, xp,
           boss, hp, hearts, qsec, limit, el (seconden), seed, done } */
function startRun(o) {
  if (run && !run.done) { toast('Finish or stop the current session first.'); return; }
  run = Object.assign({ live: true, d: T(), los: [], li: 0, qids: [], qi: 0, picks: {}, ok: 0, xp: 0, el: 0, seed: Date.now() % 1e9, phase: 'lessons', xp0: st.xp, badges0: E.badges(st, idx, T()).filter(b => b.got).map(b => b.id) }, o);
  if (run.kind === 'boss') Object.assign(run, { hp: 100, hearts: 3, qsec: 0, phase: 'intro' });
  if (run.kind === 'mock') Object.assign(run, { phase: 'intro' });
  if (run.story) run.phase = 'story';
  else if (!run.los.length && run.phase === 'lessons') run.phase = 'quiz';
  save(); render();
}
function startDaily() {
  const d = T(), ses = E.session(st, plan, idx, ST, set, d, seedOf(d));
  const info = TYPES[ses.type] || TYPES.review;
  if (ses.type === 'boss') return startBoss(ses.boss, true);
  if (ses.type === 'mock') return startMock(80, true);
  const ep = ses.type === 'learn' ? episodeFor(ses.los) : null;
  startRun({ kind: 'daily', title: info.t, los: ses.los, qids: ses.qids, story: ep ? ST.episodes[ep] : ses.case });
}
function startBoss(b, daily) {
  if (E.bossReady(st, idx, ST, b).length) { toast('Study all lessons of this boss\'s chapters first.'); return; }
  startRun({ kind: 'boss', daily: !!daily, boss: b, title: bossOf(b).naam, qids: E.bossSet(st, idx, ST, b, 12, E.rng(Date.now())) });
}
function startMock(n, daily) {
