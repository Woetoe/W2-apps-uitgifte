/* ================================================================ kliks */
app.addEventListener('click', e => {
  const el = e.target.closest('[data-a]');
  if (!el) return;
  const a = el.dataset.a;
  if (a === 'scrim') { if (e.target.closest('[data-stop]')) return; if (ui.sheet === 'result') return; ui.sheet = null; refresh(); return; }
  switch (a) {
    case 'exit': leaveNet(); location.href = '../index.html'; return;
    case 'home': leaveNet(); view = 'home'; ui.sheet = null; break;
    case 'host': openHost(); break;
    case 'join': openJoin(); break;
    case 'settings': ui.sheet = 'settings'; break;
    case 'powers': ui.sheet = 'powers'; break;
    case 'menu': ui.sheet = 'menu'; break;
    case 'close': ui.sheet = (ui.sheet === 'settings' && G && G.phase === 'over') ? 'result' : null; if (view === 'game' && S.control === 'tilt') input.zero = input.ax; break;
    case 'tog': S[el.dataset.k] = !S[el.dataset.k]; saveS(); if (el.dataset.k === 'vibrate') buzz(30); if (el.dataset.k === 'sound') sTake(); break;
    case 'control': S.control = el.dataset.v; saveS(); input.zero = input.ax; if (view === 'game' && G) { const keep = ui.sheet; buildGame(); ui.sheet = keep; } break;
    case 'tilt': S.tilt = el.dataset.v; saveS(); break;
    case 'botadd': if (L.players.length < MAXP) { const c = L.players.filter(p => p.kind === 'cpu').length; L.players.push({ name: 'Computer ' + (c + 1), kind: 'cpu', level: S.botLevel }); renumberBots(); lobbyChanged(); } return;
    case 'botdel': L.players.splice(+el.dataset.i, 1); renumberBots(); lobbyChanged(); return;
    case 'botlevel': { const p = L.players[+el.dataset.i]; const lv = ['easy', 'normal', 'strong']; p.level = lv[(lv.indexOf(p.level) + 1) % 3]; S.botLevel = p.level; lobbyChanged(); return; }
    case 'walls': L.walls = el.dataset.v; lobbyChanged(); return;
    case 'pw': { const id = el.dataset.id, i = L.powers.indexOf(id); if (i >= 0) L.powers.splice(i, 1); else L.powers.push(id); L.powers.sort((x, y) => K.POWERS.findIndex(p => p.id === x) - K.POWERS.findIndex(p => p.id === y)); lobbyChanged(); return; }
    case 'pwall': L.powers = el.dataset.v === '1' ? K.POWERS.map(p => p.id) : []; lobbyChanged(); return;
    case 'readvertise': net.err = ''; advertise(); break;
    case 'start': startGame(); return;
    case 'again': ui.sheet = null; startGame(); return;
    case 'tolobby': stopGameToLobby(); return;
    case 'pause': setPause(!G.paused); ui.sheet = null; break;
    case 'search': search(); break;
    case 'stopsearch': NET.stop(); net.status = 'idle'; break;
    case 'connect': net.status = 'connecting'; net.hostName = net.found.get(el.dataset.id) || ''; NET.connect(el.dataset.id); break;
    case 'leave': leaveNet(); openJoin(); ui.sheet = null; break;
  }
  refresh();
});
function renumberBots() { let c = 0; L.players.forEach(p => { if (p.kind === 'cpu') p.name = 'Computer ' + (++c); }); }
app.addEventListener('input', e => {
  if (e.target.dataset.in !== 'name') return;
  const v = e.target.value; setName(v);
  if (role === 'host' && L) { const me = L.players.find(p => p.tok === TOK); if (me) me.name = v.trim() || 'Jij'; clearTimeout(nameT); nameT = setTimeout(() => { lobbyChanged(); }, 400); }
  if (role === 'join' && net.status === 'connected') { clearTimeout(nameT); nameT = setTimeout(() => send({ t: 'name', name: v.trim() || 'Speler' }), 500); }
});
let nameT = 0;
window.__w2back = function () {
  if (ui.sheet && ui.sheet !== 'result') { ui.sheet = (ui.sheet === 'settings' && G && G.phase === 'over') ? 'result' : null; refresh(); return true; }
  if (view === 'game') { ui.sheet = 'menu'; refresh(); return true; }
  if (view !== 'home') { leaveNet(); view = 'home'; ui.sheet = null; render(); return true; }
  return false;
};
window.addEventListener('pagehide', () => { if (role) leaveNet(); });
document.addEventListener('visibilitychange', () => { if (document.hidden && role === 'host' && G && G.phase === 'play' && !G.paused) setPause(true); });
if (document.fonts && document.fonts.load) document.fonts.load('800 24px "Bricolage Grotesque"');
render();
})();
</script>
