<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<title>Kronkel</title>
<link rel="stylesheet" href="../fonts/fonts.css">
<style>
/* Lichtgevende lijnen op een zwart veld; alles daaromheen blijft rustig zodat het veld spreekt. */
:root{
  --bg:#0c0c11; --bg2:#14141c; --panel:#1b1b25; --line:#2c2c3b; --field:#050508;
  --text:#f4f1ea; --muted:#9d9bb0; --accent:#ffd23f; --accent-ink:#1d1600; --good:#3ddc84; --warn:#ff8a6b;
  --f-display:"Bricolage Grotesque",system-ui,sans-serif; --f-body:"Figtree",system-ui,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--text);font:16px/1.45 var(--f-body);-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;overscroll-behavior:none}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
#app{height:100%}
.wrap{max-width:520px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;gap:16px;
  padding:calc(env(safe-area-inset-top,0px) + 12px) max(16px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 20px) max(16px,env(safe-area-inset-left,0px))}
h1,h2,h3{font-family:var(--f-display);font-weight:800;margin:0;letter-spacing:-.01em;text-wrap:balance}
p{margin:0}
.muted{color:var(--muted)}
.note{font-size:14px;color:var(--muted)}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.back{display:flex;align-items:center;gap:6px;background:none;border:0;color:var(--muted);font-weight:600;padding:10px 4px}
.iconbtn{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--bg2);display:grid;place-items:center;flex:none}
.iconbtn svg{width:22px;height:22px}
.btn{border:0;border-radius:14px;padding:14px 16px;min-height:52px;font-weight:700;font-size:17px;background:var(--accent);color:var(--accent-ink)}
.btn:active{transform:translateY(1px)}
.btn:disabled{opacity:.4}
.btn.quiet{background:var(--panel);color:var(--text);border:1px solid var(--line)}
.btn.small{min-height:40px;padding:8px 14px;font-size:15px}
.hero h1{font-size:52px;line-height:.9;letter-spacing:-.03em}
.hero p{margin-top:8px;color:var(--muted)}
.hero svg{width:100%;height:auto;display:block;margin-top:14px;border-radius:18px}
.choices{display:flex;flex-direction:column;gap:10px}
.choice{display:flex;align-items:center;gap:14px;text-align:left;background:var(--bg2);border:1px solid var(--line);border-radius:16px;padding:14px 16px;min-height:76px}
.choice .ic{width:44px;height:44px;border-radius:12px;flex:none;display:grid;place-items:center;background:var(--panel)}
.choice .ic svg{width:26px;height:26px}
.choice b{display:block;font-size:17px}
.choice span{color:var(--muted);font-size:14px}
.choice:disabled{opacity:.5}
.label{font-weight:700;display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.label small{font-weight:500;color:var(--muted);font-size:14px}
.field{display:flex;flex-direction:column;gap:8px}
.input{background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:13px 14px;font-size:17px;-webkit-user-select:text;user-select:text;width:100%}
.input:focus{outline:none;border-color:var(--accent)}
.seg{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;background:var(--bg2);border:1px solid var(--line);border-radius:12px;padding:4px;gap:4px}
.seg button{border:0;background:none;border-radius:9px;padding:10px 4px;font-weight:600;color:var(--muted);font-size:15px}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink)}
.players{display:flex;flex-direction:column;gap:8px}
.pl{display:grid;grid-template-columns:18px 1fr auto;gap:12px;align-items:center;background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:8px 8px 8px 14px;min-height:56px}
.pl .dot{width:18px;height:18px;border-radius:50%;box-shadow:0 0 10px currentColor}
.pl .nm{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pl .nm small{display:block;font-weight:500;color:var(--muted);font-size:13px}
.pl .acts{display:flex;gap:6px;align-items:center}
.pill{border:1px solid var(--line);background:var(--panel);border-radius:10px;padding:8px 11px;font-size:14px;font-weight:600;min-height:40px}
.xbtn{width:40px;height:40px;border-radius:10px;border:1px solid var(--line);background:var(--panel);display:grid;place-items:center}
.xbtn svg{width:16px;height:16px}
.status{display:flex;align-items:center;gap:12px;background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.status b{display:block}
.pulse{width:14px;height:14px;border-radius:50%;background:var(--accent);animation:pu 1.2s ease-in-out infinite;flex:none}
.pulse.off{animation:none;background:var(--line)}
@keyframes pu{0%,100%{transform:scale(.7);opacity:.5}50%{transform:scale(1.1);opacity:1}}
.tip{background:var(--bg2);border-left:3px solid var(--accent);border-radius:6px 12px 12px 6px;padding:12px 14px;font-size:15px;color:var(--muted)}
.tip b{color:var(--text)}
.err{color:var(--warn);font-weight:600}
.summary{display:flex;align-items:center;gap:12px;background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:10px 10px 10px 14px}
.summary .tx{flex:1}
.summary .tx small{display:block;color:var(--muted);font-size:14px}
.minis{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px}
.minis svg{width:22px;height:22px;border-radius:50%}
.sticky{position:sticky;bottom:0;padding:10px 0 calc(env(safe-area-inset-bottom,0px) + 4px);background:linear-gradient(transparent,var(--bg) 30%);margin-top:auto}
.sticky .btn{width:100%}

/* spel */
.game{height:100%;display:grid;grid-template-rows:auto 1fr auto auto;gap:6px;max-width:640px;margin:0 auto;
  padding:calc(env(safe-area-inset-top,0px) + 6px) max(8px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 8px) max(8px,env(safe-area-inset-left,0px));touch-action:none}
.hud{display:flex;align-items:center;gap:8px;min-height:44px}
.chips{flex:1;display:flex;flex-wrap:wrap;gap:5px;justify-content:center}
.chip{display:flex;align-items:center;gap:6px;background:var(--bg2);border:1.5px solid transparent;border-radius:999px;padding:3px 10px 3px 4px;font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;transition:opacity .2s}
.chip i{width:16px;height:16px;border-radius:50%;display:block;flex:none}
.chip.me{border-color:var(--text)}
.chip.out{opacity:.38}
.chip em{font-style:normal;font-weight:500;color:var(--muted);max-width:64px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.goal{font-size:13px;color:var(--muted);text-align:right;line-height:1.15;flex:none;min-width:40px}
.goal b{display:block;font:800 17px/1 var(--f-display);color:var(--text)}
.stage{position:relative;min-height:0;display:grid;place-items:center}
.fieldbox{position:relative;background:var(--field);border-radius:6px;box-shadow:0 0 0 1px #1d1d29,0 10px 40px #000a}
.fieldbox canvas{position:absolute;inset:0;display:block}
.banner{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none}
.banner>div{background:#0c0c11e6;border:1px solid var(--line);border-radius:18px;padding:16px 20px;text-align:center;min-width:220px;max-width:88%;animation:pop .25s ease-out}
.banner h2{font-size:28px;line-height:1.05}
.banner p{color:var(--muted);margin-top:4px;font-size:15px}
@keyframes pop{from{transform:scale(.9);opacity:0}}
.fxrow{display:flex;gap:8px;justify-content:center;align-items:center;min-height:30px;font-size:14px;color:var(--muted)}
.fx{display:flex;align-items:center;gap:5px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--text)}
.fx svg{width:24px;height:24px;border-radius:50%}
.ctl{display:grid;grid-template-columns:1fr 1fr;gap:8px;height:clamp(112px,23vh,210px)}
.ctl button{border:0;border-radius:22px;background:var(--bg2);border:1.5px solid var(--line);display:grid;place-items:center;touch-action:none;transition:background .06s}
.ctl button svg{width:56px;height:56px;opacity:.85}
.ctl button.on{background:color-mix(in srgb,var(--me,#ffd23f) 28%,var(--bg2));border-color:var(--me,#ffd23f)}
.ctl .hint{grid-column:1/-1;text-align:center;font-size:13px;color:var(--muted);margin-top:-4px}

/* vellen */
.scrim{position:fixed;inset:0;background:#05050ac2;z-index:20;display:flex;align-items:flex-end;justify-content:center;padding:16px max(12px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 12px) max(12px,env(safe-area-inset-left,0px))}
.sheet{width:100%;max-width:520px;max-height:100%;overflow:auto;background:var(--bg2);border:1px solid var(--line);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:14px}
.sheet h2{font-size:26px}
.sheet h3{font-size:17px;margin-top:4px}
.sheet-head{display:flex;justify-content:space-between;align-items:center;gap:10px}
.row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:4px 0}
.row .d{font-size:14px;color:var(--muted)}
.row .ig{display:flex;align-items:center;gap:12px}
.row .ig svg{width:34px;height:34px;border-radius:50%;flex:none}
.toggle{width:52px;height:30px;border-radius:15px;border:0;background:var(--line);position:relative;flex:none}
.toggle::after{content:"";position:absolute;top:4px;left:4px;width:22px;height:22px;border-radius:50%;background:var(--text);transition:transform .15s}
.toggle[aria-pressed="true"]{background:var(--good)}
.toggle[aria-pressed="true"]::after{transform:translateX(22px)}
.list{display:flex;flex-direction:column;gap:8px}
.list .btn{width:100%}
.rank{display:flex;flex-direction:column;gap:6px;width:100%}
.rank div{display:grid;grid-template-columns:22px 16px 1fr auto;gap:10px;align-items:center;background:var(--panel);border-radius:10px;padding:10px 12px;text-align:left;font-variant-numeric:tabular-nums}
.rank i{width:16px;height:16px;border-radius:50%;display:block}
.rank b:last-child{font-size:18px}
.result{text-align:center;display:flex;flex-direction:column;gap:12px;align-items:center}
.result h2{font-size:36px;line-height:1}
.tiltmeter{position:relative;height:30px;background:var(--panel);border-radius:15px;overflow:hidden}
.tiltmeter i{position:absolute;top:5px;width:20px;height:20px;border-radius:50%;background:var(--accent);left:calc(50% - 10px);transition:left .08s}
.tiltmeter::before,.tiltmeter::after{content:"";position:absolute;top:0;bottom:0;width:2px;background:var(--line)}
.tiltmeter::before{left:var(--th1)}.tiltmeter::after{left:var(--th2)}
.rules ul{margin:6px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:15px}
.rules summary{cursor:pointer}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="app"></div>
<script src="../w2.js"></script>
<script src="engine.js"></script>
<script>
(function () {
'use strict';
const K = window.KRONKEL;
const NET = window.W2 && W2.net;
const GAME = 'kronkel';
const app = document.getElementById('app');

const COLORS = ['#ff4d4d', '#ffd23f', '#3ddc84', '#3d9bff', '#ff5fc8', '#ff9a2e', '#2fe0d9', '#a77bff'];
const CNAMES = ['Rood', 'Geel', 'Groen', 'Blauw', 'Roze', 'Oranje', 'Turkoois', 'Paars'];
const KIND_COL = { self: '#2fb862', others: '#e5484d', all: '#3b82f6' };
const KIND_NAME = { self: 'Voor jezelf', others: 'Voor de anderen', all: 'Voor iedereen' };
const LEVEL_NAME = { easy: 'Makkelijk', normal: 'Normaal', strong: 'Sterk' };
const MAXP = 8, STEP_MS = 1000 / 60, FRAME_EVERY = 3, FRAME_MS = FRAME_EVERY * STEP_MS, COUNT_MS = 2400, ROUND_PAUSE = 2900;
const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const r1 = v => Math.round(v * 10) / 10;

/* ---------------- tekeningetjes van de power-ups (24×24, lijnen) ---------------- */
const GLYPH = {
  fast: { d: 'M5 6l6 6-6 6M12 6l6 6-6 6' },
  slow: { d: 'M12 6l6 6-6 6M4.5 12h.01M8.5 12h.01', w: 2.8 },
  thin: { d: 'M6 18L18 6', w: 1.4 },
  thick: { d: 'M7.5 16.5l9-9', w: 6.5 },
  square: { d: 'M7 19V8h11M15 5l3 3-3 3' },
  ghost: { d: 'M6.5 19.5V11a5.5 5.5 0 0 1 11 0v8.5l-2.2-1.6-2.2 1.6-2.2-1.6-2.2 1.6-2.2-1.6zM10 11h.01M14 11h.01' },
  wrap: { d: 'M5 4v16M9 12h11M17 9l3 3-3 3' },
  walls: { d: 'M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5' },
  reverse: { d: 'M4 8h13M14 5l3 3-3 3M20 16H7M10 13l-3 3 3 3' },
  clear: { d: 'M18.5 9.5A7 7 0 1 0 19 14M19 4.5v5h-5' }
};
const PATHS = {};
function glyphSVG(id) {
  const pw = K.PBY[id], g = GLYPH[pw.glyph];
  return `<svg viewBox="0 0 34 34" aria-hidden="true"><circle cx="17" cy="17" r="17" fill="${KIND_COL[pw.kind]}"/><g transform="translate(5 5)" fill="none" stroke="#fff" stroke-width="${g.w || 2.4}" stroke-linecap="round" stroke-linejoin="round"><path d="${g.d}"/></g></svg>`;
}

const IC = {
  back: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>',
  gear: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2.2"/><circle cx="10" cy="17" r="2.2"/></svg>',
  menu: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>',
  host: '<svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><rect x="8" y="6" width="8" height="14" rx="2"/><path d="M5 9.5a8 8 0 0 0 0 7M19 9.5a8 8 0 0 1 0 7M2.5 7.5a12 12 0 0 0 0 11M21.5 7.5a12 12 0 0 1 0 11"/></svg>',
  join: '<svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><rect x="2.5" y="6" width="7" height="13" rx="2"/><rect x="14.5" y="6" width="7" height="13" rx="2"/><path d="M10.5 12.5h3M12 11l1.5 1.5L12 14"/></svg>',
  left: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"><path d="M34 38V27c0-7-5-12-12-12h-9"/><path d="M19 8l-7 7 7 7"/></svg>',
  right: '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 38V27c0-7 5-12 12-12h9"/><path d="M29 8l7 7-7 7"/></svg>'
};

function heroArt() {
  return `<svg viewBox="0 0 360 200" aria-hidden="true">
    <rect width="360" height="200" fill="#050508"/>
    <g fill="none" stroke-linecap="round" stroke-width="5">
      <path d="M20 160c40-10 50-80 100-80s50 60 90 60 40-90 90-90" stroke="#ff4d4d"/>
      <path d="M40 30c30 40 90 40 110 10s70-20 80 20 20 70 70 70" stroke="#ffd23f" stroke-dasharray="120 14 400"/>
      <path d="M340 180c-40 0-60-40-100-40s-50 30-90 20-30-50-60-50" stroke="#3d9bff"/>
      <path d="M200 190c0-30 30-40 40-70" stroke="#3ddc84"/>
    </g>
    <g fill="#ffe14d"><circle cx="300" cy="50" r="5"/><circle cx="300" cy="110" r="5"/><circle cx="90" cy="90" r="5"/><circle cx="240" cy="120" r="5"/></g>
    <circle cx="140" cy="150" r="13" fill="#2fb862"/><path d="M135 144l6 6-6 6M141 144l6 6-6 6" transform="translate(-3 0)" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`;
}

/* ---------------- instellingen ---------------- */
const SKEY = 'kronkel-settings';
const S = Object.assign({
  control: 'buttons', tilt: 'mid', tiltFlip: false, sound: true, vibrate: true,
  walls: 'deadly', powers: K.POWERS.map(p => p.id), bots: [{ level: 'normal' }], botLevel: 'normal'
}, (() => { try { return JSON.parse(localStorage.getItem(SKEY) || '{}'); } catch (e) { return {}; } })());
S.powers = S.powers.filter(id => K.PBY[id]);
const saveS = () => { try { localStorage.setItem(SKEY, JSON.stringify(S)); } catch (e) {} };
const myName = () => { try { return localStorage.getItem('w2-name') || ''; } catch (e) { return ''; } };
const setName = n => { try { localStorage.setItem('w2-name', n); } catch (e) {} };
const TOK = Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);

/* ---------------- toestand ---------------- */
let view = 'home';          // home | host | join | game
let role = null;            // host | join
const ui = { sheet: null };
const net = { status: 'idle', found: new Map(), hostName: '', peers: new Map(), err: '', lobby: null, busy: false };
let L = null;               // lobby (alleen bij de host)
let G = null;               // lopend spel
let sim = null;             // simulatie (alleen bij de host)
let pending = [], wrappedAcc = [], scoresDirty = false, roundTimer = 0, countTimer = 0;

const multiOK = () => !!(NET && NET.multiAvailable && NET.multiAvailable());
const send = m => { if (NET && role) { m.game = GAME; NET.send(m); } };
const sendTo = (id, m) => { if (NET) { m.game = GAME; NET.sendTo(id, m); } };

/* ---------------- geluid en trillen ---------------- */
let ac = null;
function tone(f, d, type, vol, delay, f2) {
  if (!S.sound) return;
  try {
    ac = ac || new (window.AudioContext || window.webkitAudioContext)();
    if (ac.state === 'suspended') ac.resume();
    const t = ac.currentTime + (delay || 0), o = ac.createOscillator(), g = ac.createGain();
    o.type = type || 'sine'; o.frequency.setValueAtTime(f, t);
    if (f2) o.frequency.exponentialRampToValueAtTime(f2, t + d);
    g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol || 0.1, t + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, t + d);
    o.connect(g); g.connect(ac.destination); o.start(t); o.stop(t + d + 0.02);
  } catch (e) {}
}
const buzz = p => { if (S.vibrate) try { navigator.vibrate && navigator.vibrate(p); } catch (e) {} };
const sBeep = hi => tone(hi ? 990 : 620, hi ? 0.22 : 0.09, 'square', 0.05);
const sTake = () => tone(700, 0.14, 'triangle', 0.09, 0, 1400);
const sDie = () => tone(180, 0.35, 'sawtooth', 0.07, 0, 50);
const sWin = () => [523, 659, 784, 1047].forEach((f, i) => tone(f, 0.18, 'triangle', 0.08, i * 0.09));

/* ================================================================ netwerk */
if (NET) NET.on(ev => {
  if (!role) return;
  switch (ev.type) {
    case 'hosting': if (role === 'host') net.status = 'hosting'; break;
    case 'searching': if (role === 'join') net.status = 'searching'; break;
    case 'found': net.found.set(ev.id, ev.name); break;
    case 'lost': net.found.delete(ev.id); break;
    case 'connecting': if (role === 'join') { net.status = 'connecting'; net.hostName = ev.name || net.hostName; } break;
    case 'connected':
      if (role === 'host') net.peers.set(ev.id, { name: ev.name || 'Speler', tok: null });
      else { net.status = 'connected'; net.hostName = ev.name || net.hostName; net.found.clear(); net.err = ''; send({ t: 'hi', name: myName() || 'Speler', tok: TOK }); }
      break;
    case 'disconnected':
      if (role === 'host') peerGone(ev.id); else hostGone();
      break;
    case 'error':
      net.err = NET.explain(ev);
      if (role === 'join' && net.status !== 'connected') net.status = 'idle';
      if (role === 'host' && net.status === 'hosting' && ev.where === 'host') net.status = 'idle';
      break;
    case 'stopped': net.status = 'idle'; break;
    case 'message': {
      let m; try { m = JSON.parse(ev.data); } catch (e) { return; }
      if (m.game !== GAME) return;
      if (role === 'host') hostMsg(ev.id, m); else clientMsg(m);
      return;
    }
    default: return;
  }
  refresh();
});

/* ---------- host ---------- */
function openHost() {
  role = 'host'; view = 'host'; net.err = ''; net.peers.clear();
  advertise();
  const me = { name: myName() || 'Jij', kind: 'human', tok: TOK, ep: null };
