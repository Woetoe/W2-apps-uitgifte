  app.innerHTML = `<div class="game" style="--me:${me}">
    <div class="hud"><button class="iconbtn" data-a="menu" aria-label="Menu">${IC.menu}</button><div class="chips" id="chips"></div><div class="goal" id="goal"></div></div>
