}
let fitKey = '';
function fitField(force) {
  const st = document.getElementById('stage'); if (!st) return;
  const w = st.clientWidth, h = st.clientHeight, key = w + 'x' + h;
  if (!force && key === fitKey) return;
  fitKey = key;
  const fw = Math.max(60, Math.floor(Math.min(w, h * K.W / K.H))), fh = Math.floor(fw * K.H / K.W);
  const fb = document.getElementById('fieldbox'); fb.style.width = fw + 'px'; fb.style.height = fh + 'px';
