/* ================================================================ lus */
let acc = 0, lastTs = 0, lastBeep = -1;
function loop(ts) {
  requestAnimationFrame(loop);
  const dt = Math.min(100, ts - (lastTs || ts)); lastTs = ts;
  if (view !== 'game' || !G || !R.trail) return;
  fitField();
  if (G.phase === 'count') {
    const n = Math.max(0, Math.ceil((COUNT_MS - (ts - G.countStart)) / (COUNT_MS / 3)));
    if (n !== lastBeep && n >= 1) { sBeep(false); lastBeep = n; }
  }
  if (role === 'host' && sim && G.phase === 'play' && !G.paused) {
    acc += dt; let n = 0;
    while (acc >= STEP_MS && n < 6) { acc -= STEP_MS; n++; hostStep(); if (G.phase !== 'play') break; }
    if (n >= 6) acc = 0;
  } else if (role !== 'host') R.tickClient(ts);
  R.drawTop(ts);
  if (G.phase === 'play' && ts - fxTick > 250) { fxTick = ts; updateFx(); }
}
let fxTick = 0;
requestAnimationFrame(loop);

