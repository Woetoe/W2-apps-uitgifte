    this.labels.forEach(l => {
      const k = (now - l.t0) / 900;
      c.globalAlpha = 1 - k * k; c.fillStyle = l.c; c.font = '800 24px "Bricolage Grotesque",system-ui,sans-serif'; c.textAlign = 'center';
      c.fillText(l.text, Math.min(W - 90, Math.max(90, l.x)), l.y - 26 - 30 * k); c.globalAlpha = 1;
    });
    // aftellen / pauze
    if (counting) {
      const left = COUNT_MS - (now - G.countStart), n = Math.max(1, Math.ceil(left / (COUNT_MS / 3)));
