  const mine = (G.me >= 0 && G.fx[G.me]) || [];
  const items = mine.map(([type, end]) => [type, Math.max(0, Math.ceil((end - G.t) / 60))]).filter(x => x[1] > 0);
  if (G.t < G.wallsEnd) items.push(['walls_all', Math.ceil((G.wallsEnd - G.t) / 60)]);
  let html;
  if (items.length) html = items.map(([type, s]) => `<span class="fx">${glyphSVG(type)}${s}</span>`).join('');
