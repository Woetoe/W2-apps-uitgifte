const keyDirs = { ArrowLeft: -1, ArrowRight: 1, a: -1, d: 1, A: -1, D: 1 };
const keysDown = new Set();
window.addEventListener('keydown', e => {
  if (!(e.key in keyDirs) || view !== 'game' || e.target.tagName === 'INPUT') return;
  keysDown.add(e.key); input.keys = [...keysDown].reduce((a, k) => a + keyDirs[k], 0); pushInput(); e.preventDefault();
