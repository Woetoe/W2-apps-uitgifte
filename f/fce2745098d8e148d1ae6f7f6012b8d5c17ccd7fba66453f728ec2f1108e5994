      if (q.painted) { this.seg(i, q.drawn.x, q.drawn.y, q.to.x, q.to.y, q.r); }
      const pt = { x: f[0], y: f[1] };
      if (f[3] & 2) { q.from = pt; q.drawn = pt; } else { q.from = q.to; q.drawn = q.to; }
      q.to = pt; q.painted = !!(f[3] & 1); q.alive = !!(f[3] & 4); q.ghost = !!(f[3] & 8); q.r = f[2]; q.t0 = now;
      if (q.from.x !== pt.x || q.from.y !== pt.y) q.a = Math.atan2(pt.y - q.from.y, pt.x - q.from.x);
